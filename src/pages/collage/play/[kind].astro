---
/*
  TWO TRIALS WITH THE COLLAGE CUT-OUTS, IN THE SPIRIT OF LANDS (preview only).

  Chris: "You remember the whole Minecraft philosophy of noise creating
  things and how that fundamentally changed our CSS grid? Anything similar
  to that vein that would work here?" - and, of the ideas, "try 1 and 3 but
  be ready to roll back". Nothing is placed by hand: a few rules and some
  noise, and the arrangement grows out of them. The cut-outs never map back
  onto their collage; they are the blocks, not a key to the original.

    /collage/play/world   An endless field to drag around. Each collage is a
                          biome; noise decides which biome a place is in, how
                          thick the cut-outs grow there, and how big (peaks
                          and valleys). Three depths drift at different
                          speeds. A place always grows the same way, so its
                          link (?at=x,y) can be shared.

    /collage/play/fabric  A printed fabric per collage, grown cell by cell by
                          wave function collapse: each cell may only take a
                          cut-out its neighbours allow - never the same one
                          twice side by side, mirrored across a row, turned
                          down a column, colours contrasting - so it repeats
                          like a textile without ever quite repeating.

  Rolling back is deleting this one file: nothing else uses it, and the
  production build emits neither page (getStaticPaths returns nothing there).
*/
import Layout from '../../../layouts/Layout.astro';
import {sanityClient} from '../../../lib/sanity';
import {imageUrl, imageDimensions} from '../../../lib/image';
import {COLLAGE_FILTER, collageName} from '../../../lib/collage';
import {stripStegaKey} from '../../../lib/stega';

export function getStaticPaths() {
  if (import.meta.env.PUBLIC_IS_PREVIEW !== 'true') return [];
  return [{params: {kind: 'world'}}, {params: {kind: 'fabric'}}];
}

const {kind} = Astro.params as {kind: 'world' | 'fabric'};

const collages: any[] = await sanityClient.fetch(
  `*[_type == "caseStudy" && ${COLLAGE_FILTER}]{
     _id, title, "slug": slug.current,
     "cuts": *[_type == "caseStudy" && parentBrand._ref == ^._id && defined(mainImage.asset)] | order(slug.current asc){
       title, "slug": slug.current, mainImage,
       "colour": mainImage.asset->metadata.palette.dominant.background
     }
   }`,
);

// Every collage with cut-outs, the most first: its name, and its cut-outs as the pictures to grow with.
const sets = collages
  .filter((c) => c.cuts?.length)
  .map((c) => {
    const {name, year} = collageName(c.title);
    return {
      name,
      year,
      cuts: c.cuts
        .map((k: any) => {
          const dim = imageDimensions(k.mainImage);
          const src = imageUrl(k.mainImage)?.width(kind === 'world' ? 640 : 360).url();
          if (!dim || !src) return null;
          return {slug: stripStegaKey(k.slug), title: stripStegaKey(k.title), src, a: dim.width / dim.height, colour: k.colour ?? '#888888'};
        })
        .filter(Boolean),
    };
  })
  .filter((s) => s.cuts.length)
  .sort((a, z) => z.cuts.length - a.cuts.length);

const total = sets.reduce((n, s) => n + s.cuts.length, 0);
const title = kind === 'world' ? 'Cut-out World' : 'Cut-out Fabric';
---

<Layout title={title} description="A trial: collage cut-outs arranged by rules and noise." noindex>
  {kind === 'world' ? (
    <section class="cw" aria-label="Cut-out world">
      <div class="cw__view" id="cw-view" tabindex="0" aria-label="Drag, scroll or use the arrow keys to wander">
        <div class="cw__layer" data-depth="0"></div>
        <div class="cw__layer" data-depth="1"></div>
        <div class="cw__layer" data-depth="2"></div>
      </div>
      <p class="cw__where" id="cw-where" aria-live="polite"></p>
      <p class="cw__hint" id="cw-hint">Drag to wander. {sets.length} collages, {total} cut-outs, no end.</p>
    </section>
  ) : (
    <section class="cf" aria-label="Cut-out fabric">
      <header class="cf__head">
        <h1 class="cf__title">Cut-out Fabric</h1>
        <p class="cf__line">Each collage's cut-outs, grown into a printed fabric by a few rules: never the same cut-out twice side by side, mirrored along a row, turned down a column, colours contrasting.</p>
      </header>
      {[...sets, {name: 'All of them', year: '', cuts: sets.flatMap((s) => s.cuts)}].map((s, i) => (
        <div class="cf__band" data-band={i}>
          <div class="cf__bar">
            <h2 class="cf__name">{s.name}{s.year && <span class="cf__year"> {s.year}</span>}</h2>
            <button class="cf__again" type="button" data-again={i}>Grow again</button>
          </div>
          <div class="cf__cloth" data-cloth={i}></div>
        </div>
      ))}
    </section>
  )}
  <script type="application/json" id="play-data" set:html={JSON.stringify({kind, sets})} />
</Layout>

<script>
  type Cut = {slug: string; title: string; src: string; a: number; colour: string};
  type Set = {name: string; year: string; cuts: Cut[]};
  const data = JSON.parse(document.getElementById('play-data')?.textContent || '{}') as {kind: string; sets: Set[]};
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Hashing and smooth value noise, seeded: the same place always grows the same way.
  const hash = (x: number, y: number, s: number) => {
    let h = Math.imul(x | 0, 374761393) ^ Math.imul(y | 0, 668265263) ^ Math.imul(s | 0, 2147483647);
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
  };
  const smooth = (t: number) => t * t * (3 - 2 * t);
  const noise = (x: number, y: number, s: number) => {
    const xi = Math.floor(x), yi = Math.floor(y);
    const u = smooth(x - xi), v = smooth(y - yi);
    const a = hash(xi, yi, s), b = hash(xi + 1, yi, s), c = hash(xi, yi + 1, s), d = hash(xi + 1, yi + 1, s);
    return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
  };
  const fbm = (x: number, y: number, s: number) => (noise(x, y, s) * 0.62 + noise(x * 2.1, y * 2.1, s + 17) * 0.28 + noise(x * 4.3, y * 4.3, s + 31) * 0.1);

  if (data.kind === 'world') world();
  else fabric();

  /*
    THE WORLD. Three depths, each its own scatter: far (small, many, slow),
    middle, near (big, few, fast). Each depth is cut into chunks of cells;
    a cell grows at most one cut-out, jittered inside it. Only the chunks on
    screen exist, made as they come into view and dropped as they leave.
  */
  function world() {
    const view = document.getElementById('cw-view') as HTMLElement;
    const where = document.getElementById('cw-where') as HTMLElement;
    const hint = document.getElementById('cw-hint') as HTMLElement;
    const layers = [...view.querySelectorAll<HTMLElement>('.cw__layer')];
    const sets = data.sets;
    const DEPTHS = [
      {speed: 0.55, cell: 150, min: 46, max: 110, keep: 0.5, seed: 11},
      {speed: 1, cell: 240, min: 100, max: 230, keep: 0.6, seed: 23},
      {speed: 1.6, cell: 460, min: 210, max: 380, keep: 0.28, seed: 37},
    ];
    const CHUNK = 4;
    const BIOME = 1 / 1500;

    // Which collage a place belongs to: the strongest of one noise field per collage; near a border, sometimes the runner-up.
    const biomeAt = (gx: number, gy: number, roll: number) => {
      let best = 0, second = 0, bv = -1, sv = -1;
      for (let i = 0; i < sets.length; i++) {
        const v = fbm(gx * BIOME + i * 13.7, gy * BIOME - i * 7.3, 101 + i);
        if (v > bv) { second = best; sv = bv; best = i; bv = v; }
        else if (v > sv) { second = i; sv = v; }
      }
      return bv - sv < 0.05 && roll < 0.45 ? second : best;
    };

    const grow = (d: number, cx: number, cy: number) => {
      const D = DEPTHS[d];
      // The ground this cell stands for: the same for every depth, so the biomes line up.
      const gx = (cx + 0.5) * D.cell / D.speed, gy = (cy + 0.5) * D.cell / D.speed;
      const thick = fbm(gx / 1100 + 40, gy / 1100 - 40, 7);
      if (hash(cx, cy, D.seed) > D.keep * (0.35 + thick * 1.1)) return null;
      const set = sets[biomeAt(gx, gy, hash(cx, cy, D.seed + 1))];
      // A different cut-out from the cell to the left and the one above, where they came from the same collage.
      const pick = (x: number, y: number) => Math.floor(hash(x, y, D.seed + 2) * set.cuts.length);
      let k = pick(cx, cy);
      if (set.cuts.length > 2) for (let t = 0; t < 3 && (k === pick(cx - 1, cy) || k === pick(cx, cy - 1)); t++) k = (k + 1) % set.cuts.length;
      const cut = set.cuts[k];
      const peak = fbm(gx / 900 + 500, gy / 900 + 500, 3);
      const size = (D.min + (D.max - D.min) * Math.pow(peak, 1.3)) * (0.85 + hash(cx, cy, D.seed + 3) * 0.3);
      const w = cut.a >= 1 ? size : size * cut.a;
      const h = cut.a >= 1 ? size / cut.a : size;
      const x = (cx + 0.15 + hash(cx, cy, D.seed + 4) * 0.7) * D.cell - w / 2;
      const y = (cy + 0.15 + hash(cx, cy, D.seed + 5) * 0.7) * D.cell - h / 2;
      return {cut, x, y, w, h, turn: (hash(cx, cy, D.seed + 6) - 0.5) * 10};
    };

    const live = layers.map(() => new Map<string, HTMLElement>());
    const makeChunk = (d: number, kx: number, ky: number) => {
      const el = document.createElement('div');
      el.className = 'cw__chunk';
      for (let j = 0; j < CHUNK; j++)
        for (let i = 0; i < CHUNK; i++) {
          const g = grow(d, kx * CHUNK + i, ky * CHUNK + j);
          if (!g) continue;
          const a = document.createElement('a');
          a.className = 'cw__cut';
          a.href = `/portfolio?open=${encodeURIComponent(g.cut.slug)}`;
          a.draggable = false;
          a.style.cssText = `left:${g.x.toFixed(1)}px;top:${g.y.toFixed(1)}px;width:${g.w.toFixed(1)}px;height:${g.h.toFixed(1)}px;--turn:${g.turn.toFixed(2)}deg`;
          const img = document.createElement('img');
          img.src = g.cut.src;
          img.alt = g.cut.title;
          img.decoding = 'async';
          img.draggable = false;
          a.append(img);
          el.append(a);
        }
      return el;
    };

    // The camera, in ground units; a shared link starts where it was left.
    const at = new URLSearchParams(location.search).get('at')?.split(',').map(Number);
    let camX = at && Number.isFinite(at[0]) ? at[0] : 0;
    let camY = at && Number.isFinite(at[1]) ? at[1] : 0;
    let vx = 0, vy = 0, queued = false, lastName = '';

    const draw = () => {
      queued = false;
      const vw = view.clientWidth, vh = view.clientHeight;
      layers.forEach((layer, d) => {
        const D = DEPTHS[d];
        const ox = camX * D.speed - vw / 2, oy = camY * D.speed - vh / 2;
        layer.style.transform = `translate3d(${(-ox).toFixed(1)}px, ${(-oy).toFixed(1)}px, 0)`;
        const span = D.cell * CHUNK, pad = D.max;
        const x0 = Math.floor((ox - pad) / span), x1 = Math.floor((ox + vw + pad) / span);
        const y0 = Math.floor((oy - pad) / span), y1 = Math.floor((oy + vh + pad) / span);
        const want = new Set<string>();
        for (let ky = y0; ky <= y1; ky++)
          for (let kx = x0; kx <= x1; kx++) {
            const key = `${kx},${ky}`;
            want.add(key);
            if (!live[d].has(key)) {
              const el = makeChunk(d, kx, ky);
              live[d].set(key, el);
              layer.append(el);
            }
          }
        for (const [key, el] of live[d]) if (!want.has(key)) { el.remove(); live[d].delete(key); }
      });
      // Which collage the middle of the screen stands in.
      const set = sets[biomeAt(camX, camY, 1)];
      const name = `${set.name}${set.year ? `, ${set.year}` : ''}`;
      if (name !== lastName) { where.textContent = name; lastName = name; }
    };
    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(draw); } };
    let saveTimer = 0;
    const save = () => {
      clearTimeout(saveTimer);
      saveTimer = window.setTimeout(() => history.replaceState(null, '', `?at=${Math.round(camX)},${Math.round(camY)}`), 400);
    };
    const move = (dx: number, dy: number) => { camX += dx; camY += dy; queue(); save(); hint.classList.add('is-gone'); };

    // Dragging, with a glide after letting go; a click only when it did not drag.
    let down: {x: number; y: number; t: number; moved: number} | null = null;
    view.addEventListener('pointerdown', (e) => {
      down = {x: e.clientX, y: e.clientY, t: performance.now(), moved: 0};
      vx = vy = 0;
      view.setPointerCapture(e.pointerId);
      view.classList.add('is-dragging');
    });
    view.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - down.x, dy = e.clientY - down.y, now = performance.now();
      const dt = Math.max(1, now - down.t);
      vx = -dx / dt; vy = -dy / dt;
      down.moved += Math.abs(dx) + Math.abs(dy);
      down.x = e.clientX; down.y = e.clientY; down.t = now;
      move(-dx, -dy);
    });
    const up = (e: PointerEvent) => {
      if (!down) return;
      const dragged = down.moved > 6;
      down = null;
      view.classList.remove('is-dragging');
      if (dragged) {
        view.addEventListener('click', (c) => c.preventDefault(), {capture: true, once: true});
        if (!still) glide();
      } else if (e.type === 'pointerup') {
        // Pointer capture swallows the click on the cut-out; follow its link by hand.
        view.releasePointerCapture(e.pointerId);
        const hit = document.elementFromPoint(e.clientX, e.clientY)?.closest<HTMLAnchorElement>('.cw__cut');
        if (hit) location.href = hit.href;
      }
    };
    view.addEventListener('pointerup', up);
    view.addEventListener('pointercancel', up);
    const glide = () => {
      let last = performance.now();
      const step = (now: number) => {
        if (down) return;
        const dt = now - last; last = now;
        vx *= Math.pow(0.94, dt / 16); vy *= Math.pow(0.94, dt / 16);
        if (Math.abs(vx) + Math.abs(vy) < 0.02) return;
        move(vx * dt, vy * dt);
        requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    view.addEventListener('wheel', (e) => { e.preventDefault(); move(e.deltaX, e.deltaY); }, {passive: false});
    view.addEventListener('keydown', (e) => {
      const k = ({ArrowLeft: [-80, 0], ArrowRight: [80, 0], ArrowUp: [0, -80], ArrowDown: [0, 80]} as Record<string, number[]>)[e.key];
      if (k) { e.preventDefault(); move(k[0], k[1]); }
    });
    addEventListener('resize', queue);
    draw();
  }

  /*
    THE FABRIC. A grid of cells, every other column dropped half a cell, as
    a printed textile repeats. Each cell starts able to take any cut-out in
    any of four turns (as drawn, mirrored, upside down, both). The cell with
    the fewest choices left is decided first, its pick weighted towards
    colours that contrast with its decided neighbours, and the choice is
    passed on: no neighbour may then take the same cut-out, the cells beside
    it in its row must be mirrored the other way, the cells above and below
    turned the other way. Repeat until every cell is decided - wave function
    collapse. A dead end starts the band again with the next seed.
  */
  function fabric() {
    const turns = ['', 'scaleX(-1)', 'rotate(180deg)', 'rotate(180deg) scaleX(-1)'];
    const mirrored = (o: number) => o === 1 || o === 3;
    const flipped = (o: number) => o >= 2;
    const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) || 0);
    const contrast = (a: string, b: string) => {
      const [p, q] = [rgb(a), rgb(b)];
      return Math.hypot(p[0] - q[0], p[1] - q[1], p[2] - q[2]) / 441;
    };
    const bands = [...data.sets, {name: 'All of them', year: '', cuts: data.sets.flatMap((s) => s.cuts)}];
    const seeds = bands.map((_, i) => 1 + i * 97 + Math.floor(Math.random() * 1000));

    const columns = () => (innerWidth < 640 ? 4 : innerWidth < 1100 ? 7 : 10);

    // Neighbours on a half-drop grid: above, below, and two each side (the dropped columns sit half a cell up, between rows).
    const neighbours = (c: number, r: number, cols: number, rows: number) => {
      const out: {c: number; r: number; side: boolean}[] = [];
      const push = (cc: number, rr: number, side: boolean) => { if (cc >= 0 && cc < cols && rr >= 0 && rr < rows) out.push({c: cc, r: rr, side}); };
      push(c, r - 1, false);
      push(c, r + 1, false);
      const drop = c % 2;
      for (const dc of [-1, 1]) {
        push(c + dc, drop ? r - 1 : r, true);
        push(c + dc, drop ? r : r + 1, true);
      }
      return out;
    };

    const weave = (cuts: Cut[], cols: number, rows: number, seed: number) => {
      for (let attempt = 0; attempt < 30; attempt++) {
        let s = seed + attempt * 7919;
        const rand = () => { s = (Math.imul(s, 1103515245) + 12345) >>> 0; return s / 4294967296; };
        const all = cuts.flatMap((_, k) => [0, 1, 2, 3].map((o) => k * 4 + o));
        const cells = Array.from({length: cols * rows}, () => new Set(all));
        const done = new Array<number>(cols * rows).fill(-1);
        let ok = true;
        for (let n = 0; n < cells.length && ok; n++) {
          // The undecided cell with the fewest choices left (ties broken at random).
          let at = -1, least = Infinity;
          for (let i = 0; i < cells.length; i++) if (done[i] < 0) { const e = cells[i].size + rand() * 0.5; if (e < least) { least = e; at = i; } }
          const c = at % cols, r = Math.floor(at / cols);
          const near = neighbours(c, r, cols, rows);
          const options = [...cells[at]];
          if (!options.length) { ok = false; break; }
          const weight = (st: number) => {
            let w = 0.25;
            for (const m of near) { const v = done[m.r * cols + m.c]; if (v >= 0) w += contrast(cuts[st >> 2].colour, cuts[v >> 2].colour); }
            return w * w;
          };
          const ws = options.map(weight);
          let roll = rand() * ws.reduce((x, y) => x + y, 0);
          let pick = options[options.length - 1];
          for (let i = 0; i < options.length; i++) { roll -= ws[i]; if (roll <= 0) { pick = options[i]; break; } }
          done[at] = pick;
          // Pass it on to the neighbours.
          for (const m of near) {
            const j = m.r * cols + m.c;
            if (done[j] >= 0) continue;
            for (const st of [...cells[j]]) {
              const sameCut = st >> 2 === pick >> 2;
              const bad = m.side ? mirrored(st & 3) === mirrored(pick & 3) : flipped(st & 3) === flipped(pick & 3);
              if (sameCut || bad) cells[j].delete(st);
            }
            if (!cells[j].size) ok = false;
          }
        }
        if (ok) return done;
      }
      // Too few cut-outs for every rule: drop the turns and just keep neighbours different.
      return Array.from({length: cols * rows}, (_, i) => ((i * 7 + Math.floor(i / cols) * 3) % cuts.length) * 4);
    };

    const render = (i: number) => {
      const band = bands[i];
      const cloth = document.querySelector<HTMLElement>(`[data-cloth="${i}"]`);
      if (!cloth) return;
      const cols = columns();
      const rows = i === bands.length - 1 ? 5 : 4;
      const states = weave(band.cuts, cols, rows, seeds[i]);
      cloth.style.setProperty('--cols', String(cols));
      cloth.style.setProperty('--rows', String(rows - 1));
      cloth.replaceChildren(
        ...states.map((st, n) => {
          const c = n % cols, r = Math.floor(n / cols);
          const cut = band.cuts[st >> 2];
          const cell = document.createElement('a');
          cell.className = 'cf__cell';
          cell.href = `/portfolio?open=${encodeURIComponent(cut.slug)}`;
          cell.style.gridColumn = String(c + 1);
          cell.style.gridRow = String(r + 1);
          if (c % 2) cell.classList.add('is-dropped');
          // A little give in the print: each motif a touch larger or smaller, by noise across the cloth.
          const scale = 0.72 + fbm(c * 0.45, r * 0.45, seeds[i]) * 0.3;
          const img = document.createElement('img');
          img.src = cut.src;
          img.alt = cut.title;
          img.loading = 'lazy';
          img.decoding = 'async';
          img.style.transform = `${turns[st & 3]} scale(${scale.toFixed(3)})`;
          cell.append(img);
          return cell;
        }),
      );
    };

    bands.forEach((_, i) => render(i));
    document.querySelectorAll<HTMLButtonElement>('[data-again]').forEach((b) =>
      b.addEventListener('click', () => {
        const i = Number(b.dataset.again);
        seeds[i] += 1009;
        render(i);
      }),
    );
    let lastCols = columns();
    addEventListener('resize', () => { if (columns() !== lastCols) { lastCols = columns(); bands.forEach((_, i) => render(i)); } });
  }
</script>

<style is:global>
  /* THE WORLD - the full window under the header, nothing but the field. */
  main.wrap:has(.cw) {
    max-width: none;
    padding-inline: 0;
    margin-inline: 0;
  }

  .cw {
    position: relative;
  }

  .cw__view {
    position: relative;
    height: calc(100svh - var(--header-h, 4.5rem));
    min-height: 26rem;
    overflow: hidden;
    touch-action: none;
    cursor: grab;
    background: var(--color-paper, #fff);
    outline: none;
  }

  .cw__view.is-dragging {
    cursor: grabbing;
  }

  .cw__layer {
    position: absolute;
    inset: 0 auto auto 0;
    will-change: transform;
  }

  .cw__layer[data-depth='0'] {
    opacity: 0.55;
  }

  .cw__chunk {
    position: absolute;
    inset: 0 auto auto 0;
  }

  .cw__cut {
    position: absolute;
    display: block;
    transform: rotate(var(--turn));
    -webkit-user-drag: none;
    user-select: none;
  }

  .cw__cut img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    transition: transform 0.25s ease;
  }

  .cw__layer[data-depth='2'] .cw__cut img {
    filter: drop-shadow(0 10px 14px rgb(0 0 0 / 0.16));
  }

  .cw__layer[data-depth='1'] .cw__cut img {
    filter: drop-shadow(0 5px 8px rgb(0 0 0 / 0.1));
  }

  @media (hover: hover) {
    .cw__view:not(.is-dragging) .cw__cut:hover img {
      transform: scale(1.06);
    }
  }

  .cw__where,
  .cw__hint {
    position: absolute;
    left: 1rem;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--color-ink);
    background: var(--color-paper, #fff);
    padding: 0.25rem 0.5rem;
    pointer-events: none;
  }

  .cw__where {
    bottom: 1rem;
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--color-navy);
  }

