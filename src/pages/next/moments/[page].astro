---
/*
  MOMENTS - preview only, at /next/moments/home: a mock of the homepage as
  a scroll of moments on one grid.

  Chris: "imagine a landing page where we use the CSS grid ... where one
  of the sections is an actual tile item ... those results containers, or
  floating boxes with copy in them ... seen and interactable in a sea of
  other, say, if I uploaded a bunch of those sketches around it ... a
  scroll of moments like that, then I think we would have unified this
  grid idea" - "the typographic grid is something that I've wanted on this
  site for the longest time".

  Each moment is a band of one real CSS grid - square cells, 16 across on a
  wide screen, 8 on a phone - laid out by the browser from spans worked out
  here at build time. No script places anything, so it paints at once.

  SKETCHES IN A CLUSTER. Chris, of the first mock: "you don't need to
  spread such small sketches across the width of the screen, I'd be okay
  with a cluster. That way we can manage these size better." So a moment's
  sketches gather in one tile half the width, a grid inside the grid that
  keeps its lines (subgrid) - every sketch still sits on the page's own
  columns, at the size the scans can carry.

  EVERY TILE OPENS. Chris: "those blocks should be clickable, expandable
  parts just as much as anything else. That should sort of be the running
  working theory." A click on anything - a piece, a sketch, a block of
  words - opens it a size up in place and shows what it was holding back
  (a piece's way into the portfolio; a block's longer words, its credits,
  its quote); its set stays lit and the rest of the moment drops back. The
  same click again, or Escape, closes it.

  The moments, in order:
    1  who and what, with the projects, and the first of the sketches
    2  Chateau Seven: its block of type and credits, its finished pieces,
       and the sketches that came before them - fragment, whole, origin
    3  each result, in a field of the work that earned it
    4  a way to get in touch, with the last of the sketches

  The 109 Chateau Seven sketches are the only ones in Sanity so far. Draft
  words are marked DRAFT.

  Never built for production (getStaticPaths), and noindex.
*/
import Layout from '../../../layouts/Layout.astro';
import Picture from '../../../components/next/MomentPic.astro';
import {getAllGridItems, getSiteSettings, getSketches} from '../../../lib/queries';
import {tileImage, imageDimensions} from '../../../lib/image';
import {tileHref, cleanKey} from '../../../lib/tiles';
import {stripStegaKey} from '../../../lib/stega';
import {clusterCard} from '../../../lib/clusterCard';
import {parseCreditLines} from '../../../lib/credits';

export async function getStaticPaths() {
  if (import.meta.env.PUBLIC_IS_PREVIEW !== 'true') return [];
  return [{params: {page: 'home'}}];
}

const clean = (s: unknown) => stripStegaKey(s).replace(/\s+/g, ' ').trim();
const settings = await getSiteSettings();
const CONTACT_URL = settings?.contactUrl || '/contact';
const all: any[] = (await getAllGridItems()).filter((it: any) => tileImage(it) && imageDimensions(tileImage(it)));
const sketches: any[] = (await getSketches()).filter((it: any) => imageDimensions(tileImage(it)));
const isProject = (it: any) => cleanKey(it.pageType) === 'Case Study';
const idOf = (it: any) => cleanKey(it._id).replace(/^drafts\./, '');
const keyOf = (it: any) => (it.slug?.current ? cleanKey(it.slug.current) : idOf(it));
const rank = (it: any) => (typeof it.orderRank === 'string' ? it.orderRank : null);
const studies = all.filter(isProject).sort((a, z) => {
  const ra = rank(a);
  const rz = rank(z);
  if (ra && rz) return ra < rz ? -1 : 1;
  return ra ? -1 : rz ? 1 : clean(a.title).localeCompare(clean(z.title));
});
const studyOfHref = new Map(studies.filter((s) => tileHref(s)).map((s) => [tileHref(s)!, s]));
const piecesOf = (s: any) => all.filter((it) => !isProject(it) && tileHref(it) && tileHref(it) === tileHref(s));

// A steady shuffle: the same scatter on every build.
const hash = (s: string) => [...s].reduce((h, c) => Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0, 2166136261);
const scatter = <T,>(list: T[], key: (t: T) => string) => [...list].sort((a, z) => hash(key(a)) - hash(key(z)));

/*
  A TILE'S CELLS: columns by rows, closed and open, on a wide screen and on
  a phone (whose cells are about half the width). A picture's shape picks
  the pair nearest it for the ground it is given.
*/
type Span = {c: number; r: number};
type Spans = {d: Span; od: Span; p: Span; op: Span};
const spanFor = (aspect: number, area: number, maxC: number): Span => {
  let best: Span = {c: 1, r: 1};
  let err = Infinity;
  for (let c = 1; c <= maxC; c++) {
    const r = Math.max(1, Math.round(c / aspect));
    const e = Math.abs(Math.log(c / r / aspect)) * 2 + Math.abs(Math.log((c * r) / area));
    if (e < err) [best, err] = [{c, r}, e];
  }
  return best;
};
const aspectOf = (it: any) => {
  const d = imageDimensions(tileImage(it))!;
  return d.width / d.height;
};
const grow = (s: Span, k: number, maxC: number): Span => ({c: Math.min(maxC, Math.round(s.c * k)), r: Math.round(s.r * k)});
/*
  Pieces as even squares, each picture whole inside its square. Chris, of
  the second mock: "this is way messier" - the spread of sizes was most of
  it. The project's own tile a size up; open, a size up again.
*/
const pieceSpans = (_it: any, lead = false): Spans =>
  lead ? {d: {c: 4, r: 4}, od: {c: 6, r: 6}, p: {c: 8, r: 8}, op: {c: 8, r: 8}} : {d: {c: 2, r: 2}, od: {c: 4, r: 4}, p: {c: 4, r: 4}, op: {c: 8, r: 8}};
/*
  Sketches, in their cluster, on a grid twice as fine as the page's - two
  of its cells to a page column, its lines landing on the page's every
  other one. Chris: "the sketch tiles are too large". A fine cell each, two
  for a wide or a tall one or a big scan; open, a few times that. On a
  phone the cluster keeps the page's own cells, which are already half the
  width.
*/
const sketchSpans = (it: any): Spans => {
  const a = aspectOf(it);
  const dim = imageDimensions(tileImage(it))!;
  const big = Math.max(dim.width, dim.height) >= 600;
  const d: Span = big ? {c: 2, r: 2} : a > 1.7 ? {c: 2, r: 1} : a < 0.6 ? {c: 1, r: 2} : {c: 1, r: 1};
  return {d, od: grow(d, 3, 6), p: d, op: grow(d, 3, 8)};
};

type Pic = {kind: 'pic'; it: any; set: string; s: Spans; sketch: boolean; of?: string};
type Cluster = {kind: 'cluster'; set: string; pics: Pic[]; col: number; row: number; cols: number; rows: number; prows: number};
type Words = {kind: 'words'; id: string; set: string; s: Spans; col: number; row: number; ocol?: number};
type Tile = Pic | Cluster | Words;
type Moment = {id: string; label: string; tiles: Tile[]};

const pic = (it: any, set: string, s: Spans, sketch = false, of?: string): Pic => ({kind: 'pic', it, set, s, sketch, of});
/*
  A cluster about as tall as it is wide - so it sits level with what is
  beside it rather than running on below it - on the right of the
  moment, with room for one sketch opened and little more.
*/
const cluster = (list: any[], set: string, of: string, row: number): Cluster => {
  const pics = list.map((s) => pic(s, set, sketchSpans(s), true, of));
  const cells = (k: 'd' | 'p') => pics.reduce((t, p) => t + p.s[k].c * p.s[k].r, 0);
  // Page columns, each two of the cluster's fine ones.
  const cols = Math.max(4, Math.min(8, Math.round(Math.sqrt(cells('d') * 1.4) / 2)));
  return {kind: 'cluster', set, pics, col: 17 - cols, row, cols, rows: Math.ceil(Math.ceil(cells('d') / (cols * 2)) / 2) + 2, prows: Math.ceil(cells('p') / 8) + 3};
};
// A block of words beside a cluster opens only as wide as the room left of it.
const beside = (c: Cluster, w: Words): Words => ({...w, s: {...w.s, od: {c: Math.min(w.s.od.c, 16 - c.cols), r: w.s.od.r + Math.max(0, w.s.od.c - (16 - c.cols))}}});
const words = (id: string, set: string, d: Span, od: Span, p: Span, op: Span, col: number, row: number, ocol?: number): Words => ({
  kind: 'words',
  id,
  set,
  s: {d, od, p, op},
  col,
  row,
  ocol,
});

const chateau = studies.find((s) => /chateau/i.test(clean(s.title)));
const chateauSet = chateau ? idOf(chateau) : 'sketches';
const chateauName = chateau ? clean(chateau.title) : '';
const chateauSketches = scatter(
  sketches.filter((s) => chateau && cleanKey(s.project ?? '') === idOf(chateau)),
  (s) => idOf(s),
);
/*
  ONE SECTION, FOR NOW. Chris: "just work on one section. Don't spread the
  sketches across two sections. just one." So the page is Chateau Seven's
  moment alone, every one of its sketches in its one cluster; the other
  moments below are kept, switched off (ONLY), to come back once this one
  is right.
*/
const ONLY = 'chateau';
const opening: any[] = [];
const own = chateauSketches;
const closing: any[] = [];

const moments: Moment[] = [];

// 1. Who and what.
moments.push({
  id: 'who',
  label: 'Who',
  tiles: [
    ...(() => {
      const c = cluster(opening, chateauSet, chateauName, 1);
      return [beside(c, words('intro', 'intro', {c: 6, r: 3}, {c: 7, r: 5}, {c: 8, r: 4}, {c: 8, r: 7}, 1, 1)), c];
    })(),
    ...studies.map((s) => pic(s, idOf(s), pieceSpans(s))),
  ],
});

// 2. Chateau Seven: fragment, whole, origin.
if (chateau) {
  moments.push({
    id: 'chateau',
    label: chateauName,
    tiles: [
      ...(() => {
        const c = cluster(own, chateauSet, chateauName, 1);
        return [beside(c, words('chateau-card', chateauSet, {c: 5, r: 5}, {c: 8, r: 8}, {c: 8, r: 6}, {c: 8, r: 11}, 1, 1)), c];
      })(),
      pic(chateau, chateauSet, pieceSpans(chateau, true)),
      ...scatter(piecesOf(chateau), (it) => idOf(it)).map((it) => pic(it, chateauSet, pieceSpans(it))),
    ],
  });
}

// 3. Each result, in a field of the work that earned it.
type Result = {number: string; what: string; who: string; href: string; study: any; quote?: string; by?: string};
const results: Result[] = ((settings?.proofStats ?? []) as any[])
  .map((p) => {
    const m = clean(p.stat).match(/^([$€£]?\d[\d.,]*\s*(?:%|k|K|x)?)\s*(.*)$/);
    const study = p.href ? studyOfHref.get(clean(p.href)) : undefined;
    if (!m || !study) return null;
    return {
      number: m[1].trim(),
      what: `${m[2]}${clean(p.rest) ? ` ${clean(p.rest)}` : ''}`.trim().replace(/^./, (c) => c.toLowerCase()),
      who: clean(study.title),
      href: tileHref(study)!,
      study,
      quote: clean(p.quote) || undefined,
      by: [clean(p.name), clean(p.org)].filter(Boolean).join(', ') || undefined,
    };
  })
  .filter(Boolean) as Result[];
results.forEach((res, k) => {
  const set = idOf(res.study);
  const left = k % 2 === 0;
  moments.push({
    id: `result-${k}`,
    label: res.who,
    tiles: [
      words(`result-${k}`, set, {c: 5, r: 3}, {c: 6, r: 5}, {c: 8, r: 4}, {c: 8, r: 7}, left ? 1 : 12, 1, left ? 1 : 11),
      pic(res.study, set, pieceSpans(res.study, true)),
      ...scatter(piecesOf(res.study), (it) => idOf(it))
        .slice(0, 10)
        .map((it) => pic(it, set, pieceSpans(it))),
    ],
  });
});

// 4. A way to get in touch.
moments.push({
  id: 'end',
  label: 'Contact',
  tiles: [
    ...(() => {
      const c = cluster(closing, chateauSet, chateauName, 1);
      return [beside(c, words('contact', 'contact', {c: 6, r: 3}, {c: 7, r: 5}, {c: 8, r: 4}, {c: 8, r: 7}, 1, 1)), c];
    })(),
  ],
});

const shown = moments.filter((m) => !ONLY || m.id === ONLY);
const chateauCard = chateau ? clusterCard(chateau) : null;
const chateauCredits = chateau ? parseCreditLines(chateau.projectCredits) : [];
const bioText =
  settings?.bioText ||
  'Chris Rumeau is a brand designer, illustrator, and typographer building visual identities rooted in heritage craft and hand-drawn precision.';
const socials: {platform?: string; url?: string}[] = (settings?.socialLinks ?? []).filter((s: any) => s?.url);

const vars = (s: Spans) =>
  `--c0:${s.d.c};--r0:${s.d.r};--oc:${s.od.c};--or:${s.od.r};--pc0:${s.p.c};--pr0:${s.p.r};--opc:${s.op.c};--opr:${s.op.r}`;
---

<Layout title="Moments - Rumeau Design Co" description="The homepage as moments on one grid." noindex>
  <h1 class="visually-hidden">Rumeau Design Co</h1>
  <div class="mo">
    {shown.map((m) => (
      <section class="mo-band" aria-label={m.label} data-band={m.id}>
        {m.tiles.map((t) => {
          if (t.kind === 'cluster')
            return (
              <div class="mo-cluster" style={`--col:${t.col};--row:${t.row};--cols:${t.cols};--rows:${t.rows};--prows:${t.prows}`} data-set={t.set} role="group" aria-label={`Sketches for ${t.pics[0]?.of ?? ''}`}>
                {t.pics.map((p) => (
                  <Picture p={p} />
                ))}
              </div>
            );
          if (t.kind === 'pic') return <Picture p={t} />;
          return (
            <div
              class:list={['mo-tile', 'mo-words', `mo-words--${t.id.replace(/-\d+$/, '')}`]}
              style={`${vars(t.s)};--col:${t.col};--row:${t.row};--ocol:${t.ocol ?? t.col}`}
              data-set={t.set}
              tabindex="0"
              role="button"
              aria-expanded="false"
            >
              {t.id === 'intro' && (
                <>
                  <p class="mo-big">{bioText}</p>
                  <div class="mo-more">
                    {(settings?.locality || settings?.areaServed) && (
                      <p class="mo-line">{[clean(settings?.locality), clean(settings?.areaServed)].filter(Boolean).join(' · ')}</p>
                    )}
                    <span class="mo-links">
                      <a class="mo-go" href="/about">About <span aria-hidden="true">&rarr;</span></a>
                      <a class="mo-go" href={CONTACT_URL}>Contact <span aria-hidden="true">&rarr;</span></a>
                    </span>
                  </div>
                  <a class="mo-go" href="/portfolio?view=all">All the work <span aria-hidden="true">&rarr;</span></a>
                </>
              )}
              {t.id === 'chateau-card' && chateauCard && (
                <>
                  {chateauCard.kicker && <p class="mo-kicker">{chateauCard.kicker}</p>}
                  <h2 class="mo-title">{chateauCard.title}</h2>
                  {chateauCard.client && <p class="mo-small">For {chateauCard.client}</p>}
                  {chateauCard.line && <p class="mo-line mo-less">{chateauCard.line}</p>}
                  <p class="mo-small">{chateauSketches.length} sketches, then the marks they became.</p>
                  <div class="mo-more">
                    {chateau.summaryText && <p class="mo-line">{clean(chateau.summaryText)}</p>}
                    {chateauCredits.length > 0 && (
                      <ul class="mo-credits">
                        {chateauCredits.map((c) => (
                          <li>
                            {c.role && <span class="mo-credits__role">{c.role}</span>} {c.url ? <a href={c.url}>{c.name}</a> : c.name}
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                  <span class="mo-links">
                    {tileHref(chateau) && (
                      <a class="mo-go" href={tileHref(chateau)!}>The project <span aria-hidden="true">&rarr;</span></a>
                    )}
                    <a class="mo-go" href={`/portfolio?view=all&open=${keyOf(chateau)}`}>In the portfolio <span aria-hidden="true">&rarr;</span></a>
                  </span>
                </>
              )}
              {t.id.startsWith('result-') &&
                (() => {
                  const res = results[Number(t.id.split('-')[1])];
                  const card = clusterCard(res.study);
                  return (
                    <>
                      <span class="mo-number">{res.number}</span>
                      <span class="mo-what">{res.what}</span>
                      <div class="mo-more">
                        {res.quote && <p class="mo-line">&ldquo;{res.quote}&rdquo;</p>}
                        {res.by && <p class="mo-small">{res.by}</p>}
                        {card?.line && <p class="mo-line">{card.line}</p>}
                      </div>
                      <a class="mo-go" href={res.href}>{res.who} <span aria-hidden="true">&rarr;</span></a>
                    </>
                  );
                })()}
              {t.id === 'contact' && (
                <>
                  {/* DRAFT words, Chris's to rewrite. */}
                  <p class="mo-big">Something that needs drawing?</p>
                  <div class="mo-more">
                    <p class="mo-line">Brand identities, lettering and merch, drawn by hand.</p>
                    {socials.length > 0 && (
                      <span class="mo-links">
                        {socials.map((s) => (
                          <a class="mo-go" href={s.url}>{clean(s.platform) || 'Link'} <span aria-hidden="true">&rarr;</span></a>
                        ))}
                      </span>
                    )}
                  </div>
                  <a class="button mo-button" href={CONTACT_URL}>Let's work</a>
                </>
              )}
            </div>
          );
        })}
      </section>
    ))}
  </div>
</Layout>

<script>
  /*
    EVERY TILE OPENS. A click opens it a size up in place - the grid makes
    room around it - and its set stays lit while the rest of the moment
    drops back. The same click again, or Escape, closes it. A link inside
    an opened tile (into the portfolio, the project, a credit) is followed
    as a link.
  */
  let open: HTMLElement | null = null;
  const close = () => {
    if (!open) return;
    const band = open.closest('.mo-band')!;
    band.classList.remove('has-focus');
    band.querySelectorAll('.is-lit').forEach((el) => el.classList.remove('is-lit'));
    open.classList.remove('is-open');
    open.setAttribute('aria-expanded', 'false');
    open = null;
  };
  const openTile = (tile: HTMLElement) => {
    if (open === tile) return close();
    close();
    const band = tile.closest('.mo-band')!;
    const set = tile.dataset.set!;
    band.classList.add('has-focus');
    band.querySelectorAll<HTMLElement>(`[data-set="${CSS.escape(set)}"]`).forEach((el) => el.classList.add('is-lit'));
    tile.classList.add('is-open', 'is-lit');
    tile.setAttribute('aria-expanded', 'true');
    open = tile;
  };
  document.querySelectorAll<HTMLElement>('.mo-band').forEach((band) =>
    band.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a')) return;
      const tile = target.closest<HTMLElement>('.mo-tile');
      if (tile) openTile(tile);
    }),
  );
  document.querySelectorAll<HTMLElement>('.mo-words').forEach((t) =>
    t.addEventListener('keydown', (e) => {
      if ((e.key === 'Enter' || e.key === ' ') && e.target === t) {
        e.preventDefault();
        openTile(t);
      }
    }),
  );
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
</script>

<!-- Styles: global.css, MOMENTS (PREVIEW). -->
