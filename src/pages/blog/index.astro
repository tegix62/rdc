---
import Layout from '../../layouts/Layout.astro';
import { pageDescription } from '../../lib/meta';
import PostCard from '../../components/PostCard.astro';
import { getPage, getBlogPosts } from '../../lib/queries';

const page = await getPage('blog');
const posts = await getBlogPosts();
---

<Layout title={page?.title ?? 'Blog'} description={pageDescription(page, 'Notes on brand identity, hand lettering and merch design, and the process behind the work.')}>
  <h1>{page?.heading ?? page?.title ?? 'Blog'}</h1>
  <p class="blog-intro">
    {page?.description || 'Notes on heritage brand identity, hand lettering, merch design, and the process behind the work at Rumeau Design Co.'}
  </p>
  <div class="post-list">
    {posts.map((post: any) => (
      <PostCard post={post} showCategory showExcerpt />
    ))}
  </div>
  {posts.length === 0 && <p>No posts yet.</p>}
</Layout>
