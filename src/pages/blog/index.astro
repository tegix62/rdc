---
import Layout from '../../layouts/Layout.astro';
import { pageDescription } from '../../lib/meta';
import Img from '../../components/Img.astro';
import { getPage, getBlogPosts } from '../../lib/queries';
import { dateAttr, formatDate } from '../../lib/date';
import { readingTime } from '../../lib/readingTime';

const page = await getPage('blog');
const posts = await getBlogPosts();
---

<Layout title={page?.title ?? 'Blog'} description={pageDescription(page, 'Notes on brand identity, hand lettering and merch design, and the process behind the work.')}>
  <h1>{page?.heading ?? page?.title ?? 'Blog'}</h1>
  <p class="blog-intro">
    {page?.description || 'Notes on heritage brand identity, hand lettering, merch design, and the process behind the work at Rumeau Design Co.'}
  </p>
  <div class="grid grid--prose">
    {posts.map((post: any) => (
      <a class="card" href={`/blog/${post.slug.current}`}>
        {(post.thumbnailImage || post.mainImage) && (
          <Img
            image={post.thumbnailImage || post.mainImage}
            field={post.thumbnailImage ? 'thumbnailImage' : 'mainImage'}
            alt={post.title}
            width={600}
            height={400}
            sizes="(max-width: 40rem) 100vw, (max-width: 60rem) 50vw, 33vw"
          />
        )}
        <p class="card__title">{post.title}</p>
        <p class="card__meta">
          {formatDate(post.publishedAt) && (
            <time datetime={dateAttr(post.publishedAt)}>{formatDate(post.publishedAt)}</time>
          )}
          {formatDate(post.publishedAt) && readingTime(post.body) && ' · '}
          {readingTime(post.body)}
        </p>
        {post.category && (
          <p class="card__category">{post.category}</p>
        )}
        {post.excerpt && <p class="card__meta">{post.excerpt}</p>}
      </a>
    ))}
  </div>
  {posts.length === 0 && <p>No posts yet.</p>}
</Layout>
