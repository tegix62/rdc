---
/*
  Category index pages: /blog/category/brand-identity, etc.

  These are the long-tail SEO pages. Someone searching "heritage brand
  identity design process" is more likely to land on a page titled
  "Brand Identity — Rumeau Design Co Blog" than on the generic /blog
  index, because the category page matches the query more closely.

  Each page aggregates posts with that category and shows related case
  studies, so a visitor arriving from search sees both the writing and
  the work in one place.
*/
import Layout from '../../../layouts/Layout.astro';
import Img from '../../../components/Img.astro';
import EmailCapture from '../../../components/EmailCapture.astro';
import PostCard from '../../../components/PostCard.astro';
import { sanityClient } from '../../../lib/sanity';
import { getRelatedWork } from '../../../lib/queries';
import { archiveCard } from '../../../lib/image';
import { BLOG_CATEGORIES, categorySlug } from '../../../lib/blogCategories';

export async function getStaticPaths() {
  // The names, descriptions and slug rule live in lib/blogCategories.ts, which
  // the footer index also reads - see the note there on why there is one copy.
  return Object.keys(BLOG_CATEGORIES).map((cat) => ({
    params: { category: categorySlug(cat) },
    props: { categoryName: cat, meta: BLOG_CATEGORIES[cat] },
  }));
}

const { categoryName, meta } = Astro.props;
const slug = Astro.params.category;

const posts = await sanityClient.fetch(
  `*[_type == "blogPost" && category == $category]
    | order(publishedAt desc){
      title, slug, thumbnailImage, mainImage, publishedAt, excerpt,
      "body": body[]{_type, children[]{text}}
    }`,
  { category: categoryName },
);

const relatedWork = await getRelatedWork(categoryName, 4);
---

<Layout
  title={`${meta.title} — Blog`}
  description={meta.description}
>
  <h1>{meta.title}</h1>
  <p class="blog-intro">{meta.description}</p>

  {posts.length > 0 ? (
    <div class="post-list">
      {posts.map((post: any) => (
        <PostCard post={post} showExcerpt />
      ))}
    </div>
  ) : (
    <p>No posts in this category yet. <a href="/blog">See all posts.</a></p>
  )}

  {relatedWork.length > 0 && (
    <section class="blog-related">
      <h2>{meta.title} work</h2>
      <div class="grid">
        {relatedWork.map((item: any) => {
          // Same archive card as "More Work" on a case study - see archiveCard().
          const card = archiveCard(item);
          return (
            <a class="card" href={`/work/${item.slug.current}`}>
              {card.image && (
                <Img
                  image={card.image}
                  markMode={card.mode}
                  field={card.mode === 'drawn' ? 'archiveMark (Archive Mark)' : 'thumbnail'}
                  alt={item.title}
                  width={600}
                  sizes="(max-width: 40rem) 100vw, (max-width: 60rem) 50vw, 25vw"
                />
              )}
              <p class="card__title">{item.title}</p>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <EmailCapture source={`blog/category/${slug}`} />

  <a class="blog-back" href="/blog">&larr; All posts</a>
</Layout>
