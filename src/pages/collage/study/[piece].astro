---
/*
  ONE COLLAGE UNDER GLASS, on a page of its own - preview only.

  The series lives at /collage (every piece, one per screen). This is the
  same piece alone, the way it was first tested: a place to try the
  magnifier on one square without the rest of the series around it, and
  the URL the magnifier's test drives. Production emits no page at all,
  the same way as the Red Kettle rough cut next door.
*/
import Layout from '../../../layouts/Layout.astro';
import {sanityClient} from '../../../lib/sanity';
import {collageName, collagePath} from '../../../lib/collage';
import Loupe from '../../../components/Loupe.astro';

export async function getStaticPaths() {
  if (import.meta.env.PUBLIC_IS_PREVIEW !== 'true') return [];
  const docs: any[] = await sanityClient.fetch(
    `*[_type == "caseStudy" && defined(fullScan.asset) && !(_id in path("drafts.**"))]{
       title, "slug": slug.current,
       "scan": fullScan.asset->{url, "w": metadata.dimensions.width, "h": metadata.dimensions.height}
     }`,
  );
  return docs
    .filter((d) => d.slug && d.scan?.url && d.scan.w && d.scan.h)
    .map((d) => ({params: {piece: collagePath(d.slug)}, props: d}));
}

const {title, scan} = Astro.props as any;
const {name, year} = collageName(title);
---

<Layout title={name} description={`${name}, a collage${year ? ` from ${year}` : ''}, under a magnifier.`} noindex>
  <article class="loupe-page">
    <header class="loupe-page__head">
      <p class="loupe-page__eyebrow">Collage{year && <> &middot; {year}</>}</p>
      <h1 class="loupe-page__title">{name}</h1>
    </header>
    <Loupe name={name} scan={scan} />
    <p class="loupe-page__compare">
      Compare: <a href={`/collage/lens/${collagePath(Astro.params.piece as string)}`}>the picture as the lens</a>
    </p>
  </article>
</Layout>

<style is:global>
  .loupe-page {
    padding: var(--space-5) 0 var(--space-6);
  }

  .loupe-page__head {
    margin-bottom: var(--space-3);
    text-align: center;
  }

  .loupe-page__eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray);
  }

  .loupe-page__title {
    margin: 0.25rem 0 0;
  }

  .loupe-page__compare {
    margin: var(--space-3) 0 0;
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-gray);
  }
</style>
