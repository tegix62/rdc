---
/*
  A WORLD OF WORK - preview only, at /next/world/home.

  Chris, of the first round: "original Height Map and Biome were the
  exceptional ones. Let's shelve Height Map v2 and Caves", "if this could
  operate like the main grid now, with full functionality of expansion",
  "on Biome ... stuff that's parented to a grid item to hug it, even though
  they don't have a case study", "only leave small noticeable gaps between
  Biomes". See src/lib/world.ts for the rules.

  Then: "the height map and the biome idea should just be combined", so
  LANDS - first as tinted territories ("too clunky - think like how tight
  Height Map is, but we're grouping things together"), now the height
  map's own tight fill with each project's pieces landing together, each
  piece as large as its picture is detailed. And a COLOUR switch
  (heights and lands): "black and white things might appear first".

  Detail and colour come from each picture's tiny preview (Sanity's LQIP,
  a ~20px blurred copy in the asset's metadata, sent inline), measured on a
  canvas - so nothing is downloaded to measure them.

  Then: "when you click on something, it should look like the portfolio
  grid with the blue box and all of that functionality. Not like the type
  lettering functionality", and "include, just like in the merch and
  apparel filter, the blurb for each according case study, and also the
  subtext below". So an opened piece wears the main grid's navy hairline
  frame and its project bar ("NAME · 9 pieces →", the link to the project),
  the rest of the page drops back as it does there, and the project's block
  of type - kicker, name, "For" client, its first line, the result, "See
  the project" - is set beside it, from the same clusterCard() the merch
  view uses. A case study wears its bar at rest, as on the main grid (a
  corner mark when the tile is small). Picking the opened piece again,
  Escape or the browser's back closes it.

  The first two modes: the height map (the original), and biomes (each project, or
  each piece with the pieces parented to it, a tight block; the blocks a
  cell apart). In both, a piece opens as on the main grid: large, its set
  gathered round it, the rest dimmed; a bar above names it, links its
  project and has the way back - as do Escape and the browser's back. The
  opened piece, picked again, goes to its project.

  Pictures are lazy and their tiles hidden until placed. Labels, the
  biomes' tint and the bar's contents are drawn by the script and styled
  inline - the critical-CSS step drops scoped rules for elements that only
  exist once the script runs.

  Never built for production (getStaticPaths), and noindex.
*/
import Layout from '../../../layouts/Layout.astro';
import Img from '../../../components/Img.astro';
import {getAllGridItems} from '../../../lib/queries';
import {tileImage, imageDimensions} from '../../../lib/image';
import {treatmentOf, tileHref, cleanKey, merchPlacement} from '../../../lib/tiles';
import {stripStegaKey} from '../../../lib/stega';
import {sanityClient} from '../../../lib/sanity';
import {clusterCard} from '../../../lib/clusterCard';

export async function getStaticPaths() {
  if (import.meta.env.PUBLIC_IS_PREVIEW !== 'true') return [];
  return [{params: {page: 'home'}}];
}

const clean = (s: unknown) => stripStegaKey(s).replace(/\s+/g, ' ').trim();
const all: any[] = (await getAllGridItems()).filter((it: any) => tileImage(it) && imageDimensions(tileImage(it)));
const isProject = (it: any) => cleanKey(it.pageType) === 'Case Study';

const names: Record<string, string> = {};
for (const it of all) {
  const href = tileHref(it);
  if (href && isProject(it)) names[href] = clean(it.title);
}
// Each picture's tiny preview, for its detail and colour.
const refOf = (it: any) => tileImage(it)?.asset?._ref ?? tileImage(it)?.asset?._id ?? null;
const previews: Record<string, string> = Object.fromEntries(
  (
    (await sanityClient.fetch(`*[_type == "sanity.imageAsset" && _id in $ids]{_id, "lqip": metadata.lqip}`, {
      ids: [...new Set(all.map(refOf).filter(Boolean))],
    })) as {_id: string; lqip?: string}[]
  )
    .filter((a) => a.lqip)
    .map((a) => [a._id, a.lqip!]),
);
// Each project's piece count (for its bar) and its block of type.
const count: Record<string, number> = {};
for (const it of all) {
  const href = tileHref(it);
  if (href) count[href] = (count[href] ?? 0) + 1;
}
const cards = all.filter((it) => isProject(it) && tileHref(it)).map((it) => ({href: tileHref(it)!, card: clusterCard(it)})).filter((c) => c.card);
const barOf = (it: any) => clean(it.parentTitle ?? it.title ?? 'View project');
const pieces = all.map((it) => {
  const d = imageDimensions(tileImage(it))!;
  return {
    w: d.width,
    h: d.height,
    project: tileHref(it),
    own: isProject(it),
    id: cleanKey(it._id).replace(/^drafts\./, ''),
    parent: it.pieceParent ? cleanKey(it.pieceParent) : null,
    title: clean(it.title),
    lqip: previews[refOf(it)] ?? null,
    /*
      Chris, on a phone: "I feel like less important tiles are getting more
      area". The case studies and the hero tiles he marked stand out; an
      alternate merch shot, or a piece hung off another (a close-up), takes
      less ground than the piece it supports.
    */
    big: isProject(it) || !!it.heroTile,
    weight:
      cleanKey(it.category) === 'Merch & Apparel' && merchPlacement(it) === 'later' ? 0.45 : it.pieceParent ? 0.6 : 1,
  };
});
const data = {pieces, names};
---

<Layout title="World - Rumeau Design Co" description="The portfolio as a generated world." noindex>
  <div class="wd">
    <div class="wd-bar">
      <button type="button" class="wd-btn" data-mode="heights">Height map</button>
      <button type="button" class="wd-btn" data-mode="biomes">Biomes</button>
      <button type="button" class="wd-btn" data-mode="lands">Lands</button>
      <button type="button" class="wd-btn" data-colour aria-pressed="false">By colour</button>
      <button type="button" class="wd-btn wd-btn--roll" data-roll>New world</button>
    </div>
    <p class="wd-about" data-about></p>
    <div class="wd-world">
      {all.map((it, i) => {
        const href = tileHref(it);
        return (
          <div class:list={['wd-piece', treatmentOf(it) === 'mark' && 'wd-piece--mark', isProject(it) && href && 'wd-piece--study']} data-i={i} hidden>
            <div class="wd-frame">
              <button type="button" class="wd-pic" aria-label={clean(it.title)}>
                <Img image={tileImage(it)} alt="" width={1400} sizes="25vw" loading="lazy" field="Grid Thumbnail (world)" />
              </button>
              {href && (
                <a class="wd-jump" href={href} aria-label={[barOf(it), (count[href] ?? 0) > 1 ? `${count[href]} pieces` : null].filter(Boolean).join(' - ')}>
                  <span class="wd-jump__label">{barOf(it)}</span>
                  {(count[href] ?? 0) > 1 && (
                    <span class="wd-jump__count">
                      &middot; {count[href]} pieces
                    </span>
                  )}
                  <span class="wd-jump__arrow" aria-hidden="true">&rarr;</span>
                </a>
              )}
            </div>
          </div>
        );
      })}
      {cards.map(({href, card}) => (
        <a class="wd-card" href={href} data-card={href} hidden>
          {card!.kicker && <span class="pf-card__kicker">{card!.kicker}</span>}
          <span class="pf-card__title">{card!.title}</span>
          {card!.client && <span class="pf-card__client">For {card!.client}</span>}
          {card!.line && <span class="pf-card__line">{card!.line}</span>}
          {card!.result && <span class="pf-card__result">{card!.result}</span>}
          <span class="pf-card__go">
            See the project <span aria-hidden="true">&rarr;</span>
          </span>
        </a>
      ))}
    </div>
  </div>
  <script type="application/json" id="wd-data" set:html={JSON.stringify(data)} />
</Layout>

<!--
  The page's styles are in global.css (WORLD, PREVIEW): most of them are for
  classes the script adds - the opened piece, the drop back - and the
  critical-CSS step prunes those from a page's own inline styles.
-->

<script>
  import {generateWorld, type WorldMode, type WorldResult} from '../../../lib/world';
  import {seedOf} from '../../../lib/cluster';

  type P = {w: number; h: number; project: string | null; own: boolean; id: string; parent: string | null; title: string; lqip: string | null; detail?: number; tone?: number};
  const data: {pieces: P[]; names: Record<string, string>} = JSON.parse(document.getElementById('wd-data')!.textContent!);
  const world = document.querySelector<HTMLElement>('.wd-world')!;
  const tiles = Array.from(world.querySelectorAll<HTMLElement>('.wd-piece'));
  const cards = new Map(Array.from(world.querySelectorAll<HTMLElement>('[data-card]')).map((el) => [el.dataset.card!, el]));
  const about = document.querySelector<HTMLElement>('[data-about]')!;
  const ABOUT: Record<string, string> = {
    heights: 'Under the page is an invisible landscape of hills and valleys; each piece is drawn as big as the ground is high where it lands.',
    biomes: 'Each project - or a piece with the pieces parented to it - is its own patch of land, a small gap between them.',
    lands: 'The height map, but each project lands together in its own patch of ground.',
  };
  const byId = new Map(data.pieces.map((p, i) => [p.id, i]));

  const q = new URLSearchParams(location.search);
  let mode = (['biomes', 'lands'].includes(q.get('mode') ?? '') ? q.get('mode') : 'heights') as WorldMode;
  let colour = q.get('sort') === 'colour';
  const colourBtn = document.querySelector<HTMLButtonElement>('[data-colour]')!;

  /*
    Each picture's detail and colour, from its tiny preview: detail the mean
    tone change between neighbouring pixels (ranked, 0 plainest to 1
    busiest); colour a sort key - black and white (little colour in it)
    below 1, by lightness, dark first; else 1 + its hue round the wheel.
  */
  const measure = (src: string) =>
    new Promise<{detail: number; tone: number} | null>((done) => {
      const img = new Image();
      img.onerror = () => done(null);
      img.onload = () => {
        try {
          const w = img.naturalWidth;
          const h = img.naturalHeight;
          const c = document.createElement('canvas');
          c.width = w;
          c.height = h;
          const ctx = c.getContext('2d', {willReadFrequently: true})!;
          ctx.drawImage(img, 0, 0);
          const d = ctx.getImageData(0, 0, w, h).data;
          const lum = (k: number) => 0.299 * d[k] + 0.587 * d[k + 1] + 0.114 * d[k + 2];
          let grad = 0;
          let light = 0;
          let chroma = 0;
          let hx = 0;
          let hy = 0;
          for (let y = 0; y < h; y++)
            for (let x = 0; x < w; x++) {
              const k = (y * w + x) * 4;
              if (x < w - 1) grad += Math.abs(lum(k + 4) - lum(k));
              if (y < h - 1) grad += Math.abs(lum(k + w * 4) - lum(k));
              light += lum(k) / 255;
              const r = d[k] / 255, g = d[k + 1] / 255, b = d[k + 2] / 255;
              const mx = Math.max(r, g, b), mn = Math.min(r, g, b), ch = mx - mn;
              chroma += ch;
              if (ch > 0.04) {
                const hue = mx === r ? ((g - b) / ch + 6) % 6 : mx === g ? (b - r) / ch + 2 : (r - g) / ch + 4;
                hx += ch * Math.cos((hue / 6) * 2 * Math.PI);
                hy += ch * Math.sin((hue / 6) * 2 * Math.PI);
              }
            }
          const n = w * h;
          const hue = ((Math.atan2(hy, hx) / (2 * Math.PI)) + 1) % 1;
          done({detail: grad / (n * 2), tone: chroma / n < 0.08 ? (light / n) * 0.99 : 1 + hue});
        } catch {
          done(null);
        }
      };
      img.src = src;
    });
  const measured = Promise.all(data.pieces.map((p) => (p.lqip ? measure(p.lqip) : Promise.resolve(null)))).then((m) => {
    const ranked = data.pieces.map((_, i) => i).filter((i) => m[i]).sort((a, z) => m[a]!.detail - m[z]!.detail);
    ranked.forEach((i, r) => {
      data.pieces[i].detail = ranked.length > 1 ? r / (ranked.length - 1) : 0.5;
      data.pieces[i].tone = m[i]!.tone;
    });
  });
  let seed = Number(q.get('seed')) || 4187;
  let focus: number | null = null;
  let focusRow = 0;
  let pushed = false;
  let last: WorldResult | null = null;
  const extras: HTMLElement[] = [];

  // A set's name: its project's, or the title of the piece the others hang off.
  const setName = (key: string) => {
    if (data.names[key]) return data.names[key];
    if (key.startsWith('#set-')) {
      const i = byId.get(key.slice(5));
      return i === undefined ? '' : data.pieces[i].title;
    }
    return '';
  };

  const draw = () => {
    for (const e of extras.splice(0)) e.remove();
    const phone = innerWidth < 768;
    const pad = getComputedStyle(world.parentElement!);
    /*
      On a phone the world runs to 4px from the screen's edges, past the
      page's own margins - Chris: "even slimmer". It is shifted left by
      however far in the page has put it.
    */
    const EDGE = 4;
    world.style.marginLeft = '';
    const width = phone
      ? document.documentElement.clientWidth - EDGE * 2
      : Math.min(world.parentElement!.clientWidth - parseFloat(pad.paddingLeft) - parseFloat(pad.paddingRight), 1400);
    // Biomes on a finer grid, so the gap between them is a thin line.
    const [cols, maxSpan] =
      // A finer grid on a phone than the height map's: "still looking clunky".
      mode === 'lands' ? (phone ? [8, 4] : [20, 6]) : mode === 'biomes' ? (phone ? [15, 6] : [40, 12]) : phone ? [6, 3] : [20, 6];
    const cell = width / cols;
    const gap = phone ? 2 : 3;
    const sort = colour && mode !== 'biomes' ? 'colour' : 'seed';
    /*
      The opened project's block of type, measured at the width it will
      have - beside the piece on a wide screen, the width of the page on a
      phone - so the world leaves it exactly the rows it needs.
    */
    cards.forEach((el) => (el.hidden = true));
    const cardEl = focus !== null && mode === 'lands' ? cards.get(data.pieces[focus].project ?? '') : undefined;
    let card: {cw: number; ch: number} | null = null;
    if (cardEl) {
      const cw = phone ? cols : Math.min(cols, 6);
      Object.assign(cardEl.style, {left: '0', top: '0', width: `${cw * cell - gap}px`, height: '', visibility: 'hidden'});
      cardEl.hidden = false;
      card = {cw, ch: Math.max(1, Math.ceil((cardEl.offsetHeight + gap) / cell))};
      cardEl.style.visibility = '';
    }
    const out = generateWorld(data.pieces, {cols, mode, seed, maxSpan, focus, focusRow, sort, card});
    last = out;
    const fam = new Set(out.family);
    if (cardEl && out.card) {
      Object.assign(cardEl.style, {left: `${out.card.c * cell + gap / 2}px`, top: `${out.card.r * cell + gap / 2}px`, width: `${out.card.cw * cell - gap}px`, height: `${out.card.ch * cell - gap}px`});
    } else if (cardEl) cardEl.hidden = true;
    world.classList.toggle('has-focus', focus !== null);
    world.style.width = `${width}px`;
    if (phone) world.style.marginLeft = `${EDGE - (world.parentElement!.getBoundingClientRect().left + parseFloat(pad.paddingLeft))}px`;
    world.style.height = `${Math.ceil(out.rows * cell)}px`;
    tiles.forEach((t) => (t.hidden = true));
    for (const p of out.placed) {
      const t = tiles[p.i];
      t.hidden = false;
      t.style.left = `${p.c * cell + gap / 2}px`;
      t.style.top = `${p.r * cell + gap / 2}px`;
      t.style.width = `${p.cw * cell - gap}px`;
      t.style.height = `${p.ch * cell - gap}px`;
      t.classList.toggle('is-open', p.i === focus);
      t.classList.toggle('is-sibling', fam.has(p.i));
      t.classList.toggle('is-small', p.cw * cell < 150);
      t.classList.toggle('is-tiny', p.cw * cell < 90);
      const img = t.querySelector('img');
      if (img) img.sizes = `${Math.ceil(p.cw * cell)}px`;
    }
    // The biomes' land: a faint tint per biome, a cell at a time.
    if (out.biome && out.regions) {
      const canvas = document.createElement('canvas');
      canvas.width = cols;
      canvas.height = out.rows;
      Object.assign(canvas.style, {position: 'absolute', left: '0', top: '0', width: `${width}px`, height: `${out.rows * cell}px`, imageRendering: 'pixelated', zIndex: '0', pointerEvents: 'none', opacity: focus !== null ? '0.5' : '1'});
      const ctx = canvas.getContext('2d')!;
      for (let r = 0; r < out.rows; r++)
        for (let c = 0; c < cols; c++) {
          const k = out.biome[r * cols + c];
          if (k < 0) continue;
          ctx.fillStyle = `hsl(${(k * 137.5 + (seed % 360)) % 360} 45% 94%)`;
          ctx.fillRect(c, r, 1, 1);
        }
      world.prepend(canvas);
      extras.push(canvas);
    }
    const focusSet = focus === null ? null : (data.pieces[focus].project ?? null);
    for (const l of out.labels) {
      const name = setName(l.set);
      if (!name) continue;
      const el = document.createElement(l.set.startsWith('/') ? 'a' : 'span');
      el.textContent = name;
      if (el instanceof HTMLAnchorElement) el.href = l.set;
      Object.assign(el.style, {
        position: 'absolute', left: `${l.c * cell}px`, top: `${l.r * cell}px`, width: `${l.cw * cell}px`, height: `${cell}px`,
        display: 'flex', alignItems: 'center', padding: '0 0.35rem', overflow: 'hidden', whiteSpace: 'nowrap', textOverflow: 'ellipsis',
        fontSize: phone ? '0.6rem' : '0.7rem', fontWeight: '700', letterSpacing: '0.06em', textTransform: 'uppercase',
        color: '#0a2a8a', textDecoration: 'none', zIndex: '1',
        opacity: focus !== null && l.set !== focusSet && !out.family.some((i) => `#set-${data.pieces[i].id}` === l.set || (data.pieces[i].parent && `#set-${data.pieces[i].parent}` === l.set)) ? '0.4' : '',
      });
      world.append(el);
      extras.push(el);
    }
    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
    colourBtn.setAttribute('aria-pressed', String(colour));
    colourBtn.hidden = mode === 'biomes';
    about.textContent = ABOUT[mode] + (sort === 'colour' ? ' Sorted by colour: black and white first, then round the colour wheel.' : '');
    history.replaceState(history.state, '', `?mode=${mode}&seed=${seed}${colour ? '&sort=colour' : ''}`);
  };

  // As on the main grid: a piece opens; picked again, it closes. Its bar is the way to the project.
  const open = (i: number, push = true) => {
    if (i === focus) {
      close();
      return;
    }
    focusRow = last?.placed.find((x) => x.i === i)?.r ?? 0;
    focus = i;
    if (push) {
      history.pushState({wd: i}, '');
      pushed = true;
    }
    draw();
    tiles[i].scrollIntoView({block: 'center'});
  };
  function close() {
    if (pushed) {
      history.back();
      return;
    }
    focus = null;
    draw();
  }

  tiles.forEach((t, i) => t.querySelector('.wd-pic')!.addEventListener('click', () => open(i)));
  addEventListener('popstate', (e) => {
    const i = (e.state as {wd?: number} | null)?.wd;
    pushed = typeof i === 'number';
    focus = typeof i === 'number' ? i : null;
    draw();
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && focus !== null) close();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
    b.addEventListener('click', () => {
      mode = b.dataset.mode as WorldMode;
      draw();
    }),
  );
  colourBtn.addEventListener('click', () => {
    colour = !colour;
    draw();
  });
  // Once the previews are measured, the sizes and colours they decide.
  measured.then(() => requestAnimationFrame(draw));
  document.querySelector('[data-roll]')!.addEventListener('click', () => {
    seed = (seedOf(`${seed}:${Date.now()}`) % 9000) + 1000;
    draw();
  });
  let lastWidth = 0;
  new ResizeObserver(([e]) => {
    if (Math.abs(e.contentRect.width - lastWidth) < 1) return;
    lastWidth = e.contentRect.width;
    requestAnimationFrame(draw);
  }).observe(world.parentElement!);
</script>
