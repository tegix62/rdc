---
import Layout from '../layouts/Layout.astro';

const colors = [
  { name: 'Brand Navy', value: '#002885', var: '--color-navy' },
  { name: 'Navy (hover/dark)', value: '#001c5e', var: '--color-navy-dark' },
  { name: 'White', value: '#ffffff', var: '--color-white' },
  { name: 'Light Gray', value: '#f4f4f4', var: '--color-gray-light' },
  { name: 'Gray (meta text)', value: '#666666', var: '--color-gray' },
  { name: 'Ink (body text)', value: '#1a1a1a', var: '--color-ink' },
  { name: 'Black', value: '#000000', var: '--color-black' },
];
---

<Layout title="Style Guide" description="Rumeau Design Co design tokens">
  <h1>Style Guide</h1>
  <p>
    Pulled from what's actually applied on rumeaudesign.co's real headings,
    buttons, nav, and links — not the unused component-library colors also
    sitting in the Webflow project.
  </p>

  <h2>Colors</h2>
  <div>
    {colors.map((c) => (
      <div class="swatch">
        <div class="swatch__color" style={`background:${c.value}`}></div>
        <div>
          <strong>{c.name}</strong> — <code>{c.value}</code>
          <div class="card__meta"><code>var({c.var})</code></div>
        </div>
      </div>
    ))}
  </div>

  <h2>Type</h2>
  <p>
    Headings: <strong>Inter Tight</strong> (700). Body copy:{' '}
    <strong>Gothic A1</strong>.
  </p>
  <h1>Heading 1 — 3.5rem</h1>
  <h2>Heading 2 — 3rem</h2>
  <h3>Heading 3 — 2.5rem</h3>
  <h4>Heading 4 — 2rem</h4>
  <h5>Heading 5 — 1.5rem</h5>
  <p>
    Body copy sets in Gothic A1 at a comfortable reading size, used for
    paragraphs, case study details, and blog posts across the site.
  </p>

  <h2>Buttons &amp; Links</h2>
  <p>
    <a href="#">A standard text link</a>
  </p>
  <p>
    <a class="button" href="#">A button</a>
  </p>

  <h2>Cards</h2>
  <div class="grid">
    <div class="card">
      <div class="swatch__color" style="background:#f4f4f4; width:100%; aspect-ratio:4/5;"></div>
      <p class="card__title">Card Title</p>
      <p class="card__meta">Card meta text</p>
    </div>
  </div>
</Layout>
