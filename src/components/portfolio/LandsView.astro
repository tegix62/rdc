---
/*
  A WORLD OF WORK - the portfolio's All view, a pane of /portfolio
  (?view=all), shown and hidden in place by its toolbar. See src/lib/world.ts
  for the rules of the layout.

  LANDS, the page's one mode: the height map's tight fill and sizes, with
  each project landing together in a patch of its own (Chris: "the best of
  both worlds"), case studies first as the portfolio deals them. Sizes come
  from the ground and from what the data says a piece is - a case study or
  a hero tile stands out, an alternate merch shot or a close-up takes less
  - not from a field to fill in (Chris: "I'd rather rely on data
  interpretations. The less fields, the better.").

  OPENING, as on the main grid: the navy hairline frame and the project bar
  ("NAME · 9 pieces →"), the rest dropped back, and the project's block of
  type (clusterCard, as in the merch view) set beside the piece. Picking it
  again, Escape or the browser's back closes it.

  THE PORTFOLIO'S CONTROLS: its toolbar, with Lands as All - the other
  categories go to the portfolio's own views, each of which is its own
  design - Shuffle (a new world), and - / + (a finer or coarser grid). And
  its SHAREABLE LINKS: ?open=<slug> arrives with that piece open.

  BOXES THAT FIT THEIR PICTURES. Chris asked for the blank space round
  cut-outs to be trimmed; measured, the pictures are already cropped to
  their art (and a trim measured from the tiny previews cut one piece to
  a single word, so there is none). What made evenly spaced boxes
  look unevenly spaced was the boxes' shapes: rounded to whole square
  cells, a box was rarely its picture's shape, leaving white strips down
  two sides. So Lands is laid on half-height rows, and a piece takes the
  width whose box best matches its picture - the pictures now fill about
  95% of their boxes, up from 89%.

  The Tab key and screen readers meet the pieces in the order they are seen
  (top to bottom, left to right), not the order the page lists them.

  Shelved, reachable by ?mode=heights or ?mode=biomes for a look back (the
  biomes without their tint): the height map and the biomes themselves;
  and By colour ("feels like a gimmick right now").

  Once its own page (/portfolio/all, now a redirect). Chris: "I don't
  think the views need to be separate pages". Its Shuffle and +/- are in
  the portfolio's toolbar (data-roll, data-zoom). Most styles
  are in global.css (WORLD, PREVIEW): they are for classes the script adds,
  which the critical-CSS step prunes from a page's own styles.
*/
import Img from '../Img.astro';
import {getAllGridItems, getSiteSettings, getPage, getVideoGridItems} from '../../lib/queries';
import {embedUrl} from '../../lib/video';
import {youTubePoster} from '../../lib/youtubePoster';
import {tileImage, imageDimensions} from '../../lib/image';
import {treatmentOf, explicitTreatment, tileHref, cleanKey, merchPlacement} from '../../lib/tiles';
import {stripStegaKey} from '../../lib/stega';
import {sanityClient} from '../../lib/sanity';
import {clusterCard} from '../../lib/clusterCard';
import {parseCreditLines} from '../../lib/credits';


/*
  On a picks board (src/pages/picks/[code]): ONLY the board's pieces, if it
  names any, and PICKS - a + on each piece and a tray to send them in.
  See studio/tools/PicksTool.tsx.
*/
interface Props {
  only?: string[];
  picks?: {code: string; kind: 'pitch' | 'picks' | 'vote'};
  /** The homepage's field (src/pages/index.astro): no seed in the address. */
  home?: boolean;
}
const {only, picks, home} = Astro.props as Props;
const clean = (s: unknown) => stripStegaKey(s).replace(/\s+/g, ' ').trim();
const idOf = (it: any) => cleanKey(it._id).replace(/^drafts\./, '');
const all: any[] = (await getAllGridItems()).filter((it: any) => tileImage(it) && imageDimensions(tileImage(it)) && (!only || only.includes(idOf(it))));
const isProject = (it: any) => cleanKey(it.pageType) === 'Case Study';

// The portfolio's categories and filters (portfolio.astro, CATEGORY_FILTER).
const CATEGORY_FILTER: Record<string, string> = {
  'Brand Identity': 'brand-identity',
  'Merch & Apparel': 'merch-apparel',
  Typography: 'type-lettering',
  Illustration: 'type-lettering',
  Photography: 'photography',
};
const FILTERS = [
  {value: 'brand-identity', label: 'Brand Identity', name: 'brand'},
  {value: 'merch-apparel', label: 'Merch & Apparel', name: 'merch'},
  {value: 'type-lettering', label: 'Type/Lettering', name: 'type'},
  {value: 'photography', label: 'Photography', name: 'photography'},
].filter((f) => all.some((it) => CATEGORY_FILTER[cleanKey(it.category)] === f.value));

const names: Record<string, string> = {};
for (const it of all) {
  const href = tileHref(it);
  if (href && isProject(it)) names[href] = clean(it.title);
}
// Each picture's tiny preview, for its trim.
const refOf = (it: any) => tileImage(it)?.asset?._ref ?? tileImage(it)?.asset?._id ?? null;
const previews: Record<string, string> = Object.fromEntries(
  (
    (await sanityClient.fetch(`*[_type == "sanity.imageAsset" && _id in $ids]{_id, "lqip": metadata.lqip}`, {
      ids: [...new Set(all.map(refOf).filter(Boolean))],
    })) as {_id: string; lqip?: string}[]
  )
    .filter((a) => a.lqip)
    .map((a) => [a._id, a.lqip!]),
);
/*
  Trimming is gone. It cut to the artwork measured from each picture's tiny
  preview, and the preview is too coarse to trust: it cut Two Point Oh's
  "The Sun" down to the word THE (Chris: "the grid is now cutting off").
  The pictures are already cropped to their art anyway; the boxes' shapes
  were the real unevenness, and the half-height rows fix that.
*/
const box = all.map(() => ({x0: 0, y0: 0, x1: 1, y1: 1}));

// Each project's piece count (for its bar) and its block of type.
const count: Record<string, number> = {};
for (const it of all) {
  const href = tileHref(it);
  if (href) count[href] = (count[href] ?? 0) + 1;
}
const cards = all.filter((it) => isProject(it) && tileHref(it)).map((it) => ({href: tileHref(it)!, card: clusterCard(it)})).filter((c) => c.card);
const barOf = (it: any) => clean(it.parentTitle ?? it.title ?? 'View project');
// Each case study's place in the order dragged in Studio (orderRank).
const ranks = all.filter((it) => isProject(it) && typeof it.orderRank === 'string').map((it) => it.orderRank as string).sort();
const pieces = all.map((it, i) => {
  const d = imageDimensions(tileImage(it))!;
  const t = box[i];
  return {
    // The artwork's own shape, once trimmed.
    w: d.width * (t.x1 - t.x0),
    h: d.height * (t.y1 - t.y0),
    project: tileHref(it),
    own: isProject(it),
    id: cleanKey(it._id).replace(/^drafts\./, ''),
    slug: it.slug?.current ? cleanKey(it.slug.current) : null,
    parent: it.pieceParent ? cleanKey(it.pieceParent) : null,
    title: clean(it.title),
    cat: CATEGORY_FILTER[cleanKey(it.category)] ?? '',
    // For the engine to deal the loose work across categories.
    kind: CATEGORY_FILTER[cleanKey(it.category)] ?? '',
    // A mark set as one by hand: it brings its own air, so it takes a step less ground.
    mark: explicitTreatment(it) === 'mark',
    /*
      Chris, on a phone: "I feel like less important tiles are getting more
      area". The case studies and the hero tiles he marked stand out; an
      alternate merch shot, or a piece hung off another (a close-up), takes
      less ground than the piece it supports.
    */
    big: isProject(it) || !!it.heroTile,
    order: isProject(it) && typeof it.orderRank === 'string' ? ranks.indexOf(it.orderRank) : undefined,
    // A photograph, collage or anything else filling its frame - which on a
    // phone needs more than the smallest size to be told apart; a mark on
    // transparency reads at any size.
    photo: it.tileOpaque !== false && treatmentOf(it) !== 'mark',
    weight:
      cleanKey(it.category) === 'Merch & Apparel' && merchPlacement(it) === 'later' ? 0.45 : it.pieceParent ? 0.6 : 1,
  };
});
/*
  A piece opened GROWS where it is (Chris: "instead of having something
  shrink when clicked, it actually expands ... we freeze everything that
  fades out in opacity and just expand from there"), with the tall marks
  sized by their area and a logomark's air from its shorter side. Tried on
  the preview, then live - Chris: "Okay, put it live." Off (false), the
  view goes back to the framed piece and floating card.
*/
const grow = true;

/*
  RESULTS AS TILES, preview first. Chris, on the work's blocks of words:
  "those information blocks ... can be clicked on to shift the grid around
  too", and liked the idea of the result numbers as such blocks. So the
  three metric cards in Site Settings (proofStats: the number, the rest of
  the sentence, who said it, and the project - the same cards the homepage
  shows, no new field) become tiles of their own. Each lands with its
  project, lights with it, and opens its project's own piece when picked.
  Not on a picks board, which shows only what Chris chose.
*/
const IS_PREVIEW = import.meta.env.PUBLIC_IS_PREVIEW === 'true';
const settings: any = IS_PREVIEW && !picks ? await getSiteSettings() : null;
const norm = (h: unknown) => String(stripStegaKey(h) ?? '').replace(/\/+$/, '');
const studyAt = new Map<string, number>();
all.forEach((it, i) => {
  if (isProject(it) && tileHref(it)) studyAt.set(norm(tileHref(it)), i);
});
const results = ((settings?.proofStats ?? []) as any[])
  .map((r) => {
    // The number alone large ("$3500"); the stat's other words join the sentence - a phone's tile has room for one big word.
    const [num, ...more] = clean(r.stat).split(' ');
    // In sentence case: "Weekly Listeners" was the card's bold heading; under the number it is the start of a sentence.
    const lower = more.map((w) => (/^[A-Z0-9]{2,}$/.test(w) ? w : w.toLowerCase())).join(' ');
    return {stat: num, rest: [lower, clean(r.rest)].filter(Boolean).join(' '), who: [clean(r.name), clean(r.org)].filter(Boolean).join(', '), href: norm(r.href)};
  })
  .filter((r) => r.stat && studyAt.has(r.href))
  .map((r) => ({...r, opens: studyAt.get(r.href)!}));
results.forEach((r, k) =>
  pieces.push({
    // A block of words about as wide as a postcard.
    w: 3,
    h: 2,
    project: tileHref(all[r.opens]),
    own: false,
    id: `result-${k}`,
    slug: null,
    parent: null,
    title: `${r.stat} ${r.rest}`,
    cat: '',
    kind: 'result',
    mark: false,
    // As large as a case study: Chris, of the first ones on a phone, "way too small".
    big: true,
    order: undefined,
    photo: false,
    weight: 1,
  }),
);
/*
  THE NAMES, WITH THEIR PROJECT, preview first. Chris, taking the People
  page back out: "I'd rather them be tied to each project ... name dropping
  per case study". The project's Credits panel, as Brand Identity's labels
  show it, goes in the grown piece under the project's words. Its own
  block, not inside the card: the card is a link, and the names link out.
*/
const credits = IS_PREVIEW
  ? all
      .filter((it) => isProject(it) && tileHref(it))
      .map((it) => ({href: tileHref(it)!, people: parseCreditLines(it.projectCredits)}))
      .filter((c) => c.people.length)
  : [];
/*
  THE VIDEO WORK, WITH THE REST, preview first. Chris: "my video work
  should not be separate now that I think about it" - so every video on
  the video page (its sections, as built in Studio: a video section, a
  media row's videos) is a piece of the All view too: YouTube's own still
  as its picture, its name from YouTube, a play mark; opened, it grows as
  any piece does and plays where it is. Nothing to add in Studio - a
  video put on the video page joins the field at the next build.
*/
/*
  Where a piece plays from, if it is a video: a grid item's Video panel
  (YouTube or Vimeo link, or a self-hosted R2 file). YouTube through its
  privacy-enhanced player - no cookies until it is played.
*/
const playOf = (v: any): {src: string; kind: 'embed' | 'file'; yt: string | null} | null => {
  const embed = embedUrl(stripStegaKey(v?.heroVideo ?? v?.url));
  if (embed) {
    const yt = embed.includes('youtube.com/embed/') ? embed.split('/').pop()! : null;
    return {src: yt ? `https://www.youtube-nocookie.com/embed/${yt}` : embed, kind: 'embed', yt};
  }
  const file = stripStegaKey(v?.heroVideoSrc);
  return file && /^https:\/\//.test(file) ? {src: file, kind: 'file', yt: null} : null;
};
// A grid item with a picture AND a video: its picture is the still, and it plays when opened.
const playing = all.map((it) => (IS_PREVIEW && !picks && cleanKey(it.pageType) === 'Grid Item' ? playOf(it) : null));
const titleOf = async (id: string) => {
  try {
    const r = await fetch(`https://www.youtube.com/oembed?format=json&url=${encodeURIComponent(`https://www.youtube.com/watch?v=${id}`)}`, {signal: AbortSignal.timeout(5000)});
    return r.ok ? clean(((await r.json()) as any).title) || 'Video' : 'Video';
  } catch {
    return 'Video';
  }
};
/*
  And the videos with no picture of their own: grid items that are only a
  video (getVideoGridItems - with their project, so they land and light
  with it), then the video page's videos that are not already among them.
*/
const bare: any[] = IS_PREVIEW && !picks && (!only || home) ? await getVideoGridItems() : [];
const videoPage: any = IS_PREVIEW && !picks ? await getPage('video') : null;
const seen = new Set<string>([...playing, ...bare.map(playOf)].map((v) => v?.yt).filter(Boolean) as string[]);
const loose: string[] = [];
for (const sec of videoPage?.sections ?? []) {
  for (const v of [sec, ...(Array.isArray(sec?.items) ? sec.items : [])]) {
    const yt = playOf(v)?.yt;
    if (yt && !seen.has(yt)) {
      seen.add(yt);
      loose.push(yt);
    }
  }
}
const videos = (
  await Promise.all([
    ...bare.map(async (it) => {
      const v = playOf(it);
      if (!v) return null;
      return {
        ...v,
        poster: v.yt ? await youTubePoster(v.yt) : null,
        title: clean(it.title) || (v.yt ? await titleOf(v.yt) : 'Video'),
        id: idOf(it),
        slug: it.slug?.current ? cleanKey(it.slug.current) : idOf(it),
        project: tileHref(it),
        parent: it.pieceParent ? cleanKey(it.pieceParent) : null,
        big: false,
      };
    }),
    ...loose.map(async (yt) => ({
      src: `https://www.youtube-nocookie.com/embed/${yt}`,
      kind: 'embed' as const,
      yt,
      poster: await youTubePoster(yt),
      title: await titleOf(yt),
      id: `video-${yt}`,
      slug: `video-${yt}`,
      project: null,
      parent: null,
      // Finished pieces of work on their own, sized as a case study is.
      big: true,
    })),
  ])
).filter((v): v is NonNullable<typeof v> => !!v);
const videoAt = pieces.length;
videos.forEach((v) =>
  pieces.push({
    w: 16,
    h: 9,
    project: v.project,
    own: false,
    id: v.id,
    slug: v.slug,
    parent: v.parent,
    title: v.title,
    cat: 'video',
    kind: 'video',
    mark: false,
    big: v.big,
    order: undefined,
    photo: true,
    weight: 1,
  }),
);
const data = {pieces, names, filters: FILTERS.map(({value, name}) => ({value, name})), grow, picks: picks ?? null, home: !!home};
---

<div class="wd pf-pane" data-pane="all">
    <div class="wd-world">
      {all.map((it, i) => {
        const href = tileHref(it);
        const t = box[i];
        const tw = t.x1 - t.x0;
        const th = t.y1 - t.y0;
        // The trim, as the picture's size and offset inside the artwork's box.
        const crop = `--a:${(pieces[i].w / pieces[i].h).toFixed(4)};--iw:${(100 / tw).toFixed(2)}%;--ih:${(100 / th).toFixed(2)}%;--il:${((-t.x0 / tw) * 100).toFixed(2)}%;--it:${((-t.y0 / th) * 100).toFixed(2)}%`;
        return (
          <div
            class:list={[
              'wd-piece',
              treatmentOf(it) === 'mark' && 'wd-piece--mark',
              // Air round a mark Chris set as one by hand, as on the main grid (.pf-item--air).
              explicitTreatment(it) === 'mark' && 'wd-piece--air',
              isProject(it) && href && 'wd-piece--study',
            ]}
            data-i={i}
            data-video={playing[i]?.src}
            data-video-kind={playing[i]?.kind}
            hidden
          >
            <div class="wd-frame">
              <button type="button" class="wd-pic" aria-label={clean(it.title)}>
                <span class="wd-crop" style={crop}>
                  <Img image={tileImage(it)} alt="" width={1400} sizes="25vw" loading="lazy" field="Grid Thumbnail (world)" />
                </span>
                {playing[i] && <span class="wd-play" aria-hidden="true"></span>}
              </button>
              <span class="wd-caption">{clean(it.title)}</span>
              {picks && (
                <button type="button" class="wd-add" aria-pressed="false" aria-label={`Add ${clean(it.title)} to your picks`}>
                  <span class="wd-add__mark" aria-hidden="true">+</span>
                  <span class="wd-add__label">Add to picks</span>
                </button>
              )}
              {href && (
                <a class="wd-jump" href={href} aria-label={[barOf(it), (count[href] ?? 0) > 1 ? `${count[href]} pieces` : null].filter(Boolean).join(' - ')}>
                  <span class="wd-jump__label">{barOf(it)}</span>
                  {(count[href] ?? 0) > 1 && (
                    <span class="wd-jump__count">
                      &middot; {count[href]} pieces
                    </span>
                  )}
                  <span class="wd-jump__arrow" aria-hidden="true">&rarr;</span>
                </a>
              )}
            </div>
          </div>
        );
      })}
      {results.map((r, k) => (
        <div class="wd-piece wd-piece--result" data-i={all.length + k} data-opens={r.opens} hidden>
          <div class="wd-frame">
            <button type="button" class="wd-pic wd-result" aria-label={`${r.stat} ${r.rest} - open the project`}>
              <span class="wd-result__top">
                <span class="wd-result__stat">{r.stat}</span>
                <span class="wd-result__rest">{r.rest}</span>
              </span>
              <span class="wd-result__foot">
                {r.who && <span class="wd-result__who">{r.who}</span>}
                <span class="wd-result__go" aria-hidden="true">&rarr;</span>
              </span>
            </button>
          </div>
        </div>
      ))}
      {videos.map((v, k) => (
        <div class="wd-piece wd-piece--video" data-i={videoAt + k} data-video={v.src} data-video-kind={v.kind} hidden>
          <div class="wd-frame">
            <button type="button" class="wd-pic" aria-label={`${v.title} - play`}>
              <span class="wd-crop wd-crop--still" style="--a:1.7778;--iw:100%;--ih:100%;--il:0%;--it:0%">
                {v.poster && <img src={v.poster} alt="" loading="lazy" decoding="async" width="1280" height="720" />}
              </span>
              <span class="wd-play" aria-hidden="true"></span>
            </button>
            <span class="wd-caption">{v.title}</span>
          </div>
        </div>
      ))}
      {credits.map(({href, people}) => (
        <p class="wd-credits" data-credits={href} hidden>
          {people.map((c) => (
            <span class="pf-item__credit">
              {c.role && <span class="pf-item__credit-role">{c.role}</span>}
              {c.url ? (
                <a class="pf-item__credit-name" href={c.url} target="_blank" rel="noopener">
                  {c.name}
                </a>
              ) : (
                <span class="pf-item__credit-name">{c.name}</span>
              )}
            </span>
          ))}
        </p>
      ))}
      {cards.map(({href, card}) => (
        <a class="wd-card" href={href} data-card={href} hidden>
          {card!.kicker && <span class="pf-card__kicker">{card!.kicker}</span>}
          <span class="pf-card__title">{card!.title}</span>
          {card!.client && <span class="pf-card__client">For {card!.client}</span>}
          {card!.line && <span class="pf-card__line">{card!.line}</span>}
          {card!.result && <span class="pf-card__result">{card!.result}</span>}
          <span class="pf-card__go">
            See the project <span aria-hidden="true">&rarr;</span>
          </span>
        </a>
      ))}
    </div>
  <script type="application/json" id="wd-data" set:html={JSON.stringify(data)} />
  {picks && (
    <div class="pk-tray" data-kind={picks.kind} hidden>
      <div class="pk-tray__bar">
        <p class="pk-tray__count" aria-live="polite">
          <span data-count>0</span> <span data-noun>{picks.kind === 'vote' ? 'favourites' : 'picks'}</span>
        </p>
        <ul class="pk-tray__thumbs" aria-label="Your picks"></ul>
        <button type="button" class="pk-tray__send" data-send>{picks.kind === 'vote' ? 'Send my vote' : 'Send to Chris'}</button>
      </div>
      {picks.kind !== 'vote' && (
        <form class="pk-tray__form" hidden>
          <label>
            <span>Your name</span>
            <input name="name" autocomplete="name" maxlength="120" />
          </label>
          <label>
            <span>Anything to add? (optional)</span>
            <textarea name="note" rows="2" maxlength="2000"></textarea>
          </label>
          <div class="pk-tray__actions">
            <button type="submit" class="pk-tray__send">Send</button>
            <button type="button" class="pk-tray__back" data-back>Back</button>
          </div>
        </form>
      )}
      <p class="pk-tray__said" data-said hidden></p>
    </div>
  )}
</div>

<script>
  import {generateWorld, setsOf, type WorldMode, type WorldPiece, type WorldResult} from '../../lib/world';
  import {seedOf} from '../../lib/cluster';

  type P = WorldPiece & {id: string; slug: string | null; title: string; cat: string; photo: boolean};
  const data: {pieces: P[]; names: Record<string, string>; filters: {value: string; name: string}[]; grow: boolean; picks: {code: string; kind: 'pitch' | 'picks' | 'vote'} | null; home: boolean} = JSON.parse(
    document.getElementById('wd-data')!.textContent!,
  );
  const world = document.querySelector<HTMLElement>('.wd-world')!;
  const tiles = Array.from(world.querySelectorAll<HTMLElement>('.wd-piece'));
  const cards = new Map(Array.from(world.querySelectorAll<HTMLElement>('[data-card]')).map((el) => [el.dataset.card!, el]));

  const q = new URLSearchParams(location.search);
  const mode = (['heights', 'biomes'].includes(q.get('mode') ?? '') ? q.get('mode') : 'lands') as WorldMode;
  let seed = Number(q.get('seed')) || 4187;
  // Simple is the default; ?v=rules is the version with the stiffer rules, to compare (lib/world.ts, SIMPLE).
  const simple = q.get('v') !== 'rules';
  // Shown, or kept out of sight while another view of the portfolio is (see
  // the pane controller in portfolio.astro): its address is only its own
  // while it is the one shown.
  const shown = () => document.documentElement.dataset.pfPane === 'all';
  let focus: number | null = null;
  let focusRow = 0;
  let pushed = false;
  let last: {out: WorldResult; subset: number[]} | null = null;
  // The piece open at the last drawing: the one that opens or closes is the one that moves.
  let drawn: number | null = null;
  // World pixels to bring into sight once a piece has grown: from, to, and its own top.
  let want: [number, number, number] | null = null;
  let settle = 0;

  /*
    - / +: the grid's columns. More columns, smaller tiles. The middle step
    is the one Chris settled on (20 on a wide screen; 8 on a phone - "7 was
    noticeably less compact and more clunky", 8 "might mean too small to
    tell what some tiles are", hence the photographs' floor below).
  */
  // A wide screen now 14 columns, not 20 - Chris: "too disparaging of a size
  // between tiles"; the smallest are larger and nothing takes over.
  const STEPS = {desktop: [20, 17, 14, 12, 10], phone: [10, 9, 8, 7, 6]};
  let zoom = 2;

  const phoneNow = () => innerWidth < 768;
  const keyOf = (i: number) => data.pieces[i].slug ?? data.pieces[i].id;

  const draw = () => {
    const phone = phoneNow();
    const pad = getComputedStyle(world.parentElement!);
    /*
      On a phone the world runs to 4px from the screen's edges, past the
      page's own margins - Chris: "even slimmer". It is shifted left by
      however far in the page has put it.
    */
    const EDGE = 4;
    world.style.marginLeft = '';
    const width = phone
      ? document.documentElement.clientWidth - EDGE * 2
      : // Full-bleed on a wide screen too, as the portfolio grid is (Chris: "on desktop, can we make the view full-bleed?").
        world.parentElement!.clientWidth - parseFloat(pad.paddingLeft) - parseFloat(pad.paddingRight);
    const steps = phone ? STEPS.phone : STEPS.desktop;
    let cols = steps[zoom];
    /*
      A phone's widest piece: half the columns, rounded down from the default
      up (finer grids) and up from it down (coarser ones), so - never allows
      a wider piece than the step before it: 9 columns rounded 4.5 up to 5,
      and - made the tiles larger on average than the 8 it came from.
    */
    let maxSpan = phone ? (cols > STEPS.phone[2] ? Math.floor(cols / 2) : Math.ceil(cols / 2)) : Math.round(cols * 0.3);
    if (mode === 'biomes') [cols, maxSpan] = phone ? [15, 6] : [40, 12];
    if (mode === 'heights' && phone) [cols, maxSpan] = [6, 3];
    const cell = width / cols;
    // Lands on half-height rows, so each box can follow its picture's shape.
    const kr = mode === 'lands' ? 2 : 1;
    const rowH = cell / kr;
    const gap = phone ? 2 : 3;

    const subset = data.pieces.map((_, i) => i);
    if (focus !== null && !subset.includes(focus)) focus = null;
    // A result tile as wide as a case study may be on a phone (a step under the widest), two cells on a wide screen, so its number reads.
    const sub = subset.map((i) => ({
      ...data.pieces[i],
      least: data.pieces[i].kind === 'result' ? (phone ? Math.max(2, maxSpan - 1) : 2) : phone && mode === 'lands' && data.pieces[i].photo ? 2 : 1,
    }));

    /*
      The opened project's block of type, measured at the width it will
      have - beside the piece on a wide screen, the width of the page on a
      phone - so the world leaves it exactly the rows it needs.
    */
    /*
      LANDS OPENS IN PLACE. Chris: "when you click on one, I wonder if we
      even need to have it gather to a certain area of the screen, or if we
      could just ... throw transparency on everything else and have that
      little cluster work itself out." Its set is already together there, so
      nothing moves: the rest drops back, the piece wears its navy frame and
      bar, and the project's block of type floats in a card at the foot of
      the screen. (The shelved modes still gather.)
    */
    const inPlace = mode === 'lands';
    const grow = inPlace && data.grow;
    world.querySelectorAll('.wd-kin').forEach((el) => el.remove());
    // A video plays only while it is the one open: closing it, or opening another, stops it.
    world.querySelectorAll<HTMLElement>('.wd-player').forEach((el) => {
      const t = el.closest<HTMLElement>('.wd-piece');
      if (!t || Number(t.dataset.i) !== focus) {
        t?.classList.remove('has-player');
        el.remove();
      }
    });
    world.querySelectorAll<HTMLElement>('[data-credits]').forEach((el) => {
      el.hidden = true;
      if (el.parentElement !== world) world.append(el);
    });
    cards.forEach((el) => {
      el.hidden = true;
      el.classList.remove('wd-card--float');
      if (el.parentElement !== world) world.append(el);
    });
    const cardEl = focus !== null ? cards.get(data.pieces[focus].project ?? '') : undefined;
    let card: {cw: number; ch: number} | null = null;
    if (cardEl && grow) {
      // Its block of type goes inside the piece, under the picture (growOpen).
      cardEl.removeAttribute('style');
      cardEl.hidden = false;
      tiles[focus!].querySelector('.wd-frame')!.insertBefore(cardEl, tiles[focus!].querySelector('.wd-jump'));
    } else if (cardEl && inPlace) {
      cardEl.removeAttribute('style');
      cardEl.classList.add('wd-card--float');
      cardEl.hidden = false;
    } else if (cardEl) {
      const cw = phone ? cols : Math.min(cols, Math.round(cols * 0.3));
      Object.assign(cardEl.style, {left: '0', top: '0', width: `${cw * cell - gap}px`, height: '', visibility: 'hidden'});
      cardEl.hidden = false;
      card = {cw, ch: Math.max(1, Math.ceil((cardEl.offsetHeight + gap) / rowH))};
      cardEl.style.visibility = '';
    }
    // Its people, under its words (THE NAMES, WITH THEIR PROJECT).
    const named = grow && focus !== null ? world.querySelector<HTMLElement>(`[data-credits="${CSS.escape(data.pieces[focus].project ?? '')}"]`) : null;
    if (named) {
      named.hidden = false;
      tiles[focus!].querySelector('.wd-frame')!.insertBefore(named, tiles[focus!].querySelector('.wd-jump'));
    }
    const out = generateWorld(sub, {cols, mode, seed, maxSpan, rowsPerCell: kr, focus: focus === null || inPlace ? null : subset.indexOf(focus), focusRow, card, tune: {simple, tallMarks: data.grow}});
    last = {out, subset};
    const sets = inPlace ? setsOf(sub) : [];
    const fam = new Set(
      inPlace
        ? focus === null
          ? []
          : sub.map((_, k) => k).filter((k) => sets[k] === sets[subset.indexOf(focus!)]).map((k) => subset[k])
        : out.family.map((k) => subset[k]),
    );
    if (inPlace) {
      // The card floats, or is inside the piece; nothing to place.
    } else if (cardEl && out.card) {
      Object.assign(cardEl.style, {left: `${out.card.c * cell + gap / 2}px`, top: `${out.card.r * rowH + gap / 2}px`, width: `${out.card.cw * cell - gap}px`, height: `${out.card.ch * rowH - gap}px`});
    } else if (cardEl) cardEl.hidden = true;

    world.classList.toggle('has-focus', focus !== null);
    world.classList.toggle('is-grow', grow);
    world.style.width = `${width}px`;
    if (phone) world.style.marginLeft = `${EDGE - (world.parentElement!.getBoundingClientRect().left + parseFloat(pad.paddingLeft))}px`;
    world.style.height = `${Math.ceil(out.rows * rowH)}px`;
    tiles.forEach((t) => (t.hidden = true));
    // Only the piece opening or closing glides; a redrawing (a wider window, + or -) is at once.
    const moving = grow && drawn !== focus ? [drawn, focus] : [];
    drawn = focus;
    for (const p of out.placed) {
      const i = subset[p.i];
      const t = tiles[i];
      t.hidden = false;
      // On a phone everything below makes room (see the drawer below), so everything glides.
      t.classList.toggle('is-moving', moving.length > 0 && (phone || moving.includes(i)));
      t.classList.toggle('has-card', i === focus && !!cardEl && grow);
      t.style.left = `${p.c * cell + gap / 2}px`;
      t.style.top = `${p.r * rowH + gap / 2}px`;
      t.style.width = `${p.cw * cell - gap}px`;
      t.style.height = `${p.ch * rowH - gap}px`;
      t.classList.toggle('is-open', i === focus);
      t.classList.toggle('is-sibling', fam.has(i));
      t.classList.toggle('is-small', p.cw * cell < 150);
      t.classList.toggle('is-tiny', p.cw * cell < 90);
      const img = t.querySelector('img');
      if (img) img.sizes = `${Math.ceil(p.cw * cell)}px`;
    }
    want = null;
    const lit = (focus === null ? [] : out.placed.filter((x) => fam.has(subset[x.i]) && subset[x.i] !== focus));
    const mine = grow && focus !== null && !phone ? out.placed.find((x) => subset[x.i] === focus) : undefined;
    if (mine) growOpen(tiles[focus!], focus!, mine, {cols, cell, rowH, gap, phone, rows: out.rows}, lit);
    /*
      On a phone the grown piece takes the width of the screen, so laid over
      the rest it hid the pieces lit round it - Chris: "it obscures the
      highlighted images that are related". So there it opens like a drawer:
      at the nearest line above it that no piece crosses, everything below
      moves down by its height, and nothing is covered.
    */
    const at = grow && focus !== null && phone ? out.placed.find((x) => subset[x.i] === focus) : undefined;
    if (at) {
      const crosses = (r: number) => out.placed.some((x) => x.r < r && x.r + x.ch > r);
      let cut = at.r;
      while (cut > 0 && crosses(cut)) cut--;
      /*
        ITS SET, WITH IT. Opened above its whole set, the drawer could still
        sit a screen or more from the set's other pieces, which a phone's
        layout strings down the page - Chris: "these marks can get too
        separated from their related highlighted component tiles". So on a
        phone the drawer carries them: a row of small pictures under its
        words, each opening that piece. It opens where it was picked again.
      */
      if (lit.length) {
        const kin = document.createElement('div');
        kin.className = 'wd-kin';
        const name = document.createElement('p');
        name.className = 'wd-kin__name';
        name.textContent = 'From this project';
        const row = document.createElement('div');
        row.className = 'wd-kin__row';
        for (const x of [...lit].sort((a, z) => a.r - z.r || a.c - z.c)) {
          const k = subset[x.i];
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'wd-kin__pick';
          b.setAttribute('aria-label', data.pieces[k].title);
          const from = tiles[k].querySelector('img');
          const src = from?.currentSrc || from?.getAttribute('src');
          if (src) {
            const pic = document.createElement('img');
            pic.src = src;
            pic.alt = '';
            b.append(pic);
          }
          b.addEventListener('click', () => open(k));
          row.append(b);
        }
        kin.append(name, row);
        const frame = tiles[focus!].querySelector('.wd-frame')!;
        frame.insertBefore(kin, frame.querySelector('.wd-jump'));
      }
      const eh = growOpen(tiles[focus!], focus!, at, {cols, cell, rowH, gap, phone, rows: out.rows}, [], cut);
      const room = eh + gap;
      // In sight: the drawer, which now carries its set.
      want = [cut * rowH, cut * rowH + eh, cut * rowH];
      for (const x of out.placed) if (subset[x.i] !== focus && x.r >= cut) tiles[subset[x.i]].style.top = `${x.r * rowH + gap / 2 + room}px`;
      world.style.height = `${Math.ceil(out.rows * rowH + room)}px`;
    }
    // The opened video, playing in its picture's place.
    const playing = grow && focus !== null ? tiles[focus] : null;
    if (playing?.dataset.video && !playing.querySelector('.wd-player')) {
      const player = document.createElement('div');
      player.className = 'wd-player';
      if (playing.dataset.videoKind === 'file') {
        // A self-hosted (R2) file: the browser's own player, with sound, from the start.
        const video = document.createElement('video');
        video.src = playing.dataset.video;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        video.setAttribute('aria-label', data.pieces[focus!].title);
        player.append(video);
      } else {
        const frame = document.createElement('iframe');
        frame.src = `${playing.dataset.video}${playing.dataset.video.includes('?') ? '&' : '?'}autoplay=1&rel=0&playsinline=1`;
        frame.title = data.pieces[focus!].title;
        frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        frame.allowFullscreen = true;
        player.append(frame);
      }
      playing.querySelector('.wd-pic')!.after(player);
      playing.classList.add('has-player');
    }
    clearTimeout(settle);
    if (moving.length) settle = window.setTimeout(() => tiles.forEach((t) => t.classList.remove('is-moving')), 450);
    // The order they are seen in, for the Tab key and screen readers.
    const seen = [...out.placed].sort((a, z) => a.r - z.r || a.c - z.c);
    for (const p of seen) world.append(tiles[subset[p.i]]);
    if (cardEl && out.card && !inPlace) world.append(cardEl);

    // The page's - and + (none on the homepage).
    const less = document.querySelector<HTMLButtonElement>('[data-zoom="-1"]');
    const more = document.querySelector<HTMLButtonElement>('[data-zoom="1"]');
    if (less) less.disabled = zoom === 0;
    if (more) more.disabled = zoom === steps.length - 1;
    writeLink();
  };

  /*
    THE OPENED PIECE GROWS WHERE IT IS. Nothing else moves; the rest drops
    back where it lies. The piece takes about two fifths of the width on a
    wide screen (the width of the screen on a phone), less if it would
    stand taller than the screen, snapped to the grid's columns and rows
    and kept over where it was, inside the world (on a phone, where it
    takes the whole width, the rest below moves down to make room instead).
    Under the picture, its
    project's block of type and the bar into it - or, a piece with no
    project, its name. Closed, it goes back to exactly where it was.
  */
  const PAD = 8;
  function growOpen(
    t: HTMLElement,
    i: number,
    p: {c: number; r: number; cw: number; ch: number},
    g: {cols: number; cell: number; rowH: number; gap: number; phone: boolean; rows: number},
    lit: {c: number; r: number; cw: number; ch: number}[],
    atRow?: number,
  ) {
    const a = data.pieces[i].w / data.pieces[i].h;
    const picW = (cw: number) => cw * g.cell - g.gap - PAD * 2;
    const tallest = Math.max(200, innerHeight - (g.phone ? 240 : 220));
    let widest = g.phone ? g.cols : Math.min(g.cols, Math.max(p.cw + 2, Math.round(g.cols * 0.4)));
    while (!g.phone && widest > p.cw + 1 && picW(widest) / a > tallest) widest--;

    // Its words and bar, measured at a width, before it glides there.
    const base = {width: t.style.width, height: t.style.height};
    const tall = (cw: number) => {
      t.style.transition = 'none';
      t.style.width = `${cw * g.cell - g.gap}px`;
      t.style.height = 'auto';
      const extra = t.querySelector<HTMLElement>('.wd-frame')!.offsetHeight - t.querySelector<HTMLElement>('.wd-pic')!.offsetHeight;
      return Math.ceil(Math.min(picW(cw) / a, tallest) + extra);
    };

    /*
      WHERE IT OPENS. Chris: "it does obscure some of the highlighted related
      tiles ... can we get it to lay out in a way that sits well with those
      or keeps those all within viewport". Every place near it is weighed,
      at its full width and a step or two narrower:
      - the rest of its set, lit, should not be covered (by far the most);
      - it and its set should fit one screen together;
      - it should stay close to where it was picked, and as large as it can.
      On a phone it is the drawer (atRow), and nothing is covered anyway.
    */
    let best = {c: 0, r: atRow ?? 0, cw: widest, h: 0, score: Infinity};
    const widths = g.phone || atRow !== undefined ? [widest] : [widest, widest - 1, widest - 2].filter((w) => w > p.cw);
    // The screen it should sit in: round its set if the set fits one, otherwise round the piece itself.
    const view = innerHeight - 32;
    const top = (x: {r: number}) => x.r * g.rowH;
    const bottom = (x: {r: number; ch: number}) => (x.r + x.ch) * g.rowH;
    const sTop = Math.min(top(p), ...lit.map(top));
    const sBot = Math.max(bottom(p), ...lit.map(bottom));
    const middle = sBot - sTop <= view ? (sTop + sBot) / 2 : (top(p) + bottom(p)) / 2;
    const wTop = Math.max(0, middle - view / 2);
    const wBot = wTop + view;
    const px = (p.c + p.cw / 2) * g.cell;
    const py = (top(p) + bottom(p)) / 2;
    for (const cw of widths.length ? widths : [widest]) {
      const h = tall(cw);
      const rowsTall = (h + g.gap) / g.rowH;
      const w = cw * g.cell;
      if (atRow !== undefined) {
        best = {c: 0, r: atRow, cw, h, score: 0};
        break;
      }
      const lastRow = Math.max(0, Math.ceil(g.rows - rowsTall));
      for (let r = 0; r <= lastRow; r++) {
        const y0 = r * g.rowH;
        const y1 = y0 + h;
        // Far from the screen it belongs on: not worth weighing.
        if (y1 < wTop - g.rowH * 4 || y0 > wBot + g.rowH * 4) continue;
        for (let c = 0; c <= g.cols - cw; c++) {
          const x0 = c * g.cell;
          let covered = 0;
          for (const x of lit) {
            const ox = Math.min(x0 + w, (x.c + x.cw) * g.cell) - Math.max(x0, x.c * g.cell);
            const oy = Math.min(y1, bottom(x)) - Math.max(y0, top(x));
            if (ox > 0 && oy > 0) covered += (ox * oy) / (x.cw * g.cell * x.ch * g.rowH);
          }
          const outside = Math.max(0, wTop - y0) + Math.max(0, y1 - wBot);
          const far = Math.hypot(x0 + w / 2 - px, (y0 + y1) / 2 - py);
          const score = covered * 4000 + outside * 3 + far + (widest - cw) * g.cell * 0.75;
          if (score < best.score) best = {c, r, cw, h, score};
        }
      }
    }
    Object.assign(t.style, base);
    void t.offsetWidth;
    t.style.transition = '';

    const ew = best.cw * g.cell - g.gap;
    t.style.left = `${best.c * g.cell + g.gap / 2}px`;
    t.style.top = `${best.r * g.rowH + g.gap / 2}px`;
    t.style.width = `${ew}px`;
    t.style.height = `${best.h}px`;
    world.style.height = `${Math.ceil(Math.max(g.rows * g.rowH, best.r * g.rowH + best.h + g.gap))}px`;
    t.classList.remove('is-small', 'is-tiny');
    const img = t.querySelector('img');
    if (img) img.sizes = `${Math.ceil(ew)}px`;
    // In sight once it has grown: it and its set, if they fit one screen.
    if (atRow === undefined) want = [Math.min(best.r * g.rowH, sBot - sTop <= view ? sTop : Infinity), Math.max(best.r * g.rowH + best.h, sBot - sTop <= view ? sBot : 0), best.r * g.rowH];
    return best.h;
  }

  /*
    SHAREABLE LINKS, as /portfolio: ?open=<slug>, plus the
    world's seed so the same world comes back. In place (replaceState): the
    one history entry is the one opening adds, so Back closes a piece.
  */
  const writeLink = () => {
    if (!shown()) return;
    const url = new URL(location.href);
    const set = (k: string, v: string | null) => (v ? url.searchParams.set(k, v) : url.searchParams.delete(k));
    set('open', focus === null ? null : keyOf(focus));
    // The homepage's field is the one world it always is: no seed in its address.
    set('seed', data.home ? null : String(seed));
    set('mode', mode === 'lands' ? null : mode);
    set('v', simple ? null : 'rules');
    if (url.href !== location.href) history.replaceState(history.state, '', url);
  };

  /*
    The scroll that brings a grown piece into sight, after its short wait.
    Not the browser's own smooth scroll, whose speed cannot be set: Chris
    liked the wait and asked for the scroll at double the speed, so this
    takes about half as long (a quarter of a second, a little more for a long
    way). A wheel, touch or key from the visitor stops it where it is.
  */
  let gliding = 0;
  function glide(y: number, instant: boolean) {
    cancelAnimationFrame(gliding);
    if (instant) {
      scrollTo({top: y});
      return;
    }
    const from = scrollY;
    const way = y - from;
    const time = Math.min(400, 220 + Math.abs(way) * 0.1);
    const start = performance.now();
    const stop = () => {
      cancelAnimationFrame(gliding);
      removeEventListener('wheel', stop);
      removeEventListener('touchstart', stop);
      removeEventListener('keydown', stop);
    };
    addEventListener('wheel', stop, {passive: true});
    addEventListener('touchstart', stop, {passive: true});
    addEventListener('keydown', stop);
    const step = (now: number) => {
      const k = Math.min(1, (now - start) / time);
      scrollTo({top: from + way * (1 - Math.pow(1 - k, 3))});
      if (k < 1) gliding = requestAnimationFrame(step);
      else stop();
    };
    gliding = requestAnimationFrame(step);
  }

  // As on the main grid: a piece opens; picked again, it closes. Its bar is the way to the project.
  const open = (i: number, push = true) => {
    if (i === focus) {
      close();
      return;
    }
    const at = last?.out.placed.find((x) => last!.subset[x.i] === i);
    focusRow = at?.r ?? 0;
    if (push && focus === null) {
      history.pushState({wd: i}, '');
      pushed = true;
    }
    focus = i;
    draw();
    // In place, it is already where it was picked; a gathering mode brings it into view.
    if (mode !== 'lands') tiles[i].scrollIntoView({block: 'center'});
    // Grown, all of it in sight once it has finished growing.
    else if (data.grow) {
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      setTimeout(() => {
        if (focus !== i || !want) return;
        // As little scrolling as brings it - and its set, where they fit - into sight.
        const at = world.getBoundingClientRect().top + scrollY;
        const [from, to, own] = want;
        const lo = scrollY + 16;
        const hi = scrollY + innerHeight - 16;
        let y = scrollY;
        if (to - from <= innerHeight - 32) {
          if (at + from < lo) y = at + from - 16;
          else if (at + to > hi) y = at + to - innerHeight + 16;
        } else y = at + own - 16;
        if (Math.abs(y - scrollY) > 2) glide(y, still || !push);
      }, still ? 0 : 320);
    }
  };
  function close() {
    if (pushed) {
      history.back();
      return;
    }
    focus = null;
    draw();
  }

  // A result tile opens its project's own piece (data-opens), not itself.
  tiles.forEach((t) => t.querySelector('.wd-pic')!.addEventListener('click', () => open(Number(t.dataset.opens ?? t.dataset.i))));

  /*
    PICKS, on a board (src/pages/picks/[code]): a + on each piece puts it in
    the tray, which rises from the foot of the screen once something is in
    it; the tray's thumbnails take a piece out again, and Send posts them
    (with a name and a line, unless it is a vote) to functions/api/picks.ts.
    Opening and growing a piece work as anywhere else - the + is beside the
    picture, not on it. Chosen pieces are kept for the visit (session
    storage), and a sent board remembers it was sent (local storage), so a
    vote is not sent twice by accident.
  */
  const tray = document.querySelector<HTMLElement>('.pk-tray');
  if (data.picks && tray) {
    const P = data.picks;
    const KEEP = `picks:${P.code}`;
    const SENT = `picks-sent:${P.code}`;
    const store = (s: Storage | undefined, k: string, v?: string) => {
      try {
        if (v === undefined) return s?.getItem(k) ?? null;
        s?.setItem(k, v);
      } catch {}
      return null;
    };
    const ids = data.pieces.map((p) => p.id);
    let chosen = new Set<string>(
      (() => {
        try {
          return (JSON.parse(store(sessionStorage, KEEP) ?? '[]') as string[]).filter((id) => ids.includes(id));
        } catch {
          return [];
        }
      })(),
    );
    const form = tray.querySelector<HTMLFormElement>('.pk-tray__form');
    const said = tray.querySelector<HTMLElement>('[data-said]')!;
    const bar = tray.querySelector<HTMLElement>('.pk-tray__bar')!;
    const thumbs = tray.querySelector<HTMLElement>('.pk-tray__thumbs')!;
    let done = store(localStorage, SENT) === '1';

    const render = () => {
      tiles.forEach((t) => {
        const on = chosen.has(data.pieces[Number(t.dataset.i)].id);
        t.classList.toggle('is-picked', on);
        const b = t.querySelector('.wd-add');
        if (b) {
          b.setAttribute('aria-pressed', String(on));
          b.querySelector('.wd-add__mark')!.textContent = on ? '✓' : '+';
          b.querySelector('.wd-add__label')!.textContent = on ? 'In your picks' : 'Add to picks';
        }
      });
      tray.querySelector('[data-count]')!.textContent = String(chosen.size);
      thumbs.replaceChildren(
        ...[...chosen].map((id) => {
          const i = ids.indexOf(id);
          const li = document.createElement('li');
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'pk-tray__thumb';
          b.setAttribute('aria-label', `Take ${data.pieces[i].title} out`);
          const img = tiles[i].querySelector('img');
          if (img?.currentSrc) {
            const pic = document.createElement('img');
            pic.src = img.currentSrc;
            pic.alt = '';
            b.append(pic);
          } else b.textContent = data.pieces[i].title;
          b.addEventListener('click', () => pick(id, false));
          li.append(b);
          return li;
        }),
      );
      tray.hidden = !done && chosen.size === 0;
      document.body.classList.toggle('has-tray', !tray.hidden);
      store(sessionStorage, KEEP, JSON.stringify([...chosen]));
    };
    const pick = (id: string, on: boolean) => {
      if (done) return;
      on ? chosen.add(id) : chosen.delete(id);
      if (!chosen.size && form) showForm(false);
      render();
    };
    const showForm = (on: boolean) => {
      if (!form) return;
      form.hidden = !on;
      bar.querySelector<HTMLButtonElement>('[data-send]')!.hidden = on;
      if (on) form.querySelector<HTMLInputElement>('input')?.focus();
    };
    const finish = (text: string) => {
      done = true;
      store(localStorage, SENT, '1');
      chosen = new Set();
      said.textContent = text;
      said.hidden = false;
      bar.hidden = true;
      if (form) form.hidden = true;
      document.querySelectorAll<HTMLElement>('.wd-add').forEach((b) => (b.hidden = true));
      render();
    };
    const send = async (name = '', note = '') => {
      said.hidden = true;
      const sendBtns = tray.querySelectorAll<HTMLButtonElement>('.pk-tray__send');
      sendBtns.forEach((b) => (b.disabled = true));
      try {
        const res = await fetch('/api/picks', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({board: P.code, pieces: [...chosen], name, note}),
        });
        const body = (await res.json().catch(() => ({}))) as {ok?: boolean; message?: string};
        if (res.ok && body.ok) finish(P.kind === 'vote' ? 'Thank you - your vote is in.' : 'Sent - thank you. Chris will see them.');
        else {
          said.textContent = body.message ?? 'That did not go through. Please try again.';
          said.hidden = false;
        }
      } catch {
        said.textContent = 'That did not go through. Please try again.';
        said.hidden = false;
      }
      sendBtns.forEach((b) => (b.disabled = false));
    };

    tiles.forEach((t) =>
      t.querySelector('.wd-add')?.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = data.pieces[Number(t.dataset.i)].id;
        pick(id, !chosen.has(id));
      }),
    );
    bar.querySelector('[data-send]')!.addEventListener('click', () => (P.kind === 'vote' ? send() : showForm(true)));
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = new FormData(form);
      send(String(f.get('name') ?? ''), String(f.get('note') ?? ''));
    });
    form?.querySelector('[data-back]')?.addEventListener('click', () => showForm(false));
    if (done) {
      said.textContent = P.kind === 'vote' ? 'Your vote is in - thank you.' : 'Your picks were sent - thank you.';
      said.hidden = false;
      bar.hidden = true;
      document.querySelectorAll<HTMLElement>('.wd-add').forEach((b) => (b.hidden = true));
    }
    render();
  }
  // Grown, a click on the ground between the pieces puts it back too.
  world.addEventListener('click', (e) => {
    if (data.grow && e.target === world && focus !== null) close();
  });
  addEventListener('popstate', (e) => {
    const i = (e.state as {wd?: number} | null)?.wd;
    pushed = typeof i === 'number';
    focus = typeof i === 'number' ? i : null;
    draw();
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && focus !== null) close();
  });
  document.querySelector('[data-roll]')?.addEventListener('click', () => {
    seed = (seedOf(`${seed}:${Date.now()}`) % 9000) + 1000;
    draw();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) =>
    b.addEventListener('click', () => {
      const steps = phoneNow() ? STEPS.phone : STEPS.desktop;
      zoom = Math.max(0, Math.min(steps.length - 1, zoom + Number(b.dataset.zoom)));
      draw();
    }),
  );

  // Arriving on a shared link: the view at once, the piece opened in it.
  const arrive = shown() ? q.get('open') : null;
  const arriving = arrive ? data.pieces.findIndex((p) => p.slug === arrive || p.id === arrive) : -1;
  draw();
  if (arriving >= 0) open(arriving, false);

  let lastWidth = 0;
  new ResizeObserver(([e]) => {
    if (Math.abs(e.contentRect.width - lastWidth) < 1) return;
    lastWidth = e.contentRect.width;
    requestAnimationFrame(draw);
  }).observe(world.parentElement!);
</script>
