---
/*
  The homepage: on the preview, the work-first one (components/home/WorkFirst.astro)
  while it is tried; on production, the original (components/home/ClassicHome.astro),
  which also lives at /hello as a landing page.
*/
import Layout from '../layouts/Layout.astro';
import { pageDescription } from '../lib/meta';
import WorkFirst from '../components/home/WorkFirst.astro';
import ClassicHome from '../components/home/ClassicHome.astro';
import { getPage, getSiteSettings, getFeaturedWork } from '../lib/queries';

const page = await getPage('home');
const IS_PREVIEW = import.meta.env.PUBLIC_IS_PREVIEW === 'true';
const settings = IS_PREVIEW ? await getSiteSettings() : null;
const featuredWork = IS_PREVIEW ? await getFeaturedWork(8) : [];
const CONTACT_URL = settings?.contactUrl || '/contact';
const bioText =
  settings?.bioText ||
  'Chris Rumeau is a brand designer, illustrator, and typographer building visual ' +
    'identities rooted in heritage craft and hand-drawn precision.';
---

<Layout title={page?.title ?? 'Rumeau Design Co'} description={pageDescription(page, 'Hand-drawn brand identity, lettering and merch design for heritage apparel brands and musicians. The studio of Chris Rumeau, New Jersey.')}>
  {IS_PREVIEW ? (
    <WorkFirst settings={settings} contactUrl={CONTACT_URL} bioText={bioText} featured={featuredWork} />
  ) : (
    <ClassicHome />
  )}
</Layout>
