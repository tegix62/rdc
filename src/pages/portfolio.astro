---
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import Sections from '../components/Sections.astro';
import { getPage, getAllGridItems } from '../lib/queries';
import { urlFor } from '../lib/image';

const page = await getPage('portfolio');
const items = await getAllGridItems();

/*
  Maps a grid item's category to a filter class. Typography and Illustration
  deliberately share one "Type/Lettering" button, matching the live site.

  Accepts BOTH the friendly name and the raw Webflow category id, because the
  dataset contains the raw ids and the migration can no longer correct them.
  The documents were seeded before CATEGORY_MAP existed, so they hold values
  like "25b18402...". Re-running the migration does not fix it: the fill-in-the-
  blanks rule added to stop migrations clobbering Studio edits only writes
  fields that are EMPTY, and these are not empty - they are populated and
  wrong. Every one of the 80 items reports "kept Studio version" for exactly
  that reason.

  Normalising on read fixes it immediately and works whichever value a document
  holds, which also means new items created in Studio with the friendly names
  keep working. Repairing the stored data needs a deliberate forced migration.
*/
const CATEGORY_FILTER: Record<string, string> = {
  // Friendly names, as written by the current migration and by Studio.
  'Brand Identity': 'brand-identity',
  'Merch & Apparel': 'merch-apparel',
  Typography: 'type-lettering',
  Illustration: 'type-lettering',
  Photography: 'photography',
  // Raw Webflow category ids, as actually stored on the migrated documents.
  '25b184027eb70b18d6c7b600aee158e8': 'brand-identity',
  '9401f9935a5e974e1aafa54688842d7d': 'merch-apparel',
  '434c6f273e30a5b44173206a70f0a63b': 'type-lettering',
  '72001b43acecb4bd274abbeb9fc58dc3': 'type-lettering',
  c497ce92016cc5970b75f3a85057a17f: 'photography',
};

/*
  A tile whose category isn't in the map above gets no filter class, so it only
  ever appears under "All" - reachable, but silently absent from every category.
  That's invisible on the page, so the build says so instead.
*/
// Printed every build so the actual stored values are visible rather than
// inferred. This is what would have identified the raw-id problem immediately.
const seen = [...new Set(items.map((i: any) => i.category ?? '(none)'))];
console.log(`[portfolio] ${items.length} tiles; category values in use: ${seen.join(' | ')}`);

const unmapped = [
  ...new Set(
    items
      .map((i: any) => i.category)
      .filter((c: string) => c && !(c in CATEGORY_FILTER)),
  ),
];
if (unmapped.length > 0) {
  console.warn(
    `[portfolio] ${unmapped.length} category value(s) have no filter button and ` +
      `will only show under "All": ${unmapped.join(', ')}`,
  );
}
const uncategorised = items.filter((i: any) => !i.category).length;
if (uncategorised > 0) {
  console.warn(
    `[portfolio] ${uncategorised} grid item(s) have no category at all and will ` +
      `only show under "All".`,
  );
}

const filters = [
  { value: '*', label: 'All' },
  { value: '.brand-identity', label: 'Brand Identity' },
  { value: '.merch-apparel', label: 'Merch & Apparel' },
  { value: '.type-lettering', label: 'Type/Lettering' },
  { value: '.photography', label: 'Photography' },
];
---

<Layout title={page?.title ?? 'Portfolio'} description={page?.seoDescription}>
  <section class="pf-section">
    <div class="pf-controls" id="pf-controls">
      {filters.map((f, i) => (
        <button type="button" class:list={['pf-btn', i === 0 && 'is-active']} data-filter={f.value}>
          {f.label}
        </button>
      ))}
      <span class="pf-divider" aria-hidden="true"></span>
      <button type="button" class="pf-btn" id="pf-shuffle">Shuffle</button>
      <button type="button" class="pf-btn" id="pf-minus" aria-label="Smaller tiles">&minus;</button>
      <button type="button" class="pf-btn" id="pf-plus" aria-label="Larger tiles">+</button>
    </div>

    <div class="pf-grid" id="pf-grid">
      {items.map((item: any) => {
        const img = item.thumbnail || item.mainImage;
        const cat = CATEGORY_FILTER[item.category] ?? '';
        // Only link to a parent that actually has a page.
        const parentHref =
          item.parentSlug && item.parentType === 'Case Study' ? `/work/${item.parentSlug}` : null;
        // The category has to be a real CLASS, not just a data attribute:
        // Isotope filters with CSS selectors (".brand-identity"), so with the
        // value only in data-category every filter matched zero tiles and the
        // buttons appeared to do nothing. data-category is kept for styling
        // and debugging.
        return img ? (
          <div class:list={['pf-item', cat]} data-category={cat}>
            <Img class="pf-item__img" image={img} alt={item.title} width={800} sizes="(max-width: 48rem) 33vw, 17vw" />
            {parentHref && (
              <a class="pf-item__jump" href={parentHref}>
                <span class="pf-item__jump-label">{item.parentTitle ?? 'View project'}</span>
                <span class="pf-item__jump-arrow" aria-hidden="true">&rarr;</span>
              </a>
            )}
          </div>
        ) : null;
      })}
    </div>
    {items.length === 0 && <p>No items found.</p>}
  </section>

  {page?.sections?.length > 0 && (
    <div class="page-sections">
      <Sections sections={page.sections} />
    </div>
  )}
</Layout>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.isotope/3.0.6/isotope.pkgd.min.js"></script>
<script src="https://unpkg.com/imagesloaded@5/imagesloaded.pkgd.min.js"></script>
<script>
  declare const Isotope: any;
  declare const imagesLoaded: any;

  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.querySelector<HTMLElement>('#pf-grid');
    if (!grid) return;

    const sizer = document.createElement('div');
    sizer.className = 'pf-sizer';
    grid.insertBefore(sizer, grid.firstChild);

    let cols = window.innerWidth < 768 ? 3 : 6;

    function setColWidth() {
      grid!.style.setProperty('--pf-col-w', 100 / cols + '%');
    }
    setColWidth();

    const iso = new Isotope(grid, {
      itemSelector: '.pf-item',
      layoutMode: 'masonry',
      masonry: { columnWidth: '.pf-sizer', gutter: 0 },
      percentPosition: true,
      transitionDuration: 0,
    });

    imagesLoaded(grid).on('progress', () => iso.layout());

    document.querySelectorAll<HTMLElement>('.pf-btn[data-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const filterVal = btn.dataset.filter!;
        const allBtn = document.querySelector<HTMLElement>('.pf-btn[data-filter="*"]');

        // An expanded tile that gets filtered away would keep its expanded
        // state (and its double width) for when it returns, which reads as a
        // glitch. Collapse on any filter change.
        grid.querySelectorAll('.pf-item.is-expanded').forEach((el) => el.classList.remove('is-expanded'));
        if (filterVal === '*') {
          document.querySelectorAll('.pf-btn[data-filter]').forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          iso.arrange({ filter: '*' });
          return;
        }
        btn.classList.toggle('is-active');
        const activeFilters = Array.from(document.querySelectorAll('.pf-btn[data-filter].is-active'))
          .map((b) => (b as HTMLElement).dataset.filter)
          .filter((f) => f !== '*');
        if (activeFilters.length === 0) {
          allBtn?.classList.add('is-active');
          iso.arrange({ filter: '*' });
        } else {
          allBtn?.classList.remove('is-active');
          iso.arrange({ filter: activeFilters.join(', ') });
        }
      });
    });

    document.querySelector('#pf-shuffle')?.addEventListener('click', () => iso.shuffle());

    function updateCols() {
      setColWidth();
      iso.layout();
    }
    document.querySelector('#pf-plus')?.addEventListener('click', () => {
      if (cols > 1) {
        cols--;
        updateCols();
      }
    });
    document.querySelector('#pf-minus')?.addEventListener('click', () => {
      if (cols < 12) {
        cols++;
        updateCols();
      }
    });

    grid.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // The jump button lives inside the tile, so without this its click would
      // bubble up here and collapse the tile instead of navigating.
      if (target.closest('a')) return;

      const item = target.closest<HTMLElement>('.pf-item');
      if (!item) return;
      const wasExpanded = item.classList.contains('is-expanded');
      grid.querySelectorAll('.pf-item.is-expanded').forEach((el) => el.classList.remove('is-expanded'));
      if (!wasExpanded) item.classList.add('is-expanded');

      // The button becoming visible changes the tile's height, so Isotope has
      // to re-measure. Two frames: one for the class to apply and the browser
      // to reflow, then layout against real heights. A single synchronous
      // call here measures the pre-reveal height and leaves tiles overlapping.
      requestAnimationFrame(() => requestAnimationFrame(() => iso.layout()));
    });
  });
</script>
