---
/*
  THE MONOGRAPH - a typographic trial, preview only, at /next/grid/works and
  /next/grid/<case study>. Chris: "I wonder if there are ways to make the
  site typographically gridded and elevated/academic levels of graphic
  design", then "try all six in one preview". All six, in one system:

    1. ONE TYPE SCALE: six sizes, where the live stylesheet has over 25.
    2. A COLUMN GRID: twelve columns on a wide screen, four on a phone,
       fixed gutters; every block starts and ends on a column line.
    3. A BASELINE: every line height and every gap a multiple of 8px, so
       text in neighbouring columns sits on the same lines.
    4. THE APPARATUS: numbered figures and captions, a running head,
       marginal notes, small-capital labels, tabular figures, set quotes
       and dashes.
    5. CASE STUDIES AS MONOGRAPHS: a facts table, the essay with its notes
       in the margin, the plates in sequence, the works catalogued.
    6. AN INDEX OF WORKS: every piece numbered and ruled, like a catalogue
       raisonné, sortable by any column.

  Press G (or the Grid button) to show the columns and the baseline.
  The index is "works", not "index": Cloudflare takes /x/index for the
  folder's own page and answers 404.
  Never built for production (getStaticPaths), and noindex.
*/
import Layout from '../../../layouts/Layout.astro';
import Img from '../../../components/Img.astro';
import {getAllGridItems, getCaseStudy, getGridItems} from '../../../lib/queries';
import {tileImage, imageDimensions, hasAsset} from '../../../lib/image';
import {tileHref, cleanKey} from '../../../lib/tiles';
import {stripStegaKey} from '../../../lib/stega';
import {renderPortableText} from '../../../lib/portableText';
import {paragraphs, typeset, credits, services, plates, isPlaceholder, catalogueNo} from '../../../lib/monograph';

const clean = (s: unknown) => stripStegaKey(s).replace(/\s+/g, ' ').trim();
const isProject = (it: any) => cleanKey(it.pageType) === 'Case Study';
const rank = (it: any) => (typeof it.orderRank === 'string' ? it.orderRank : null);
const byTitle = (a: any, z: any) => clean(a.title).localeCompare(clean(z.title));
const slugOf = (it: any) => clean(it?.slug?.current ?? it?.slug);

async function catalogue() {
  const items: any[] = (await getAllGridItems()).filter((it: any) => tileImage(it) && imageDimensions(tileImage(it)));
  const studies = items.filter(isProject).sort((a, z) => {
    const ra = rank(a);
    const rz = rank(z);
    if (ra && rz) return ra < rz ? -1 : 1;
    if (ra || rz) return ra ? -1 : 1;
    return byTitle(a, z);
  });
  return {items, studies};
}

export async function getStaticPaths() {
  if (import.meta.env.PUBLIC_IS_PREVIEW !== 'true') return [];
  // Self-contained: Astro runs this apart from the rest of the frontmatter.
  const all: any[] = await getAllGridItems();
  const slugs = all
    .filter((it) => stripStegaKey(it.pageType) === 'Case Study')
    .map((it) => stripStegaKey(it?.slug?.current ?? it?.slug).trim())
    .filter(Boolean);
  return [{params: {page: 'works'}}, ...[...new Set(slugs)].map((page) => ({params: {page}}))];
}

const {page} = Astro.params as {page: string};
const {items, studies} = await catalogue();
const studyNo = (slug: string) => studies.findIndex((s) => slugOf(s) === slug) + 1;
const pad2 = (n: number) => String(n).padStart(2, '0');
/*
  A piece's own name, without its project in front: "Hug a Mug - Tarot
  Taurus Tee" under Hug a Mug Coffeehouse & Ceramics Studio is "Tarot Taurus
  Tee" - whether the title starts with the project's whole name or with the
  short name before a dash that the project's title begins with.
*/
const ownName = (title: string, project: string) => {
  const t = title.trim();
  const p = project.toLowerCase();
  if (p && t.toLowerCase().startsWith(p)) return t.slice(project.length).replace(/^[\s\-–—:]+/, '') || t;
  const m = t.match(/^(.+?)\s+[-–—:]\s+(.+)$/);
  if (m && p.startsWith(m[1].toLowerCase())) return m[2];
  return t;
};
// A place on the grid: at('4 / 10') is columns 4 to 10, written into the markup so nothing moves as the page loads.
const at = (c: string) => ({'data-c': c, style: `--c: ${c}`});

// The index: each case study, then its pieces, then everything else - numbered in that order.
type Row = {no: string; title: string; project: string; discipline: string; type: string; year: string; image: any; href: string | null; study: boolean};
let rows: Row[] = [];
if (page === 'works') {
  const used = new Set<any>();
  const ordered: any[] = [];
  for (const s of studies)
    for (const it of [s, ...items.filter((x) => !isProject(x) && tileHref(x) && tileHref(x) === tileHref(s)).sort(byTitle)]) {
      ordered.push(it);
      used.add(it);
    }
  for (const it of items.filter((x) => !used.has(x)).sort(byTitle)) ordered.push(it);
  const projectName: Record<string, string> = {};
  for (const s of studies) if (tileHref(s)) projectName[tileHref(s)!] = clean(s.title);
  rows = ordered.map((it, n) => {
    const project = tileHref(it) ? (projectName[tileHref(it)!] ?? '') : '';
    // "DumpStat - Fantasy Keth Tee" is "Fantasy Keth Tee" in its project's column.
    const title = ownName(clean(it.title), project);
    return {
      no: catalogueNo(n + 1),
      title: typeset(title),
      project: typeset(project),
      discipline: clean(it.category) || '—',
      type: clean(it.assetType) || '—',
      year: it.year ? String(it.year) : '—',
      image: tileImage(it),
      href: isProject(it) && slugOf(it) ? `/next/grid/${slugOf(it)}` : null,
      study: isProject(it),
    };
  });
}

// A monograph.
const cs: any = page === 'works' ? null : await getCaseStudy(page);
const works: any[] = cs ? (await getGridItems(cs._id)).filter((it: any) => tileImage(it)) : [];
const no = cs ? studyNo(page) : 0;
const title = cs ? typeset(clean(cs.title)) : 'Index of Works';
const lead = cs ? typeset(clean(cs.oneLineSummary) || paragraphs(cs.summary)[0] || '') : '';
const client = cs && !isPlaceholder(clean(cs.client)) ? typeset(clean(cs.client)) : '';
const credited = cs ? credits(cs.creditsText) : [];
const typefaces = credited.filter((c) => /font|type/i.test(c.role) || (!c.role && /font|type/i.test(c.name)));
const people = credited.filter((c) => !typefaces.includes(c));
const done = cs ? services(cs.servicesRendered) : [];
const essayHtml = cs ? renderPortableText(cs.body) || renderPortableText(cs.summary) : '';
const figs = cs ? plates(cs) : [];
const placeholderLeft = cs ? isPlaceholder(clean(cs.client)) || paragraphs(cs.servicesRendered).some(isPlaceholder) : false;

/*
  The plates in sequence, on the grid: a wide picture across the measure with
  its caption in the margin, alternating sides; two upright ones as a pair.
*/
type Laid = {kind: 'wide' | 'pair' | 'full'; side?: 'l' | 'r'; upright?: boolean; figs: {n: number; image: any; caption: string; w: number; h: number}[]};
const laid: Laid[] = [];
{
  const withDims = figs
    .map((p, k) => ({...p, n: k + 1, d: imageDimensions(p.image)}))
    .filter((p) => p.d)
    .map((p) => ({n: p.n, image: p.image, w: p.d!.width, h: p.d!.height, caption: typeset(p.caption || p.group || `${clean(cs?.title)}, ${cs?.year ?? ''}`.replace(/,\s*$/, ''))}));
  let side: 'l' | 'r' = 'r';
  for (let k = 0; k < withDims.length; k++) {
    const p = withDims[k];
    const upright = p.w / p.h < 1.15;
    const next = withDims[k + 1];
    // Fig. 1 across the page - or, upright, on the text's columns with its caption beside it.
    if (k === 0) laid.push({kind: 'full', upright, figs: [p]});
    else if (upright && next && next.w / next.h < 1.15) {
      laid.push({kind: 'pair', figs: [p, next]});
      k++;
    } else {
      laid.push({kind: 'wide', side, figs: [p]});
      side = side === 'r' ? 'l' : 'r';
    }
  }
}
const nextStudy = cs ? studies[no % studies.length] : null;
const prevStudy = cs ? studies[(no - 2 + studies.length) % studies.length] : null;
const span = (() => {
  const years = studies.map((s) => Number(s.year)).filter(Boolean);
  return years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '';
})();
---

<Layout title={`${cs ? clean(cs.title) : 'Index of Works'} - Monograph trial - Rumeau Design Co`} description="A typographic trial." noindex>
  <div class="mg" id="mg">
    <!-- The running head: where you are in the book, and the grid's switch. -->
    <div class="mg-run">
      <div class="mg-grid mg-run__in">
        <p class="mg-run__here" {...at('1 / 7')}>
          {cs ? <><span class="mg-num">{'№'} {pad2(no)}</span> {title}</> : <>Index of Works</>}
        </p>
        <p class="mg-run__book" {...at('7 / 11')}>
          <a href="/next/grid/works">Rumeau Design, work {span}</a>
        </p>
        <p class="mg-run__tools" {...at('11 / 13')}>
          <button type="button" class="mg-gridbtn" id="mg-gridbtn" aria-pressed="false">Grid <kbd>G</kbd></button>
        </p>
      </div>
    </div>

    {cs ? (
      <article>
        <!-- 5. The monograph: its title, its lead, its facts. -->
        <header class="mg-grid mg-head">
          <h1 class="mg-h1" {...at('1 / 11')}>{title}</h1>
          {lead && <p class="mg-lead" {...at('4 / 11')}>{lead}</p>}
        </header>

        <section class="mg-grid mg-facts" aria-label="Facts">
          <dl {...at('4 / 13')} class="mg-facts__dl">
            {client && (<><dt>Client</dt><dd>{client}</dd></>)}
            {cs.year && (<><dt>Year</dt><dd class="mg-tab">{cs.year}</dd></>)}
            {cs.category && (<><dt>Discipline</dt><dd>{clean(cs.category)}</dd></>)}
            {done.length > 0 && (<><dt>Services</dt><dd>{done.map((d) => typeset(d)).join(', ')}</dd></>)}
            {typefaces.length > 0 && (<><dt>Typefaces</dt><dd>{typefaces.map((t) => typeset(t.name)).join(', ')}</dd></>)}
            <dt>Plates</dt><dd class="mg-tab">{figs.length}{works.length > 0 && <>; {works.length} works catalogued</>}</dd>
          </dl>
        </section>

        <!-- Fig. 1, across the page. -->
        {laid[0] && (
          <figure class="mg-grid mg-fig mg-fig--full">
            <div class="mg-fig__pic" {...at(laid[0].upright ? '4 / 10' : '1 / 13')}>
              <Img image={laid[0].figs[0].image} alt={laid[0].figs[0].caption} width={2000} sizes={laid[0].upright ? '(min-width: 48rem) 50vw, 100vw' : '100vw'} loading="eager" field="Main image (monograph)" />
            </div>
            <figcaption class:list={['mg-cap', laid[0].upright && 'mg-cap--beside']} {...at(laid[0].upright ? '1 / 4' : '1 / 5')}><span class="mg-sc">Fig. 1</span> {laid[0].figs[0].caption}</figcaption>
          </figure>
        )}

        <!-- The essay, with its notes in the margin. -->
        {essayHtml && (
          <section class="mg-grid mg-essay">
            <aside class="mg-notes" {...at('1 / 4')} aria-label="Notes">
              {people.length > 0 && (
                <>
                  <p class="mg-sc">Collaborators</p>
                  <ul>
                    {people.map((p) => (
                      <li>
                        {p.role && <span class="mg-note__role">{typeset(p.role)}</span>}
                        {p.href ? <a href={p.href} rel="noopener" target="_blank">{typeset(p.name)}</a> : typeset(p.name)}
                      </li>
                    ))}
                  </ul>
                </>
              )}
              {figs.length > 1 && <p class="mg-note">See plates, Figs. 2{'–'}{figs.length}.</p>}
            </aside>
            <div class="mg-text" {...at('4 / 10')} set:html={essayHtml} />
          </section>
        )}

        <!-- 4. The plates, numbered, on the grid. -->
        <section class="mg-plates" aria-label="Plates">
          {laid.slice(1).map((l) =>
            l.kind === 'pair' ? (
              <div class="mg-grid mg-fig mg-fig--pair">
                {l.figs.map((f, k) => (
                  <figure {...at(k === 0 ? '1 / 7' : '7 / 13')}>
                    <div class="mg-fig__pic"><Img image={f.image} alt={f.caption} width={1200} sizes="(min-width: 48rem) 50vw, 100vw" field="Plate (monograph)" /></div>
                    <figcaption class="mg-cap"><span class="mg-sc">Fig. {f.n}</span> {f.caption}</figcaption>
                  </figure>
                ))}
              </div>
            ) : (
              <figure class={`mg-grid mg-fig mg-fig--wide mg-fig--${l.side}`}>
                <div class="mg-fig__pic" {...at(l.side === 'r' ? '4 / 13' : '1 / 10')}>
                  <Img image={l.figs[0].image} alt={l.figs[0].caption} width={1600} sizes="(min-width: 48rem) 75vw, 100vw" field="Plate (monograph)" />
                </div>
                <figcaption class="mg-cap" {...at(l.side === 'r' ? '1 / 4' : '10 / 13')}><span class="mg-sc">Fig. {l.figs[0].n}</span> {l.figs[0].caption}</figcaption>
              </figure>
            ),
          )}
        </section>

        <!-- The works, catalogued. -->
        {works.length > 0 && (
          <section class="mg-grid mg-works" aria-label="Works">
            <h2 class="mg-h3" {...at('1 / 4')}>Works</h2>
            <table class="mg-table" {...at('4 / 13')}>
              <thead><tr><th class="mg-tab">No.</th><th>Title</th><th>Type</th><th class="mg-tab">Year</th></tr></thead>
              <tbody>
                {works.sort(byTitle).map((w, k) => {
                  const t = ownName(clean(w.title), clean(cs.title));
                  return (
                    <tr>
                      <td class="mg-tab">{pad2(no)}.{pad2(k + 1)}</td>
                      <td>{typeset(t)}</td>
                      <td>{clean(w.assetType) || clean(w.category) || '—'}</td>
                      <td class="mg-tab">{w.year || cs.year || '—'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </section>
        )}

        <nav class="mg-grid mg-turn" aria-label="Monographs">
          {prevStudy && <a {...at('1 / 7')} href={`/next/grid/${slugOf(prevStudy)}`}><span class="mg-sc">Previous</span> {'№'} {pad2(studyNo(slugOf(prevStudy)))} {typeset(clean(prevStudy.title))}</a>}
          {nextStudy && <a {...at('7 / 13')} class="mg-turn__next" href={`/next/grid/${slugOf(nextStudy)}`}><span class="mg-sc">Next</span> {'№'} {pad2(studyNo(slugOf(nextStudy)))} {typeset(clean(nextStudy.title))}</a>}
        </nav>
        {placeholderLeft && (
          <p class="mg-grid mg-trialnote"><span {...at('4 / 10')}>Left out here: this project's Client or Services field still holds the old template's placeholder text in Studio.</span></p>
        )}
      </article>
    ) : (
      <article>
        <!-- 6. The index of works. -->
        <header class="mg-grid mg-head">
          <h1 class="mg-h1" {...at('1 / 11')}>Index of Works</h1>
          <p class="mg-lead" {...at('4 / 11')}>
            {rows.length} works, {span}. Each case study is followed by its pieces, then the rest in order of title. Select a column heading to sort.
          </p>
        </header>
        <section class="mg-grid mg-studies" aria-label="Monographs">
          <h2 class="mg-h3" {...at('1 / 4')}>Monographs</h2>
          <ol class="mg-studies__list" {...at('4 / 13')}>
            {studies.filter((s) => slugOf(s)).map((s, k) => (
              <li><a href={`/next/grid/${slugOf(s)}`}><span class="mg-tab">{'№'} {pad2(k + 1)}</span> {typeset(clean(s.title))}<span class="mg-tab mg-studies__year">{s.year ?? ''}</span></a></li>
            ))}
          </ol>
        </section>
        <section class="mg-grid mg-index" aria-label="Index">
          <div class="mg-index__wrap" {...at('1 / 13')}>
            <table class="mg-table mg-table--index" id="mg-index">
              <thead>
                <tr>
                  <th class="mg-tab"><button type="button" data-sort="0">No.</button></th>
                  <th class="mg-index__thumb"><span class="mg-visually-hidden">Picture</span></th>
                  <th><button type="button" data-sort="2">Title</button></th>
                  <th><button type="button" data-sort="3">Project</button></th>
                  <th><button type="button" data-sort="4">Discipline</button></th>
                  <th><button type="button" data-sort="5">Type</button></th>
                  <th class="mg-tab"><button type="button" data-sort="6">Year</button></th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr class:list={[r.study && 'is-study']}>
                    <td class="mg-tab">{r.no}</td>
                    <td class="mg-index__thumb">{hasAsset(r.image) && <Img image={r.image} alt="" altFallback={r.title} width={96} sizes="48px" field="Index thumbnail" />}</td>
                    <td>{r.href ? <a href={r.href}>{r.title}</a> : r.title}</td>
                    <td>{r.project || '—'}</td>
                    <td>{r.discipline}</td>
                    <td>{r.type}</td>
                    <td class="mg-tab">{r.year}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </article>
    )}
  </div>
</Layout>

<style is:global>
  /*
    THE SYSTEM. One unit (8px) under everything; six sizes, each on a line
    height that is a whole number of units; twelve columns.
  */
  .mg {
    --u: 0.5rem;
    --t-cap: 0.8125rem; /* 13 on 16 */
    --t-body: 1.0625rem; /* 17 on 24 */
    --t-lead: 1.375rem; /* 22 on 32 */
    --t-h3: 1.75rem; /* 28 on 32 */
    --t-h2: 2.75rem; /* 44 on 48 */
    --t-h1: clamp(2.75rem, 6.5vw, 5.5rem); /* 44-88, set solid */
    --gutter: 1.5rem;
    --margin: max(3rem, env(safe-area-inset-left, 0px));
    --ink: var(--color-ink, #1a1a1a);
    --rule: var(--color-ink, #1a1a1a);
    --quiet: #5f6673;
    --accent: var(--color-navy, #002885);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: calc(var(--u) * 3);
    font-kerning: normal;
    font-variant-ligatures: common-ligatures;
    hanging-punctuation: first allow-end last;
    padding-bottom: calc(var(--u) * 12);
  }
  .mg * { box-sizing: border-box; }
  .mg-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    max-width: 90rem;
    margin-inline: auto;
    padding-left: var(--margin);
    padding-right: max(3rem, env(safe-area-inset-right, 0px));
  }
  .mg-grid > * { grid-column: 1 / -1; min-width: 0; }
  @media (min-width: 48rem) {
    .mg-grid > [data-c] { grid-column: var(--c); }
  }
  @media (max-width: 47.99rem) {
    .mg { --gutter: 1rem; --t-lead: 1.25rem; }
    .mg-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding-left: max(1rem, env(safe-area-inset-left, 0px));
      padding-right: max(1rem, env(safe-area-inset-right, 0px));
    }
  }

  /* The six sizes. */
  .mg-h1 {
    font-family: var(--font-heading);
    font-size: var(--t-h1);
    line-height: 1;
    /* Set solid, rounded up to whole units so what follows stays on the baseline. */
    line-height: round(up, var(--t-h1), var(--u));
    font-weight: 700;
    letter-spacing: -0.035em;
    margin: 0;
    padding-top: calc(var(--u) * 9);
    text-wrap: balance;
    color: var(--accent);
  }
  .mg-h3 {
    font-family: var(--font-heading);
    font-size: var(--t-h3);
    line-height: calc(var(--u) * 4);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .mg-lead {
    font-size: var(--t-lead);
    line-height: calc(var(--u) * 4);
    margin: calc(var(--u) * 3) 0 0;
    max-width: 34em;
    text-wrap: pretty;
  }
  .mg-cap, .mg-note, .mg-notes, .mg-table, .mg-facts__dl, .mg-run, .mg-turn, .mg-trialnote {
    font-size: var(--t-cap);
    line-height: calc(var(--u) * 2);
  }
  /* Small capitals, as labels: the caption size, spaced, never a size of its own. */
  .mg-sc {
    font-family: var(--font-heading);
    font-size: var(--t-cap);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .mg-tab, .mg-num { font-variant-numeric: lining-nums tabular-nums; }
  .mg a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .mg a:hover { color: var(--accent); }

  /* The running head. */
  .mg-run {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 30;
    background: var(--color-white, #fff);
    /* Rules are drawn, not bordered: a border adds a pixel and walks everything below off the baseline. */
    box-shadow: inset 0 -1px 0 var(--rule);
  }
  .mg-run__in > p { margin: 0; padding-block: var(--u); }
  .mg-run__here { font-family: var(--font-heading); font-weight: 600; }
  .mg-num { color: var(--accent); margin-right: 0.35em; }
  .mg-run__book a { text-decoration: none; }
  .mg-run__tools { text-align: right; }
  .mg-gridbtn {
    font: inherit;
    font-family: var(--font-heading);
    font-weight: 600;
    background: none;
    border: 0;
    padding: 0;
    color: var(--ink);
    cursor: pointer;
  }
  .mg-gridbtn kbd {
    font: inherit;
    border: 1px solid currentColor;
    padding: 0 0.3em;
    margin-left: 0.3em;
  }
  .mg-gridbtn[aria-pressed='true'] { color: var(--accent); }
  @media (max-width: 47.99rem) {
    .mg-run__book { display: none; }
    .mg-run__in { grid-template-columns: 1fr auto; }
    .mg-run__in > * { grid-column: auto; }
  }

  /* The facts. */
  .mg-head { padding-bottom: calc(var(--u) * 6); }
  .mg-facts__dl {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    column-gap: var(--gutter);
    margin: 0;
    box-shadow: inset 0 1px 0 var(--rule);
    /* Label and value on one baseline, whatever their typefaces' metrics. */
    align-items: baseline;
  }
  .mg-facts__dl dt, .mg-facts__dl dd {
    margin: 0;
    padding-block: var(--u);
    box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--rule) 25%, transparent);
  }
  .mg-facts__dl dt {
    font-family: var(--font-heading);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Figures. */
  .mg-fig { margin: 0; padding-top: calc(var(--u) * 9); row-gap: var(--u); }
  .mg-fig figure { margin: 0; }
  /* A picture hugs the column line it starts on (the far one, on a plate set to the left), at its own shape. */
  .mg-fig__pic { display: flex; align-items: flex-end; }
  .mg-fig__pic img, .mg-fig__pic video { display: block; width: auto; max-width: 100%; height: auto; max-height: 82vh; }
  .mg-fig--pair .mg-fig__pic img { width: 100%; }
  .mg-fig--full:not(:has(.mg-cap--beside)) .mg-fig__pic img { width: 100%; object-fit: contain; object-position: left bottom; }
  .mg-fig--wide.mg-fig--l .mg-fig__pic { justify-content: flex-end; }
  .mg-cap { margin: 0; color: var(--quiet); text-wrap: pretty; }
  .mg-cap .mg-sc { color: var(--ink); margin-right: 0.5em; }
  @media (min-width: 48rem) {
    .mg-fig--wide { align-items: end; }
    .mg-fig--wide .mg-cap { grid-row: 1; padding-bottom: calc(var(--u) * 0); }
    .mg-fig--wide.mg-fig--l .mg-cap { text-align: left; }
    .mg-fig--pair figure .mg-cap { margin-top: var(--u); }
    .mg-fig--full .mg-cap { margin-top: 0; }
    .mg-fig--full { align-items: end; }
    .mg-fig--full .mg-cap--beside { grid-row: 1; }
  }
  .mg-fig--pair figure .mg-cap { margin-top: var(--u); }

  /* The essay and its notes. */
  .mg-essay { padding-top: calc(var(--u) * 9); }
  .mg-text p { margin: 0 0 calc(var(--u) * 3); text-wrap: pretty; }
  .mg-text ul, .mg-text ol { margin: 0 0 calc(var(--u) * 3); padding-left: 1.2em; }
  .mg-text h2, .mg-text h3 { font-family: var(--font-heading); font-size: var(--t-lead); line-height: calc(var(--u) * 4); margin: calc(var(--u) * 3) 0; }
  .mg-notes { color: var(--quiet); padding-top: calc(var(--u) * 0.5); }
  .mg-notes ul { list-style: none; margin: var(--u) 0 calc(var(--u) * 3); padding: 0; }
  .mg-notes li { margin: 0 0 var(--u); }
  .mg-note__role { display: block; color: var(--ink); }
  .mg-note { margin: 0; }
  .mg-notes .mg-sc { color: var(--ink); margin: 0; }
  @media (max-width: 47.99rem) {
    .mg-notes { order: 2; padding-top: calc(var(--u) * 3); }
  }

  /* Tables: the works, and the index. */
  .mg-works { padding-top: calc(var(--u) * 12); }
  .mg-table { width: 100%; border-collapse: collapse; }
  .mg-table tr { vertical-align: baseline; }
  .mg-table th, .mg-table td {
    text-align: left;
    vertical-align: top;
    padding: var(--u) calc(var(--u) * 2) var(--u) 0;
    box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--rule) 25%, transparent);
  }
  .mg-table thead th {
    font-family: var(--font-heading);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    box-shadow: inset 0 1px 0 var(--rule), inset 0 -1px 0 var(--rule);
  }
  .mg-table th button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    cursor: pointer;
  }
  .mg-table th[aria-sort='ascending'] button::after { content: ' \2191'; }
  .mg-table th[aria-sort='descending'] button::after { content: ' \2193'; }
  .mg-table tr.is-study td { font-weight: 600; color: var(--accent); }
  .mg-index { padding-top: calc(var(--u) * 6); }
  .mg-index__wrap { overflow-x: auto; }
  .mg-table--index { min-width: 44rem; }
  .mg-index__thumb { width: calc(var(--u) * 8); }
  .mg-index__thumb img { display: block; width: calc(var(--u) * 6); height: calc(var(--u) * 6); object-fit: contain; }
  .mg-table--index td { padding-block: var(--u); }
  .mg-studies { padding-top: calc(var(--u) * 3); }
  .mg-studies__list { list-style: none; margin: 0; padding: 0; box-shadow: inset 0 1px 0 var(--rule); font-size: var(--t-lead); line-height: calc(var(--u) * 4); }
  .mg-studies__list a { display: flex; align-items: baseline; gap: calc(var(--u) * 3); padding-block: var(--u); box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--rule) 25%, transparent); text-decoration: none; font-family: var(--font-heading); font-weight: 600; }
  .mg-studies__list .mg-tab { color: var(--accent); min-width: 3.5em; }
  .mg-studies__year { margin-left: auto; color: var(--quiet); font-weight: 400; }

  /* Turning the page. */
  .mg-turn { padding-top: calc(var(--u) * 12); }
  .mg-turn a { display: block; padding-block: var(--u); box-shadow: inset 0 1px 0 var(--rule); text-decoration: none; font-family: var(--font-heading); font-size: var(--t-lead); line-height: calc(var(--u) * 4); font-weight: 600; }
  .mg-turn a .mg-sc { display: block; color: var(--quiet); }
  .mg-turn__next { text-align: right; }
  .mg-trialnote { color: var(--quiet); padding-top: calc(var(--u) * 6); }
  .mg-visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /*
    The grid, shown (G): the columns as faint bands, the baseline every 8px,
    with every third line - the body's - a little darker.
  */
  .mg-show-grid .mg { position: relative; }
  .mg-show-grid .mg::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 40;
    background:
      repeating-linear-gradient(to bottom, rgb(0 40 133 / 0.18) 0 1px, transparent 1px calc(var(--u) * 3)),
      repeating-linear-gradient(to bottom, rgb(0 40 133 / 0.06) 0 1px, transparent 1px var(--u));
  }
  .mg-show-grid .mg-grid { position: relative; }
  .mg-show-grid .mg-grid::before {
    content: '';
    position: absolute;
    inset: 0;
    margin-left: var(--margin);
    margin-right: max(3rem, env(safe-area-inset-right, 0px));
    pointer-events: none;
    z-index: 41;
    background: repeating-linear-gradient(
      to right,
      rgb(228 0 43 / 0.07) 0 calc((100% - 11 * var(--gutter)) / 12),
      transparent calc((100% - 11 * var(--gutter)) / 12) calc((100% - 11 * var(--gutter)) / 12 + var(--gutter))
    );
  }
  @media (max-width: 47.99rem) {
    .mg-show-grid .mg-grid::before {
      margin-left: max(1rem, env(safe-area-inset-left, 0px));
      margin-right: max(1rem, env(safe-area-inset-right, 0px));
      background: repeating-linear-gradient(
        to right,
        rgb(228 0 43 / 0.07) 0 calc((100% - 3 * var(--gutter)) / 4),
        transparent calc((100% - 3 * var(--gutter)) / 4) calc((100% - 3 * var(--gutter)) / 4 + var(--gutter))
      );
    }
  }
</style>

<script>
  // Every [data-c] places itself on the grid: {...at('4 / 10')} is columns 4 to 10.
  document.querySelectorAll<HTMLElement>('.mg [data-c]').forEach((el) => el.style.setProperty('--c', el.dataset.c!));

  // The grid, shown and hidden: G, or the button. Remembered for the visit.
  const btn = document.getElementById('mg-gridbtn');
  const set = (on: boolean) => {
    document.documentElement.classList.toggle('mg-show-grid', on);
    btn?.setAttribute('aria-pressed', String(on));
    try {
      sessionStorage.setItem('mg-grid', on ? '1' : '');
    } catch {}
  };
  try {
    if (sessionStorage.getItem('mg-grid')) set(true);
  } catch {}
  btn?.addEventListener('click', () => set(!document.documentElement.classList.contains('mg-show-grid')));
  addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key.toLowerCase() !== 'g' || e.metaKey || e.ctrlKey || e.altKey || t.closest('input, textarea, select, [contenteditable]')) return;
    set(!document.documentElement.classList.contains('mg-show-grid'));
  });

  // The index, sorted by any column; the catalogue number keeps the original order.
  const table = document.getElementById('mg-index') as HTMLTableElement | null;
  if (table) {
    const body = table.tBodies[0];
    table.querySelectorAll<HTMLButtonElement>('th button[data-sort]').forEach((b) =>
      b.addEventListener('click', () => {
        const col = Number(b.dataset.sort);
        const th = b.closest('th')!;
        const dir = th.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
        table.querySelectorAll('th').forEach((h) => h.removeAttribute('aria-sort'));
        th.setAttribute('aria-sort', dir);
        const key = (tr: HTMLTableRowElement) => tr.cells[col].textContent!.trim();
        const rowsNow = Array.from(body.rows);
        rowsNow.sort((a, z) => {
          const ka = key(a);
          const kz = key(z);
          // A dash (no value) always last.
          if (ka === '—' || kz === '—') return ka === kz ? 0 : ka === '—' ? 1 : -1;
          const c = ka.localeCompare(kz, undefined, {numeric: true});
          return dir === 'ascending' ? c : -c;
        });
        body.append(...rowsNow);
      }),
    );
  }
</script>
