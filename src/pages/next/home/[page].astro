---
/*
  THE HOMEPAGE AS A LOOKBOOK - preview only, at /next/home/lookbook: the
  homepage with Lookbook.astro in place of the field, to set beside the
  homepage itself. Chris: "man we're really lacking in good looks in the
  mobile". Never built for production (getStaticPaths), and noindex.
*/
import Layout from '../../../layouts/Layout.astro';
import WorkFirst from '../../../components/home/WorkFirst.astro';
import {getSiteSettings, getFeaturedWork} from '../../../lib/queries';

export async function getStaticPaths() {
  if (import.meta.env.PUBLIC_IS_PREVIEW !== 'true') return [];
  return [{params: {page: 'lookbook'}}];
}

const settings = await getSiteSettings();
const featuredWork = await getFeaturedWork(8);
const CONTACT_URL = settings?.contactUrl || '/contact';
const bioText =
  settings?.bioText ||
  'Chris Rumeau is a brand designer, illustrator, and typographer building visual ' +
    'identities rooted in heritage craft and hand-drawn precision.';
---

<Layout title="The homepage as a lookbook - Rumeau Design Co" description="The apparel work, one project at a time." noindex>
  <WorkFirst settings={settings} contactUrl={CONTACT_URL} bioText={bioText} featured={featuredWork} look />
</Layout>
