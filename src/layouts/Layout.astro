---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Rumeau Design Co' } = Astro.props;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/portfolio' },
  { label: 'Merch', href: '/merchfolio' },
  { label: 'Collage', href: '/collage' },
  { label: 'Process', href: '/video' },
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="wrap">
      <nav class="site-nav">
        <a class="site-nav__brand" href="/">Rumeau Design Co</a>
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>&copy; {new Date().getFullYear()} Rumeau Design Co.</p>
      </div>
    </footer>
  </body>
</html>
