---
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import { getPage, getMerchItems } from '../lib/queries';

const page = await getPage('merchfolio');
const items = await getMerchItems();

function linkFor(item: any) {
  if (item.pageType === 'Case Study') return `/work/${item.slug.current}`;
  if (item.parentSlug) return `/work/${item.parentSlug}`;
  return '/portfolio';
}
---

<Layout title={page?.title ?? 'Merch Portfolio'} description={page?.seoDescription}>
  <h1>{page?.heading ?? page?.title ?? 'Merch Portfolio'}</h1>
  <div class="grid">
    {items.map((item: any) => (
      <a class="card" href={linkFor(item)}>
        {(item.thumbnail || item.mainImage) && (
          <Img
            image={item.thumbnail || item.mainImage}
            alt={item.title}
            width={600}
            height={600}
            sizes="(max-width: 40rem) 50vw, 25vw"
          />
        )}
        <p class="card__title">{item.title}</p>
      </a>
    ))}
  </div>
</Layout>
