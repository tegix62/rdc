---
/*
  THE LOOKBOOK - the homepage's apparel work as an edited sequence, tried at
  /next/home/lookbook on the preview. Chris, of the field on his phone: "man
  we're really lacking in good looks in the mobile". The field put cut-out
  shirts, photographs, marks and numbers edge to edge on white at every
  scale; this gives each project room:

    - its lead garment large, on a paper-toned panel (a cut-out reads as a
      product on it; a photograph fills it);
    - the project's name, and its result in plain type, under it;
    - a row of up to three of its other pieces, one size, the same panel;
    - the same space between every project.

  One column on a phone, two on a wide screen. The clusters come from
  WorkFirst (its apparel mix), in Chris's order.
*/
import Img from '../Img.astro';
import {tileImage} from '../../lib/image';

export interface LookPiece {
  item: any;
  title: string;
  /** A photograph (fills its panel) rather than a cut-out or a mark (sits in it). */
  photo: boolean;
}
export interface LookCluster {
  name: string;
  href: string | null;
  count: number;
  hero: LookPiece;
  more: LookPiece[];
  result: {stat: string; rest: string} | null;
}
interface Props {
  clusters: LookCluster[];
}
const {clusters} = Astro.props;
---

<div class="lb">
  {clusters.map((c, n) => (
    <article class="lb-item">
      {c.href ? (
        <a class:list={['lb-panel', 'lb-hero', c.hero.photo && 'is-photo']} href={c.href} aria-label={c.name}>
          <Img image={tileImage(c.hero.item)} alt="" altFallback={c.hero.title} width={900} sizes="(min-width: 48rem) 45vw, 92vw" loading={n < 2 ? 'eager' : 'lazy'} field="Grid Thumbnail (lookbook)" />
        </a>
      ) : (
        <div class:list={['lb-panel', 'lb-hero', c.hero.photo && 'is-photo']}>
          <Img image={tileImage(c.hero.item)} alt="" altFallback={c.hero.title} width={900} sizes="(min-width: 48rem) 45vw, 92vw" loading={n < 2 ? 'eager' : 'lazy'} field="Grid Thumbnail (lookbook)" />
        </div>
      )}
      <div class="lb-meta">
        <h3 class="lb-name">{c.href ? <a href={c.href}>{c.name}</a> : c.name}</h3>
        {c.count > 1 && <span class="lb-count">{c.count} pieces</span>}
      </div>
      {c.result && (
        <p class="lb-result">
          <b>{c.result.stat}</b> {c.result.rest}
        </p>
      )}
      {c.more.length > 0 && (
        <ul class="lb-more" style={`--n:${c.more.length}`}>
          {c.more.map((m) => (
            <li class:list={['lb-panel', m.photo && 'is-photo']}>
              <Img image={tileImage(m.item)} alt="" altFallback={m.title} width={400} sizes="(min-width: 48rem) 15vw, 30vw" loading="lazy" field="Grid Thumbnail (lookbook)" />
            </li>
          ))}
        </ul>
      )}
    </article>
  ))}
</div>

<style>
  .lb {
    --lb-paper: #f2f0eb;
    --lb-gap: 0.5rem;
    display: grid;
    gap: 3rem;
    padding: var(--space-2, 1rem) var(--space-2, 1rem) var(--space-5, 3rem);
  }
  @media (min-width: 48rem) {
    .lb {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-4, 2rem);
      row-gap: 4rem;
      max-width: var(--content-width, 75rem);
      margin: 0 auto;
      padding-inline: var(--space-3, 1.5rem);
    }
  }
  .lb-item {
    display: grid;
    gap: var(--lb-gap);
    align-content: start;
  }
  .lb-panel {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--lb-paper);
  }
  .lb-panel :global(img) {
    position: absolute;
    inset: 9%;
    width: 82%;
    height: 82%;
    object-fit: contain;
  }
  .lb-panel.is-photo :global(img) {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lb-hero {
    aspect-ratio: 4 / 5;
  }
  .lb-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .lb-name {
    margin: 0;
    font: 800 1.25rem / 1.1 var(--font-heading);
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }
  .lb-name a {
    color: inherit;
    text-decoration: none;
  }
  .lb-count {
    flex: 0 0 auto;
    font-size: 0.8125rem;
    color: var(--color-gray);
  }
  .lb-result {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--color-ink);
  }
  .lb-result b {
    font-family: var(--font-heading);
    font-weight: 800;
    color: var(--color-navy);
  }
  .lb-more {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--lb-gap);
  }
  .lb-more li {
    aspect-ratio: 1;
  }
</style>
