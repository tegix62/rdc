---
import Layout from '../layouts/Layout.astro';
import Sections from '../components/Sections.astro';
import Panorama from '../components/Panorama.astro';
import { sanityClient } from '../lib/sanity';

const colors = [
  { name: 'Brand Navy', value: '#002885', var: '--color-navy' },
  { name: 'Navy (hover/dark)', value: '#001c5e', var: '--color-navy-dark' },
  { name: 'White', value: '#ffffff', var: '--color-white' },
  { name: 'Light Gray', value: '#f4f4f4', var: '--color-gray-light' },
  { name: 'Gray (meta text)', value: '#666666', var: '--color-gray' },
  { name: 'Ink (body text)', value: '#1a1a1a', var: '--color-ink' },
  { name: 'Black', value: '#000000', var: '--color-black' },
];
/*
  Fixtures for every layout block, rendered through the real Sections component.

  Why this page and not a real case study: a new block that nothing uses is a
  block nobody has seen. Media Row and Media + Text were shipped correct as far
  as type-checking goes, and that says nothing about whether they render, whether
  a video sits properly beside text, or whether three items across overflow on a
  phone. Seeding Chris's live case studies to find out would mean editing his
  content to test my code.

  Sections takes a plain array, so fixtures need no Sanity query at all. The
  asset references below are real files from the dataset, chosen on purpose:

  - the two GIFs are confirmed animated by scripts/audit-animated.mjs, so a row
    of them exercises the pass-through path rather than a static stand-in. The
    400x400 one is the file the transform pipeline turns from 867 KB into
    4,374 KB, which makes it the best possible canary.
  - the videos are the Vimeo and YouTube embeds already used elsewhere on the
    site, so both providers get covered.

  The page audit loads /style-guide at both widths, so these get checked for
  sideways scroll and weight on every run.
*/
const ref = (id: string) => ({_type: 'image', asset: {_type: 'reference', _ref: id}});

const ANIMATED_GIF_A = 'image-84932c87f8d266a2d3c30330f2797e46e86308c2-1080x1080-gif';
const ANIMATED_GIF_B = 'image-7699f292fa859c7d126fd3aafe76eaf7eb0ac579-400x400-gif';
const STATIC_IMAGE = 'image-b3834b3ffbcf2783a337743475cd2041ff0aceb9-1080x1080-webp';

/*
  Two Point Oh's three posters - the actual row that made the automatic slot
  shape necessary. Portrait, and NOT the same portrait: 0.800, 0.750, 0.801.

  Fixtures of one shape cannot show what a slot does, because every slot
  suits them. These three disagree just enough to make the difference
  visible, and they are the content Chris was looking at, so the row on this
  page is the row on his page.
*/
const POSTER_800 = 'image-dbb0c8ff444a0602ea6bc9c3f9e0ad458b3895b3-2400x3000-webp';
const POSTER_750 = 'image-329248a1d3eec375b842d0adb19e4a070ebf4a04-2160x2880-jpg';
const POSTER_801 = 'image-a88128a09e8c208c4194e58e69c298ee911f572a-800x999-gif';

const VIMEO = 'https://player.vimeo.com/video/1044782545';
const YOUTUBE = 'https://www.youtube.com/watch?v=plYFXjoViKI';

/*
  A real uploaded video for the autoplay fixture.

  The self-hosted branch needs an actual file, and a fabricated URL would 404
  and prove nothing. This used to borrow an MP4 from animatedVideoMap - the
  GIF-to-video conversion - but that feature has been removed, so it now takes
  any real MP4 file asset in the dataset. Which means it starts exercising the
  autoplay path properly the moment a hand-uploaded clip exists, rather than
  depending on a converter that is gone.

  Resolves to null when the dataset holds no MP4, and the fixture is skipped.
*/
const uploaded = await sanityClient.fetch<{mp4?: string; webm?: string} | null>(
  `*[_type == "sanity.fileAsset" && extension == "mp4"] | order(_createdAt desc)[0]{
    "mp4": url,
    "webm": null
  }`,
);

const blockFixtures = [
  {
    _type: 'mediaRowSection',
    _key: 'row-three-animated',
    heading: 'Three across, two of them animated',
    items: [
      {_type: 'mediaImage', _key: 'a', image: {...ref(ANIMATED_GIF_A), alt: 'Animated logo loop'}, caption: 'Animated GIF'},
      {_type: 'mediaImage', _key: 'b', image: {...ref(ANIMATED_GIF_B), alt: 'Animated print mockup'}, caption: 'Animated GIF'},
      {_type: 'mediaImage', _key: 'c', image: {...ref(STATIC_IMAGE), alt: 'Static brand sheet'}, caption: 'Static image'},
    ],
  },
  /*
    The three Layout modes, on identical content, so the difference is the
    setting and nothing else.

    Same three images in the same order each time - a square, a square and a
    landscape - because the whole question is what a row does when the items
    do NOT share a shape, and that is invisible if the fixtures are uniform.
    Nothing in Studio uses these settings yet, so without this the feature
    would ship unseeable, which is the reason this page exists.

    The two rows after them carry real posters instead, and exist to show the
    slot SHAPE rather than the layout mode - automatic against imposed.
  */
  {
    _type: 'mediaRowSection',
    _key: 'row-layout-shape',
    heading: 'Layout: sized by shape (the default) - widths follow each image',
    items: [
      {_type: 'mediaImage', _key: 'a', image: {...ref(STATIC_IMAGE), alt: 'Square source'}},
      {_type: 'mediaImage', _key: 'b', image: {...ref(ANIMATED_GIF_A), alt: 'Square source'}},
      {_type: 'mediaImage', _key: 'c', image: {...ref(ANIMATED_GIF_B), alt: 'Square source'}},
    ],
  },
  {
    _type: 'mediaRowSection',
    _key: 'row-layout-fit',
    rowLayout: 'fit',
    /*
      SQUARE slots for square sources, which is the rule this mode lives or
      dies by: match the slot to the content.

      This demo was 4:5, and with these square fixtures that is the worst
      possible pairing - every image letterboxed to 467x467 inside a 583-tall
      slot, banded top and bottom, reading as though the pictures had been
      shrunk for no reason. The geometry was right (nothing is ever stretched
      - measured, a circle stays circular) but the demonstration made a
      correct mode look broken, which is worse than not demonstrating it.

      Mismatch mattes, it does not crop. That is the whole point of "fit" and
      it is the right behaviour for a mark or a poster whose edges matter -
      but it is a fallback for when the shape cannot be helped, not a look to
      design towards.
    */
    cellShape: '1 / 1',
    heading: 'Layout: equal slots, images sit inside - square (1:1) slots matching square sources, nothing cropped',
    items: [
      {_type: 'mediaImage', _key: 'a', image: {...ref(STATIC_IMAGE), alt: 'Square source'}},
      {_type: 'mediaImage', _key: 'b', image: {...ref(ANIMATED_GIF_A), alt: 'Square source'}},
      {_type: 'mediaImage', _key: 'c', image: {...ref(ANIMATED_GIF_B), alt: 'Square source'}},
    ],
  },
  {
    _type: 'mediaRowSection',
    _key: 'row-layout-fill',
    rowLayout: 'fill',
    cellShape: '3 / 2',
    /*
      Deliberately the mismatched case, and the counterpart to the row above:
      the same square sources in landscape slots. "fill" crops them to the
      slot; "fit" would have matted them. Between the two rows you can see
      what each does with a shape that is not the slot's.
    */
    heading: 'Layout: equal slots, images fill - landscape (3:2) slots, square sources cropped to fit',
    items: [
      {_type: 'mediaImage', _key: 'a', image: {...ref(STATIC_IMAGE), alt: 'Square source'}},
      {_type: 'mediaImage', _key: 'b', image: {...ref(ANIMATED_GIF_A), alt: 'Square source'}},
      {_type: 'mediaImage', _key: 'c', image: {...ref(ANIMATED_GIF_B), alt: 'Square source'}},
    ],
  },
  /*
    THE DEFAULT, on the content that proved it was needed.

    No cellShape, so the slots take the widest poster's ratio. Measured at
    1440px: three 443x553 slots, every poster at the row's full height, and
    the only space added is beside the 0.750 one. Compare the row below it,
    which is what a fixed 3:2 default did to the same three - 443x295, under
    half the area, banded either side of all three. Nothing was ever
    stretched in either; the difference is entirely which shape the row was
    told to be.
  */
  {
    _type: 'mediaRowSection',
    _key: 'row-layout-auto',
    rowLayout: 'fit',
    heading: 'Layout: equal slots, automatic slot shape (the default) - three posters of three portrait ratios',
    items: [
      {_type: 'mediaImage', _key: 'a', image: {...ref(POSTER_800), alt: 'Poster, 4:5'}},
      {_type: 'mediaImage', _key: 'b', image: {...ref(POSTER_750), alt: 'Poster, 3:4'}},
      {_type: 'mediaImage', _key: 'c', image: {...ref(POSTER_801), alt: 'Poster, roughly 4:5'}},
    ],
  },
  {
    _type: 'mediaRowSection',
    _key: 'row-layout-auto-overridden',
    rowLayout: 'fit',
    cellShape: '3 / 2',
    heading: 'The same three in imposed landscape (3:2) slots - what a fixed default cost them',
    items: [
      {_type: 'mediaImage', _key: 'a', image: {...ref(POSTER_800), alt: 'Poster, 4:5'}},
      {_type: 'mediaImage', _key: 'b', image: {...ref(POSTER_750), alt: 'Poster, 3:4'}},
      {_type: 'mediaImage', _key: 'c', image: {...ref(POSTER_801), alt: 'Poster, roughly 4:5'}},
    ],
  },
  {
    _type: 'mediaRowSection',
    _key: 'row-two-videos',
    heading: 'Two videos side by side',
    items: [
      {_type: 'mediaVideo', _key: 'a', url: VIMEO, caption: 'Vimeo'},
      {_type: 'mediaVideo', _key: 'b', url: YOUTUBE, caption: 'YouTube'},
    ],
  },
  {
    _type: 'mediaRowSection',
    _key: 'row-mixed',
    heading: 'A video beside a mockup',
    items: [
      {_type: 'mediaVideo', _key: 'a', url: YOUTUBE, caption: 'Walkthrough'},
      {_type: 'mediaImage', _key: 'b', image: {...ref(STATIC_IMAGE), alt: 'Mobile mockup'}, caption: 'Mockup'},
    ],
  },
  {
    _type: 'mediaTextSection',
    _key: 'mt-video',
    videoUrl: VIMEO,
    mediaPosition: 'Left',
    heading: 'Media + Text, with a video',
    text: 'The video replaces the image when a URL is set, the same rule a case study hero uses.',
  },
  ...(uploaded?.mp4
    ? [
        {
          _type: 'mediaRowSection',
          _key: 'row-autoplay',
          /*
            Named for both states, because the left-hand clip genuinely has
            two and the caption used to assert only one. Anyone with "reduce
            motion" on saw a still frame under the words "autoplaying
            silently on a loop" - a style guide describing behaviour the
            viewer is not getting is worse than no caption, since the natural
            reading is that the feature is broken.
          */
          heading: 'Uploaded file: set to autoplay, beside the same file set to click',
          items: [
            {
              _type: 'mediaVideo',
              _key: 'a',
              videoFile: {asset: {url: uploaded.mp4}},
              videoWebm: uploaded.webm ? {asset: {url: uploaded.webm}} : undefined,
              videoPlayback: 'autoplay',
              caption:
                'Autoplay: muted, looping, no player script. With "reduce motion" on it holds still and the pill reads Play - that is the setting working, not a failure.',
            },
            {
              _type: 'mediaVideo',
              _key: 'b',
              videoFile: {asset: {url: uploaded.mp4}},
              videoPlayback: 'click',
              caption: 'Same file, click to play with the browser’s own controls',
            },
          ],
        },
      ]
    : []),
  {
    _type: 'mediaTextSection',
    _key: 'mt-image',
    image: {...ref(STATIC_IMAGE), alt: 'Brand sheet detail'},
    mediaPosition: 'Right',
    heading: 'Media + Text, image on the right',
    text: 'Same block with no video URL, and the media half flipped to the right.',
  },
];
---

{/* noindex: this is an internal reference page, not part of the site. It is
    already left out of sitemap.xml, but production robots.txt allows the whole
    site, so nothing but obscurity was keeping it out of search results. */}
<Layout title="Style Guide" description="Rumeau Design Co design tokens" noindex>
  <h1>Style Guide</h1>
  <p class="style-guide-note">
    Pulled from what's actually applied on rumeaudesign.co's real headings,
    buttons, nav, and links - not the unused component-library colors also
    sitting in the Webflow project.
  </p>

  <h2>Colors</h2>
  <div>
    {colors.map((c) => (
      <div class="swatch">
        <div class="swatch__color" style={`background:${c.value}`}></div>
        <div>
          <strong>{c.name}</strong> - <code>{c.value}</code>
          <div class="card__meta"><code>var({c.var})</code></div>
        </div>
      </div>
    ))}
  </div>

  <h2>Type</h2>
  <p>
    Headings: <strong>Inter Tight</strong> (700). Body copy:{' '}
    <strong>Gothic A1</strong>.
  </p>
  {/*
      Specimens, not headings. These were real <h1>-<h5> tags, which gave this
      page two <h1> elements and a document outline claiming a type sample was
      a section of the page. The .t-* classes carry the identical rules - see
      global.css - so nothing about how this looks has changed.
  */}
  <p class="t-h1">Heading 1 - 3.5rem</p>
  <p class="t-h2">Heading 2 - 3rem</p>
  <p class="t-h3">Heading 3 - 2.5rem</p>
  <p class="t-h4">Heading 4 - 2rem</p>
  <p class="t-h5">Heading 5 - 1.5rem</p>
  <p class="style-guide-note">
    Body copy sets in Gothic A1 at a comfortable reading size, used for
    paragraphs, case study details, and blog posts across the site.
  </p>

  <h2>Buttons &amp; Links</h2>
  <p>
    <a href="#">A standard text link</a>
  </p>
  <p>
    <a class="button" href="#">A button</a>
  </p>

  <h2>Cards</h2>
  <div class="grid">
    <div class="card">
      <div class="swatch__color" style="background:#f4f4f4; width:100%; aspect-ratio:4/5;"></div>
      <p class="card__title">Card Title</p>
      <p class="card__meta">Card meta text</p>
    </div>
  </div>

  <h2>Layout blocks</h2>
  <p class="style-guide-note">
    Every block available in Studio, rendered with fixture content. Two of the
    GIFs below are genuinely animated files from the dataset, so this also
    checks that animated sources bypass the resize pipeline.
  </p>
  <p class="style-guide-note">
    <strong>Your motion setting:</strong>
    <span class="reduce-motion__off">
      normal — the autoplay clip below should start on its own, with a Pause
      control.
    </span>
    <span class="reduce-motion__on">
      <strong>reduce motion is ON</strong> — autoplay is disabled here by
      design, so that clip holds still and offers a Play control instead.
      Nothing is broken; turn the system setting off to see it autoplay.
    </span>
  </p>
  <Sections sections={blockFixtures} />

  <h2>Panorama (prototype)</h2>
  <p class="style-guide-note">
    Artwork sliced into layers that drift past each other as the section
    crosses the viewport. Nothing in Studio makes one of these yet — this is
    here to be scrolled on a real phone before a CMS block gets built around
    it, so the shape of the data can be decided from the feel rather than
    guessed at. The slices are placeholders from <code>public/parallax-demo/</code>
    and are labelled with their own depth so it is obvious which layer is
    doing what.
  </p>
  <p class="style-guide-note">
    No JavaScript: it runs on <code>animation-timeline</code>, the same
    mechanism as the fade-and-rise on cards. Where that is unsupported, or
    where reduced motion is requested, the layers hold still at the midpoint of
    their travel — which is why the still composition has to be the design and
    the movement the bonus.
  </p>
  <p class="style-guide-note">
    <strong>This browser:</strong>
    <span class="panorama-support__yes">
      supports scroll-driven animation — the layers below should drift as you
      scroll past them. If they look static, the effect is too weak rather than
      missing.
    </span>
    <span class="panorama-support__no">
      has no scroll-driven animation — you are seeing the still composition,
      which is the fallback working as intended, not a bug. Nothing here will
      move however far you scroll.
    </span>
  </p>
  <Panorama
    label="Placeholder panorama: four layers drifting at different depths"
    caption="Placeholder slices — depth 0 / 4 / 10 / 22"
    layers={[
      { src: '/parallax-demo/layer-1-sky.svg', depth: 0 },
      { src: '/parallax-demo/layer-2-far.svg', depth: 4 },
      { src: '/parallax-demo/layer-3-mid.svg', depth: 10 },
      { src: '/parallax-demo/layer-4-near.svg', depth: 22 },
    ]}
  />
</Layout>
