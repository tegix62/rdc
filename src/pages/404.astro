---
import Layout from '../layouts/Layout.astro';
import { getSiteSettings } from '../lib/queries';

const settings = await getSiteSettings();
const CONTACT_URL = settings?.contactUrl || '/contact';

const routes = [
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/video', label: 'Video' },
  { href: '/merchfolio', label: 'Merch' },
  { href: '/collage', label: 'Collage' },
  { href: '/blog', label: 'Blog' },
];
---

<Layout
  title="Page Not Found"
  description="That page doesn't exist. Here's the way back to the work."
>
  <div class="not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__heading">Nothing here.</h1>
    <p class="not-found__body">
      That page has moved or never existed. The work is all still here&mdash;pick a lane.
    </p>

    <nav class="not-found__nav" aria-label="Site pages">
      {routes.map((route) => (
        <a class="not-found__link" href={route.href}>{route.label}</a>
      ))}
    </nav>

    <p class="not-found__fallback">
      Or just <a href={CONTACT_URL}>tell me what you were looking for</a>.
    </p>
  </div>
</Layout>

<style>
  .not-found {
    text-align: center;
    padding: var(--space-6) 0;
    max-width: 36rem;
    margin: 0 auto;
  }

  .not-found__code {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(6rem, 20vw, 12rem);
    line-height: 1;
    color: var(--color-navy);
    margin: 0;
    letter-spacing: -0.04em;
    opacity: 0.12;
  }

  .not-found__heading {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-top: -0.5em;
  }

  .not-found__body {
    color: var(--color-gray);
    font-size: 1.0625rem;
    margin-top: var(--space-1);
  }

  .not-found__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: var(--space-4);
  }

  .not-found__link {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--color-navy);
    border: 1.5px solid var(--color-navy);
    padding: 0.5rem 1.25rem;
    transition: background 0.15s, color 0.15s;
  }

  .not-found__link:hover {
    background: var(--color-navy);
    color: var(--color-white);
  }

  .not-found__fallback {
    margin-top: var(--space-4);
    font-size: 0.9375rem;
    color: var(--color-gray);
  }

  .not-found__fallback a {
    color: var(--color-navy);
  }
</style>
