---
/*
  THE IDEAS, ON ONE PAGE - preview only, at /next/ideas/all: everything
  tried on the preview the night of 30-31 October 2026, so Chris can walk
  through them in the morning. Each says what it is, where it is, and what
  (if anything) it needs from him.

  Never built for production (getStaticPaths), and noindex.
*/
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  if (import.meta.env.PUBLIC_IS_PREVIEW !== 'true') return [];
  return [{params: {page: 'all'}}];
}

/*
  Chris's calls, 31 October 2026 - the full list, with his words, is
  IDEAS.md at the root of the repository. This page links what can be seen.
*/
const ideas = [
  {name: 'Copier mode', href: '/next/copier/mode', what: 'Kept - to become a secret button on the site.', needs: 'Where the button goes.'},
  {name: 'Lost in the copier (404)', href: '/this-page-does-not-exist', what: 'The 404 as a photocopy.', needs: 'Say live when happy.'},
  {name: 'Signed votes', href: '/portfolio?view=all&vote=1', what: 'Shelved for now - back very soon.', needs: 'The D1 DB binding on the preview; the privacy policy line.'},
  {name: 'The road', href: '/next/road/map', what: 'To develop: the illustrated, modular pieces.', needs: 'Drawings and stops in Studio.'},
  {name: 'Friend, where it works', href: '/next/friend/specimen', what: 'Shelved - good in spots, not fully working yet.', needs: 'Nothing now.'},
  {name: 'The yearly free one', href: '/next/free/one', what: 'Shelved.', needs: 'Nothing now.'},
  {name: 'The register', href: '/next/register/runs', what: 'Shelved - maybe folded into each case study instead.', needs: 'Nothing now.'},
  {name: 'An issue', href: '/next/issue/latest', what: 'Shelved.', needs: 'Nothing now.'},
];
---

<Layout title="The ideas, sorted - Rumeau Design Co" description="The ideas tried on the preview, sorted." noindex>
  <div class="id">
    <header class="id-head">
      <h1>The ideas, sorted</h1>
      <p>What can be seen of them, after Chris's calls on 31 October. The full list is IDEAS.md. Nothing here is live.</p>
    </header>
    <ol class="id-list">
      {ideas.map((i, n) => (
        <li>
          <span class="id-no">{String(n + 1).padStart(2, '0')}</span>
          <div>
            <h2><a href={i.href}>{i.name}</a></h2>
            <p>{i.what}</p>
            <p class="id-needs"><b>Needs:</b> {i.needs}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Layout>

<style>
  .id {
    max-width: 48rem;
    margin: 0 auto;
    padding: var(--space-5, 3rem) var(--space-4, 1.5rem) var(--space-6, 4rem);
  }
  .id-head h1 {
    margin: 0 0 0.5rem;
    font: 800 clamp(2.25rem, 6vw, 3.75rem) / 0.95 var(--font-heading);
    letter-spacing: -0.035em;
    color: var(--color-navy);
  }
  .id-head {
    margin-bottom: 2rem;
  }
  .id-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--color-navy);
  }
  .id-list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .id-no {
    font: 700 0.875rem/1.6 var(--font-heading);
    font-variant-numeric: tabular-nums;
    color: var(--color-gray);
  }
  .id-list h2 {
    margin: 0 0 0.35rem;
    font: 800 1.375rem/1.1 var(--font-heading);
    letter-spacing: -0.02em;
  }
  .id-list h2 a {
    color: var(--color-navy);
  }
  .id-list p {
    margin: 0 0 0.35rem;
    line-height: 1.5;
  }
  .id-needs {
    font-size: 0.875rem;
    color: var(--color-gray);
  }
  .id-needs b {
    color: var(--color-ink);
  }
</style>
