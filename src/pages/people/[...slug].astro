---
/*
  PEOPLE: everyone the work was made with, and what they did on it.

  Chris: "a big thing agencies would be looking for is like names
  involved", and after Eric Carter's piece on designer-as-celebrity, credit
  the room - "putting the work they are doing for the project" ahead of the
  designer. Read from each project's Credits panel (lib/credits.ts, the same
  reading that feeds the labels and the structured data) - no new field.
  The typeface credit is the foundry, not a person, so it is left out.

  One row a person: name (linked where the panel links it), what they did,
  and the projects they are on, each opening that project in the All view.

  Preview only while it is a trial: a rest route, so production builds
  none of it.
*/
import Layout from '../../layouts/Layout.astro';
import Img from '../../components/Img.astro';
import {sanityClient} from '../../lib/sanity';
import {contributorsOf} from '../../lib/credits';
import {stripStegaKey} from '../../lib/stega';

export function getStaticPaths() {
  return import.meta.env.PUBLIC_IS_PREVIEW === 'true' ? [{params: {slug: undefined}}] : [];
}

const studies: any[] = await sanityClient.fetch(
  `*[_type == "caseStudy" && pageType == "Case Study" && !(_id in path("drafts.**")) && defined(slug.current)]{
     title, "slug": slug.current, creditsText, credits, "image": coalesce(thumbnail, mainImage)
   } | order(orderRank asc)`,
);
const clean = (s: unknown) => stripStegaKey(s).replace(/\s+/g, ' ').trim();
type Person = {name: string; url?: string; roles: string[]; projects: {title: string; slug: string; image: any}[]};
const people = new Map<string, Person>();
for (const s of studies) {
  for (const c of contributorsOf(s)) {
    const name = clean(c.name);
    if (!name) continue;
    const key = name.toLowerCase();
    const p = people.get(key) ?? {name, roles: [], projects: []};
    if (!p.url && c.url) p.url = c.url;
    const role = clean(c.role);
    if (role && !p.roles.some((r) => r.toLowerCase() === role.toLowerCase())) p.roles.push(role);
    const slug = clean(s.slug);
    if (!p.projects.some((x) => x.slug === slug)) p.projects.push({title: clean(s.title), slug, image: s.image});
    people.set(key, p);
  }
}
const list = [...people.values()].sort((a, z) => z.projects.length - a.projects.length || a.name.localeCompare(z.name));
---

<Layout title="People - Rumeau Design Co" description="The people the work was made with: photographers, models, producers and collaborators, and the projects they are on.">
  <section class="pp">
    <header class="pp-head">
      <h1 class="pp-head__title">People</h1>
      <p class="pp-head__line">The work was made with these people. {list.length} of them, so far.</p>
    </header>
    <ul class="pp-list">
      {list.map((p) => (
        <li class="pp-row">
          <div class="pp-row__who">
            {p.url ? (
              <a class="pp-row__name" href={p.url} target="_blank" rel="noopener">
                {p.name}
              </a>
            ) : (
              <span class="pp-row__name">{p.name}</span>
            )}
            {p.roles.length > 0 && <span class="pp-row__roles">{p.roles.join(' · ')}</span>}
          </div>
          <ul class="pp-row__work">
            {p.projects.map((w) => (
              <li>
                <a href={`/portfolio?view=all&open=${w.slug}`} class="pp-work" title={w.title}>
                  {w.image?.asset && <Img image={w.image} alt="" width={160} sizes="64px" loading="lazy" field="thumbnail (people)" />}
                  <span class="pp-work__title">{w.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </section>
</Layout>
