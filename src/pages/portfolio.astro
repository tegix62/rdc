---
import Layout from '../layouts/Layout.astro';
import { pageDescription } from '../lib/meta';
import Img from '../components/Img.astro';
import InkMode from '../components/InkMode.astro';
import Sections from '../components/Sections.astro';
import { getPage, getAllGridItems } from '../lib/queries';
// Shared with the homepage's miniature grid, so the two cannot disagree about
// what counts as a logomark or how wide a hero tile is. See lib/tiles.ts.
import { cleanKey, treatmentOf, explicitTreatment, tileHref, heroHeight, HERO_RATIO_PORTFOLIO } from '../lib/tiles';
import { orderTiles, isCaseStudy } from '../lib/gridOrder';
import { tileImage } from '../lib/image';

const page = await getPage('portfolio');
const allItems = await getAllGridItems();

/*
  Weighted grid: parent projects occupy the first screenful, then their
  child pieces, then everything else.

  Tier 1 — Case Studies (the projects themselves, each with its own page)
  Tier 2 — Grid Items whose parent is a Case Study (clickable child pieces)
  Tier 3 — Everything else (orphan pieces, items with non-project parents)

  Tier 1 is still shuffled freely - one case study per project means they
  cannot clump with each other. Tiers 2 and 3 are now dealt rather than
  shuffled, so a project's offshoots are spread instead of landing in a run.
  orderTiles does both; the local shuffle it replaced is gone.
*/

/*
  Case studies first, then everything else dealt round-robin across projects
  so a brand never sits beside itself. See lib/gridOrder.ts - the tiering is
  unchanged, the second tier is no longer a free shuffle.

  The count is logged rather than swallowed: above zero means one project
  outnumbers the rest badly enough that contact is arithmetic, and that is
  worth knowing from the build output rather than from squinting at the page.
*/
const ordered = orderTiles(allItems as any[]);
const items = ordered.items;
if (ordered.adjacentPairs > 0) {
  console.warn(
    `[portfolio] ${ordered.adjacentPairs} tile(s) had to sit beside one from the ` +
      `same project - ${ordered.crowdedBy} holds more items than every other ` +
      `project combined, so some of them cannot be separated.`,
  );
}

/*
  Maps a grid item's category to a filter class. Typography and Illustration
  deliberately share one "Type/Lettering" button, matching the live site.
*/
const CATEGORY_FILTER: Record<string, string> = {
  'Brand Identity': 'brand-identity',
  'Merch & Apparel': 'merch-apparel',
  Typography: 'type-lettering',
  Illustration: 'type-lettering',
  Photography: 'photography',
};

const ALL_FILTERS = [
  { value: '.brand-identity', label: 'Brand Identity' },
  { value: '.merch-apparel', label: 'Merch & Apparel' },
  { value: '.type-lettering', label: 'Type/Lettering' },
  { value: '.photography', label: 'Photography' },
];

// How many tiles each filter would actually show.
const counts = new Map<string, number>();
for (const item of items) {
  const c = CATEGORY_FILTER[cleanKey(item.category)];
  if (c) counts.set(c, (counts.get(c) ?? 0) + 1);
}

/*
  A filter with nothing behind it is worse than a missing one: clicking it
  empties the grid, which reads as a broken site rather than an empty category.
  Photography currently has zero tagged items, so its button would do exactly
  that. Buttons are hidden when empty and the gap is logged instead, so it stays
  visible as a content task rather than disappearing silently.
*/
const filters = [
  { value: '*', label: 'All' },
  ...ALL_FILTERS.filter((f) => (counts.get(f.value.replace('.', '')) ?? 0) > 0),
];

/*
  Same gate as the constellation and the collage prototype, read here
  because the Gather toggle is markup rather than script. A Sanity publish
  deploys main to production, so an experiment must not reach the live site
  by a route nobody chose.
*/
const PREVIEW = import.meta.env.PUBLIC_IS_PREVIEW === 'true';

const emptyFilters = ALL_FILTERS.filter(
  (f) => (counts.get(f.value.replace('.', '')) ?? 0) === 0,
);
if (emptyFilters.length > 0) {
  console.warn(
    `[portfolio] filter button(s) hidden with no tagged items: ` +
      `${emptyFilters.map((f) => f.label).join(', ')}. Tag work with that ` +
      `category in Studio to bring the button back.`,
  );
}
---

<Layout title={page?.title ?? 'Portfolio'} description={pageDescription(page, 'Brand identity, merch, typography, illustration and photography work - the full archive of projects and pieces, filterable by category.')}>
  {/*
    The one page on the site that had no <h1>, and it is the main one. A screen
    reader opened it onto a row of unlabelled controls with nothing naming the
    page, and `heading` in Studio was being ignored here.

    Visually hidden rather than rendered: the control row sits directly under
    the nav by design and there is no room for a heading above it. If a visible
    one is ever wanted, drop the class - the markup is already right.
  */}
  <h1 class="visually-hidden">{page?.heading ?? page?.title ?? 'Portfolio'}</h1>
  <section class="pf-section">
    {/*
      Three groups rather than one long run of buttons: what to show, how to
      show it, and how to arrange it.

      The grouping is not decoration. Flat, the row wrapped wherever it ran out
      of width, which on a phone put the `+` on a line by itself under eight
      other buttons - an orphan, and a control that no longer reads as the
      partner of the `-` next to it. Groups wrap as units, and the zoom pair
      never splits at all.

      The dividers are gone with them. They were doing the grouping's job badly,
      and on a narrow screen they ended up starting and ending lines.
    */}
    <div class="pf-controls" id="pf-controls">
      <div class="pf-group pf-group--filters" role="group" aria-label="Filter by category">
        {filters.map((f, i) => (
          <button type="button" class:list={['pf-btn', i === 0 && 'is-active']} data-filter={f.value}>
            {f.label}
          </button>
        ))}
      </div>

      <div class="pf-group" role="group" aria-label="Arrange">
        <button type="button" class="pf-btn" id="pf-shuffle">Shuffle</button>
        {/*
          A SWITCH BETWEEN TWO ANSWERS TO THE SAME QUESTION, FOR JUDGING.

          Lines and gather both say "these pieces belong together" - one
          keeps the grid intact, the other breaks it to make the set
          legible. Chris wants to pick one and shelve the other, and the
          only way to compare them is side by side on the real grid with
          real content.

          aria-pressed rather than a checkbox because it is a toggle on the
          view, not a value being submitted. Preview only: this is a
          decision aid, not navigation, and it must not ship.
        */}
        {PREVIEW && (
          <button type="button" class="pf-btn" id="pf-gather" aria-pressed="false">
            Gather: off
          </button>
        )}
        {/* nowrap: these two are one control in two halves. */}
        <span class="pf-zoom">
          <button type="button" class="pf-btn" id="pf-minus" aria-label="Smaller tiles">&minus;</button>
          <button type="button" class="pf-btn" id="pf-plus" aria-label="Larger tiles">+</button>
        </span>
      </div>

      {/*
        Archive: the black-and-white view of this grid, in place.

        Last in the row and pushed to the far right on a wide screen - away
        from the filters, because it is not one.

        THIS IS THE ORIGINAL IDEA, RESTORED. For a while the switch navigated
        to /catalog instead - the same work arranged as a museum catalog -
        because two half-formed ideas had ended up stacked on each other and
        neither could be judged while they were tied together. Separating them
        was right; the catalog was the one that turned out not to be worth
        keeping, and it is gone.

        What comes back is the treatment that has something behind it: the
        authored archiveMark alternates. Where a mark has been DRAWN in
        black-and-white, archive view shows that file rather than a computed
        approximation of it - see archiveCard() in lib/image.ts and the
        data-archive-src swap in InkMode. Everything without one falls back to
        the CSS threshold, so the view improves as more marks get drawn and
        never breaks while they have not been. A catalog could not do that:
        its citations were the same text in a different arrangement.

        No destination props, so it toggles this page rather than leaving it -
        which is what it was always meant to do. The inkmodechange listener
        further down re-lays the grid out as ruled rows when it turns on.
      */}
      <div class="pf-group pf-group--view" role="group" aria-label="View">
        <InkMode />
      </div>
    </div>

    {/*
      `is-laying-out` hides the tiles until Isotope has positioned them.

      The grid's markup is a column of floated divs; Isotope then absolutely
      positions every one of them. Both layouts are valid and they look nothing
      alike, so the browser paints the first and then, a moment later, moves 68
      tiles at once. That is the 0.4722 layout shift the audit measures on this
      page - the worst number on the site, and precisely the jank you can feel.

      Hiding them means the wrong layout is never painted, so there is nothing
      to shift from. Two things make that safe rather than a way to lose the
      whole grid:

        - the class is added by an inline script below rather than being in the
          markup, so with JavaScript off the grid is simply visible;
        - a timeout removes it regardless, so if Isotope fails to load the
          tiles come back in float order instead of staying invisible.
    */}
    <div class="pf-grid" id="pf-grid">
      {items.map((item: any, i: number) => {
        // tileImage, not `thumbnail || mainImage`: an empty Grid Thumbnail is
        // truthy and used to swallow the real picture. See lib/image.ts.
        const img = tileImage(item);
        const cat = CATEGORY_FILTER[cleanKey(item.category)] ?? '';
        const parentHref = tileHref(item);
        // The category has to be a real CLASS, not just a data attribute:
        // Isotope filters with CSS selectors (".brand-identity"), so with the
        // value only in data-category every filter matched zero tiles and the
        // buttons appeared to do nothing. data-category is kept for styling
        // and debugging.
        return img ? (
          <div
            class:list={[
              'pf-item',
              cat,
              treatmentOf(item) === 'mark' && 'pf-item--mark',
              // Air in the NORMAL grid, for a treatment Chris set by hand.
              // Separate from --mark because an inferred mark must not gain
              // it: see explicitTreatment() in lib/tiles.ts.
              explicitTreatment(item) === 'mark' && 'pf-item--air',
              // Wears its "View project" bar at rest rather than on expand,
              // so the curated work is findable while scanning and is one
              // click away instead of two. See .pf-item--study in global.css.
              isCaseStudy(item) && 'pf-item--study',
              item.heroTile && 'pf-item--hero',
            ]}
            data-category={cat}
          >
            {/*
              The frame wraps the image and the jump button so a selected tile
              can carry ONE border around both. Bordering each separately would
              read as two stacked outlines with a gap between them.
            */}
            {/*
              Plate number. Only visible in archive mode, where it turns a
              gallery into a catalogue - the convention every plate book and
              type specimen uses. Not a title: Chris's whole point about
              logomarks is that they carry themselves without one, and an index
              number indexes rather than describes.

              Source order, not display order, so a given piece keeps its number
              when the grid is shuffled or filtered.
            */}
            <span class="pf-item__plate" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="pf-item__frame">
              {/*
                Passing height alongside width is what makes Img crop rather
                than keep the source aspect - and the crop follows the hotspot
                set in Studio, so a mark or a face stays in frame instead of
                being cut out of the middle.
              */}
              <Img
                class="pf-item__img"
                image={img}
                field={img === item.thumbnail ? 'thumbnail (Tile Image)' : 'mainImage (Main Project Image)'}
                archive={item.archiveMark}
                alt={item.title}
                width={item.heroTile ? 1600 : 800}
                height={item.heroTile ? heroHeight(1600, HERO_RATIO_PORTFOLIO) : undefined}
                sizes={item.heroTile ? '(max-width: 48rem) 66vw, 34vw' : '(max-width: 48rem) 33vw, 17vw'}
                {...(item.heroTile
                  ? {}
                  : {
                      // Clicking a tile doubles its width, and `sizes` above
                      // promises the single-column size - so the file chosen
                      // for 17vw is the one that gets stretched across 34vw.
                      // These ship as attributes and cost nothing until the
                      // handler below assigns them. See Img.astro.
                      upgradeWidth: 2000,
                      upgradeSizes: '(max-width: 48rem) 66vw, 34vw',
                    })}
              />
              {parentHref && (
                <a class="pf-item__jump" href={parentHref}>
                  <span class="pf-item__jump-label">{item.parentTitle ?? item.title ?? 'View project'}</span>
                  <span class="pf-item__jump-arrow" aria-hidden="true">&rarr;</span>
                </a>
              )}
            </div>
          </div>
        ) : null;
      })}
    </div>
    {/*
      Inline and immediately after the grid on purpose. It has to run during
      parsing, before the browser has had a chance to paint the float layout -
      a module script is deferred and would run after that first paint, which
      is the whole problem. `is:inline` keeps Astro from bundling and deferring
      it.
    */}
    <script is:inline>
      (function () {
        var grid = document.getElementById('pf-grid');
        if (!grid) return;
        grid.classList.add('is-laying-out');
        // If Isotope never loads - a blocked CDN, an offline runner - show the
        // tiles anyway. An unstyled grid beats a blank page.
        setTimeout(function () {
          grid.classList.remove('is-laying-out');
        }, 3000);
      })();
    </script>

    {items.length === 0 && <p>No items found.</p>}
  </section>

  {page?.sections?.length > 0 && (
    <div class="page-sections">
      <Sections sections={page.sections} where="/portfolio" />
    </div>
  )}
</Layout>

{/*
  Self-hosted rather than pulled from cdnjs/unpkg at request time.

  These were the only two avoidable third parties on the site - every visitor
  to this page had their IP seen by two more companies just to load a layout
  library. The files are the exact same builds (isotope-layout 3.0.6,
  imagesloaded 5.0.0, both pulled from npm and diffed against the CDN's own
  version string), copied into public/vendor rather than imported, because
  they set globals (`Isotope`, `imagesLoaded`) that the script below already
  expects - bundling them through Vite would mean rewriting that contract for
  no behavioural gain.

  is:inline on both: without it Astro tries to process the src as a module to
  bundle, which fails outright for a plain public/ path - "references an
  asset in the public/ directory... add is:inline". A CDN URL never hit this
  path because it's not a local file for Astro to try to load. Missed it
  testing the two files in a plain HTML harness instead of through the real
  Astro build, which is exactly the gap a local build check exists to close.
*/}
<script src="/vendor/isotope-3.0.6.min.js" is:inline></script>
<script src="/vendor/imagesloaded-5.0.0.min.js" is:inline></script>
<script>
  declare const Isotope: any;
  declare const imagesLoaded: any;

  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.querySelector<HTMLElement>('#pf-grid');
    if (!grid) return;

    const sizer = document.createElement('div');
    sizer.className = 'pf-sizer';
    grid.insertBefore(sizer, grid.firstChild);

    /*
      The responsive default, in ONE place.

      This lived as `window.innerWidth < 768 ? 3 : 6` in two spots - the
      initial count and the keyboard arrow step - which is two chances to
      disagree about how wide a row is. The arrow keys were already reading a
      hardcoded 3 while the grid could be showing something else entirely
      after a zoom.

      SEVEN ON A WIDE SCREEN, which is what Chris asked for: a landscape
      laptop or desktop should show seven across rather than six. The
      threshold is 1280 because that is where a seventh column stops costing
      the tiles anything worth noticing - at 1280 each tile is about 178px
      wide against 208 at six, and by 1920 it is 270 against 315. Below
      1280 a seventh column is taking width off a tile that is already the
      smallest thing on the page.

      Width rather than orientation, deliberately. A landscape iPad is 1024
      and would get 146px tiles, which is a thumbnail of a logomark - the
      grid's constraint is how wide a tile ends up, and orientation only
      predicts that indirectly.
    */
    const MOBILE_COLS = 4;
    const DESKTOP_COLS = 6;
    const WIDE_COLS = 7;
    const WIDE_FROM = 1280;
    const defaultCols = () => {
      if (window.innerWidth < 768) return MOBILE_COLS;
      return window.innerWidth >= WIDE_FROM ? WIDE_COLS : DESKTOP_COLS;
    };

    let cols = defaultCols();
    // Once the visitor uses +/- the count is theirs, and a resize must not
    // quietly take it back off them.
    let zoomed = false;

    function setColWidth() {
      grid!.style.setProperty('--pf-col-w', 100 / cols + '%');
    }
    setColWidth();

    const iso = new Isotope(grid, {
      itemSelector: '.pf-item',
      layoutMode: 'masonry',
      masonry: { columnWidth: '.pf-sizer', gutter: 0 },
      percentPosition: true,
      transitionDuration: 0,
    });

    /*
      KEEP AN EXPANDED TILE IN ITS OWN COLUMNS.

      Masonry places a two-column item in the leftmost column pair with the
      lowest bottom edge. Where the item already was is not an input, so
      clicking a tile in column 5 threw it across the grid - measured on the
      live page, 12 of 14 tiles moved more than half a column.

      Worth being precise about what is wrong, because it is narrower than it
      looks: items are placed in DOM order, so an item's column depends only
      on the items BEFORE it. A tile that merely grows taller keeps its column
      for free. It is going from one column to two that triggers the search,
      and only for the item doing it.

      So the search is what gets constrained, for that one item, rather than
      the reflow being removed. An earlier attempt removed the reflow instead:
      the tile stayed put and sat on top of its neighbours, which is a worse
      fault than the one it fixed.

      This overrides a method on the layout mode instance. Normally that would
      be too clever to live, and here it is defensible for two reasons: the
      library is vendored at a pinned 3.0.6 in public/vendor, so the shape
      cannot change under us without someone editing that file; and the
      override falls through to the original whenever no preferred column is
      set, which is every item except the one being expanded.

      The tile can still move DOWN. Its two columns may have different bottom
      edges and masonry seats a spanning item below the lower of them. That is
      the grid making room, which is what was asked for - it is sideways
      travel that made the click feel wrong.
    */
    const masonry: any = (iso as any).modes?.masonry;
    if (masonry && typeof masonry._getItemLayoutPosition === 'function') {
      const original = masonry._getItemLayoutPosition.bind(masonry);
      masonry._getItemLayoutPosition = function (item: any) {
        const preferred = item?.element?.__pfCol;
        if (typeof preferred !== 'number') return original(item);

        item.getSize();
        const colSpan = Math.max(
          1,
          Math.min(Math.ceil(item.size.outerWidth / this.columnWidth), this.cols),
        );
        // Clamped so a tile in the last column spans the final pair rather
        // than running off the right-hand edge.
        const col = Math.max(0, Math.min(preferred, this.cols - colSpan));

        let y = 0;
        for (let i = 0; i < colSpan; i++) y = Math.max(y, this.colYs[col + i]);
        const setY = y + item.size.outerHeight;
        for (let i = 0; i < colSpan; i++) this.colYs[col + i] = setY;

        return {x: this.columnWidth * col, y};
      };
    } else {
      // Not fatal: without it the grid behaves as it did before, which jumps.
      console.warn('[portfolio] masonry layout mode not found; expanded tiles will re-pack freely');
    }

    // Isotope has positioned everything, so the tiles can be shown. Anything
    // after this point is a deliberate rearrangement the visitor asked for.
    grid.classList.remove('is-laying-out');

    /*
      One relayout when every image has finished, not one per image.

      This used to be `.on('progress', ...)`, which relaid the whole grid 68
      times on a cold load - each one moving every tile. It was there to cope
      with images whose height was unknown until they arrived, and that stopped
      being true when Img started emitting width and height on every image: the
      browser now reserves each tile's box from the markup, so Isotope's first
      layout is already measuring the final heights.

      The `always` pass stays as a safety net for anything whose intrinsic size
      the CDN did not report.
    */
    imagesLoaded(grid).on('always', () => iso.layout());

    /*
      Re-layout when coming BACK to this page, which is the mobile bug where
      the grid returned as a single stacked column and stayed wrong until you
      touched a filter.

      Everything here hangs off DOMContentLoaded, and that does not fire on a
      back/forward restore - the page comes out of the browser's cache with
      the DOM as it was, including Isotope's absolutely-positioned tiles, but
      with none of this code re-running. If anything about the viewport
      changed in between - a rotation, the mobile URL bar collapsing or
      expanding - those pixel positions are now wrong and nothing recomputes
      them. Touching a filter called iso.layout() as a side effect, which is
      why interacting appeared to "reset" it.

      The listener is registered in here so it closes over `iso`, and the
      closure survives in the cache along with the page.

      Scroll position comes back with the restore, and the tile order is
      fixed at build time, so re-laying out puts every tile back exactly
      where it was - which is what keeps a tile you clicked in the same place
      when you return to it.
    */
    window.addEventListener('pageshow', (e) => {
      if (!(e as PageTransitionEvent).persisted) return;
      if (!zoomed) cols = defaultCols();
      setColWidth();
      iso.layout();
    });

    /*
      And on resize, which had no handler at all - so crossing the mobile
      breakpoint, or simply rotating, left the tiles at positions measured
      for the old width.

      Throttled to one animation frame rather than debounced on a timer.

      A trailing debounce was the wrong shape for what actually triggers this.
      Rotating a phone, or the mobile URL bar collapsing, is a single discrete
      event - waiting out a timer after it just adds lag to the one case that
      matters, and there is nothing to collapse. Dragging a desktop window is
      the opposite: resize fires up to once a frame, and relaying out 66 tiles
      that often is real jank.

      requestAnimationFrame answers both. A rotation relays out on the very
      next frame, which is as instant as the browser can paint. A drag can
      never queue more work than one layout per frame, because the flag
      refuses to schedule a second while one is pending - so it is naturally
      capped at whatever the machine can actually keep up with.
    */
    let resizePending = false;

    /*
      Constellation state, declared up here because remeasure() below redraws
      the lines and drawLinks reads these. Same reasoning as the function
      being a declaration: the ordering should not be something anyone has to
      work out.

      LINES is preview-only. A Sanity publish deploys main to production, so
      an experiment Chris has not approved must not reach the live site by
      that route - the same gate the collage prototype uses.
    */
    const LINES = import.meta.env.PUBLIC_IS_PREVIEW === 'true';
    let focusItem: HTMLElement | null = null;
    let focusFamily: HTMLElement[] = [];

    function remeasure() {
      if (resizePending) return;
      resizePending = true;
      requestAnimationFrame(() => {
        resizePending = false;
        const gridW = grid!.clientWidth;
        const sizerW = sizer.offsetWidth;
        /*
          Width unchanged means this was Isotope's own doing. Masonry sets the
          container's HEIGHT when it lays out, so an observer watching the
          grid hears about every layout it performs - and relaying out in
          response would be an infinite loop. Only a width tells us anything.
        */
        if (gridW === lastGridW && sizerW === lastSizerW) return;
        lastGridW = gridW;
        const next = defaultCols();
        if (!zoomed && next !== cols) {
          cols = next;
          setColWidth();
        }
        lastSizerW = sizer.offsetWidth;
        iso.layout();
        // A width change moves every tile, so any open constellation's lines
        // now point at where things used to be. Redrawn from the new
        // positions rather than stretched, which is what leaving an svg with
        // a stale viewBox would do.
        requestAnimationFrame(() => drawLinks());
      });
    }

    /*
      WHY AN OBSERVER RATHER THAN window.resize.

      Chris hit this again: the grid opens as one stacked column and a click
      on anything fixes it. The stacking is what Isotope does when it measures
      the sizer as being as wide as the container - one column, every tile at
      left 0 - and the tiles are still their proper quarter-width afterwards
      because the CSS that sizes them lands later. That is the exact picture.

      There are at least two ways to arrive there and window.resize catches
      neither:

        A TAB OPENED IN THE BACKGROUND. DOMContentLoaded fires and this code
        measures a container the browser has not laid out at the real width
        yet. Bringing the tab forward does not fire a resize, so nothing ever
        remeasured - until a filter click called iso.layout() as a side
        effect, which is precisely the "resets on a click" symptom.

        THE DEFERRED STYLESHEET. inline-critical-css.mjs hands the main
        stylesheet to the browser as media="print" and flips it to all on
        load, so first paint is styled from an inline subset. If Isotope
        measures in the window before the real sheet applies, .pf-sizer and
        .pf-item have no width rule at all and are full-width blocks. Again
        no resize event: the viewport never changed, only the styles did.

      A ResizeObserver hears the thing that actually matters in both - the
      measured width changing - regardless of what caused it. It also still
      covers rotation, the mobile URL bar, and desktop drags, so it replaces
      the resize handler rather than joining it; two listeners would just
      relayout twice for every drag frame.

      The rAF throttle and its reasoning are unchanged: a rotation relays out
      on the next frame, and a drag can never queue more than one layout per
      frame because the flag refuses to schedule a second.
    */
    let lastGridW = grid.clientWidth;
    let lastSizerW = sizer.offsetWidth;

    if (typeof ResizeObserver === 'function') {
      const ro = new ResizeObserver(remeasure);
      // The grid catches the viewport changing; the sizer catches the column
      // width changing under it, which is what a late stylesheet does without
      // touching the grid at all.
      ro.observe(grid);
      ro.observe(sizer);
    } else {
      window.addEventListener('resize', remeasure);
    }

    document.querySelectorAll<HTMLElement>('.pf-btn[data-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const filterVal = btn.dataset.filter!;
        const allBtn = document.querySelector<HTMLElement>('.pf-btn[data-filter="*"]');

        // An expanded tile that gets filtered away would keep its expanded
        // state (and its double width) for when it returns, which reads as a
        // glitch. Collapse on any filter change - including the column hint,
        // which would otherwise pin the tile to a column that means something
        // different once the grid holds a different set of tiles.
        grid.querySelectorAll<HTMLElement>('.pf-item.is-expanded').forEach((el) => {
          el.classList.remove('is-expanded');
          delete (el as any).__pfCol;
        });
        // And the lit set, which would otherwise survive into a filtered view
        // where most of its members are hidden - dimming a grid around tiles
        // that are no longer on it.
        clearFamily();
        if (filterVal === '*') {
          document.querySelectorAll('.pf-btn[data-filter]').forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          iso.arrange({ filter: '*' });
          return;
        }
        btn.classList.toggle('is-active');
        const activeFilters = Array.from(document.querySelectorAll('.pf-btn[data-filter].is-active'))
          .map((b) => (b as HTMLElement).dataset.filter)
          .filter((f) => f !== '*');
        if (activeFilters.length === 0) {
          allBtn?.classList.add('is-active');
          iso.arrange({ filter: '*' });
        } else {
          allBtn?.classList.remove('is-active');
          iso.arrange({ filter: activeFilters.join(', ') });
        }
      });
    });

    /*
      Shuffle RE-DEALS, it does not randomise.

      This was `iso.shuffle()`, which assigns random positions with no idea
      what a project is - one click and the spacing the build worked out is
      gone, putting four Hug a Mug tiles together again. The whole rule
      undone by the button next to it.

      So it rotates the deal instead: the DOM order already alternates
      between projects, and moving a slice from the front to the back keeps
      that alternation while giving a genuinely different arrangement. The
      offset is random and never zero, so the grid visibly changes.

      Isotope lays out in DOM order, so reordering the elements and calling
      layout() is all it takes. Tiles hidden by a filter move with the rest
      and come back in the new order when the filter clears.
    */
    document.querySelector('#pf-shuffle')?.addEventListener('click', () => {
      const tiles = Array.from(grid.querySelectorAll('.pf-item'));
      if (tiles.length < 3) return;
      const offset = 1 + Math.floor(Math.random() * (tiles.length - 1));
      const frag = document.createDocumentFragment();
      for (const el of [...tiles.slice(offset), ...tiles.slice(0, offset)]) frag.appendChild(el);
      grid.appendChild(frag);
      iso.reloadItems();
      iso.layout();
    });

    function updateCols() {
      // From here on the count is the visitor's, so a later resize leaves it
      // alone instead of snapping back to the responsive default.
      zoomed = true;
      setColWidth();
      iso.layout();
    }
    document.querySelector('#pf-plus')?.addEventListener('click', () => {
      if (cols > 1) {
        cols--;
        updateCols();
      }
    });
    document.querySelector('#pf-minus')?.addEventListener('click', () => {
      if (cols < 12) {
        cols++;
        updateCols();
      }
    });

    /*
      SHARPEN A TILE THAT IS ABOUT TO BE, OR HAS JUST BEEN, ENLARGED.

      A tile is served a file for 17vw and then doubled to 34vw on click, so
      the picture is stretched about 1.3x on a 2x screen - measured on Two
      Point Oh - Luna Tee, a 2000px upload shown as 800px across 1056 device
      pixels. Declaring the big size for everyone would fix it and cost +9.5
      MB across the grid's 87 images, so instead Img.astro ships a larger
      srcset in data attributes and this assigns it for the one tile involved.

      Both attributes are assigned, and `sizes` FIRST. Setting srcset alone
      re-runs the browser's selection against the old 17vw promise, which can
      pick the same file again - a swap that looks implemented and changes
      nothing.

      Nothing is reverted on collapse. The larger file is in the cache by
      then, so putting the small one back would be a second decode to make the
      tile worse.

      Idempotent via the flag: hover and click both call it, and a tile that
      has no upgrade to offer - pass-through, or an upload no bigger than the
      base - is marked done so it is not re-checked on every pointer move.
    */
    const sharpen = (item: HTMLElement) => {
      const img = item.querySelector<HTMLImageElement>('img');
      if (!img || img.dataset.upgraded) return;
      const next = img.dataset.upgradeSrcset;
      if (!next) {
        img.dataset.upgraded = 'none';
        return;
      }
      img.dataset.upgraded = '1';

      /*
        DECODE FIRST, THEN SWAP.

        Assigning srcset directly is enough on a grid that does not reflow,
        and it was: the overlay version measured 356% of the original pixel
        density through the swap, meaning nothing ever disappeared. Putting
        the re-pack back changed that - measured on production, one frame
        came back 544x584 at 29 bytes per 1000 pixels against a baseline of
        2116. A full-size box with nothing in it.

        Reflowing and decoding at the same time is what does it: the element
        is resized and repositioned while its new file is still arriving, and
        for a frame there is nothing to paint at the new size.

        So the file is fetched into a detached image first and only assigned
        once it has decoded, by which point it is in cache and the swap is
        immediate. Until then the tile keeps showing what it already had,
        slightly soft at the larger size, which is the correct thing to show.

        This is also why hovering never flickered - it was already doing this
        by accident, just with the decode happening 150ms before the click.

        `sizes` is assigned to the detached image too. It has no layout, so a
        viewport-relative value is what makes it choose the same candidate the
        real one will; without it the preload would warm the wrong file and
        the swap would still have to fetch.

        decode() is not everywhere, and a failed decode must not strand the
        tile on its small file, so both paths end in the same assignment.
      */
      const apply = () => {
        if (img.dataset.upgradeSizes) img.sizes = img.dataset.upgradeSizes;
        img.srcset = next;
      };

      const pre = new Image();
      if (img.dataset.upgradeSizes) pre.sizes = img.dataset.upgradeSizes;
      pre.srcset = next;
      if (typeof pre.decode === 'function') {
        pre.decode().then(apply, apply);
      } else {
        pre.addEventListener('load', apply, {once: true});
        pre.addEventListener('error', apply, {once: true});
      }
    };

    /*
      Start on intent rather than on the click, so the larger file is usually
      decoded before the tile opens and the swap is invisible.

      A dwell timer, because a pointer crossing the grid enters dozens of
      tiles on its way somewhere else and each one would start a download. A
      pause is what separates "looking at this" from "passing over it".

      Touch never fires pointerenter ahead of the tap, so the click path below
      still has to do the work for phones - this is an optimisation for
      pointers, not the mechanism.
    */
    let hoverTimer: ReturnType<typeof setTimeout> | undefined;
    grid.addEventListener(
      'pointerenter',
      (e) => {
        const pe = e as PointerEvent;
        if (pe.pointerType === 'touch') return;
        const item = (e.target as HTMLElement)?.closest<HTMLElement>('.pf-item');
        if (!item) return;
        clearTimeout(hoverTimer);
        hoverTimer = setTimeout(() => sharpen(item), 150);
      },
      true,
    );
    grid.addEventListener(
      'pointerleave',
      () => clearTimeout(hoverTimer),
      true,
    );

    /*
      THE CONSTELLATION.

      Expanding a tile also lights up every other piece from the same project
      and drops the rest back, so for as long as the tile is open the grid
      reads as "this project" against "everything else". One tap tells you
      three things without any text: these pieces belong together, this is how
      much work that brand represents, and the only blue object left on a
      dimmed page is the way to read about it.

      The grouping key is already in the markup. Every tile that belongs to a
      project carries that project's URL in its jump link - hidden until
      expanded, but present - and a case study carries its own. So siblings
      are "same href", with no data change and no second source of truth
      about what belongs to what.

      Opacity, not the ink treatment. Archive mode would be more on-brand but
      it swaps image sources through InkMode, which is far too heavy for
      something that fires on every tap and can visibly half-apply. Opacity
      is instant and atomic.

      Nothing here relayouts. It is one class on the grid and one on each
      sibling, so Isotope never runs and the placement work is untouched.
    */
    const FAMILY_MIN = 4;

    const projectOf = (el: Element) =>
      el.querySelector('.pf-item__jump')?.getAttribute('href') ?? null;

    /*
      LINES BETWEEN THE PIECES - PREVIEW ONLY FOR NOW.

      An experiment Chris wanted to see rather than a decision, so it is
      gated the same way the collage prototype is: a Sanity publish deploys
      main to production, and an unapproved experiment must not reach the
      live site by that route. Same flag, same reasoning.
    */
    const clearFamily = () => {
      grid.classList.remove('has-focus');
      grid.querySelectorAll('.pf-item.is-sibling').forEach((el) => el.classList.remove('is-sibling'));
      grid.querySelector('.pf-links')?.remove();
      focusItem = null;
      focusFamily = [];
    };

    /*
      BEHIND THE TILES, NOT OVER THEM.

      Chris's constraint is the whole design here: clicking a tile is a
      request to see THAT piece, so anything the click adds must not compete
      with it. Lines drawn over the grid would cross the very thing they are
      meant to point at.

      So the svg is the first child of the grid and the tiles paint after it
      in DOM order - the lines pass behind every tile and emerge in the gaps.
      The dimmed field reads as having something underneath it; the lit tiles
      sit on top, unobstructed. pointer-events are off so nothing here
      changes what a click lands on.

      Drawn from measured positions rather than from column arithmetic,
      because masonry decides where a tile ends up and only the painted box
      knows the answer.

      A declaration rather than a const arrow, because remeasure() above
      calls it: hoisting means the ordering is not something a reader has to
      work out, and the state it reads is guarded on the first line rather
      than assumed.
    */
    function drawLinks() {
      if (!LINES || !focusItem || focusFamily.length < 2) return;
      grid.querySelector('.pf-links')?.remove();

      const gr = grid.getBoundingClientRect();

      /*
        The PICTURE's box, not the tile's.

        .pf-item carries the grid's padding, so its edge sits in the middle
        of the gutter; .pf-item__frame is where the artwork actually stops.
        Trimming to the frame is what puts the line's end in the gap rather
        than against the image.
      */
      const boxOf = (el: Element) => {
        const r = (el.querySelector('.pf-item__frame') ?? el).getBoundingClientRect();
        return {
          x: r.left - gr.left + r.width / 2,
          y: r.top - gr.top + r.height / 2,
          hw: r.width / 2,
          hh: r.height / 2,
        };
      };

      /*
        Where a line leaves a box, instead of where the box's middle is.

        Chris: a line running under the artwork is a distraction, and with
        transparent logos it shows straight through. So no line starts or
        ends inside a picture - each one is cut back to the edge of the box
        it points at, and pushed a few pixels further out so it sits in the
        gutter rather than touching the frame.

        The maths is a ray from the centre in the direction of the other
        tile, scaled to whichever edge it meets first - the smaller of
        half-width/|dx| and half-height/|dy|. Which edge that turns out to be
        is the answer, not something to branch on.
      */
      /*
        NEAREST BY THE GAP BETWEEN PICTURES, NOT BETWEEN THEIR MIDDLES.

        Chris: "it doesn't look like it's targeting the nearest object...
        you might see like an O shape of images when one thing is
        highlighted". The tree WAS connecting each piece to its nearest
        already-connected piece, so the algorithm was right and the metric
        was wrong.

        Centre-to-centre is a bad proxy for nearness on a masonry grid,
        because the tiles are wildly different sizes and the clicked one
        doubles. A big tile's centre can be 400px from a small neighbour
        whose edge nearly touches it, while a same-sized tile two columns
        away measures closer. So the tree kept reaching past the obvious
        neighbour for something that was only nearer in the arithmetic, and
        chaining those choices is what drew the ring.

        Measuring the clear space BETWEEN the two rectangles is what the eye
        is actually doing. Zero when they overlap on an axis, so two tiles
        sitting side by side in the same row read as adjacent no matter how
        tall either one is.
      */
      const gapBetween = (
        a: {x: number; y: number; hw: number; hh: number},
        b: {x: number; y: number; hw: number; hh: number},
      ) => {
        const dx = Math.max(0, Math.abs(a.x - b.x) - (a.hw + b.hw));
        const dy = Math.max(0, Math.abs(a.y - b.y) - (a.hh + b.hh));
        return Math.hypot(dx, dy);
      };

      /*
        Does this segment lie across a picture? Liang-Barsky clipping.

        Chris's other constraint: "not have it intersecting any images where
        the line gets cut off". The mask guarantees a line never PAINTS over
        a lit picture, but that is not the same as never being in the way -
        a hop that passes behind a third lit tile comes out the other side
        with a hole in it, which is the broken-looking thing he is seeing.

        So the tree is told to avoid those hops rather than to draw them and
        let the mask hide the damage.
      */
      const crossesBox = (
        ax: number,
        ay: number,
        bx: number,
        by: number,
        box: {x: number; y: number; hw: number; hh: number},
      ) => {
        let t0 = 0;
        let t1 = 1;
        const dx = bx - ax;
        const dy = by - ay;
        const edges: [number, number][] = [
          [-dx, ax - (box.x - box.hw)],
          [dx, box.x + box.hw - ax],
          [-dy, ay - (box.y - box.hh)],
          [dy, box.y + box.hh - ay],
        ];
        for (const [p, q] of edges) {
          if (p === 0) {
            if (q < 0) return false;
          } else {
            const r = q / p;
            if (p < 0) {
              if (r > t1) return false;
              if (r > t0) t0 = r;
            } else {
              if (r < t0) return false;
              if (r < t1) t1 = r;
            }
          }
        }
        return t1 > t0;
      };

      const GAP = 3;
      const edge = (box: {x: number; y: number; hw: number; hh: number}, toward: {x: number; y: number}) => {
        const dx = toward.x - box.x;
        const dy = toward.y - box.y;
        if (dx === 0 && dy === 0) return {x: box.x, y: box.y};
        const sx = dx === 0 ? Infinity : box.hw / Math.abs(dx);
        const sy = dy === 0 ? Infinity : box.hh / Math.abs(dy);
        const s = Math.min(sx, sy);
        const len = Math.hypot(dx, dy);
        const out = s + GAP / len;
        return {x: box.x + dx * out, y: box.y + dy * out};
      };

      const NS = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('class', 'pf-links');
      svg.setAttribute('viewBox', `0 0 ${Math.round(gr.width)} ${Math.round(gr.height)}`);
      svg.setAttribute('preserveAspectRatio', 'none');
      svg.setAttribute('aria-hidden', 'true');

      /*
        OFF THE LIT PICTURES ONLY. OVER THE DIMMED ONES ON PURPOSE.

        The first version masked every frame on the grid, and Chris's verdict
        was the right one: "basically not visible". With 8px gutters, a line
        allowed to exist only in the margins becomes a row of dashes, and a
        row of dashes at 45% opacity is nothing at all.

        The mistake was treating all eighty-two tiles as artwork to protect.
        They are not. A dimmed tile has already been pushed to a fifth
        opacity and explicitly deprioritised - it is ground, not figure, and
        a line crossing it is not a distraction but the thing that makes the
        dimming legible. Behind the grid at 0.2 opacity, the stroke reads as
        passing UNDER the ghosted pieces, which is a better effect than the
        one I was protecting.

        The pictures that matter are the lit ones: the piece clicked and its
        siblings, at full opacity, which is what the visitor asked to see.
        Those still need the knockout, because so much of this portfolio is
        logos on transparent grounds - drawing "behind" them is drawing
        through them.

        So: white open field, one black rect per LIT frame. White is drawn
        through, black is knocked out.
      */
      const mask = document.createElementNS(NS, 'mask');
      mask.setAttribute('id', 'pf-links-mask');
      // maskUnits in user space, so the rects below can be plain pixel
      // coordinates in the same system as the lines.
      mask.setAttribute('maskUnits', 'userSpaceOnUse');

      const open = document.createElementNS(NS, 'rect');
      open.setAttribute('x', '0');
      open.setAttribute('y', '0');
      open.setAttribute('width', String(Math.round(gr.width)));
      open.setAttribute('height', String(Math.round(gr.height)));
      open.setAttribute('fill', '#fff');
      mask.appendChild(open);

      for (const tile of focusFamily) {
        const f = (tile.querySelector('.pf-item__frame') ?? tile).getBoundingClientRect();
        if (f.width < 2 || f.height < 2) continue;
        const cut = document.createElementNS(NS, 'rect');
        cut.setAttribute('x', String(Math.round(f.left - gr.left)));
        cut.setAttribute('y', String(Math.round(f.top - gr.top)));
        cut.setAttribute('width', String(Math.round(f.width)));
        cut.setAttribute('height', String(Math.round(f.height)));
        cut.setAttribute('fill', '#000');
        mask.appendChild(cut);
      }

      const defs = document.createElementNS(NS, 'defs');
      defs.appendChild(mask);
      svg.appendChild(defs);

      const strokes = document.createElementNS(NS, 'g');
      strokes.setAttribute('mask', 'url(#pf-links-mask)');
      svg.appendChild(strokes);

      /*
        A THREAD THROUGH THE SET, NOT A STARBURST FROM THE MIDDLE.

        Chris: "what should we do about non-greyed if they're stacking". The
        honest answer is that masking cannot fix it, and neither can routing.
        A spoke from the clicked tile to a sibling nine columns away has to
        get there, and if two lit siblings sit between them it crosses both.
        Nine spokes from one hub across a seven-column masonry grid crossing
        each other and the artwork is not a bug in the drawing - it is what a
        hub-and-spoke diagram looks like at that density.

        So the shape changes. Each piece connects to its NEAREST already
        connected piece instead of to the hub, which is Prim's algorithm
        grown from the clicked tile. What comes out is a tree of short hops
        between neighbours: the total ink is the minimum that still touches
        every piece, and a hop between two adjacent tiles has almost nothing
        left to cross. The knockout above stops being the main event and
        becomes the rare safety net it should have been.

        Rooted at the clicked tile deliberately, not a free minimum spanning
        tree. The root is what keeps Chris's first constraint intact - the
        thread visibly STARTS at the piece you chose and travels outward, so
        the clicked piece still reads as the subject rather than as one node
        among equals. Same edge count either way; the difference is which
        end the eye begins at.

        O(n * n) per step with n at most a couple of dozen tiles, run once
        per click. Clarity is worth more here than the heap.
      */
      const nodes = focusFamily.map((el) => ({el, box: boxOf(el)}));
      const root = nodes.find((n) => n.el === focusItem);
      if (!root) return;

      const reached = [root];
      const pending = nodes.filter((n) => n !== root);
      /* Hops in growth order, each carrying how far it is from the root so
         the animation can expand outward a ring at a time. */
      const hops: Array<{from: typeof root; to: typeof root; ring: number}> = [];
      const ringOf = new Map<typeof root, number>([[root, 0]]);

      /*
        A hop that would be cut is worth avoiding, not forbidding.

        Scored rather than filtered: a flat penalty far larger than any real
        gap means a clean hop always beats an obstructed one, while an
        obstructed hop is still available when every option is obstructed.
        Hard-filtering would leave a sibling unreachable and silently drop
        it from the constellation, which is worse than one line with a hole.
      */
      const BLOCKED = 100_000;
      const blocked = (a: (typeof nodes)[number], b: (typeof nodes)[number]) => {
        const from = edge(a.box, b.box);
        const to = edge(b.box, a.box);
        return nodes.some(
          (n) => n !== a && n !== b && crossesBox(from.x, from.y, to.x, to.y, n.box),
        );
      };

      while (pending.length) {
        let pick: {at: number; to: (typeof nodes)[number]; from: (typeof nodes)[number]; d: number} | null = null;
        for (let i = 0; i < pending.length; i++) {
          for (const have of reached) {
            /*
              Nearest by clear space between the pictures, with obstructed
              hops pushed to the back of the queue. Both halves matter: the
              metric is what makes the tree pick the neighbour the eye calls
              nearest, and the penalty is what keeps it from drawing a line
              that arrives with a hole in it.
            */
            const d =
              gapBetween(pending[i].box, have.box) + (blocked(pending[i], have) ? BLOCKED : 0);
            if (!pick || d < pick.d) pick = {at: i, to: pending[i], from: have, d};
          }
        }
        if (!pick) break;
        hops.push({from: pick.from, to: pick.to, ring: (ringOf.get(pick.from) ?? 0) + 1});
        ringOf.set(pick.to, (ringOf.get(pick.from) ?? 0) + 1);
        reached.push(pick.to);
        pending.splice(pick.at, 1);
      }

      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      for (const hop of hops) {
        const source = hop.from.box;
        const target = hop.to.box;

        const from = edge(source, target);
        const to = edge(target, source);

        /*
          Two tiles close enough that the trimmed ends cross each other have
          no line to draw - the gap between them is smaller than the two
          pushes away from their edges. Drawing it anyway produces a short
          stub pointing the wrong way, which reads as a glitch.

          Far more common now that the hops are between neighbours, and
          skipping one costs nothing: the tile is still lit, and the tree
          still reaches everything through it.
        */
        const spanned = Math.hypot(to.x - from.x, to.y - from.y);
        const apart = Math.hypot(target.x - source.x, target.y - source.y);
        if (spanned < 2 || spanned > apart) continue;

        const line = document.createElementNS(NS, 'line');
        line.setAttribute('x1', String(Math.round(from.x)));
        line.setAttribute('y1', String(Math.round(from.y)));
        line.setAttribute('x2', String(Math.round(to.x)));
        line.setAttribute('y2', String(Math.round(to.y)));
        /*
          Each hop draws itself away from the piece it grew out of, delayed
          by its distance from the root, so the thread travels rather than
          appearing all at once. The order matters more than the motion: the
          eye follows the growth from the piece you chose to the ones it is
          related to, which is the sentence the whole effect is trying to
          say.
        */
        if (!still) {
          const len = Math.hypot(to.x - from.x, to.y - from.y);
          line.style.strokeDasharray = String(len);
          line.style.strokeDashoffset = String(len);
          requestAnimationFrame(() => {
            line.style.transition = `stroke-dashoffset 320ms ease-out ${Math.min(hop.ring - 1, 8) * 90}ms`;
            line.style.strokeDashoffset = '0';
          });
        }
        strokes.appendChild(line);
      }

      grid.prepend(svg);
    }

    /*
      GATHER: PULL A PROJECT'S PIECES TO THE TILE YOU CLICKED.

      Chris's third idea: "if you click something, everything snaps close to
      it that is... related to the project. But this would take everything
      out of the grid, and I don't know if I want to resort everything around
      it, how much that would sacrifice speed."

      SPEED IS NOT THE COST, AND IT IS WORTH SAYING WHY

      Isotope positions with transforms, so a relayout of all 82 tiles is
      GPU work, not layout thrash - the Shuffle button already re-deals the
      whole grid on every press. What this actually costs is ORIENTATION.
      Re-sorting moves the tile you clicked, so your scroll position stops
      meaning anything and content from below the fold gets pulled past you.
      On a grid this tall that reads as a glitch rather than a reveal.

      So the scroll is corrected. The clicked tile's distance from the top of
      the viewport is measured before the re-sort and restored after it, which
      keeps the one thing the visitor is looking at exactly where they left
      it while everything else rearranges around it. That is the difference
      between "the grid gathered" and "the page jumped".

      WHY A TOGGLE RATHER THAN THE CLICK BEHAVIOUR

      Gather and the constellation answer the same question - what else
      belongs to this - and running both at once is noise. Chris wants to
      judge them against each other and keep one, so the mode is switchable
      on the page instead of decided in the source. Preview only, so the
      toggle is not UI that ships.
    */
    let gatherMode = false;
    let preGather: HTMLElement[] | null = null;

    /* The deal as the build dealt it, kept so gather is undoable without
       re-running orderTiles in the browser. */
    const rememberOrder = () => {
      if (!preGather) preGather = Array.from(grid.querySelectorAll<HTMLElement>('.pf-item'));
    };

    const restoreOrder = () => {
      if (!preGather) return;
      const frag = document.createDocumentFragment();
      for (const el of preGather) frag.appendChild(el);
      grid.appendChild(frag);
      preGather = null;
      iso.reloadItems();
      iso.layout();
    };

    const gather = (item: HTMLElement, family: HTMLElement[]) => {
      /*
        Moving from one gathered project straight to another puts the deal
        back first, silently - no reloadItems, no layout, so there is one
        animation rather than two. Without this the leftovers from the
        previous gather become the starting order for the next one and the
        grid drifts further from the dealt arrangement with every click.
      */
      if (preGather) {
        const back = document.createDocumentFragment();
        for (const el of preGather) back.appendChild(el);
        grid.appendChild(back);
      } else {
        rememberOrder();
      }
      const anchorBefore = item.getBoundingClientRect().top;

      /*
        The clicked tile first, then its siblings, then everything else in
        the order it was already in. Masonry fills in DOM order, so putting
        the set at the front is what brings it together - and leaving the
        remainder's relative order alone means the rest of the grid is
        rearranged as little as the move allows.
      */
      const rest = Array.from(grid.querySelectorAll<HTMLElement>('.pf-item')).filter(
        (el) => el !== item && !family.includes(el),
      );
      const frag = document.createDocumentFragment();
      frag.appendChild(item);
      for (const el of family) if (el !== item) frag.appendChild(el);
      for (const el of rest) frag.appendChild(el);
      grid.appendChild(frag);

      iso.reloadItems();
      iso.layout();

      /*
        Correct the scroll once the tiles have actually landed. Isotope
        animates, so measuring before layoutComplete reads a position
        halfway through the move and corrects by the wrong amount.

        `once` rather than a standing listener: every filter, shuffle and
        expand fires layoutComplete too, and a scroll correction attached to
        all of them would fight the visitor for control of the page.
      */
      const settle = () => {
        const drift = item.getBoundingClientRect().top - anchorBefore;
        if (Math.abs(drift) > 1) window.scrollBy({top: drift, behavior: 'instant' as ScrollBehavior});
      };
      /*
        Explicit branch rather than `once?.(...) ?? setTimeout(...)`. If
        Isotope's `once` exists but returns undefined, the nullish fallback
        fires the timeout as well and the page gets scroll-corrected twice -
        once by the right amount and once by nothing, or worse, overshooting.
        A silent double-correction is exactly the bug that looks like the
        animation being janky.
      */
      if (typeof (iso as any).once === 'function') (iso as any).once('layoutComplete', settle);
      else setTimeout(settle, 450);
    };

    const markFamily = (item: HTMLElement) => {
      const href = projectOf(item);
      // A standalone piece has no project, so there is no constellation to
      // show. Dimming the page around a lone tile would read as a fault.
      if (!href) return;

      const family = Array.from(grid.querySelectorAll<HTMLElement>('.pf-item')).filter(
        (el) => projectOf(el) === href,
      );

      /*
        Below the threshold the effect is worse than nothing: Chateau Seven is
        one piece plus its case study, and dimming eighty tiles to spotlight
        two looks like a bug rather than a reveal. Four is the smallest group
        where the lit tiles read as a set - it takes in DumpStat's nineteen,
        Adelante's ten and Two Point Oh's seven, and leaves the pairs alone.
      */
      if (family.length < FAMILY_MIN) return;

      for (const el of family) el.classList.add('is-sibling');
      grid.classList.add('has-focus');
      focusItem = item;
      focusFamily = family;
    };

    grid.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // The jump button lives inside the tile, so without this its click would
      // bubble up here and collapse the tile instead of navigating.
      if (target.closest('a')) return;

      const item = target.closest<HTMLElement>('.pf-item');
      if (!item) return;
      const wasExpanded = item.classList.contains('is-expanded');
      grid.querySelectorAll<HTMLElement>('.pf-item.is-expanded').forEach((el) => {
        el.classList.remove('is-expanded');
        // Clear the hint with the state it belongs to, or the tile keeps
        // being pinned to a column it is no longer expanded in.
        delete (el as any).__pfCol;
      });
      // Always, including when collapsing and when moving to another tile -
      // the lit set belongs to whichever tile is open, and leaving the old
      // one lit would say two projects are one.
      clearFamily();
      if (!wasExpanded) {
        /*
          Record which column the tile is in BEFORE the class is added, since
          that is the one it should open in - read from the painted box
          rather than from an index, because masonry's own choices are the
          only thing that knows where a tile ended up.
        */
        const gridBox = grid.getBoundingClientRect();
        const colW = sizer.offsetWidth;
        if (colW > 0) {
          const left = item.getBoundingClientRect().left - gridBox.left;
          (item as any).__pfCol = Math.max(0, Math.round(left / colW));
        }
        item.classList.add('is-expanded');
        markFamily(item);
        // Before the reflow below, so the request is in flight while the tile
        // is still growing rather than starting after it has settled.
        sharpen(item);
      }

      // The button becoming visible changes the tile's height, so Isotope has
      // to re-measure. Two frames: one for the class to apply and the browser
      // to reflow, then layout against real heights. A single synchronous
      // call here measures the pre-reveal height and leaves tiles overlapping.
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          iso.layout();
          /*
            One mode or the other, never both. Gather re-sorts the grid, so
            lines drawn against the old positions would point at where
            things used to be - and even measured correctly, two answers to
            "what else belongs to this" at once is the noise Chris is
            trying to choose between.
          */
          if (gatherMode) {
            if (focusItem && focusFamily.length >= FAMILY_MIN) gather(focusItem, focusFamily);
            else if (wasExpanded) restoreOrder();
          } else {
            // A third frame: layout() moves tiles, and lines measured before
            // that settles point at where things USED to be.
            requestAnimationFrame(drawLinks);
          }
        }),
      );
    });

    /*
      Flipping the mode puts the grid back to the dealt order first.

      Turning gather off while a project is still gathered would leave the
      grid in an arrangement no rule produced and no button could undo - the
      state you cannot get out of is the one worth handling here.
    */
    document.querySelector('#pf-gather')?.addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      gatherMode = !gatherMode;
      btn.setAttribute('aria-pressed', String(gatherMode));
      btn.textContent = `Gather: ${gatherMode ? 'on' : 'off'}`;
      restoreOrder();
      if (gatherMode) grid.querySelector('.pf-links')?.remove();
      else if (focusItem) requestAnimationFrame(drawLinks);
    });

    /*
      Archive mode changes tile heights - gutters open up and logomarks get
      inset - so the grid has to be re-measured the same way. InkMode fires this
      rather than reaching into the grid itself, so neither component needs to
      know about the other's internals.

      Two frames again, for the same reason: the CSS has to apply and the
      browser reflow before Isotope reads real heights.
    */
    // Arrow-key navigation: move a visible highlight through the grid.
    let cursor = -1;
    function visibleItems(): HTMLElement[] {
      return Array.from(grid.querySelectorAll<HTMLElement>('.pf-item'))
        .filter((el) => el.style.display !== 'none' && !el.classList.contains('isotope-hidden'));
    }
    function setCursor(i: number) {
      const items = visibleItems();
      if (!items.length) return;
      items.forEach((el) => el.classList.remove('pf-item--focus'));
      cursor = Math.max(0, Math.min(i, items.length - 1));
      const item = items[cursor];
      item.classList.add('pf-item--focus');
      item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }
    document.addEventListener('keydown', (e) => {
      if (['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement)?.tagName)) return;
      const items = visibleItems();
      if (!items.length) return;
      // `cols` is already the live count - responsive by default, and the
      // visitor's own once they have zoomed. The old literal here meant Down
      // stepped 3 tiles on a phone no matter how many were actually in a row.
      const c = cols;
      if (e.key === 'ArrowRight') { e.preventDefault(); setCursor(cursor + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); setCursor(cursor - 1); }
      else if (e.key === 'ArrowDown') { e.preventDefault(); setCursor(cursor + c); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setCursor(cursor - c); }
      else if (e.key === 'Enter' && cursor >= 0 && cursor < items.length) {
        e.preventDefault();
        const link = items[cursor].querySelector<HTMLAnchorElement>('a');
        if (link) link.click();
        else items[cursor].click();
      }
    });

    document.addEventListener('inkmodechange', (e: any) => {
      /*
        The categorical change: masonry becomes fitRows.

        Masonry is a feed - ragged columns, items packing into whatever gap is
        nearest, no shared horizontal line. An archive is the opposite: ruled
        rows, every plate on a common baseline, the way a specimen sheet or a
        catalogue is set. Combined with the square cells the CSS gives archive
        tiles, that turns the same content into a plate book rather than a
        recoloured feed.

        Isotope has fitRows built in, so this is a mode switch rather than a
        second layout engine.
      */
      const on = Boolean(e?.detail?.on);
      iso.arrange({layoutMode: on ? 'fitRows' : 'masonry'});
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          iso.layout();
          // A third frame: layout() moves tiles, and lines measured before
          // that settles point at where things USED to be.
          requestAnimationFrame(drawLinks);
        }),
      );
    });
  });
</script>
