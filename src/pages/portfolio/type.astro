---
/*
  TYPE/LETTERING - at /portfolio/type: the portfolio's fourth
  view, back under its own name.

  Chris: keep the label - "pretend, okay, the person clicking on this is
  looking for this, but I'm actually showing them more" - and make it "the
  cleanest filter of all, where it's like a horizontal row per case study
  ... a clean, sober take". So: one row per project, in the order dragged in
  Studio, each opening with the project's name and its block of type, then
  its pieces at one height, its lettering first (Typography and
  Illustration pieces, and the hand-set marks), then the rest. After the
  projects, the loose lettering in a row of its own. A row swipes sideways
  on a phone, and has arrows on a wide screen.

  A piece opens here, over the rows, large and captioned, with arrows
  through its row - not by leaving for Up close. Chris: "when you go to
  click something, it does a sort of close-up view, but then you can't
  return back to this page." Closing (the cross, Escape, outside it, or the
  browser's back) leaves the rows as they were. "Look closer" still goes on
  to Up close, and without the script every piece is a plain link there.

  Live since Chris: "take the portfolio changes and push those live".
  noindex, as /catalog: the same work as /portfolio, which should rank.
*/
import Layout from '../../layouts/Layout.astro';
import Img from '../../components/Img.astro';
import {getAllGridItems} from '../../lib/queries';
import {tileImage, imageDimensions, imageUrl, buildSrcSet} from '../../lib/image';
import {tileHref, cleanKey, explicitTreatment} from '../../lib/tiles';
import {stripStegaKey} from '../../lib/stega';
import {clusterCard} from '../../lib/clusterCard';
import {museumLabel} from '../../lib/museumLabel';


const clean = (s: unknown) => stripStegaKey(s).replace(/\s+/g, ' ').trim();
const items: any[] = (await getAllGridItems()).filter((it: any) => tileImage(it) && imageDimensions(tileImage(it)));
const isProject = (it: any) => cleanKey(it.pageType) === 'Case Study';
const idOf = (it: any) => cleanKey(it._id).replace(/^drafts\./, '');
const byTitle = (a: any, z: any) => clean(a.title).localeCompare(clean(z.title));
const rank = (it: any) => (typeof it.orderRank === 'string' ? it.orderRank : null);
// Lettering: the categories the portfolio files under Type/Lettering, and
// the marks Chris set by hand.
const isType = (it: any) => ['Typography', 'Illustration'].includes(cleanKey(it.category)) || explicitTreatment(it) === 'mark';

const studies = items
  .filter(isProject)
  .sort((a, z) => {
    const ra = rank(a);
    const rz = rank(z);
    if (ra && rz) return ra < rz ? -1 : 1;
    if (ra || rz) return ra ? -1 : 1;
    return byTitle(a, z);
  });

type Row = {title: string; href: string | null; card: ReturnType<typeof clusterCard> | null; pieces: any[]};
const used = new Set<string>();
const rows: Row[] = [];
for (const s of studies) {
  const href = tileHref(s);
  const own = [s, ...items.filter((x) => !isProject(x) && href && tileHref(x) === href)];
  own.sort((a, z) => Number(isType(z)) - Number(isType(a)) || Number(z === s) - Number(a === s) || byTitle(a, z));
  for (const it of own) used.add(idOf(it));
  rows.push({title: clean(s.parentTitle ?? s.title), href, card: clusterCard(s), pieces: own});
}
const loose = items.filter((x) => !used.has(idOf(x)) && isType(x)).sort(byTitle);
if (loose.length) rows.push({title: 'More lettering', href: null, card: null, pieces: loose});

const keyOf = (it: any) => (it.slug?.current ? cleanKey(it.slug.current) : idOf(it));
const aspectOf = (it: any) => {
  const d = imageDimensions(tileImage(it))!;
  return d.width / d.height;
};
// The viewer's copy: as wide as a large screen shows it.
const viewOf = (it: any) => {
  const img = tileImage(it);
  const label = museumLabel(it);
  return {
    'data-src': imageUrl(img)?.width(1600).url(),
    'data-srcset': buildSrcSet(img, 2400),
    'data-title': clean(label?.title ?? it.title),
    'data-detail': label?.detail ?? '',
  };
};
// The row's height, in CSS pixels (global.css, --ty-h): for the sizes hint.
const H = {desktop: 300, phone: 200};
---

<Layout title="Type/Lettering - Rumeau Design Co" description="The portfolio, a row per project." noindex>
  {/* The page's heading, for screen readers and search, as on /portfolio. */}
  <h1 class="visually-hidden">Portfolio: Type/Lettering</h1>
  <div class="ty pf-section">
    <div class="pf-controls">
      <div class="pf-group pf-group--filters" role="group" aria-label="Views">
        <a class="pf-btn" href="/portfolio/all">All</a>
        <a class="pf-btn" href="/portfolio">Brand Identity</a>
        <a class="pf-btn" href="/portfolio?view=merch">Merch &amp; Apparel</a>
        <a class="pf-btn is-active" href="/portfolio/type" aria-current="page">Type/Lettering</a>
      </div>
    </div>

    <ol class="ty-rows">
      {rows.map((row) => (
        <li class="ty-row" data-title={row.title} data-href={row.href ?? undefined}>
          <div class="ty-head">
            <h2 class="ty-title">{row.href ? <a href={row.href}>{row.title}</a> : row.title}</h2>
            {row.card?.kicker && <p class="ty-kicker">{row.card.kicker}</p>}
            {row.card?.line && <p class="ty-line">{row.card.line}</p>}
            {row.href && (
              <a class="ty-go" href={row.href}>
                The project <span aria-hidden="true">&rarr;</span>
              </a>
            )}
          </div>
          <div class="ty-track">
          <ul class="ty-strip" aria-label={row.title}>
            {row.pieces.map((it) => {
              const a = aspectOf(it);
              const mark = explicitTreatment(it) === 'mark';
              return (
                <li class:list={['ty-piece', mark && 'ty-piece--air']} style={`--a:${a.toFixed(3)}`}>
                  <a href={`/portfolio/up-close#${keyOf(it)}`} aria-label={clean(it.title)} {...viewOf(it)}>
                    <Img
                      image={tileImage(it)}
                      alt=""
                      width={1400}
                      sizes={`(min-width: 48rem) ${Math.round(H.desktop * a)}px, ${Math.round(H.phone * a)}px`}
                      loading="lazy"
                      field="Grid Thumbnail (type rows)"
                    />
                  </a>
                </li>
              );
            })}
          </ul>
          <button type="button" class="ty-more ty-more--back" aria-label="Back along the row" hidden>&larr;</button>
          <button type="button" class="ty-more ty-more--on" aria-label="On along the row" hidden>&rarr;</button>
          </div>
        </li>
      ))}
    </ol>

    <dialog class="ty-view" aria-label="The piece">
      <figure class="ty-view__fig">
        <div class="ty-view__stage"><img class="ty-view__img" alt="" /></div>
        <figcaption class="ty-view__bar">
          <span class="ty-view__label">
            <span class="ty-view__title"></span>
            <span class="ty-view__detail"></span>
          </span>
          <span class="ty-view__count"></span>
          <span class="ty-view__links">
            <a class="ty-view__closer" href="/portfolio/up-close">Look closer <span aria-hidden="true">&rarr;</span></a>
            <a class="ty-view__project" href="/">The project <span aria-hidden="true">&rarr;</span></a>
          </span>
        </figcaption>
      </figure>
      <button type="button" class="ty-view__step ty-view__step--back" aria-label="Previous piece">&larr;</button>
      <button type="button" class="ty-view__step ty-view__step--on" aria-label="Next piece">&rarr;</button>
      <button type="button" class="ty-view__x" aria-label="Close">&times;</button>
    </dialog>
  </div>
</Layout>

<script>
  /*
    The viewer: a piece opens over the rows, with the row's others a step
    away. Opening adds an entry to the history, so the browser's back
    closes it rather than leaving the page.
  */
  const view = document.querySelector<HTMLDialogElement>('.ty-view')!;
  const img = view.querySelector<HTMLImageElement>('.ty-view__img')!;
  const q = <T extends Element>(s: string) => view.querySelector<T>(s)!;
  let row: HTMLElement | null = null;
  let at = 0;
  let pushed = false;

  const linksOf = (r: HTMLElement) => Array.from(r.querySelectorAll<HTMLAnchorElement>('.ty-piece a'));

  function show(r: HTMLElement, i: number) {
    const links = linksOf(r);
    at = (i + links.length) % links.length;
    row = r;
    const a = links[at];
    img.removeAttribute('src');
    img.srcset = a.dataset.srcset ?? '';
    img.sizes = '90vw';
    img.src = a.dataset.src ?? '';
    img.alt = a.dataset.title ?? '';
    view.classList.toggle('is-air', !!a.closest('.ty-piece--air'));
    q('.ty-view__title').textContent = a.dataset.title ?? '';
    q('.ty-view__detail').textContent = [r.dataset.href ? r.dataset.title : null, a.dataset.detail].filter(Boolean).join(' \u00b7 ');
    q('.ty-view__count').textContent = links.length > 1 ? `${at + 1} / ${links.length}` : '';
    q<HTMLAnchorElement>('.ty-view__closer').href = a.getAttribute('href')!;
    const project = q<HTMLAnchorElement>('.ty-view__project');
    project.hidden = !r.dataset.href;
    if (r.dataset.href) project.href = r.dataset.href;
    view.querySelectorAll<HTMLElement>('.ty-view__step').forEach((b) => (b.hidden = links.length < 2));
    // Keep the row under the viewer at the piece shown.
    a.closest('.ty-piece')!.scrollIntoView({block: 'nearest', inline: 'nearest'});
  }

  function open(a: HTMLAnchorElement) {
    const r = a.closest<HTMLElement>('.ty-row')!;
    show(r, linksOf(r).indexOf(a));
    if (!view.open) {
      view.showModal();
      history.pushState({tyView: true}, '');
      pushed = true;
    }
  }

  // Closing goes back through the history entry opening added.
  function close() {
    if (pushed) history.back();
    else view.close();
  }
  addEventListener('popstate', () => {
    pushed = false;
    if (view.open) view.close();
  });
  view.addEventListener('close', () => {
    if (row) linksOf(row)[at]?.focus({preventScroll: true});
  });

  document.querySelectorAll<HTMLAnchorElement>('.ty-piece a').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      open(a);
    }),
  );
  view.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
  q('.ty-view__x').addEventListener('click', close);
  q('.ty-view__step--back').addEventListener('click', () => row && show(row, at - 1));
  q('.ty-view__step--on').addEventListener('click', () => row && show(row, at + 1));
  // Outside the picture and its caption closes it.
  view.addEventListener('click', (e) => {
    if (e.target === view || (e.target as HTMLElement).classList.contains('ty-view__stage')) close();
  });
  view.addEventListener('keydown', (e) => {
    if (!row) return;
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    // The page deck (PageDeck.astro) turns pages on these; not here.
    e.preventDefault();
    show(row, at + (e.key === 'ArrowRight' ? 1 : -1));
  });

  // A row's arrows, on a wide screen, when it runs past the edge.
  document.querySelectorAll<HTMLElement>('.ty-track').forEach((track) => {
    const strip = track.querySelector<HTMLElement>('.ty-strip')!;
    const back = track.querySelector<HTMLButtonElement>('.ty-more--back')!;
    const on = track.querySelector<HTMLButtonElement>('.ty-more--on')!;
    const update = () => {
      back.hidden = strip.scrollLeft < 4;
      on.hidden = strip.scrollLeft + strip.clientWidth > strip.scrollWidth - 4;
    };
    const by = (d: number) => strip.scrollBy({left: d * strip.clientWidth * 0.8, behavior: 'smooth'});
    back.addEventListener('click', () => by(-1));
    on.addEventListener('click', () => by(1));
    strip.addEventListener('scroll', update, {passive: true});
    addEventListener('resize', update);
    update();
  });
</script>

<!-- Styles: global.css, TYPE ROWS (PREVIEW). -->
