---
/*
  COPIER MODE - preview only, at /next/copier/mode: a sample of the
  portfolio and its words, with the switch. The look itself lives in
  src/components/Copier.astro, carried by the layout on the preview and
  shared with the 404 ("lost in the copier") and the site's secret button,
  the © in the footer - so tuning it here tunes it there.

  Never built for production (getStaticPaths), and noindex.
*/
import Layout from '../../../layouts/Layout.astro';
import Img from '../../../components/Img.astro';
import {getAllGridItems} from '../../../lib/queries';
import {tileImage} from '../../../lib/image';
import {stripStegaKey} from '../../../lib/stega';

export async function getStaticPaths() {
  if (import.meta.env.PUBLIC_IS_PREVIEW !== 'true') return [];
  return [{params: {page: 'mode'}}];
}

const clean = (s: unknown) => stripStegaKey(s).replace(/\s+/g, ' ').trim();
const all = ((await getAllGridItems()) as any[]).filter((it) => tileImage(it));
// A spread of the work: every few pieces, so it is not all one project.
const step = Math.max(1, Math.floor(all.length / 12));
const pieces = all.filter((_, i) => i % step === 0).slice(0, 12);
---

<Layout title="Copier mode - Rumeau Design Co" description="The portfolio, photocopied." noindex>
  <div class="cp">
    <div class="cp-bar" role="group" aria-label="Copier">
      <button type="button" data-copy="off" aria-pressed="true">Original</button>
      <button type="button" data-copy="on" aria-pressed="false">Copied</button>
    </div>

    <header class="cp-head">
      <h1>Brand identity &amp; merch, for heritage apparel brands and musicians.</h1>
      <p>A sample of the portfolio and its words, run through the copier. The pictures, the type and the paper all go together.</p>
    </header>
    <ul class="cp-grid">
      {pieces.map((p) => (
        <li>
          <Img image={tileImage(p)} alt={clean(p.title)} width={600} sizes="(min-width: 48rem) 25vw, 50vw" loading="lazy" />
          <span class="cp-name copier-small">{clean(p.title)}</span>
        </li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  .cp {
    padding: var(--space-4, 1.5rem) 0 var(--space-6, 4rem);
  }
  .cp-bar {
    position: sticky;
    top: 0.75rem;
    z-index: 5;
    display: inline-flex;
    margin-bottom: 1.5rem;
    border: 2px solid var(--color-navy);
    background: #fff;
  }
  .cp-bar button {
    font: inherit;
    font-size: 0.875rem;
    padding: 0.5rem 0.9rem;
    border: 0;
    background: #fff;
    color: var(--color-navy);
    cursor: pointer;
  }
  .cp-bar button + button {
    border-left: 1px solid var(--color-navy);
  }
  .cp-bar button[aria-pressed='true'] {
    background: var(--color-navy);
    color: #fff;
  }
  .cp-head {
    max-width: 44rem;
    margin-bottom: 2rem;
  }
  .cp-head h1 {
    margin: 0 0 1rem;
    font: 800 clamp(1.75rem, 1rem + 3.2vw, 3.5rem) / 1.02 var(--font-heading);
    letter-spacing: -0.03em;
    color: var(--color-navy);
  }
  .cp-head p {
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .cp-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 4;
    column-gap: 14px;
  }
  .cp-grid li {
    break-inside: avoid;
    margin-bottom: 16px;
  }
  .cp-grid :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .cp-name {
    display: inline-block;
    margin-top: 0.35rem;
    font-size: 0.8125rem;
  }
  @media (max-width: 47.99rem) {
    .cp-grid {
      columns: 2;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', () => {
      document.documentElement.classList.toggle('is-copied', b.dataset.copy === 'on');
      document.querySelectorAll('[data-copier-switch]').forEach((s) => s.setAttribute('aria-pressed', String(b.dataset.copy === 'on')));
      document.querySelectorAll('[data-copy]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    }),
  );
</script>
