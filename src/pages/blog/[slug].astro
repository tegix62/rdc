---
import Layout from '../../layouts/Layout.astro';
import Img from '../../components/Img.astro';
import { sanityClient } from '../../lib/sanity';
import { getBlogPost } from '../../lib/queries';
import { urlFor } from '../../lib/image';
import { renderPortableText } from '../../lib/portableText';

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(`*[_type == "blogPost"].slug.current`);
  return slugs.map((slug: string) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await getBlogPost(slug!);
if (!post) {
  throw new Error(`Blog post not found for slug: ${slug}`);
}

const ogSource = post.mainImage ?? post.thumbnailImage;
const ogImage = ogSource
  ? urlFor(ogSource).width(1200).height(630).fit('crop').url()
  : undefined;
---

<Layout
  title={post.title}
  description={post.metaDescription ?? post.excerpt}
  ogType="article"
  ogImage={ogImage}
>
  <article>
    <h1>{post.title}</h1>
    <p class="card__meta">
      {post.author}
      {post.publishedAt && ` · ${new Date(post.publishedAt).toLocaleDateString()}`}
    </p>
    {post.mainImage && (
      <Img image={post.mainImage} alt={post.title} width={1600} sizes="100vw" loading="eager" fetchpriority="high" />
    )}
    {post.body?.length > 0 && (
      <div class="prose" set:html={renderPortableText(post.body)} />
    )}
  </article>
</Layout>
