---
/*
  "Ink mode" - collapses the whole site to one ink colour on coloured stock,
  after 1980s one-colour offset/riso fantasy zines.

  How it works, and why this way:

  Images are pushed to greyscale, then contrast is cranked, then they are
  multiplied over the paper colour. Multiply means white areas take the paper
  colour and dark areas stay dark, which is exactly what one ink on coloured
  stock does. Crucially this is all `filter` and `mix-blend-mode` - both
  compositor-friendly - rather than SVG filters, which Chrome does not
  GPU-accelerate and which would visibly stall a 66-tile portfolio grid.

  Threshold is `contrast()` taken far past 100%, with `brightness()` shifting
  where the cut falls. That is the cheap 1-bit trick and it is tunable per
  image, which matters: thresholding destroys low-contrast work, so anything
  photographic needs a softer setting or none at all.

  The choice is written to <html> before first paint by an inline script, so
  reloading in ink mode doesn't flash the full-colour site first.
*/

// Named after the stock colours in the reference zines. `ink` is deliberately
// near-black rather than pure black - slightly lifted reads more like real
// press ink and less like a screenshot.
const PAPERS = [
  /*
    Press is the archive: plain white stock, black ink, no colour cast. Chris
    wanted the black-and-white archive view and the riso zine treatment to be
    one idea rather than two controls, and a white paper stock is what makes
    that work - the archive is simply print mode on white.
  */
  { id: 'press', label: 'Press', paper: '#ffffff', ink: '#0d0d0d' },
  { id: 'bone', label: 'Bone', paper: '#f4efe3', ink: '#141110' },
  { id: 'blood', label: 'Blood', paper: '#e5473c', ink: '#150605' },
  { id: 'acid', label: 'Acid', paper: '#c3e84f', ink: '#101504' },
  { id: 'shock', label: 'Shock', paper: '#f45fa4', ink: '#17040d' },
  { id: 'ice', label: 'Ice', paper: '#a9c9e8', ink: '#040b15' },
];
---

{/*
  Collapsed to a single corner button by default.

  This is an experimental tool rather than site furniture, so it should not cost
  screen space or pull the eye on a page meant to show work to a client. The
  handle stays deliberately recessed - thin outline, no fill, part opacity -
  until hovered or until print mode is actually on, at which point it fills in so
  the state is legible without expanding anything.

  44x44 even so. It would be smaller still as a slim edge tab, but the page audit
  measures every control against a 44px floor and a knowingly-failing one is
  worse than a slightly larger button.
*/}
<div class="ink-bar" role="group" aria-label="Print mode" data-open="false" id="ink-bar">
  <div class="ink-bar__panel" id="ink-panel" hidden>
    <button type="button" class="ink-bar__toggle" id="ink-toggle" aria-pressed="false">
      <span class="ink-bar__toggle-label">Print mode</span>
    </button>

    <div class="ink-bar__papers" id="ink-papers" hidden>
    {PAPERS.map((p) => (
      <button
        type="button"
        class="ink-bar__swatch"
        data-paper={p.id}
        style={`--swatch: ${p.paper}; --swatch-ink: ${p.ink}`}
        aria-label={`${p.label} stock`}
        title={p.label}
      ></button>
    ))}
      <button type="button" class="ink-bar__swatch ink-bar__swatch--grain" id="ink-grain" aria-pressed="false" title="Grain">
        <span aria-hidden="true">▚</span>
      </button>
    </div>
  </div>

  <button
    type="button"
    class="ink-bar__handle"
    id="ink-handle"
    aria-expanded="false"
    aria-controls="ink-panel"
    aria-label="Print mode options"
    title="Print mode"
  >
    <span aria-hidden="true">▚</span>
  </button>
</div>

{/* Inline and un-bundled so it runs before the first paint. */}
<script is:inline define:vars={{ PAPERS }}>
  (() => {
    const root = document.documentElement;
    const KEY = 'rdc-ink';

    const apply = (state) => {
      if (!state || !state.on) {
        root.removeAttribute('data-ink');
        root.removeAttribute('data-ink-grain');
        root.style.removeProperty('--ink-paper');
        root.style.removeProperty('--ink-ink');
        return;
      }
      const paper = PAPERS.find((p) => p.id === state.paper) ?? PAPERS[0];
      root.setAttribute('data-ink', paper.id);
      root.style.setProperty('--ink-paper', paper.paper);
      root.style.setProperty('--ink-ink', paper.ink);
      if (state.grain) root.setAttribute('data-ink-grain', 'on');
      else root.removeAttribute('data-ink-grain');
    };

    /*
      Swap in authored black-and-white alternates.

      Any image carrying data-archive-src has a hand-thresholded version, which
      beats anything the CSS filter can do - a computed threshold flattens
      midtones, whereas these were drawn. Images without one keep the filter, so
      this gets better as more are made and never breaks while they aren't.

      Swapped rather than rendered as a hidden second <img>, because a hidden
      image is still fetched in most browsers and that would mean every visitor
      downloading two portfolios to look at one. The original src is stashed on
      first swap so turning print mode off restores it exactly.
    */
    const swapArchive = (on) => {
      for (const img of document.querySelectorAll('img[data-archive-src]')) {
        if (on) {
          if (!img.dataset.originalSrc) {
            img.dataset.originalSrc = img.getAttribute('src') || '';
            img.dataset.originalSrcset = img.getAttribute('srcset') || '';
          }
          img.setAttribute('src', img.dataset.archiveSrc);
          // The archive file is one fixed rendering, so any srcset from the
          // colour version would point the browser back at colour candidates.
          img.removeAttribute('srcset');
          img.removeAttribute('sizes');
        } else if (img.dataset.originalSrc) {
          img.setAttribute('src', img.dataset.originalSrc);
          if (img.dataset.originalSrcset) img.setAttribute('srcset', img.dataset.originalSrcset);
        }
      }
    };

    // `open` is only the panel's visibility, kept with the rest so the tool
    // stays where you left it rather than re-collapsing on every page.
    let state = { on: false, paper: 'bone', grain: true, open: false };
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (saved) state = { ...state, ...saved };
    } catch {}
    apply(state);

    const save = () => {
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch {}
    };

    // The controls are below this script in the document, so wait for them.
    document.addEventListener('DOMContentLoaded', () => {
      const bar = document.getElementById('ink-bar');
      const handle = document.getElementById('ink-handle');
      const panel = document.getElementById('ink-panel');
      const toggle = document.getElementById('ink-toggle');
      const papers = document.getElementById('ink-papers');
      const grain = document.getElementById('ink-grain');
      if (!toggle || !papers || !bar || !handle || !panel) return;

      const sync = () => {
        toggle.setAttribute('aria-pressed', String(state.on));
        papers.hidden = !state.on;
        grain?.setAttribute('aria-pressed', String(!!state.grain));
        for (const b of papers.querySelectorAll('[data-paper]')) {
          b.classList.toggle('is-active', state.on && b.dataset.paper === state.paper);
        }
        panel.hidden = !state.open;
        bar.setAttribute('data-open', String(!!state.open));
        handle.setAttribute('aria-expanded', String(!!state.open));
        // The handle fills in when print mode is active, so the state is
        // readable while collapsed.
        handle.setAttribute('data-active', String(!!state.on));
      };
      sync();

      handle.addEventListener('click', () => {
        state.open = !state.open;
        save();
        sync();
      });

      // Escape collapses it, which is the expected way out of a panel that
      // covers part of the page.
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && state.open) {
          state.open = false;
          save();
          sync();
        }
      });

      // Runs on load as well as on click, so arriving already in print mode
      // shows the marks rather than waiting for a toggle.
      swapArchive(state.on);

      toggle.addEventListener('click', () => {
        state.on = !state.on;
        apply(state);
        swapArchive(state.on);
        save();
        sync();
      });

      papers.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-paper]');
        if (!btn) return;
        state.paper = btn.dataset.paper;
        state.on = true;
        apply(state);
        swapArchive(true);
        save();
        sync();
      });

      grain?.addEventListener('click', () => {
        state.grain = !state.grain;
        apply(state);
        save();
        sync();
      });
    });
  })();
</script>
