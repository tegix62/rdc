---
/*
  ============================================================================
  EXPERIMENT - NOT A DECISION. Delete this file and its one line in
  Layout.astro to remove it entirely; nothing else depends on it.
  ============================================================================

  WHAT IT IS

  A way to SEE the related-work cards ("More Work" on a case study, "See the
  work" on a blog post) drawn with each project's Archive Mark instead of its
  photographic thumbnail, without shipping that as the site's behaviour.

  OFF for every visitor. It turns on only for whoever adds ?marks to the URL,
  and stays on for that browser tab so you can click between projects and
  judge it as a set rather than one page at a time - which is the whole point,
  since the cards are how you move between projects.

    ?marks      on           /work/two-point-oh?marks
    ?marks=off  off          or click the badge

  WHY IT COSTS NOTHING WHEN OFF

  Img.astro already emits the mark as data-archive-src rather than as a second
  <img> - precisely because a hidden image still gets downloaded in most
  browsers, and nobody should pay for a version of the page they may never
  ask for. So the marks are addresses in the HTML until this script swaps one
  in. The script itself bails on its first two lines when the flag is absent.

  TWO WAYS A CARD CAN BE AN ARCHIVE CARD

  1. It has an Archive Mark, which is swapped in and set `contain` inside the
     same box the thumbnail used - so nothing is cropped and nothing shifts. A
     trimmed logomark cover-cropped to 4:5 would just be wrong, and would tell
     you nothing about the idea.

  2. It has no Archive Mark, and its existing image gets the ink treatment
     instead: the same grayscale/brightness/contrast and multiply blend the
     dormant print mode uses on every image.

  The second case is the point, not a consolation. An empty Archive Mark
  field usually means the tile ALREADY IS the mark - Chateau Seven's thumbnail
  is its logo, so there was nothing to add - and an earlier version of this
  left those cards in full colour, which showed a half-converted grid rather
  than the idea. Filtering in place is what makes the row read as one set
  whether or not a separate mark was ever drawn.

  Per-image tuning still applies: Img.astro emits data-ink-mode from Studio,
  and soft / hard / skip are honoured here the same way print mode honours
  them.

  The badge still reports the split, because which cards took which route is
  worth knowing - a card that had to be filtered is a card where a drawn mark
  might do better.
*/
---

<style is:global>
  /*
    Scoped behind the attribute the script sets, so none of this applies
    unless the experiment is switched on.
  */
  [data-mark-experiment] .card[data-mark='drawn'] img {
    object-fit: contain;
    background: transparent;
    padding: 8%;
  }

  /*
    No drawn mark: ink the image that IS there.

    Same declaration as `:root[data-ink] img` - desaturate, push contrast,
    multiply onto the stock so white goes to paper and dark stays dark. It
    cannot simply reuse that rule, because that one is scoped to the whole
    document being in print mode, and turning print mode on to preview four
    cards would repaint the entire site.

    The three variant values below mirror the ones in the print-mode block.
    Duplicated on purpose: this file has to delete cleanly on its own, and an
    experiment that reaches into shipped rules is harder to remove than to
    keep. If the experiment graduates, these collapse back into one place.
  */
  [data-mark-experiment] .card[data-mark='inked'] img {
    filter: grayscale(1) brightness(var(--ink-bright, 108%))
      contrast(var(--ink-contrast, 260%));
    mix-blend-mode: multiply;
  }

  /* Photographic and low-contrast work loses everything to a hard cut. */
  [data-mark-experiment] .card[data-mark='inked'] img[data-ink-mode='soft'] {
    --ink-contrast: 125%;
    --ink-bright: 102%;
  }

  [data-mark-experiment] .card[data-mark='inked'] img[data-ink-mode='hard'] {
    --ink-contrast: 900%;
    --ink-bright: 112%;
  }

  /* Left in full colour - for anything the conversion simply ruins. */
  [data-mark-experiment] .card[data-mark='inked'] img[data-ink-mode='skip'] {
    filter: none;
    mix-blend-mode: normal;
  }

  .mark-badge {
    position: fixed;
    left: var(--space-2);
    bottom: var(--space-2);
    z-index: 9998;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: var(--color-white, #fff);
    color: var(--color-navy, #1a1a1a);
    font-family: var(--font-heading, inherit);
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
  }

  .mark-badge__count {
    opacity: 0.6;
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'rdc-mark-experiment';
    var param = new URLSearchParams(location.search).get('marks');
    var on;

    if (param !== null) {
      on = param !== '0' && param !== 'off' && param !== 'false';
      try { sessionStorage.setItem(KEY, on ? '1' : '0'); } catch (e) {}
    } else {
      try { on = sessionStorage.getItem(KEY) === '1'; } catch (e) { on = false; }
    }
    if (!on) return;

    function run() {
      document.documentElement.setAttribute('data-mark-experiment', '');

      var cards = document.querySelectorAll(
        '.work-related .card, .blog-related .card'
      );
      if (!cards.length) return;

      var drawn = 0;
      var inked = [];

      cards.forEach(function (card) {
        var img = card.querySelector('img');
        if (!img) return;
        var src = img.getAttribute('data-archive-src');

        if (!src) {
          // No drawn mark: ink whatever is already there. See the CSS above.
          card.setAttribute('data-mark', 'inked');
          var t = card.querySelector('.card__title');
          inked.push(t ? t.textContent.trim() : 'untitled');
          return;
        }

        /*
          srcset and sizes have to go, or the browser keeps choosing from the
          candidate list built for the THUMBNAIL and the new src is ignored -
          srcset wins over src whenever both are present.
        */
        img.removeAttribute('srcset');
        img.removeAttribute('sizes');
        img.src = src;
        card.setAttribute('data-mark', 'drawn');
        drawn++;
      });

      var badge = document.createElement('button');
      badge.type = 'button';
      badge.className = 'mark-badge';
      badge.innerHTML =
        'Archive marks on <span class="mark-badge__count">' +
        drawn + ' drawn / ' + cards.length +
        (inked.length ? ' · inked: ' + inked.join(', ') : '') +
        '</span>';
      badge.title = 'Click to switch back to thumbnails';
      badge.addEventListener('click', function () {
        try { sessionStorage.setItem(KEY, '0'); } catch (e) {}
        /*
          The PARAM has to go too, not just the stored flag. A plain reload
          keeps ?marks in the address bar, the param outranks storage on the
          way back in, and the badge turns the experiment off and straight
          back on - which is what it did the first time this was measured.
        */
        var url = new URL(location.href);
        url.searchParams.delete('marks');
        location.replace(url.toString());
      });
      document.body.appendChild(badge);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }
  })();
</script>
