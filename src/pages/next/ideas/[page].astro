---
/*
  THE IDEAS, ON ONE PAGE - preview only, at /next/ideas/all: everything
  tried on the preview the night of 30-31 October 2026, so Chris can walk
  through them in the morning. Each says what it is, where it is, and what
  (if anything) it needs from him.

  Never built for production (getStaticPaths), and noindex.
*/
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  if (import.meta.env.PUBLIC_IS_PREVIEW !== 'true') return [];
  return [{params: {page: 'all'}}];
}

const ideas = [
  {
    name: 'Currently, and the commission tickets',
    href: '/',
    what: 'Under the homepage intro: "Currently: ..." and the next season\'s slots as numbered tickets, the taken ones stamped.',
    needs: 'Site Settings > Homepage > "Currently" line; Site Settings > Booking > the slots.',
  },
  {
    name: 'Votes, signed',
    href: '/portfolio?view=all&vote=1',
    what: 'The button says Vote. After a first vote, people can put their name or @handle and a link on it, public or just for you. Public names email you first; with Votes on, approved names tag the pieces.',
    needs: 'Votes need the database connected to the preview in Cloudflare (Pages > Settings > Bindings > D1, name DB). And a line in the privacy policy, for your review.',
  },
  {
    name: 'The road',
    href: '/next/road/map',
    what: 'Your freelance years as a map you walk down by scrolling; headings now in Friend (?type=plain to compare).',
    needs: 'Stops in Studio under The road. Landmark drawings when you have them.',
  },
  {
    name: 'Friend, where it works',
    href: '/next/friend/specimen',
    what: 'Friend beside the site\'s type in five places, with the site\'s own words.',
    needs: 'Your eye: which places, if any.',
  },
  {
    name: 'Shapes by type',
    href: '/next/shapes/compare',
    what: 'The same pieces as uploaded, and shaped by their Asset Type - shirts 4:5, records square, sheets and videos wide. A switch flips between them.',
    needs: 'Your eye. Pieces with no Asset Type are outlined in red.',
  },
  {
    name: 'The yearly free one',
    href: '/next/free/one',
    what: 'Once a year, one band or small business, designed for free and shown start to finish.',
    needs: 'Site Settings > Booking: the year, open or not, your words, where stories go.',
  },
  {
    name: 'The register',
    href: '/next/register/runs',
    what: 'Every run of merch and prints as a numbered ledger: for whom, what, how many, how it went.',
    needs: 'Runs in Studio under Register run. Until then, the merch pieces stand in.',
  },
  {
    name: 'In the wild',
    href: '/next/sightings/wild',
    what: 'Your work out in the world. Strangers just tag #rumeauinthewild or email you; you add the ones you like.',
    needs: 'Photos in Studio under Sighting - yours count.',
  },
  {
    name: 'An issue',
    href: '/next/issue/latest',
    what: 'The work as a seasonal issue: a cover with the masthead, the contents, a note, the pieces.',
    needs: 'An Issue in Studio: number, season, cover, a few lines, the work.',
  },
  {
    name: 'Copier mode',
    href: '/next/copier/mode',
    what: 'Original, copy, copy of a copy: a noisy black glow on everything, a fade, paper and toner, a crooked page.',
    needs: 'Your eye. If it works, it could replace the print mode on the portfolio.',
  },
  {
    name: 'Candlelight',
    href: '/next/candle/light',
    what: 'DumpStat in a dark room, by a small warm light you carry. For the dismal fantasy page, if that happens.',
    needs: 'Nothing.',
  },
];
---

<Layout title="Tonight's ideas - Rumeau Design Co" description="Everything tried on the preview overnight." noindex>
  <div class="id">
    <header class="id-head">
      <h1>Tonight's ideas</h1>
      <p>Everything tried on the preview overnight, one link each. Nothing here is live.</p>
    </header>
    <ol class="id-list">
      {ideas.map((i, n) => (
        <li>
          <span class="id-no">{String(n + 1).padStart(2, '0')}</span>
          <div>
            <h2><a href={i.href}>{i.name}</a></h2>
            <p>{i.what}</p>
            <p class="id-needs"><b>Needs:</b> {i.needs}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Layout>

<style>
  .id {
    max-width: 48rem;
    margin: 0 auto;
    padding: var(--space-5, 3rem) var(--space-4, 1.5rem) var(--space-6, 4rem);
  }
  .id-head h1 {
    margin: 0 0 0.5rem;
    font: 800 clamp(2.25rem, 6vw, 3.75rem) / 0.95 var(--font-heading);
    letter-spacing: -0.035em;
    color: var(--color-navy);
  }
  .id-head {
    margin-bottom: 2rem;
  }
  .id-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--color-navy);
  }
  .id-list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .id-no {
    font: 700 0.875rem/1.6 var(--font-heading);
    font-variant-numeric: tabular-nums;
    color: var(--color-gray);
  }
  .id-list h2 {
    margin: 0 0 0.35rem;
    font: 800 1.375rem/1.1 var(--font-heading);
    letter-spacing: -0.02em;
  }
  .id-list h2 a {
    color: var(--color-navy);
  }
  .id-list p {
    margin: 0 0 0.35rem;
    line-height: 1.5;
  }
  .id-needs {
    font-size: 0.875rem;
    color: var(--color-gray);
  }
  .id-needs b {
    color: var(--color-ink);
  }
</style>
