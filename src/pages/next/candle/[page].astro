---
/*
  CANDLELIGHT - preview only, at /next/candle/light. The dismal fantasy
  idea: a dark room, and the pointer (or a finger) carries a small warm
  light that shows the work as it moves. Chris: "Candlelight is a fun
  gimmick if I go the dismal fantasy route" - so it is tried here, on its
  own page, never on the portfolio.

  The work is DumpStat's, the project that grew out of that aesthetic (any
  piece filed under a project with "dump" in its name), else the
  illustration. The light is a mask over a dark layer, moved by a CSS
  variable - no canvas, nothing heavy. It flickers a little, slows when it
  is still, and is set down where it was left. With reduced motion asked
  for, it holds still; "Light every candle" shows the room plainly for
  anyone who would rather just look.

  Never built for production (getStaticPaths), and noindex.
*/
import Layout from '../../../layouts/Layout.astro';
import Img from '../../../components/Img.astro';
import {getAllGridItems} from '../../../lib/queries';
import {tileImage} from '../../../lib/image';
import {stripStegaKey} from '../../../lib/stega';

export async function getStaticPaths() {
  if (import.meta.env.PUBLIC_IS_PREVIEW !== 'true') return [];
  return [{params: {page: 'light'}}];
}

const clean = (s: unknown) => stripStegaKey(s).replace(/\s+/g, ' ').trim();
const all = ((await getAllGridItems()) as any[]).filter((it) => tileImage(it));
const dump = all.filter((it) => /dump/i.test(clean(it.parentTitle)) || /dump/i.test(clean(it.title)));
const pieces = (dump.length >= 6 ? dump : all.filter((it) => /illustration/i.test(clean(it.category)))).slice(0, 18);
---

<Layout title="By candlelight - Rumeau Design Co" description="The work in a dark room, by the light you carry." noindex>
  <div class="cl" data-candle>
    <header class="cl-head">
      <h1>By candlelight</h1>
      <p>Move the light over the room.</p>
      <button type="button" class="cl-all" data-all aria-pressed="false">Light every candle</button>
    </header>
    <ul class="cl-room">
      {pieces.map((p) => (
        <li>
          <Img image={tileImage(p)} alt={clean(p.title)} width={700} sizes="(min-width: 48rem) 25vw, 50vw" loading="lazy" />
        </li>
      ))}
    </ul>
    <div class="cl-dark" aria-hidden="true"></div>
  </div>
</Layout>

<style>
  .cl {
    --x: 50vw;
    --y: 40vh;
    --r: 15rem;
    position: relative;
    min-height: 100vh;
    margin: 0 calc(50% - 50vw);
    padding: var(--space-5, 3rem) var(--space-4, 1.5rem) var(--space-6, 4rem);
    background: #14100c;
    color: #e9dcc4;
    overflow: hidden;
  }
  .cl-head {
    position: relative;
    z-index: 3;
    max-width: 30rem;
    margin-bottom: 2rem;
  }
  .cl-head h1 {
    margin: 0 0 0.5rem;
    font: 800 clamp(2rem, 6vw, 4rem) / 0.95 var(--font-heading);
    letter-spacing: -0.03em;
    color: #f2e3c6;
  }
  .cl-head p {
    margin: 0 0 1rem;
    color: #b9a888;
  }
  .cl-all {
    font: 700 0.75rem/1 var(--font-heading);
    letter-spacing: var(--label-track, 0.06em);
    text-transform: uppercase;
    padding: 0.6rem 0.9rem;
    border: 1px solid #b9a888;
    background: transparent;
    color: #f2e3c6;
    cursor: pointer;
  }
  .cl-room {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 4;
    column-gap: 10px;
  }
  .cl-room li {
    break-inside: avoid;
    margin-bottom: 10px;
  }
  .cl-room :global(img) {
    display: block;
    width: 100%;
    height: auto;
    filter: sepia(0.35) saturate(0.9);
  }
  /* The dark, with a hole of warm light where the candle is. */
  .cl-dark {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(
      circle var(--r) at var(--x) var(--y),
      rgba(255, 170, 70, 0.1) 0%,
      rgba(20, 14, 8, 0.15) 35%,
      rgba(12, 9, 6, 0.86) 75%,
      rgba(8, 6, 4, 0.97) 100%
    );
    transition: opacity 0.6s;
  }
  .cl.is-lit .cl-dark {
    opacity: 0;
  }
  @media (max-width: 47.99rem) {
    .cl-room {
      columns: 2;
    }
    .cl {
      --r: 9rem;
    }
  }
</style>

<script>
  const room = document.querySelector<HTMLElement>('[data-candle]');
  if (room) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let x = innerWidth / 2;
    let y = innerHeight * 0.45;
    let tx = x;
    let ty = y;
    const move = (e: PointerEvent) => {
      tx = e.clientX;
      ty = e.clientY;
      if (still) set(1);
    };
    addEventListener('pointermove', move, {passive: true});
    addEventListener('pointerdown', move, {passive: true});

    // The light trails the hand a little, and flickers.
    const set = (flicker: number) => {
      room.style.setProperty('--x', `${x}px`);
      room.style.setProperty('--y', `${y}px`);
      room.style.setProperty('--r', `calc(${innerWidth < 768 ? 9 : 15}rem * ${flicker})`);
    };
    if (still) {
      x = tx;
      y = ty;
      set(1);
    } else {
      let t = 0;
      const frame = () => {
        t += 1;
        x += (tx - x) * 0.18;
        y += (ty - y) * 0.18;
        set(1 + Math.sin(t * 0.21) * 0.012 + Math.sin(t * 0.077) * 0.018);
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }

    room.querySelector<HTMLButtonElement>('[data-all]')!.addEventListener('click', (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      const lit = room.classList.toggle('is-lit');
      b.setAttribute('aria-pressed', String(lit));
      b.textContent = lit ? 'Back to one candle' : 'Light every candle';
    });
  }
</script>
