---
/*
  Renders the flexible layout blocks editors build in Sanity. Shared by case
  study pages and regular pages so both get the same set of building blocks
  and there's only one place to change when a block type is added.
*/
import { urlFor } from '../lib/image';
import Img from './Img.astro';
import { renderPortableText } from '../lib/portableText';

interface Props {
  sections: any[];
}

const { sections } = Astro.props;

function embedUrl(url: string) {
  try {
    const u = new URL(url);
    if (u.hostname.includes('youtube.com') || u.hostname.includes('youtu.be')) {
      // Take the path segment for youtu.be, else the v param. Webflow stored
      // at least one URL as `watch?v=ID?si=...` (a second `?` instead of `&`),
      // which makes the whole tail land in the `v` value — so trim at any
      // stray separator rather than trusting the param verbatim.
      const raw = u.hostname.includes('youtu.be')
        ? u.pathname.slice(1)
        : (u.searchParams.get('v') ?? '');
      const id = raw.split(/[?&/]/)[0];
      return id ? `https://www.youtube.com/embed/${id}` : url;
    }
    if (u.hostname.includes('vimeo.com')) {
      const id = u.pathname.split('/').filter(Boolean).pop();
      return id ? `https://player.vimeo.com/video/${id}` : url;
    }
    return url;
  } catch {
    return url;
  }
}
---

{sections?.map((section: any) => {
  switch (section._type) {
    case 'fullImageSection':
      return section.image ? (
        <div class="work-section work-section--full">
          <Img image={section.image} alt={section.alt ?? ''} width={2000} sizes="100vw" />
        </div>
      ) : null;
    case 'twoUpSection':
      return (
        <div class="work-section work-section--two-up">
          {section.imageLeft && (
            <Img image={section.imageLeft} alt="" width={1200} sizes="(max-width: 40rem) 100vw, 50vw" />
          )}
          {section.imageRight && (
            <Img image={section.imageRight} alt="" width={1200} sizes="(max-width: 40rem) 100vw, 50vw" />
          )}
        </div>
      );
    case 'threeUpSection':
      return (
        <div class="work-section work-section--three-up">
          {[section.imageOne, section.imageTwo, section.imageThree].map(
            (img: any) =>
              img && <Img image={img} alt="" width={800} sizes="(max-width: 40rem) 100vw, 33vw" />,
          )}
        </div>
      );
    case 'imageTextSection':
      return (
        <div
          class:list={[
            'work-section',
            'work-section--image-text',
            section.imagePosition === 'Right' && 'is-reversed',
          ]}
        >
          {section.image && (
            <Img image={section.image} alt="" width={1200} sizes="(max-width: 40rem) 100vw, 50vw" />
          )}
          <div class="work-section__text">
            {section.heading && <h3>{section.heading}</h3>}
            {section.text && <p>{section.text}</p>}
          </div>
        </div>
      );
    case 'videoSection':
      return section.url ? (
        <div class="work-section work-section--video">
          <div class="work-video-frame">
            <iframe
              src={embedUrl(section.url)}
              title={section.caption ?? 'Video'}
              loading="lazy"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            />
          </div>
          {section.caption && <p class="work-video-caption">{section.caption}</p>}
        </div>
      ) : null;
    case 'statCalloutSection':
      return (
        <div class="work-section work-section--stat-callout">
          {section.heading && <h3>{section.heading}</h3>}
          {section.checklist?.length > 0 && (
            <ul class="work-stat-checklist">
              {section.checklist.map((item: string) => <li>{item}</li>)}
            </ul>
          )}
          {(section.statValue || section.statLabel) && (
            <p class="work-stat">
              {section.statValue && <strong>{section.statValue}</strong>} {section.statLabel}
            </p>
          )}
        </div>
      );
    case 'textSection':
      return (
        <div class="work-section work-section--text">
          {section.heading && <h3>{section.heading}</h3>}
          {section.body?.length > 0 && <div set:html={renderPortableText(section.body)} />}
        </div>
      );
    case 'achievementsSection':
      return (
        <div class="work-section work-section--achievements">
          <div class="work-section--achievements__images">
            {section.imageLeft && (
              <Img image={section.imageLeft} alt="" width={1200} sizes="(max-width: 40rem) 100vw, 50vw" />
            )}
            {section.imageRight && (
              <Img image={section.imageRight} alt="" width={1200} sizes="(max-width: 40rem) 100vw, 50vw" />
            )}
          </div>
          {section.items?.length > 0 && <div set:html={renderPortableText(section.items)} />}
        </div>
      );
    case 'videoHeroSection':
      return (
        <div class="work-section work-section--video-hero">
          {section.url && (
            <div class="work-video-hero__bg">
              <iframe
                src={embedUrl(section.url)}
                title={section.heading ?? 'Video'}
                loading="lazy"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
              />
            </div>
          )}
          {section.heading && (
            <div class="work-video-hero__overlay">
              <h2>{section.heading}</h2>
            </div>
          )}
        </div>
      );
    default:
      return null;
  }
})}
