---
/*
  A WORLD OF WORK - preview only, at /next/world/home.

  Chris, of the first round: "original Height Map and Biome were the
  exceptional ones. Let's shelve Height Map v2 and Caves", "if this could
  operate like the main grid now, with full functionality of expansion",
  "on Biome ... stuff that's parented to a grid item to hug it, even though
  they don't have a case study", "only leave small noticeable gaps between
  Biomes". See src/lib/world.ts for the rules.

  Two modes: the height map (the original), and biomes (each project, or
  each piece with the pieces parented to it, a tight block; the blocks a
  cell apart). In both, a piece opens as on the main grid: large, its set
  gathered round it, the rest dimmed; a bar above names it, links its
  project and has the way back - as do Escape and the browser's back. The
  opened piece, picked again, goes to its project.

  Pictures are lazy and their tiles hidden until placed. Labels, the
  biomes' tint and the bar's contents are drawn by the script and styled
  inline - the critical-CSS step drops scoped rules for elements that only
  exist once the script runs.

  Never built for production (getStaticPaths), and noindex.
*/
import Layout from '../../../layouts/Layout.astro';
import Img from '../../../components/Img.astro';
import {getAllGridItems} from '../../../lib/queries';
import {tileImage, imageDimensions} from '../../../lib/image';
import {treatmentOf, tileHref, cleanKey} from '../../../lib/tiles';
import {stripStegaKey} from '../../../lib/stega';

export async function getStaticPaths() {
  if (import.meta.env.PUBLIC_IS_PREVIEW !== 'true') return [];
  return [{params: {page: 'home'}}];
}

const clean = (s: unknown) => stripStegaKey(s).replace(/\s+/g, ' ').trim();
const all: any[] = (await getAllGridItems()).filter((it: any) => tileImage(it) && imageDimensions(tileImage(it)));
const isProject = (it: any) => cleanKey(it.pageType) === 'Case Study';

const names: Record<string, string> = {};
for (const it of all) {
  const href = tileHref(it);
  if (href && isProject(it)) names[href] = clean(it.title);
}
const pieces = all.map((it) => {
  const d = imageDimensions(tileImage(it))!;
  return {
    w: d.width,
    h: d.height,
    project: tileHref(it),
    own: isProject(it),
    id: cleanKey(it._id).replace(/^drafts\./, ''),
    parent: it.pieceParent ? cleanKey(it.pieceParent) : null,
    title: clean(it.title),
  };
});
const data = {pieces, names};
---

<Layout title="World - Rumeau Design Co" description="The portfolio as a generated world." noindex>
  <div class="wd">
    <div class="wd-bar">
      <button type="button" class="wd-btn" data-mode="heights">Height map</button>
      <button type="button" class="wd-btn" data-mode="biomes">Biomes</button>
      <button type="button" class="wd-btn wd-btn--roll" data-roll>New world</button>
    </div>
    <p class="wd-about" data-about></p>
    <div class="wd-open" data-open hidden></div>
    <div class="wd-world">
      {all.map((it, i) => (
        <button
          type="button"
          class:list={['wd-piece', treatmentOf(it) === 'mark' && 'wd-piece--mark']}
          data-i={i}
          hidden
          aria-label={clean(it.title)}
        >
          <Img image={tileImage(it)} alt="" width={1400} sizes="25vw" loading="lazy" field="Grid Thumbnail (world)" />
        </button>
      ))}
    </div>
  </div>
  <script type="application/json" id="wd-data" set:html={JSON.stringify(data)} />
</Layout>

<style>
  .wd {
    padding: 1rem 1rem 3rem;
  }
  .wd-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }
  .wd-btn {
    border: 1px solid currentColor;
    background: none;
    color: inherit;
    padding: 0.35rem 0.7rem;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .wd-btn[aria-pressed='true'] {
    color: #fff;
    background: #0a2a8a;
    border-color: #0a2a8a;
  }
  .wd-about {
    text-align: center;
    font-size: 0.8rem;
    opacity: 0.7;
    margin: 0 auto 1rem;
    max-width: 40rem;
  }
  /* The opened piece's bar: the way back, always in view. */
  .wd-open {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem 1.25rem;
    padding: 0.6rem 0;
    margin-bottom: 0.5rem;
    background: #fff;
    font-size: 0.85rem;
  }
  .wd-open[hidden] {
    display: none;
  }
  .wd-world {
    position: relative;
    margin: 0 auto;
  }
  .wd-piece {
    display: block;
    position: absolute;
    z-index: 1;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .wd-piece[hidden] {
    display: none;
  }
  .wd-piece:focus-visible {
    outline: 2px solid #0a2a8a;
    outline-offset: 2px;
  }
  /*
    Whole, never cropped: a box is rounded to whole cells, so it is rarely
    the picture's own shape. The picture sits inside it at its own shape.
  */
  .wd-piece :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>

<script>
  import {generateWorld, type WorldMode, type WorldResult} from '../../../lib/world';
  import {seedOf} from '../../../lib/cluster';

  type P = {w: number; h: number; project: string | null; own: boolean; id: string; parent: string | null; title: string};
  const data: {pieces: P[]; names: Record<string, string>} = JSON.parse(document.getElementById('wd-data')!.textContent!);
  const world = document.querySelector<HTMLElement>('.wd-world')!;
  const tiles = Array.from(world.querySelectorAll<HTMLButtonElement>('.wd-piece'));
  const about = document.querySelector<HTMLElement>('[data-about]')!;
  const openBar = document.querySelector<HTMLElement>('[data-open]')!;
  const ABOUT: Record<string, string> = {
    heights: 'Under the page is an invisible landscape of hills and valleys; each piece is drawn as big as the ground is high where it lands.',
    biomes: 'Each project - or a piece with the pieces parented to it - is its own patch of land, a small gap between them.',
  };
  const byId = new Map(data.pieces.map((p, i) => [p.id, i]));

  const q = new URLSearchParams(location.search);
  let mode = (q.get('mode') === 'biomes' ? 'biomes' : 'heights') as WorldMode;
  let seed = Number(q.get('seed')) || 4187;
  let focus: number | null = null;
  let focusRow = 0;
  let pushed = false;
  let last: WorldResult | null = null;
  const extras: HTMLElement[] = [];

  // A set's name: its project's, or the title of the piece the others hang off.
  const setName = (key: string) => {
    if (data.names[key]) return data.names[key];
    if (key.startsWith('#set-')) {
      const i = byId.get(key.slice(5));
      return i === undefined ? '' : data.pieces[i].title;
    }
    return '';
  };

  const draw = () => {
    for (const e of extras.splice(0)) e.remove();
    const phone = innerWidth < 768;
    const width = Math.min(world.parentElement!.clientWidth - 32, 1400);
    // Biomes on a finer grid, so the gap between them is a thin line.
    const [cols, maxSpan] = mode === 'biomes' ? (phone ? [15, 6] : [40, 12]) : phone ? [6, 3] : [20, 6];
    const cell = width / cols;
    const gap = phone ? 2 : 3;
    const out = generateWorld(data.pieces, {cols, mode, seed, maxSpan, focus, focusRow});
    last = out;
    const fam = new Set(out.family);
    world.style.width = `${width}px`;
    world.style.height = `${Math.ceil(out.rows * cell)}px`;
    tiles.forEach((t) => (t.hidden = true));
    for (const p of out.placed) {
      const t = tiles[p.i];
      t.hidden = false;
      t.style.left = `${p.c * cell + gap / 2}px`;
      t.style.top = `${p.r * cell + gap / 2}px`;
      t.style.width = `${p.cw * cell - gap}px`;
      t.style.height = `${p.ch * cell - gap}px`;
      t.style.opacity = focus !== null && !fam.has(p.i) ? '0.3' : '';
      const img = t.querySelector('img');
      if (img) img.sizes = `${Math.ceil(p.cw * cell)}px`;
    }
    // The biomes' land: a faint tint per biome, a cell at a time.
    if (out.biome && out.regions) {
      const canvas = document.createElement('canvas');
      canvas.width = cols;
      canvas.height = out.rows;
      Object.assign(canvas.style, {position: 'absolute', left: '0', top: '0', width: `${width}px`, height: `${out.rows * cell}px`, imageRendering: 'pixelated', zIndex: '0', pointerEvents: 'none', opacity: focus !== null ? '0.5' : '1'});
      const ctx = canvas.getContext('2d')!;
      for (let r = 0; r < out.rows; r++)
        for (let c = 0; c < cols; c++) {
          const k = out.biome[r * cols + c];
          if (k < 0) continue;
          ctx.fillStyle = `hsl(${(k * 137.5 + (seed % 360)) % 360} 45% 94%)`;
          ctx.fillRect(c, r, 1, 1);
        }
      world.prepend(canvas);
      extras.push(canvas);
    }
    const focusSet = focus === null ? null : (data.pieces[focus].project ?? null);
    for (const l of out.labels) {
      const name = setName(l.set);
      if (!name) continue;
      const el = document.createElement(l.set.startsWith('/') ? 'a' : 'span');
      el.textContent = name;
      if (el instanceof HTMLAnchorElement) el.href = l.set;
      Object.assign(el.style, {
        position: 'absolute', left: `${l.c * cell}px`, top: `${l.r * cell}px`, width: `${l.cw * cell}px`, height: `${cell}px`,
        display: 'flex', alignItems: 'center', padding: '0 0.35rem', overflow: 'hidden', whiteSpace: 'nowrap', textOverflow: 'ellipsis',
        fontSize: phone ? '0.6rem' : '0.7rem', fontWeight: '700', letterSpacing: '0.06em', textTransform: 'uppercase',
        color: '#0a2a8a', textDecoration: 'none', zIndex: '1',
        opacity: focus !== null && l.set !== focusSet && !out.family.some((i) => `#set-${data.pieces[i].id}` === l.set || (data.pieces[i].parent && `#set-${data.pieces[i].parent}` === l.set)) ? '0.4' : '',
      });
      world.append(el);
      extras.push(el);
    }
    // The bar for the opened piece.
    openBar.replaceChildren();
    openBar.hidden = focus === null;
    if (focus !== null) {
      const p = data.pieces[focus];
      const back = document.createElement('button');
      back.type = 'button';
      back.textContent = '← All work';
      Object.assign(back.style, {border: '0', background: 'none', padding: '0', font: 'inherit', color: 'inherit', textDecoration: 'underline', cursor: 'pointer'});
      back.addEventListener('click', close);
      const name = document.createElement('span');
      name.textContent = p.title;
      name.style.fontWeight = '700';
      openBar.append(back, name);
      if (p.project?.startsWith('/')) {
        const go = document.createElement('a');
        go.href = p.project;
        go.textContent = `${data.names[p.project] ?? 'The project'} →`;
        openBar.append(go);
      }
    }
    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
    about.textContent = ABOUT[mode];
    history.replaceState(history.state, '', `?mode=${mode}&seed=${seed}`);
  };

  const open = (i: number, push = true) => {
    const p = data.pieces[i];
    if (i === focus) {
      if (p.project?.startsWith('/')) location.href = p.project;
      else close();
      return;
    }
    focusRow = last?.placed.find((x) => x.i === i)?.r ?? 0;
    focus = i;
    if (push) {
      history.pushState({wd: i}, '');
      pushed = true;
    }
    draw();
    tiles[i].scrollIntoView({block: 'center'});
  };
  function close() {
    if (pushed) {
      history.back();
      return;
    }
    focus = null;
    draw();
  }

  tiles.forEach((t, i) => t.addEventListener('click', () => open(i)));
  addEventListener('popstate', (e) => {
    const i = (e.state as {wd?: number} | null)?.wd;
    pushed = typeof i === 'number';
    focus = typeof i === 'number' ? i : null;
    draw();
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && focus !== null) close();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
    b.addEventListener('click', () => {
      mode = b.dataset.mode as WorldMode;
      draw();
    }),
  );
  document.querySelector('[data-roll]')!.addEventListener('click', () => {
    seed = (seedOf(`${seed}:${Date.now()}`) % 9000) + 1000;
    draw();
  });
  let lastWidth = 0;
  new ResizeObserver(([e]) => {
    if (Math.abs(e.contentRect.width - lastWidth) < 1) return;
    lastWidth = e.contentRect.width;
    requestAnimationFrame(draw);
  }).observe(world.parentElement!);
</script>
