/portfolio/all/     /portfolio?view=all   301
/portfolio/type     /portfolio?view=type  301
/portfolio/type/    /portfolio?view=type  301
/next/world/home    /portfolio?view=all   301
/next/world/home/   /portfolio?view=all   301
/next/type/home     /portfolio?view=type  301
/next/type/home/    /portfolio?view=type  301
/next/close/home    /portfolio/up-close   301
/next/close/home/   /portfolio/up-close   301

