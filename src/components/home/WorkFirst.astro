---
/*
  THE WORK FIRST - the homepage as the work itself. Tried on the preview,
  then live ("Let's go live with all of that").

  Chris, of the homepage: "I'm still struggling with the idea that the
  homepage is not servicing the website as much as the portfolio is." The
  portfolio is the site now - the work is the content, and it is used, not
  read - so the homepage stops being a brochure in front of it:

  - A slim band: what the studio does (the page's one heading, for search
    as much as for people), one sentence of who, and the two ways on.
  - The field: the All view itself (LandsView) - pieces grow where they
    are, projects light together, the result numbers and the video work
    are among them - over a curated part of the work, not all of it, so the
    page stays light: each project's own piece and the first of its
    pieces, plus whatever Chris picks in Site Settings' Homepage Work Grid.
  - A short foot: his portrait, how he works, and Let's work again, so the
    page keeps a face and some real words.

  What moved, not lost: the logo strip (those clients are in the field as
  their work), the testimonial cards (their numbers are tiles here), the
  checklist and the process video - About is the place for them.
*/
import Img from '../Img.astro';
import LandsView from '../portfolio/LandsView.astro';
import Lookbook, {type LookCluster} from './Lookbook.astro';
import {getAllGridItems} from '../../lib/queries';
import {cleanKey, tileHref, merchPlacement, treatmentOf} from '../../lib/tiles';
import {tileImage, backgroundUrl, hasAsset} from '../../lib/image';
import {stripStegaKey} from '../../lib/stega';

interface Props {
  settings: any;
  contactUrl: string;
  bioText: string;
  featured: any[];
  /** The lookbook in place of the field (preview, /next/home/lookbook). */
  look?: boolean;
}
const {settings, contactUrl, bioText, featured, look} = Astro.props;
const clean = (s: unknown) => stripStegaKey(s).replace(/\s+/g, ' ').trim();
const idOf = (it: any) => cleanKey(it?._id).replace(/^drafts\./, '');

/*
  THE APPAREL MIX. Chris, thinking about professional clients: "maybe the
  homepage view should be some mix of the Merch & Apparel view with
  shorter-quantity clusters. Chateau Seven is my best apparel job to date.
  I'm also working with BalloonShop/Star Cadet currently ... Two Point Oh is
  a band but that shirt sold really well. DumpStat ran a merch line briefly
  that was profitable."

  So the field leads with the apparel work, in LEAD's order, and every
  cluster is short:
    - a project with merch: its own piece and up to SHORT more, the simple
      garment shots first, then the alternates, then the rest of its work
      (its marks) - LEAD_SHORT for Chateau Seven, the best of it;
    - loose merch (no case study yet - BalloonShop, Star Cadet): up to SHORT;
    - every other project: its own piece and one more, so the range shows
      without taking over;
    - plus whatever Chris picks in Site Settings' Homepage Work Grid.
  The band videos stay in the All view (only picked ones come here).
*/
// Adelante second - Chris: "the Adelante Barbell Club thing was largely apparel project, so that could go up there as well" (and its $3,500 first day).
const LEAD = ['Chateau Seven', 'Adelante Barbell Club', 'Two Point Oh', 'DumpStat', 'BalloonShop', 'Star Cadet'];
const SHORT = 4;
const LEAD_SHORT = 6;
const OTHER = 1;
const squash = (s: unknown) => clean(s).toLowerCase().replace(/[^a-z0-9]/g, '');
const leadOf = (it: any) => {
  const names = [it.parentTitle, it.title, it.client].map(squash).filter(Boolean);
  return LEAD.findIndex((n) => names.some((s) => s.startsWith(squash(n))));
};
const isMerch = (it: any) => cleanKey(it.category) === 'Merch & Apparel';
const merchFirst = (it: any) => (isMerch(it) ? (merchPlacement(it) === 'lead' ? 0 : 1) : 2);

// Preview first; false (or production) keeps the old curation below.
const APPAREL_MIX = import.meta.env.PUBLIC_IS_PREVIEW === 'true';
const items: any[] = (await getAllGridItems()).filter((it: any) => tileImage(it));
const only = new Set<string>(featured.map(idOf).filter(Boolean));
const lead: Record<string, number> = {};
const sets = new Map<string, any[]>();
for (const it of items) {
  const k = tileHref(it) ?? (leadOf(it) >= 0 && isMerch(it) ? `lead:${leadOf(it)}` : null);
  if (k) sets.set(k, [...(sets.get(k) ?? []), it]);
}
if (APPAREL_MIX) for (const list of sets.values()) {
  const own = list.filter((it) => cleanKey(it.pageType) === 'Case Study');
  const rest = list.filter((it) => cleanKey(it.pageType) !== 'Case Study');
  const at = Math.max(-1, ...list.map(leadOf));
  // The projects Chris named are apparel work whatever their pieces are filed
  // under - Chateau Seven's are Brand Identity in Studio.
  const apparel = at >= 0 || list.some(isMerch);
  const cap = !apparel ? OTHER : LEAD[at] === 'Chateau Seven' ? LEAD_SHORT : SHORT;
  // Stable sort: the portfolio's order within each kind.
  // An apparel cluster is its merch: one other piece beside it at most
  // (Two Point Oh's posters were crowding its shirt), unless it has no merch
  // shots yet - then its own work, so it still shows.
  const merchN = rest.filter(isMerch).length;
  const sorted = rest.map((it, n) => ({it, n})).sort((a, z) => merchFirst(a.it) - merchFirst(z.it) || a.n - z.n).map(({it}) => it);
  const others = apparel && merchN ? 1 : cap;
  const chosen = [...sorted.filter(isMerch), ...sorted.filter((it) => !isMerch(it)).slice(0, others)].slice(0, cap);
  const picked = [...own, ...chosen];
  for (const it of picked) {
    only.add(idOf(it));
    if (apparel && at >= 0) lead[idOf(it)] = at;
  }
}
/*
  THE LOOKBOOK's clusters (Lookbook.astro): the apparel projects in LEAD's
  order, then any other project with merch; each led by its simple garment
  shot (or its first merch, or its own piece), with up to three others -
  merch first - and its result from Site Settings' proof stats.
*/
const norm = (h: unknown) => String(stripStegaKey(h) ?? '').replace(/\/+$/, '');
const proof = ((settings?.proofStats ?? []) as any[]).map((r) => {
  const [stat, ...more] = clean(r.stat).split(' ');
  const lower = more.map((w) => (/^[A-Z0-9]{2,}$/.test(w) ? w : w.toLowerCase())).join(' ');
  return {stat, rest: [lower, clean(r.rest)].filter(Boolean).join(' '), href: norm(r.href)};
});
// A photograph fills its panel; a cut-out or a mark sits in it (as the field tells them apart).
const lookPiece = (it: any) => ({item: it, title: clean(it.title), photo: it.tileOpaque !== false && treatmentOf(it) !== 'mark'});
const clusters: LookCluster[] = look
  ? [...sets.entries()]
      .map(([k, list]) => ({k, list, at: Math.max(-1, ...list.map(leadOf))}))
      .filter(({list, at}) => at >= 0 || list.some(isMerch))
      .sort((a, z) => (a.at < 0 ? 99 : a.at) - (z.at < 0 ? 99 : z.at))
      .map(({k, list}) => {
        const own = list.find((it) => cleanKey(it.pageType) === 'Case Study');
        const merch = list.filter(isMerch).sort((a, z) => merchFirst(a) - merchFirst(z));
        const hero = merch[0] ?? own ?? list[0];
        const rest = [...merch.slice(1), ...list.filter((it) => !isMerch(it) && it !== hero)];
        const href = k.startsWith('/work/') ? k : null;
        const result = href ? proof.find((r) => r.href === norm(href)) ?? null : null;
        return {
          name: clean(own?.title) || clean(list[0]?.parentTitle) || clean(list[0]?.title),
          href,
          count: list.length,
          hero: lookPiece(hero),
          more: rest.slice(0, 3).map(lookPiece),
          result: result && result.stat ? {stat: result.stat, rest: result.rest} : null,
        };
      })
  : [];
/*
  The curation before the apparel mix, as live: every project's own piece
  and up to PER more of its pieces, in the portfolio's order.
*/
const PER = 7;
if (!APPAREL_MIX) {
  const taken = new Map<string, number>();
  for (const it of items) {
    const href = tileHref(it);
    if (!href) continue;
    const study = cleanKey(it.pageType) === 'Case Study';
    const n = taken.get(href) ?? 0;
    if (study || n < PER) {
      only.add(idOf(it));
      if (!study) taken.set(href, n + 1);
    }
  }
}
/*
  The blue sheet of logo sketches behind the foot - Site Settings' Proof
  Band Background, the way the original homepage used it behind its cards:
  tiled at 420px under a white wash. Chris: "use the original blue logo
  flash sheet WebP ... similar to how I used it on the original homepage",
  then, of it behind the opening band: "Drop the flashy background on the
  top. Maybe it will work better on the bottom." So it fades in from the
  white the field ends in. 840 wide for a 420px tile on a sharp screen.
*/
const sheet = await backgroundUrl(settings?.proofBandBackground, 840);
const tagline = clean(settings?.tagline) || 'Brand identity & merch design for heritage apparel brands.';
/*
  CURRENTLY - one line on what Chris is working on and when he is next
  free (Site Settings > Homepage > "Currently" line). Chris liked "what's
  Chris up to" - an open question since the first site brief. Preview only
  until he says; there, an empty field says where to write it.
*/
/*
  SHELVED, both, 31 October 2026 - Chris: "good try but shelve it. I do like a
  'what i'm up to' style thing but keep a pin in it"; and of the tickets, "not
  needed right now ... currently takes too much attention away from
  everything else on the page even with not enough context to what it's
  implying." Off on the preview too; the Studio fields stay. See IDEAS.md.
*/
const CURRENTLY = false;
const nowLine = clean(settings?.nowLine);
/*
  YOUR FACE BY THE HEADLINE (Site Settings > Homepage); empty, the
  municipal selfie - Chris: "use the municipal selfie not that other one"
  (chrisrumeau-municipalselfie-blue, the 1900px upload). Chris: "float my ... selfie somewhere next to where the
  H1 heading is ... probably on the right side ... I already like where the
  header is as is." So the headline does not move: on a wide screen the face
  takes a column to its right; on a phone it floats at the right and the
  headline sits beside it, the face taking the room the headline leaves.
  SHIPPED (Chris: "live", 1 November 2026); false takes it off.
*/
const FACE = true;
const MUNICIPAL_SELFIE = {_type: 'image', asset: {_type: 'reference', _ref: 'image-c74769e63b77e501e3b7bd233664d25e36508d80-1900x1900-webp'}};
const face = FACE ? (hasAsset(settings?.headFace) ? settings.headFace : MUNICIPAL_SELFIE) : null;
/*
  COMMISSION SLOTS as a ticket drop (Site Settings > Booking): a numbered
  ticket per slot, the taken ones stamped. Preview only, beside Currently;
  left out until a season and a count are set, except on the preview where
  a DRAFT row shows what it would look like.
*/
const slotsTotal = Number(settings?.slotsTotal) || 0;
const slots = {
  season: clean(settings?.slotsSeason),
  total: slotsTotal || 5,
  taken: Math.min(Number(settings?.slotsTaken) || 0, slotsTotal || 5),
  note: clean(settings?.slotsNote),
  draft: !slotsTotal || !clean(settings?.slotsSeason),
};
if (slots.draft) slots.taken = 2;
const left = slots.total - slots.taken;
// His own closing words from Site Settings, or none - no sentence written for him.
const finalLine = clean(settings?.finalCtaLine) || clean(settings?.finalCtaHeading).replace(/:\s*$/, '');
---

<section class:list={['wf-band', face && 'wf-band--face']}>
  {face && <Img class="wf-band__face" image={face} field="headFace (Your face by the headline)" alt="Chris Rumeau" width={640} sizes="(max-width: 40rem) 10rem, 16rem" loading="eager" />}
  <h1 class="wf-band__line">{tagline}</h1>
  <p class="wf-band__who">{bioText}</p>
  {CURRENTLY && (
    <div class="tk" aria-label={`Commission slots${slots.season ? `, ${slots.season}` : ''}: ${left} of ${slots.total} open`}>
      <p class="tk__head">
        {slots.season || 'Next season'}: {left ? `${left} of ${slots.total} open` : 'all taken'}
        {slots.draft && <em> DRAFT - Site Settings &gt; Booking</em>}
      </p>
      <ol class="tk__row">
        {Array.from({length: slots.total}, (_, i) =>
          i < slots.taken ? (
            <li class="tk__ticket is-taken"><span class="tk__no">{String(i + 1).padStart(2, '0')}</span><span class="tk__stamp">Taken</span></li>
          ) : (
            <li class="tk__ticket"><a class="tk__no" href={contactUrl} aria-label={`Claim slot ${i + 1}`}>{String(i + 1).padStart(2, '0')}</a></li>
          ),
        )}
      </ol>
      {(slots.note || !left) && <p class="tk__note">{slots.note || 'The next season opens soon.'}</p>}
    </div>
  )}
  {CURRENTLY && (
    <p class="wf-band__now">
      Currently: {nowLine || <em>write this line in Studio, Site Settings &gt; Homepage &gt; "Currently" line</em>}
    </p>
  )}
  <div class="wf-band__go">
    <a class="button" href={contactUrl}>Let's Work</a>
    <a class="button button--outline" href="/portfolio?view=all">Portfolio</a>
  </div>
</section>

<section class:list={['pf-section', look ? 'wf-look' : 'wf-field']} aria-label="The work">
  {/* The field asks which pane is shown; here it is the only one. */}
  <script is:inline>document.documentElement.dataset.pfPane = 'all';</script>
  {look ? (
    <>
      <Lookbook clusters={clusters} />
      <p class="wf-look__more"><a class="button" href="/portfolio?view=all">See all the work</a></p>
    </>
  ) : (
    <>
      <LandsView only={[...only]} lead={APPAREL_MIX ? lead : undefined} home />
      {/* The field fades out under this, so it reads as going on - and the way on is a button. */}
      <p class="wf-field__more"><a class="button" href="/portfolio?view=all">See all the work</a></p>
    </>
  )}
</section>

<section class="wf-foot" style={sheet ? `--wf-sheet: url(${sheet})` : undefined}>
  {settings?.portrait && (
    <Img class="wf-foot__portrait" image={settings.portrait} field="portrait (Portrait of you)" alt="Chris Rumeau, founder of Rumeau Design Co" width={700} sizes="(max-width: 40rem) 272px, 340px" loading="lazy" />
  )}
  <div class="wf-foot__words">
    {finalLine && <p class="wf-foot__line">{finalLine}</p>}
    <a class="button" href={contactUrl}>Let's Work</a>
  </div>
</section>
