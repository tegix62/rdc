---
import Layout from '../../layouts/Layout.astro';
import Img from '../../components/Img.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { sanityClient } from '../../lib/sanity';
import { getBlogPost, getOtherBlogPosts, getRelatedWork, getSiteSettings } from '../../lib/queries';
import { socialCardUrl, fileUrl, archiveCard } from '../../lib/image';
import { renderPortableText } from '../../lib/portableText';
import { blogPostNode } from '../../lib/structuredData';
import { dateAttr, formatDate } from '../../lib/date';
import { blogPostDescription } from '../../lib/meta';
import { readingTime } from '../../lib/readingTime';

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(`*[_type == "blogPost"].slug.current`);
  return slugs.map((slug: string) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await getBlogPost(slug!);
if (!post) {
  throw new Error(`Blog post not found for slug: ${slug}`);
}

const settings = await getSiteSettings();
const CONTACT_URL = settings?.contactUrl || '/contact';

const ogImage =
  socialCardUrl(post.mainImage) ?? socialCardUrl(post.thumbnailImage) ?? undefined;

const morePosts = await getOtherBlogPosts(slug!);
const relatedWork = await getRelatedWork(post.category);
const audioUrl = fileUrl(post.audioNarration);
const time = readingTime(post.body);
---

<Layout
  title={post.title}
  description={blogPostDescription(post)}
  ogType="article"
  ogImage={ogImage}
  jsonLd={(ctx) => blogPostNode(ctx, post)}
>
  <article class="blog-article">
    <header class="blog-header">
      {post.category && (
        <p class="blog-category">{post.category}</p>
      )}
      <h1>{post.title}</h1>
      <p class="blog-byline">
        {post.author}
        {post.author && formatDate(post.publishedAt) && ' · '}
        {formatDate(post.publishedAt) && (
          <time datetime={dateAttr(post.publishedAt)}>{formatDate(post.publishedAt)}</time>
        )}
        {(post.author || formatDate(post.publishedAt)) && time && ' · '}
        {time}
      </p>
    </header>

    {audioUrl && (
      <div class="blog-audio">
        <p class="blog-audio__label">Listen to this post</p>
        <audio controls preload="metadata" src={audioUrl}>
          Your browser does not support the audio element.
        </audio>
      </div>
    )}

    {post.mainImage && (
      <Img class="blog-hero-img" image={post.mainImage} alt={post.title} field="mainImage" width={1600} sizes="100vw" loading="eager" fetchpriority="high" />
    )}

    {post.body?.length > 0 && (
      <div class="prose" set:html={renderPortableText(post.body)} />
    )}
  </article>

  {relatedWork.length > 0 && (
    <section class="blog-related">
      <h2>{post.category ? `${post.category} work` : 'See the work'}</h2>
      <div class="grid">
        {relatedWork.map((item: any) => {
          // Same archive card as "More Work" on a case study - see archiveCard().
          const card = archiveCard(item);
          return (
            <a class="card" href={`/work/${item.slug.current}`}>
              {card.image && (
                <Img
                  image={card.image}
                  markMode={card.mode}
                  field={card.mode === 'drawn' ? 'archiveMark (Archive Mark)' : 'thumbnail'}
                  alt={item.title}
                  width={600}
                  sizes="(max-width: 40rem) 100vw, (max-width: 60rem) 50vw, 25vw"
                />
              )}
              <p class="card__title">{item.title}</p>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <section class="blog-cta">
    <p class="blog-cta__text">Like what you see? Let's make something together.</p>
    <a class="button" href={CONTACT_URL}>Let's Work</a>
  </section>

  {morePosts.length > 0 && (
    <section class="more-posts">
      <h2>More posts</h2>
      <div class="grid grid--prose">
        {morePosts.map((p: any) => (
          <a class="card" href={`/blog/${p.slug.current}`}>
            {(p.thumbnailImage || p.mainImage) && (
              <Img
                image={p.thumbnailImage || p.mainImage}
                field={p.thumbnailImage ? 'thumbnailImage' : 'mainImage'}
                alt={p.title}
                width={600}
                height={400}
                sizes="(max-width: 40rem) 100vw, (max-width: 60rem) 50vw, 33vw"
              />
            )}
            <p class="card__title">{p.title}</p>
            <p class="card__meta">
              {formatDate(p.publishedAt) && (
                <time datetime={dateAttr(p.publishedAt)}>{formatDate(p.publishedAt)}</time>
              )}
              {formatDate(p.publishedAt) && readingTime(p.body) && ' · '}
              {readingTime(p.body)}
            </p>
          </a>
        ))}
      </div>
    </section>
  )}

  <EmailCapture source={`blog/${slug}`} />

  <a class="blog-back" href="/blog">&larr; All posts</a>
</Layout>
