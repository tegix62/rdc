---
/*
  Renders the flexible layout blocks editors build in Sanity. Shared by case
  study pages and regular pages so both get the same set of building blocks
  and there's only one place to change when a block type is added.
*/
import Img from './Img.astro';
import { renderPortableText } from '../lib/portableText';
import Video from './Video.astro';
import { imageDimensions } from '../lib/image';
import StripRule from './StripRule.astro';

interface Props {
  sections: any[];
}

const { sections } = Astro.props;

/*
  The one number a row of plates needs: each plate's aspect ratio.

  A row laid out as equal-width columns gives every plate the same WIDTH, so
  its height falls out of its own proportions - three flyers of three shapes
  end at three different heights, which reads as broken alignment rather than
  as varied artwork. A gallery wall, a contact sheet and a specimen page all
  do the opposite: common height, widths that vary honestly.

  Handing each image `flex-grow: <its ratio>` against `flex-basis: 0` is the
  whole mechanism. Flexbox hands out the row's free space in proportion to
  grow factors, so plate i gets width k·ratio(i), and its natural height is
  therefore width/ratio = k - the same k for every plate in the row, exactly,
  at every viewport width, with no cropping and no distortion. Gaps come off
  the top and only change k.

  The ratio comes from the asset reference (Sanity encodes pixel dimensions
  in the _ref), so this costs no request and no layout shift. When it is
  missing - a stale reference, a hand-written fixture - the fallback is 1,
  which is the old equal-width behaviour for that plate rather than a
  collapse.
*/
function aspect(image: any): number {
  const d = imageDimensions(image);
  return d && d.height > 0 ? d.width / d.height : 1;
}

/*
  The ratio travels as a custom property, not as flex-grow directly.

  It was `flex-grow: 1.7778` written inline, and an inline declaration cannot
  be overridden by a stylesheet - so no media query could turn the growing
  off. That already bit once: `flex: 0 0 auto` on a self-hosted video row was
  silently ignored for exactly this reason and the gaps stayed wrong. Handing
  CSS the number instead and letting it decide what to do with it is what lets
  the phone layout size these by height rather than by share.
*/
/*
  The image's ratio, handed to CSS so it can cap the HEIGHT of an Image + Text
  image without taking away the width:100% that keeps it filling its column.

  See --image-text-fit in global.css for why the cap has to be expressed as a
  max-WIDTH, and why width:auto is the wrong tool here.
*/
function ratioStyle(image: any): string | undefined {
  if (!image) return undefined;
  return `--ar:${aspect(image).toFixed(4)}`;
}

function plateStyle(image: any): string {
  return `--ar:${aspect(image).toFixed(4)}`;
}

/*
  The same number for a Media Row item, which may be a video rather than an
  image.

  A video has no dimensions to read at build time, so its poster stands in -
  the poster IS the shape of the slot until someone presses play. With no
  poster either, 16:9, which is what an embed resolves to and the least
  surprising guess for anything else.
*/
function mediaAspect(item: any): number {
  if (item?._type === 'mediaVideo') {
    const d = imageDimensions(item.videoPoster);
    return d && d.height > 0 ? d.width / d.height : 16 / 9;
  }
  return aspect(item?.image);
}

/*
  The one item that sizes ITSELF, and so must not be given a share of the row.

  Everything else here is solved by ratio: the slot is computed and the picture
  fills it. A self-hosted video is the other way round - it caps itself at
  --video-fit and its frame hugs it (.work-video-frame:has(.video--self)),
  which is what removed the black side bars. Given a computed slot as well, it
  centres inside one and leaves dead space on BOTH sides of every item.
  Measured with real clips at 1512x900: three 540x960 videos render 329px wide
  and sat in 491px slots, so what reads as the gap between them was 24px of
  actual gap plus 138px of nothing.

  And the ratio cannot be computed for them anyway. Sanity encodes pixel
  dimensions in an IMAGE's asset reference; a file asset carries none, so a
  video's shape is unknown until the browser has the file. mediaAspect falls
  back to the poster and then to 16:9 - and for portrait clips with no poster
  that fallback is not merely unknown but wrong, and it was sizing the slots.

  `0 1 auto`, not `0 0 auto`: content-sized still has to SHRINK. A landscape
  clip stops at --video-fit x 16/9, which is 1040px on a 900px-tall screen, and
  three of those refusing to shrink overflowed the page by 828px - measured,
  not imagined. Shrinking lets the frame's fit-content follow the space it
  actually has.

  Written inline rather than left to the :has() rule alone, so a browser
  without :has() gets the right layout instead of items collapsed to nothing
  by the flex-basis:0 that the rest of the row needs.
*/
function isSelfHostedVideo(item: any): boolean {
  return (
    item?._type === 'mediaVideo' &&
    Boolean(item.videoFile || item.videoWebm || item.videoSrc)
  );
}

function mediaItemStyle(item: any): string | undefined {
  // A self-hosted video takes no share of the row and has no ratio to give -
  // the class below carries that instead, for the same reason as above.
  if (isSelfHostedVideo(item)) return undefined;
  return `--ar:${mediaAspect(item).toFixed(4)}`;
}

/*
  The row's own variables, counting only the items that actually take a share.

  A row of nothing but self-hosted videos sums to zero, and a zero sum would
  make the height cap `0 x max-height + gaps` - 48px - and collapse the row.
  Such a row needs no cap at all: content-sized items are already bounded by
  --video-fit, which is the same job. So it is handed its full room instead.
*/
/*
  Which rows become a sideways strip on a phone.

  Three or more of anything: a set rather than a pair, and fitting three into
  390px costs more than it buys.

  TWO, when either is a self-hosted video. A video needs more room than a
  picture does, because it carries controls: measured, a pair of portrait
  clips fitted side by side comes out about 175px wide each, where the same
  pair in a strip is 216px and neither is squeezed. A pair of PICTURES at
  175px is simply a smaller picture, which is why the image rule stays at
  three - the point of a two-up is seeing both at once.
*/
function isStripRow(items: any[]): boolean {
  if (items.length > 2) return true;
  return items.length > 1 && items.some(isSelfHostedVideo);
}

function mediaRowStyle(items: any[]): string {
  const sum = items
    .filter((item) => !isSelfHostedVideo(item))
    .reduce((total, item) => total + mediaAspect(item), 0);
  if (sum === 0) return '--row-cap:var(--row-room)';
  return `--row-ar:${sum.toFixed(4)};--row-n:${items.length};--row-max:${rowMaxFor(items.length)}`;
}

/*
  How tall a row of n plates may get. See --row-max in global.css: a safety
  valve for ratios that would otherwise run away, not a size, so it is set
  high enough to stay out of the way in ordinary rows.

  Two plates get a taller ceiling than three, having half the row each rather
  than a third of it. Both numbers matter: the vh half rules an ordinary
  laptop, the rem half stops a 2560px monitor from growing a row without
  limit.

  This lives up here rather than beside its call site because the switch below
  is inside a template expression, where the compiler reads `<=` as the start
  of a tag. It cost a build to learn.
*/
function rowMaxFor(count: number): string {
  if (count < 2) return 'min(74vh, 48rem)';
  if (count === 2) return 'min(68vh, 44rem)';
  return 'min(62vh, 40rem)';
}

/*
  What the row as a whole needs, so it can bound its own height.

  The common height k works out to (row width - gaps) / (sum of the ratios),
  which is fine for wide plates and runaway for narrow ones: two portraits at
  1:2 sum to 1.0, so a 1000px row would set them 1000px TALL. Nothing in the
  flex algorithm stops that, because it is solving for width.

  Since the sum is known here, the bound can be handed to CSS as a width:
  holding the row to (sum x max height + gaps) holds k at max height exactly,
  because k is linear in the width. A row of wide plates never reaches that
  width, so the bound is inert where it isn't needed, and a row of tall ones
  narrows and centres instead of towering. --row-n is the plate count, which
  is what turns the gaps into a number.
*/
function rowStyle(images: any[]): string {
  const present = images.filter(Boolean);
  const sum = present.reduce((total, img) => total + aspect(img), 0);
  return `--row-ar:${sum.toFixed(4)};--row-n:${present.length}`;
}

---

{/*
  Drives every strip's scroll indicator. See StripRule.astro for what it is
  and why the native scrollbar could not do the job.

  Astro bundles this once for the page rather than per section. It does
  nothing at all where no strip exists, which is every desktop viewport and
  every page without a row of three.
*/}
<script>
  const ROWS = '.work-section--three-up.is-strip, .media-row__items.is-strip';

  function wire(row: HTMLElement) {
    const rule = row.parentElement?.querySelector<HTMLElement>(':scope > .strip-rule');
    if (!rule) return;

    let queued = false;
    const measure = () => {
      queued = false;
      const travel = row.scrollWidth - row.clientWidth;
      // Nothing to scroll: a row whose plates fit is an ordinary row, and an
      // indicator on it would be a control for a thing that cannot move.
      if (travel <= 1) {
        rule.classList.remove('is-active');
        return;
      }
      rule.classList.add('is-active');
      rule.style.setProperty('--strip-f', String(row.clientWidth / row.scrollWidth));
      rule.style.setProperty('--strip-p', String(row.scrollLeft / travel));
    };

    /*
      rAF-throttled rather than debounced: a scroll indicator that arrives
      after the gesture has finished is worse than none, because it contradicts
      what the thumb is for. Same treatment the Portfolio grid's resize handler
      uses.
    */
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(measure);
    };

    row.addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule, { passive: true });
    /*
      Images carry width and height so the row's width is known before they
      arrive, but a late-decoding image can still nudge it, and the strip only
      exists below 40rem where a re-measure costs nothing.
    */
    addEventListener('load', schedule);
    measure();
  }

  const start = () => document.querySelectorAll<HTMLElement>(ROWS).forEach(wire);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
  // DOMContentLoaded does not fire on a back/forward restore; pageshow does.
  addEventListener('pageshow', (e) => {
    if ((e as PageTransitionEvent).persisted) start();
  });
</script>

{sections?.map((section: any) => {
  switch (section._type) {
    case 'fullImageSection': {
      if (!section.image) return null;
      /*
        Capped to the viewport height unless explicitly told otherwise.

        This used to branch on the image's shape - cap wide ones, let tall
        ones run - and that was wrong twice over. Measured at 1512x900 with
        the cap on:

          2.4:1  100% of page width      1:1    51%
          16:9    90%                    3:4    38%
          4:3     67%                    1:1.78 28%

        A square caps to half the page, which is a plate, not the stamp the
        rule was built to avoid. Only genuinely tall images get narrow, and
        the earlier "floating in red" symptom was mostly a separate bug -
        width:auto applied to column images - not this cap at all.

        Meanwhile the uncapped branch had no upper bound whatsoever: a square
        at full bleed renders as tall as the viewport is wide, which on a
        desktop is roughly three screens of one picture.

        So the cap is simply the default, and it is what makes the rule a
        rule: no plate is ever taller than the screen. 'fill' remains as a
        deliberate opt-out for a plate worth scrolling. Anything still
        holding the old 'auto' value gets capped, which is now the sane
        reading of it.
      */
      const fit = section.plateFit !== 'fill';
      return (
        <div class="work-section work-section--full" data-plate-fit={fit ? '' : undefined}>
          {/* No alt prop: it comes from the image's own field in Sanity now.
              This used to read section.alt, which was never in the schema, so
              every full-width image shipped with an empty alt. */}
          <Img image={section.image} field={`${section._type} → image`} width={2000} sizes="100vw" />
        </div>
      );
    }
    case 'twoUpSection':
      return (
        <div class="work-section work-section--two-up" style={rowStyle([section.imageLeft, section.imageRight])}>
          {[section.imageLeft, section.imageRight].map(
            (img: any) =>
              img && (
                <div class="work-section__plate" style={plateStyle(img)}>
                  <Img image={img} field={`${section._type} → imageLeft/Right`} width={1200} sizes="(max-width: 40rem) 100vw, 50vw" />
                </div>
              ),
          )}
        </div>
      );
    case 'threeUpSection': {
      const plates = [section.imageOne, section.imageTwo, section.imageThree].filter(Boolean);
      return (
        /*
          The outer div exists so the scroll indicator has somewhere to live.
          A rule drawn inside the scroller would scroll away with the plates,
          and one placed after the section would sit between two .work-section
          siblings and break the `+` selector that spaces them apart.

          .work-section stays on the outer element and the row classes move
          in: nothing targets the two together, and the row's width maths is
          unchanged because the wrapper stretches to the same 1104px the row
          used to occupy.
        */
        <div class="work-section">
        <div
          class:list={['work-section--three-up', plates.length > 2 && 'is-strip']}
          style={rowStyle(plates)}
        >
          {plates.map(
            (img: any) =>
              img && (
                <div class="work-section__plate" style={plateStyle(img)}>
                  {/* 1000, not the 800 this used to ask for: a plate in a
                      broken-out three-up row measures about 460 CSS px on a
                      1512 screen, which is 920 device pixels at 2x. An 800
                      ceiling meant the browser's best candidate was one it
                      had to enlarge. */}
                  <Img image={img} field={`${section._type} → imageOne/Two/Three`} width={1000} sizes="(max-width: 40rem) 100vw, 33vw" />
                </div>
              ),
          )}
        </div>
        {plates.length > 2 && <StripRule />}
        </div>
      );
    }
    case 'imageTextSection':
      return (
        <div
          class:list={[
            'work-section',
            'work-section--image-text',
            section.imagePosition === 'Right' && 'is-reversed',
          ]}
          style={ratioStyle(section.image)}
        >
          {section.image && (
            <Img image={section.image} field={`${section._type} → image`} width={1200} sizes="(max-width: 40rem) 100vw, 50vw" />
          )}
          <div class="work-section__text">
            {/*
              h2, not h3: every section here is a direct, one-per-section
              title sibling of the page's h1 - same level as Services and the
              hero/aesthetic-range headings below, which already use h2. A
              case study whose FIRST section was one of these (imageText,
              statCallout, text, mediaRow, mediaText) jumped straight from h1
              to h3 with nothing in between, which is a document outline that
              claims a heading level exists when it does not. t-h3 keeps the
              size exactly as it was - see the type-scale utility classes
              above for why size and semantic level are separate here.
            */}
            {section.heading && <h2 class="t-h3">{section.heading}</h2>}
            {section.text && <p>{section.text}</p>}
          </div>
        </div>
      );
    case 'videoSection':
      return section.url || section.videoFile || section.videoWebm || section.videoSrc ? (
        <div class="work-section work-section--video">
          <div class="work-video-frame">
            <Video
              url={section.url}
              file={section.videoFile}
              webm={section.videoWebm}
              videoSrc={section.videoSrc}
              poster={section.videoPoster}
              posterField={`${section._type} → videoPoster`}
              playback={section.videoPlayback}
              posterBackground={section.videoPosterBackground}
              muted={section.videoMuted}
              title={section.caption ?? 'Video'}
              width={1600}
            />
          </div>
          {section.caption && <p class="work-video-caption">{section.caption}</p>}
        </div>
      ) : null;
    case 'statCalloutSection':
      return (
        <div class="work-section work-section--stat-callout">
          {/* h2 - see the comment on imageTextSection's heading above. */}
          {section.heading && <h2 class="t-h3">{section.heading}</h2>}
          {section.checklist?.length > 0 && (
            <ul class="work-stat-checklist">
              {section.checklist.map((item: string) => <li>{item}</li>)}
            </ul>
          )}
          {(section.statValue || section.statLabel) && (
            <p class="work-stat">
              {section.statValue && <strong>{section.statValue}</strong>} {section.statLabel}
            </p>
          )}
        </div>
      );
    case 'textSection':
      return (
        <div class="work-section work-section--text">
          {/* h2 - see the comment on imageTextSection's heading above. */}
          {section.heading && <h2 class="t-h3">{section.heading}</h2>}
          {section.body?.length > 0 && <div set:html={renderPortableText(section.body)} />}
        </div>
      );
    case 'achievementsSection':
      return (
        <div class="work-section work-section--achievements">
          {/* Two images side by side is a plate row, so it gets the plate row's
              treatment rather than a third copy of the equal-width columns
              that were wrong in twoUpSection and in Media Row. */}
          <div
            class="work-section--achievements__images"
            style={rowStyle([section.imageLeft, section.imageRight])}
          >
            {[section.imageLeft, section.imageRight].map(
              (img: any) =>
                img && (
                  <div class="work-section__plate" style={plateStyle(img)}>
                    <Img image={img} field={`${section._type} → imageLeft/Right`} width={1200} sizes="(max-width: 40rem) 100vw, 50vw" />
                  </div>
                ),
            )}
          </div>
          {section.items?.length > 0 && <div set:html={renderPortableText(section.items)} />}
        </div>
      );
    case 'videoHeroSection':
      return (
        <div class="work-section work-section--video-hero">
          {(section.url || section.videoFile || section.videoWebm || section.videoSrc) && (
            <div class="work-video-hero__bg">
              <Video
                url={section.url}
                file={section.videoFile}
                webm={section.videoWebm}
                videoSrc={section.videoSrc}
                poster={section.videoPoster}
                posterField={`${section._type} → videoPoster`}
                playback={section.videoPlayback}
                posterBackground={section.videoPosterBackground}
                muted={section.videoMuted}
                title={section.heading ?? 'Video'}
                width={2000}
              />
            </div>
          )}
          {section.heading && (
            <div class="work-video-hero__overlay">
              <h2>{section.heading}</h2>
            </div>
          )}
        </div>
      );
    /*
      Media Row. Each item is independently an image or a video, so three
      animated GIFs across, two videos side by side, or a video beside a mockup
      are all this one block. --media-count drives the column count; the CSS
      stacks them on a phone regardless, because three things across 390px is
      unreadable.
    */
    case 'mediaRowSection': {
      const items = (section.items ?? []).filter(
        (i: any) =>
          (i._type === 'mediaVideo' && (i.url || i.videoFile || i.videoWebm || i.videoSrc)) ||
          (i._type === 'mediaImage' && i.image),
      );
      if (items.length === 0) return null;
      /*
        Narrower slots want smaller files, so the srcset ceiling follows the
        item count.

        3000 rather than the 2000 this used to divide, for the same reason
        three-up went from 800 to 1000: the row now breaks out past the band,
        so a slot in a three-item row is about 460 CSS px on a 1512 screen -
        920 device pixels at 2x, above the old 666 ceiling. cappedWidth still
        clamps every request to the file's own size, so a generous ceiling
        costs nothing on a source that cannot fill it.
      */
      const slotWidth = Math.round(3000 / items.length);
      /*
        A Media Row is a row of plates, so it shares the two-up/three-up
        treatment: one height, widths from each item's own ratio. See the
        long note in global.css for why, and for why the sum of the ratios
        has to travel with it - and mediaItemStyle above for the one kind of
        item that opts out.
      */
      return (
        <div class="work-section media-row" style={`--media-count: ${items.length}`}>
          {/* h2 - see the comment on imageTextSection's heading above. */}
          {section.heading && <h2 class="media-row__heading t-h3">{section.heading}</h2>}
          <div
            class:list={[
              'media-row__items',
              /*
                Three or more become a sideways strip on a phone; two stay
                fitted side by side. A pair is a comparison - putting it into
                a swipe means never seeing both at once, which is the one
                thing a two-up is for. Three is already a set rather than a
                pair, and at that count fitting them costs more than it buys.
              */
              isStripRow(items) && 'is-strip',
            ]}
            style={mediaRowStyle(items)}
          >
            {items.map((item: any, i: number) => (
              <figure
                class:list={['media-row__item', isSelfHostedVideo(item) && 'media-row__item--video']}
                style={mediaItemStyle(item)}
              >
                {item._type === 'mediaVideo' ? (
                  <div class="work-video-frame">
                    <Video
                      url={item.url}
                      file={item.videoFile}
                      webm={item.videoWebm}
                      videoSrc={item.videoSrc}
                      poster={item.videoPoster}
                      posterField={`mediaRowSection → items[${i}].videoPoster`}
                      playback={item.videoPlayback}
                      posterBackground={item.videoPosterBackground}
                      muted={item.videoMuted}
                      title={item.caption ?? 'Video'}
                      width={slotWidth}
                      sizes={`(max-width: 40rem) 100vw, ${Math.round(100 / items.length)}vw`}
                    />
                  </div>
                ) : (
                  <Img
                    image={item.image}
                    field={`mediaRowSection → items[${i}].image`}
                    width={slotWidth}
                    sizes={`(max-width: 40rem) 100vw, ${Math.round(100 / items.length)}vw`}
                  />
                )}
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            ))}
          </div>
          {isStripRow(items) && <StripRule />}
        </div>
      );
    }
    /*
      Media + Text. Image + Text with the media half able to be a video, using
      the same "fill in the video and it replaces the image" rule as a case
      study hero.
    */
    case 'mediaTextSection':
      return (
        <div
          class:list={[
            'work-section',
            'work-section--image-text',
            section.mediaPosition === 'Right' && 'is-reversed',
          ]}
          style={ratioStyle(section.image)}
        >
          {section.videoUrl || section.videoFile || section.videoWebm || section.videoSrc ? (
            <div class="work-video-frame">
              <Video
                url={section.videoUrl}
                file={section.videoFile}
                webm={section.videoWebm}
                videoSrc={section.videoSrc}
                poster={section.videoPoster}
                posterField={`${section._type} → videoPoster`}
                playback={section.videoPlayback}
                posterBackground={section.videoPosterBackground}
                muted={section.videoMuted}
                title={section.heading ?? 'Video'}
                width={1200}
                sizes="(max-width: 40rem) 100vw, 50vw"
              />
            </div>
          ) : (
            section.image && (
              <Img image={section.image} field={`${section._type} → image`} width={1200} sizes="(max-width: 40rem) 100vw, 50vw" />
            )
          )}
          <div class="work-section__text">
            {/* h2 - see the comment on imageTextSection's heading above. */}
            {section.heading && <h2 class="t-h3">{section.heading}</h2>}
            {section.text && <p>{section.text}</p>}
          </div>
        </div>
      );
    case 'aestheticRangeSection': {
      const items = section.items ?? [];
      if (items.length === 0) return null;
      return (
        <div class="work-section aesthetic-range">
          {section.heading && <h2 class="aesthetic-range__heading">{section.heading}</h2>}
          {section.intro && <p class="aesthetic-range__intro">{section.intro}</p>}
          <ul class="aesthetic-range__tray" style={`--tray-count: ${items.length}`}>
            {items.map((item: any) => {
              const inner = (
                <>
                  <span class="aesthetic-range__icon">
                    {item.icon ? (
                      <Img
                        image={item.icon}
                        alt={item.iconAlt ?? ''}
                        field="aestheticRangeSection → items[].icon"
                        width={320}
                        sizes="(max-width: 40rem) 40vw, 160px"
                      />
                    ) : (
                      /* No icon yet: a marker keeps the tile's shape and rhythm
                         so the tray reads as deliberate rather than broken
                         while the artwork is still being drawn. */
                      <span class="aesthetic-range__placeholder" aria-hidden="true"></span>
                    )}
                  </span>
                  <span class="aesthetic-range__label">{item.label}</span>
                </>
              );
              return (
                <li class="aesthetic-range__item">
                  {item.href ? (
                    <a class="aesthetic-range__tile" href={item.href}>
                      {inner}
                    </a>
                  ) : (
                    <span class="aesthetic-range__tile">{inner}</span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      );
    }
    default:
      return null;
  }
})}
