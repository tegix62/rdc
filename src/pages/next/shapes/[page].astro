---
/*
  SHAPES BY TYPE - preview only, at /next/shapes/compare: the same pieces
  two ways, to see the idea before deciding on it.

  From the punch list's "wouldn't it be cool": let a piece's Asset Type set
  its tile's shape - a shirt 4:5, a record or a social card square, a wide
  video 16:9 across two columns, a brand sheet 3:2 across two - so the grid
  has a deliberate rhythm instead of whatever shape each upload happened to
  be. Chris: "I don't know what you mean by number six. So, you'd have to
  show it to me."

  "As uploaded" is the masonry the Brand Identity grid uses today; "Shaped
  by type" is the idea. A logomark (Tile Layout, or an Identity / Brand
  Sheet or record by default) sits whole inside its shape; anything else
  fills it, cropped round its hotspot. Pieces with no Asset Type are
  counted and outlined, since the rhythm can only be as good as that field.

  Never built for production (getStaticPaths), and noindex.
*/
import Layout from '../../../layouts/Layout.astro';
import Img from '../../../components/Img.astro';
import {getAllGridItems} from '../../../lib/queries';
import {tileImage, hotspotPosition} from '../../../lib/image';
import {treatmentOf, cleanKey} from '../../../lib/tiles';
import {stripStegaKey} from '../../../lib/stega';

export async function getStaticPaths() {
  if (import.meta.env.PUBLIC_IS_PREVIEW !== 'true') return [];
  return [{params: {page: 'compare'}}];
}

const clean = (s: unknown) => stripStegaKey(s).replace(/\s+/g, ' ').trim();

// Each type's shape (width over height) and how many of four columns it takes.
const SHAPES: Record<string, {ratio: string; span: number}> = {
  Apparel: {ratio: '4 / 5', span: 1},
  'Social Card': {ratio: '1 / 1', span: 1},
  'Vinyl / Record': {ratio: '1 / 1', span: 1},
  Packaging: {ratio: '1 / 1', span: 1},
  'Identity / Brand Sheet': {ratio: '3 / 2', span: 2},
  'Wide Video': {ratio: '16 / 9', span: 2},
};
const NONE = {ratio: '1 / 1', span: 1};

const pieces = ((await getAllGridItems()) as any[])
  .map((it) => {
    const type = cleanKey(it.assetType);
    const image = tileImage(it);
    return {
      title: clean(it.title),
      type,
      image,
      shape: SHAPES[type] ?? NONE,
      typed: Boolean(SHAPES[type]),
      mark: treatmentOf(it) === 'mark',
      at: hotspotPosition(image),
    };
  })
  .filter((p) => p.image);

const counts = Object.keys(SHAPES).map((t) => [t, pieces.filter((p) => p.type === t).length] as const);
const untyped = pieces.filter((p) => !p.typed).length;
---

<Layout title="Shapes by type - Rumeau Design Co" description="The same pieces, as uploaded and shaped by type." noindex>
  <div class="sh" data-shapes="typed">
    <header class="sh-head">
      <h1>Shapes by type</h1>
      <p>
        The same {pieces.length} pieces two ways. <strong>As uploaded</strong> is the grid today: every tile the shape its
        file happened to be. <strong>Shaped by type</strong> lets the Asset Type set the shape: shirts 4:5, records and
        cards square, brand sheets and wide videos across two columns.
      </p>
      <div class="sh-switch" role="group" aria-label="Show">
        <button type="button" data-show="uploaded" aria-pressed="false">As uploaded</button>
        <button type="button" data-show="typed" aria-pressed="true">Shaped by type</button>
      </div>
      <p class="sh-count">
        {counts.filter(([, n]) => n).map(([t, n]) => `${t}: ${n}`).join(' · ')}
        {untyped > 0 && <> · <span class="sh-untyped-key">no Asset Type: {untyped}</span> (square, outlined in red)</>}
      </p>
    </header>

    <ul class="sh-grid">
      {pieces.map((p) => (
        <li
          class:list={['sh-tile', p.mark && 'sh-tile--mark', !p.typed && 'sh-tile--untyped']}
          style={`--ratio:${p.shape.ratio};--span:${p.shape.span};${p.at ? `--at:${p.at};` : ''}`}
          title={`${p.title}${p.type ? ` - ${p.type}` : ' - no Asset Type'}`}
        >
          <Img image={p.image} alt={p.title} width={900} sizes="(min-width: 48rem) 50vw, 100vw" loading="lazy" />
        </li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  .sh {
    padding: var(--space-5, 3rem) var(--space-4, 1.5rem) var(--space-6, 4rem);
  }
  .sh-head {
    max-width: 44rem;
    margin-bottom: var(--space-4, 2rem);
  }
  .sh-head h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.25rem);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0 0 1rem;
  }
  .sh-switch {
    display: inline-flex;
    border: 2px solid var(--color-navy);
    margin: 1rem 0 0.75rem;
  }
  .sh-switch button {
    font: inherit;
    font-size: 0.9375rem;
    padding: 0.55rem 1rem;
    border: 0;
    background: var(--color-white);
    color: var(--color-navy);
    cursor: pointer;
  }
  .sh-switch button[aria-pressed='true'] {
    background: var(--color-navy);
    color: var(--color-white);
  }
  .sh-count {
    font-size: 0.8125rem;
    color: var(--color-gray);
  }
  .sh-untyped-key {
    color: #b00;
  }

  .sh-grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sh-tile :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* As uploaded: masonry, each tile its file's own shape. */
  [data-shapes='uploaded'] .sh-grid {
    columns: 4;
    column-gap: 8px;
  }
  [data-shapes='uploaded'] .sh-tile {
    break-inside: avoid;
    margin-bottom: 8px;
  }

  /* Shaped by type: rows of four, each tile its type's shape. */
  [data-shapes='typed'] .sh-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-flow: dense;
    gap: 8px;
  }
  [data-shapes='typed'] .sh-tile {
    grid-column: span var(--span);
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--color-gray-light);
  }
  [data-shapes='typed'] .sh-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--at, 50% 50%);
  }
  [data-shapes='typed'] .sh-tile--mark :global(img) {
    object-fit: contain;
    padding: 8%;
    box-sizing: border-box;
  }
  [data-shapes='typed'] .sh-tile--untyped {
    outline: 2px solid #b00;
    outline-offset: -2px;
  }

  @media (max-width: 47.99rem) {
    [data-shapes='uploaded'] .sh-grid {
      columns: 2;
    }
    [data-shapes='typed'] .sh-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-shapes]');
  root?.querySelectorAll<HTMLButtonElement>('[data-show]').forEach((b) =>
    b.addEventListener('click', () => {
      root.dataset.shapes = b.dataset.show!;
      root.querySelectorAll('[data-show]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    }),
  );
</script>
