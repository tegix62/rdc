---
/*
  One video component for the whole site, so the two very different kinds of
  video are decided in one place rather than per call site.

  UPLOADED FILE -> a native <video>. No player JavaScript at all.
    playback 'autoplay': muted, looping, inline, no controls, plus one small
      pause button. Muted is not a style choice - browsers refuse to autoplay
      anything else - and `playsinline` is what stops iOS taking the video
      fullscreen the moment it starts.
    playback 'click': normal controls, preload="none" so nothing but the poster
      is fetched until someone presses play.

  YOUTUBE / VIMEO -> a facade. A poster and a play button; the iframe is created
  on click.

  That last part is the measured win. Each embed pulls roughly 640 KB of player
  JavaScript whether or not anyone watches: /video was 1,199 KB with 960 KB of
  it script, and /style-guide with three embeds pulled 1,921 KB. A facade moves
  all of that behind an intention to watch.

  The facade is a <button> rather than a div with a handler, so it is reachable
  by keyboard and announced as a control for free.
*/
import {embedUrl} from '../lib/video';
import {imageUrl} from '../lib/image';
import Img from './Img.astro';

interface Props {
  /** A YouTube or Vimeo link. Ignored when a file is present. */
  url?: string | null;
  /** Uploaded MP4, as resolved from Sanity (`videoFile{asset->{url}}`). */
  file?: {asset?: {url?: string}} | null;
  /** Uploaded WebM. Offered before the MP4, being usually smaller. */
  webm?: {asset?: {url?: string}} | null;
  /** Direct URL to a hosted video file (R2, CDN). */
  videoSrc?: string | null;
  poster?: any;
  /* Which Studio field the poster came from, for build warnings only - see the
     `field` prop on Img.astro. A warning naming only the document sends someone
     to the wrong one of its six image fields. */
  posterField?: string;
  playback?: 'click' | 'autoplay' | 'poster' | null;
  /** Strip audio from playback. */
  muted?: boolean | null;
  /** Used for the accessible name, and as the iframe title. */
  title?: string;
  /** Largest width this is rendered at, for sizing the poster. */
  width?: number;
  sizes?: string;
  class?: string;
}

const {
  url,
  file,
  webm,
  poster,
  posterField,
  playback = 'click',
  title = 'Video',
  width = 1600,
  sizes = '100vw',
  class: className,
} = Astro.props;

const mp4 = file?.asset?.url ?? null;
const webmUrl = webm?.asset?.url ?? null;
const directUrl = typeof Astro.props.videoSrc === 'string' ? Astro.props.videoSrc : null;
const directType = directUrl?.endsWith('.webm') ? 'video/webm' : directUrl?.endsWith('.mov') ? 'video/quicktime' : directUrl ? 'video/mp4' : null;
const forceMuted = Boolean(Astro.props.muted);
const selfHosted = Boolean(mp4 || webmUrl || directUrl);
const autoplay = selfHosted && playback === 'autoplay';
const posterPlay = playback === 'poster';

/*
  embedUrl now guarantees string-or-null, so this is belt and braces rather than
  the fix - but a component that renders whatever it is handed should not be the
  thing that takes a build down, and a video that silently does not appear is a
  far better failure than a blank site.
*/
const embed = !selfHosted ? embedUrl(url) : null;

/*
  Content problems should be visible to whoever can fix them, not swallowed.

  Named by `title`, because the value alone is useless as a diagnostic: when the
  field holds an object the message read `[Video] "[object Object]"`, which says
  there is a problem somewhere in 21 pages and nothing about where. The title is
  already passed in for the accessible name, so it costs nothing to say which
  document to open.
*/
if (!selfHosted && url && !embed) {
  const shown = typeof url === 'string' ? `"${url.slice(0, 80)}"` : `a ${typeof url}, not a link`;
  console.warn(
    `[Video] ${title}: ${shown} is not a YouTube or Vimeo link, so nothing ` +
      `will render here. Only those two are embeddable.`,
  );
}

/*
  The poster for an embed facade, in order of preference:
    1. the poster image set in Studio
    2. YouTube's own thumbnail, derived from the id already parsed out of the
       embed URL
    3. nothing, and the facade renders as a plain block with a play button

  Vimeo is deliberately absent from step 2. Its thumbnails need an API call, and
  making the build depend on a third-party request to render a page is a bad
  trade for one still - the poster field covers it.
*/
const youTubeId = embed?.includes('youtube.com/embed/')
  ? embed.split('/embed/')[1]?.split(/[?&]/)[0]
  : null;
/*
  sddefault (640x480) rather than hqdefault (480x360): a facade poster can be
  standing in for a full-bleed hero, and 480px wide is visibly soft at that
  size. Deliberately not maxresdefault - that only exists for videos uploaded
  at 1080p or above and 404s for the rest, which would leave a broken image
  where the poster should be.
*/
const fallbackPoster = youTubeId ? `https://i.ytimg.com/vi/${youTubeId}/sddefault.jpg` : null;
const posterUrl = imageUrl(poster)?.width(width).url() ?? null;
/*
  posterUrl, not the raw poster object. An image field can save its
  crop/hotspot settings with no file attached (the "shell" problem - see
  Img.astro), and such a shell is truthy while producing no URL. Measured
  live on Two Point Oh: hasPoster judged by the object chose preload="none",
  the <video> got no poster attribute because there was nothing to render,
  and the result was a grey box that no amount of preload fixing could
  reach. The poster the element can actually show is the only one that
  counts.
*/
const hasPoster = Boolean(posterUrl);
---

{selfHosted && posterPlay ? (
  <div class:list={['video', 'video--self', 'video--poster-play', className]} data-poster-play>
    <button type="button" class="video__poster-wrap" aria-label={`Play ${title}`}>
      {poster ? (
        <Img image={poster} alt="" field={posterField ?? 'video poster'} width={width} sizes={sizes} />
      ) : posterUrl ? (
        <img src={posterUrl} alt="" loading="lazy" />
      ) : (
        <span class="video__facade-blank" aria-hidden="true"></span>
      )}
      <span class="video__play video__play--corner" aria-hidden="true">
        <span class="video__play-tri" aria-hidden="true"></span>
      </span>
    </button>
    <video
      class="video__el"
      hidden
      controls
      controlslist="nodownload"
      muted={forceMuted || undefined}
      data-force-muted={forceMuted || undefined}
      preload="none"
      aria-label={title}
    >
      {directUrl && <source src={directUrl} type={directType!} />}
      {webmUrl && <source src={webmUrl} type="video/webm" />}
      {mp4 && <source src={mp4} type="video/mp4" />}
    </video>
    <button type="button" class="video__back" data-video-back hidden aria-label="Back to poster">
      <span class="video__back-icon" aria-hidden="true">&times;</span>
    </button>
  </div>
) : selfHosted ? (
  <div class:list={['video', 'video--self', className]}>
    <video
      class="video__el"
      poster={posterUrl ?? undefined}
      autoplay={autoplay || undefined}
      loop={autoplay || undefined}
      muted={autoplay || forceMuted || undefined}
      data-force-muted={forceMuted || undefined}
      playsinline={autoplay || undefined}
      controls={!autoplay || undefined}
      controlslist="nodownload"
      preload={autoplay || !hasPoster ? 'auto' : 'none'}
      aria-label={title}
    >
      {directUrl && <source src={directUrl} type={directType!} />}
      {webmUrl && <source src={webmUrl} type="video/webm" />}
      {mp4 && <source src={mp4} type="video/mp4" />}
    </video>

    {autoplay && (
      <button type="button" class="video__pause" data-video-pause aria-pressed="false">
        <span class="video__pause-icon" aria-hidden="true"></span>
        <span class="video__pause-label">Pause</span>
      </button>
    )}
  </div>
) : embed && posterPlay ? (
  <div class:list={['video', 'video--embed', 'video--poster-play', className]} data-video-embed={embed} data-video-title={title}>
    <button type="button" class="video__facade" aria-label={`Play ${title}`}>
      {poster ? (
        <Img image={poster} alt="" field={posterField ?? 'video poster'} width={width} sizes={sizes} />
      ) : fallbackPoster ? (
        <img src={fallbackPoster} alt="" loading="lazy" width="640" height="480" />
      ) : (
        <span class="video__facade-blank" aria-hidden="true"></span>
      )}
      <span class="video__play video__play--corner" aria-hidden="true">
        <span class="video__play-tri" aria-hidden="true"></span>
      </span>
    </button>
  </div>
) : embed ? (
  <div class:list={['video', 'video--embed', className]} data-video-embed={embed} data-video-title={title}>
    <button type="button" class="video__facade" aria-label={`Play ${title}`}>
      {poster ? (
        <Img image={poster} alt="" field={posterField ?? 'video poster'} width={width} sizes={sizes} />
      ) : fallbackPoster ? (
        <img src={fallbackPoster} alt="" loading="lazy" width="640" height="480" />
      ) : (
        <span class="video__facade-blank" aria-hidden="true"></span>
      )}
      <span class="video__play" aria-hidden="true"></span>
    </button>
  </div>
) : null}

<script>
  /*
    Both behaviours, delegated from the document so any number of videos on a
    page share one listener - and so videos added later by any other script are
    covered without re-binding.
  */
  // Hard-mute: re-mute immediately if someone tries to unmute a force-muted video.
  document.addEventListener('volumechange', (e) => {
    const v = e.target;
    if (v instanceof HTMLVideoElement && v.dataset.forceMuted !== undefined && !v.muted) {
      v.muted = true;
    }
  }, true);

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    // --- poster-play: reveal the hidden video on click --------------------
    const posterWrap = target.closest<HTMLElement>('[data-poster-play] .video__poster-wrap');
    if (posterWrap) {
      const container = posterWrap.closest<HTMLElement>('[data-poster-play]');
      if (!container) return;
      const video = container.querySelector<HTMLVideoElement>('video');
      const back = container.querySelector<HTMLElement>('[data-video-back]');
      if (video) {
        container.style.height = Math.min(container.offsetHeight, window.innerHeight * 0.8) + 'px';
        container.dataset.playing = '';
        posterWrap.hidden = true;
        video.hidden = false;
        if (back) back.hidden = false;
        video.play();
      }
      return;
    }

    // --- poster-play: back to poster --------------------------------------
    const backBtn = target.closest<HTMLElement>('[data-video-back]');
    if (backBtn) {
      const container = backBtn.closest<HTMLElement>('[data-poster-play]');
      if (!container) return;
      const video = container.querySelector<HTMLVideoElement>('video');
      const wrap = container.querySelector<HTMLElement>('.video__poster-wrap');
      if (video) { video.pause(); video.hidden = true; }
      if (wrap) wrap.hidden = false;
      container.style.height = '';
      delete container.dataset.playing;
      backBtn.hidden = true;
      return;
    }

    // --- embed facade: build the iframe on first click ---------------------
    const facade = target.closest<HTMLElement>('.video__facade');
    if (facade) {
      const holder = facade.closest<HTMLElement>('[data-video-embed]');
      const src = holder?.dataset.videoEmbed;
      if (!holder || !src) return;
      const frame = document.createElement('iframe');
      // autoplay=1 because the click WAS the intention to play; without it the
      // visitor has to press play a second time inside the iframe.
      frame.src = src + (src.includes('?') ? '&' : '?') + 'autoplay=1';
      frame.title = holder.dataset.videoTitle || 'Video';
      frame.allow = 'autoplay; fullscreen; picture-in-picture';
      frame.setAttribute('allowfullscreen', '');
      frame.loading = 'eager';
      holder.replaceChildren(frame);
      return;
    }

    // --- pause button on an autoplaying loop ------------------------------
    const pause = target.closest<HTMLElement>('[data-video-pause]');
    if (pause) {
      const video = pause.parentElement?.querySelector('video');
      if (!(video instanceof HTMLVideoElement)) return;
      if (video.paused) {
        delete video.dataset.userPaused;
        video.play();
        pause.setAttribute('aria-pressed', 'false');
        pause.querySelector('.video__pause-label')!.textContent = 'Pause';
      } else {
        // Remembered so the viewport observer below does not restart a clip
        // the visitor explicitly stopped the moment it scrolls back into view.
        video.dataset.userPaused = '1';
        video.pause();
        pause.setAttribute('aria-pressed', 'true');
        pause.querySelector('.video__pause-label')!.textContent = 'Play';
      }
    }
  });

  /*
    Respect "reduce motion". Someone who has asked their system not to animate
    things should not be handed a looping video that started on its own. The
    poster stays, and the pause button becomes the way to start it.
  */
  // Force the browser to decode a first frame for posterless videos.
  // Chrome ignores preload="auto" when there are several videos on one
  // page; setting currentTime makes it seek and decode regardless.
  for (const v of document.querySelectorAll<HTMLVideoElement>('video[preload="auto"]:not([autoplay])')) {
    if (v.readyState < 2) {
      v.addEventListener('loadeddata', () => { v.currentTime = 0.001; }, { once: true });
      v.load();
    }
  }

  /*
    Autoplay follows the viewport instead of trusting the attribute.

    Two reasons. Reliability: Chrome defers the autoplay attribute when
    several videos compete on one page, so a clip can sit frozen even though
    it is allowed to play - calling play() whenever it enters view covers
    every such deferral, not just the one a fixed timer happens to catch.
    And economy: a looping clip nobody can see is pure bandwidth, so leaving
    the viewport pauses it and coming back resumes it - the observer fires
    with the current state on observe(), so clips already on screen start
    immediately.

    A clip the visitor stopped with the pause button stays stopped
    (data-user-paused, set by the handler above).
  */
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const inView = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const v = entry.target;
        if (!(v instanceof HTMLVideoElement)) continue;
        if (entry.isIntersecting) {
          if (v.paused && !v.dataset.userPaused) v.play().catch(() => {});
        } else if (!v.paused) {
          v.pause();
        }
      }
    }, { threshold: 0.25 });
    for (const v of document.querySelectorAll('video[autoplay]')) inView.observe(v);

    /*
      Last-resort unlock for profiles that refuse even muted scripted play.

      Measured: real branded Chrome 151 under a clean policy plays these
      clips from the observer alone, yet one same-version profile with no
      enterprise policies, no extensions (incognito) and no energy saver
      refused every scripted play() until the page saw a real gesture -
      after which the same call succeeded. Whatever local setting causes
      that, the first gesture of ANY kind is enough, so the first
      pointerdown/keydown/touch/wheel anywhere retries the visible clips
      and the listeners remove themselves. Browsers that autoplay normally
      never reach this with anything left to start.

      The gesture's own target is skipped: if that first gesture is the
      Play pill on one of these clips, starting it here would make the
      click handler read it as already playing and pause it - the visitor
      would press Play and see the clip stop.
    */
    const unlock = (e: Event) => {
      for (const v of document.querySelectorAll<HTMLVideoElement>('video[autoplay]')) {
        if (e.target instanceof Node && v.parentElement?.contains(e.target)) continue;
        const r = v.getBoundingClientRect();
        const visible = r.bottom > 0 && r.top < innerHeight;
        if (visible && v.paused && !v.dataset.userPaused) v.play().catch(() => {});
      }
    };
    for (const evt of ['pointerdown', 'keydown', 'touchstart', 'wheel']) {
      document.addEventListener(evt, unlock, { once: true, passive: true, capture: true });
    }
  }

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const v of document.querySelectorAll('video[autoplay]')) {
      if (v instanceof HTMLVideoElement) {
        v.autoplay = false;
        v.pause();
        const btn = v.parentElement?.querySelector('[data-video-pause]');
        btn?.setAttribute('aria-pressed', 'true');
        const label = btn?.querySelector('.video__pause-label');
        if (label) label.textContent = 'Play';
      }
    }
  }
</script>
