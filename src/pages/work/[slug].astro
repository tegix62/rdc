---
import Layout from '../../layouts/Layout.astro';
import Img from '../../components/Img.astro';
import Sections from '../../components/Sections.astro';
import { sanityClient } from '../../lib/sanity';
import { getCaseStudy, getGridItems, getOtherCaseStudies } from '../../lib/queries';
import { socialCardUrl, fileUrl, archiveCard } from '../../lib/image';
import { embedUrl } from '../../lib/video';
import { renderPortableText } from '../../lib/portableText';
import Video from '../../components/Video.astro';
import { caseStudyNode } from '../../lib/structuredData';
import { caseStudyDescription } from '../../lib/meta';
import { readableOn } from '../../lib/color';

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(
    `*[_type == "caseStudy" && pageType == "Case Study"].slug.current`,
  );
  return slugs.map((slug: string) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const caseStudy = await getCaseStudy(slug!);
if (!caseStudy) {
  throw new Error(`Case study not found for slug: ${slug}`);
}
const gridItems = await getGridItems(caseStudy._id);
const otherWork = await getOtherCaseStudies(caseStudy._id);
const galleries = ['merchGrid', 'flyerGrid', 'processGrid'] as const;

/*
  The sections band is painted with the project's own accent colour, so its
  text colour has to be chosen from that colour rather than fixed. Without
  this the copy inherited the site's near-black ink: Adelante Barbell Club's
  accent is #333333, and its entire body section shipped as #1a1a1a on #333333.

  Computed rather than authored per project, because the colour is Chris's to
  pick in Studio and any value has to work.
*/
const bandStyle = caseStudy.accentColor
  ? [
      `--work-accent: ${caseStudy.accentColor}`,
      readableOn(caseStudy.accentColor) && `--work-accent-fg: ${readableOn(caseStudy.accentColor)}`,
    ]
      .filter(Boolean)
      .join('; ')
  : undefined;

/*
  The film embed, resolved in advance.

  `filmEmbed` is declared as a url but one migrated document holds an OBJECT,
  which is truthy - so the block below rendered its frame, `Video` correctly
  declined to render anything inside a frame it could not fill, and
  /work/two-point-oh shipped an empty bordered gap. The build has been logging
  `[Video] "[object Object]"` about it on every run.

  Gating on the resolved URL instead of on the raw field means an unusable value
  produces no block at all, which is the right amount of page for no video.
*/
const filmEmbed = embedUrl(caseStudy.filmEmbed);

/*
  `oneLineSummary` was the whole meta description, and it is empty on most of
  the 13 projects - so those pages fell through to Layout's default and shipped
  "Rumeau Design Co" as the description of every one of them. The fallback chain
  is in lib/meta.ts with a test in front of it.
*/
const description = caseStudyDescription(caseStudy);

// Social previews need an absolute URL and a predictable crop. socialCardUrl
// holds the shape and the forced JPEG - see lib/image.ts. It was three
// duplicated chains, one of which would eventually have drifted.
const ogImage =
  socialCardUrl(caseStudy.mainImage) ?? socialCardUrl(caseStudy.thumbnail) ?? undefined;
const ogVideo =
  fileUrl(caseStudy.heroVideoWebm) ?? fileUrl(caseStudy.heroVideoFile) ?? undefined;
const gated = !!caseStudy.accessPassword;
---

<Layout
  title={caseStudy.title}
  description={description}
  ogType="article"
  ogImage={ogImage}
  ogVideo={ogVideo}
  jsonLd={(ctx) => caseStudyNode(ctx, caseStudy)}
>
  {/*
    A case study leads with either a video or an image, never both. Hug a Mug's
    real page opens straight into video, and stacking a static hero above it was
    the port's invention. Setting Hero Video swaps the two rather than adding to
    them.
  */}
  {caseStudy.heroVideo || caseStudy.heroVideoFile || caseStudy.heroVideoWebm ? (
    <div class="work-hero work-hero--video full-bleed">
      <Video
        url={caseStudy.heroVideo}
        file={caseStudy.heroVideoFile}
        webm={caseStudy.heroVideoWebm}
        poster={caseStudy.mainImage ?? caseStudy.thumbnail}
        posterField={caseStudy.mainImage ? 'mainImage (Main Project Image)' : 'thumbnail (Tile Image)'}
        playback={caseStudy.heroVideoPlayback ?? 'autoplay'}
        title={caseStudy.title}
        width={2400}
      />
    </div>
  ) : (
    caseStudy.mainImage && (
      <div class="work-hero full-bleed">
        <Img
          image={caseStudy.mainImage}
          field="mainImage (Main Project Image)"
          alt={caseStudy.title}
          width={2400}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  )}

  <section class="work-identity full-bleed">
    <div class="work-identity__inner">
      <div class="work-identity__main">
        {/*
          Kicker and title wrapped as one block so the phone layout can put
          the client's mark beside THEM specifically - see the
          display:contents note in global.css. Layout-neutral on desktop,
          where __main is an ordinary block either way.
        */}
        <div class="work-identity__head">
          {caseStudy.subtitle && <p class="work-identity__kicker">{caseStudy.subtitle}</p>}
          <h1>{caseStudy.headline ?? caseStudy.title}</h1>
        </div>
        {(caseStudy.summary || caseStudy.oneLineSummary) && (
          <p class="work-identity__summary">{caseStudy.summary ?? caseStudy.oneLineSummary}</p>
        )}
        {/*
          Result Stat was in the schema and read by nothing - the CMS audit
          found it dead. It's the one number on the page a prospective client
          scans for, so it gets its own line rather than being folded into the
          summary paragraph.
        */}
        {caseStudy.resultStat && <p class="work-identity__stat">{caseStudy.resultStat}</p>}
      </div>
      {(caseStudy.clientLogo || caseStudy.credits?.length > 0 || caseStudy.principalType) && (
        <div class="work-identity__aside">
          {caseStudy.clientLogo && (
            <div class="work-identity__mark">
              <Img image={caseStudy.clientLogo} alt={caseStudy.client ?? ''} field="clientLogo (Client's Logo)" width={340} sizes="170px" />
            </div>
          )}
          {caseStudy.credits?.length > 0 && (
            <div class="work-identity__credits">
              {/*
                The name links out when a URL is given, the same treatment
                Principal Type already gets. Deliberately a normal followed
                link rather than nofollow: Chris credits collaborators partly
                so the credit is worth something to them, and a nofollow credit
                passes nothing on.
              */}
              {caseStudy.credits.map((c: any) => (
                <p>
                  <strong>{c.role}</strong>
                  {c.name && ' - '}
                  {c.name && (c.url ? (
                    <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
                  ) : c.name)}
                </p>
              ))}
            </div>
          )}
          {/*
            Principal type, credited the way a typography book does it. Sits
            with the credits because that is what it is - crediting the
            typographers the work borrows from, whether or not they know it.
          */}
          {caseStudy.principalType && (
            <div class="work-identity__credits work-identity__type">
              <p>
                <strong>Principal Type</strong>{' - '}
                {caseStudy.principalTypeUrl ? (
                  <a href={caseStudy.principalTypeUrl} target="_blank" rel="noopener noreferrer">
                    {caseStudy.principalType}
                  </a>
                ) : (
                  caseStudy.principalType
                )}
              </p>
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  {/*
    Film Embed was likewise dead. It sits after the identity block so a case
    study can lead with its story and then show the film, rather than
    competing with the hero for the top of the page.
  */}
  {filmEmbed && (
    <div class="work-section work-section--video">
      <div class="work-video-frame">
        {/* Through Video for the same reason as everything else: the 640 KB of
            player script waits for someone to actually want it. */}
        <Video url={filmEmbed} title={`${caseStudy.title} film`} width={1600} />
      </div>
    </div>
  )}

  {caseStudy.sections?.length > 0 ? (
    <div class="work-band full-bleed" style={bandStyle}>
      <div class="work-band__inner">
        <Sections sections={caseStudy.sections} />
      </div>
    </div>
  ) : (
    <article class="prose">
      {caseStudy.body?.length > 0 && <div set:html={renderPortableText(caseStudy.body)} />}
      {caseStudy.servicesRendered?.length > 0 && (
        <>
          <h2>Services</h2>
          <div set:html={renderPortableText(caseStudy.servicesRendered)} />
        </>
      )}
      {galleries.map((field) =>
        caseStudy[field]?.length > 0 ? (
          <div class="grid">
            {caseStudy[field].map((img: any) => (
              <Img image={img} field={field} width={800} sizes="(max-width: 40rem) 100vw, 33vw" />
            ))}
          </div>
        ) : null,
      )}
      {gridItems.length > 0 && (
        <div class="grid">
          {gridItems.map(
            (item: any) =>
              item.thumbnail && (
                <Img image={item.thumbnail} alt={item.title} field="thumbnail (Tile Image)" width={800} sizes="(max-width: 40rem) 100vw, 33vw" />
              ),
          )}
        </div>
      )}
    </article>
  )}

  {otherWork.length > 0 && (
    <section class="work-related">
      <p class="section-label">More Work</p>
      <div class="grid">
        {otherWork.map((item: any) => {
          /*
            An archive card, not a thumbnail - the Archive Mark where one is
            drawn, the tile inked where one is not. See archiveCard().

            No `height`, deliberately: that was a 4:5 crop, and these are now
            contained whole in a square box, so cropping first would only
            throw away edges before showing the rest.
          */
          const card = archiveCard(item);
          return (
            <a class="card" href={`/work/${item.slug.current}`}>
              {card.image && (
                <Img
                  image={card.image}
                  markMode={card.mode}
                  alt={item.title}
                  field={card.mode === 'drawn' ? 'archiveMark (Archive Mark)' : 'thumbnail (Tile Image)'}
                  width={600}
                  sizes="(max-width: 40rem) 33vw, 25vw"
                />
              )}
              <p class="card__title">{item.title}</p>
              {item.client && <p class="card__meta">{item.client}</p>}
            </a>
          );
        })}
      </div>
    </section>
  )}

  {gated && (
    <div class="pw-gate" id="pw-gate">
      <div class="pw-gate__card">
        <p class="pw-gate__heading">This project is under NDA.</p>
        <p class="pw-gate__body">Enter the password to view the case study.</p>
        <form class="pw-gate__form" id="pw-form">
          <input
            class="pw-gate__input"
            type="password"
            id="pw-input"
            placeholder="Password"
            autocomplete="off"
            required
          />
          <button class="pw-gate__btn" type="submit">View</button>
        </form>
        <p class="pw-gate__error" id="pw-error" hidden>Wrong password.</p>
      </div>
    </div>
  )}
</Layout>

{gated && (
  <style>
    .pw-gate {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--color-white);
    }

    .pw-gate__card {
      text-align: center;
      max-width: 22rem;
      padding: var(--space-4);
    }

    .pw-gate__heading {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 1.5rem;
      color: var(--color-navy);
      margin: 0;
    }

    .pw-gate__body {
      color: var(--color-gray);
      font-size: 0.9375rem;
      margin-top: var(--space-1);
    }

    .pw-gate__form {
      display: flex;
      gap: 0.5rem;
      margin-top: var(--space-3);
    }

    .pw-gate__input {
      flex: 1;
      font-family: var(--font-body);
      font-size: 0.9375rem;
      padding: 0.625rem 0.875rem;
      border: 1.5px solid var(--color-border);
      outline: none;
      transition: border-color 0.15s;
    }

    .pw-gate__input:focus {
      border-color: var(--color-navy);
    }

    .pw-gate__btn {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      background: var(--color-navy);
      color: var(--color-white);
      border: none;
      padding: 0.625rem 1.5rem;
      cursor: pointer;
      transition: background 0.15s;
    }

    .pw-gate__btn:hover {
      background: var(--color-navy-dark);
    }

    .pw-gate__error {
      color: #c0392b;
      font-size: 0.8125rem;
      margin-top: var(--space-1);
    }
  </style>

  <script is:inline define:vars={{ expected: caseStudy.accessPassword, slug }}>
    (function () {
      var key = 'pw-ok:' + slug;
      if (sessionStorage.getItem(key) === '1') {
        document.getElementById('pw-gate').remove();
        return;
      }
      document.getElementById('pw-form').addEventListener('submit', function (e) {
        e.preventDefault();
        var val = document.getElementById('pw-input').value;
        if (val === expected) {
          sessionStorage.setItem(key, '1');
          document.getElementById('pw-gate').remove();
        } else {
          document.getElementById('pw-error').hidden = false;
          document.getElementById('pw-input').value = '';
          document.getElementById('pw-input').focus();
        }
      });
    })();
  </script>
)}
