---
/*
  THE WORK FIRST - the homepage as the work itself. Tried on the preview,
  then live ("Let's go live with all of that").

  Chris, of the homepage: "I'm still struggling with the idea that the
  homepage is not servicing the website as much as the portfolio is." The
  portfolio is the site now - the work is the content, and it is used, not
  read - so the homepage stops being a brochure in front of it:

  - A slim band: what the studio does (the page's one heading, for search
    as much as for people), one sentence of who, and the two ways on.
  - The field: the All view itself (LandsView) - pieces grow where they
    are, projects light together, the result numbers and the video work
    are among them - over a curated part of the work, not all of it, so the
    page stays light: each project's own piece and the first of its
    pieces, plus whatever Chris picks in Site Settings' Homepage Work Grid.
  - A short foot: his portrait, how he works, and Let's work again, so the
    page keeps a face and some real words.

  What moved, not lost: the logo strip (those clients are in the field as
  their work), the testimonial cards (their numbers are tiles here), the
  checklist and the process video - About is the place for them.
*/
import Img from '../Img.astro';
import LandsView from '../portfolio/LandsView.astro';
import {getAllGridItems} from '../../lib/queries';
import {cleanKey, tileHref} from '../../lib/tiles';
import {tileImage, backgroundUrl} from '../../lib/image';
import {stripStegaKey} from '../../lib/stega';

interface Props {
  settings: any;
  contactUrl: string;
  bioText: string;
  featured: any[];
}
const {settings, contactUrl, bioText, featured} = Astro.props;
const clean = (s: unknown) => stripStegaKey(s).replace(/\s+/g, ' ').trim();
const idOf = (it: any) => cleanKey(it?._id).replace(/^drafts\./, '');

/*
  The curated part: every project's own piece and up to PER more of its
  pieces, in the portfolio's order, and the Homepage Work Grid picks.
*/
const PER = 7;
const items: any[] = (await getAllGridItems()).filter((it: any) => tileImage(it));
const taken = new Map<string, number>();
const only = new Set<string>(featured.map(idOf).filter(Boolean));
for (const it of items) {
  const href = tileHref(it);
  if (!href) continue;
  const study = cleanKey(it.pageType) === 'Case Study';
  const n = taken.get(href) ?? 0;
  if (study || n < PER) {
    only.add(idOf(it));
    if (!study) taken.set(href, n + 1);
  }
}
/*
  The blue sheet of logo sketches behind the foot - Site Settings' Proof
  Band Background, the way the original homepage used it behind its cards:
  tiled at 420px under a white wash. Chris: "use the original blue logo
  flash sheet WebP ... similar to how I used it on the original homepage",
  then, of it behind the opening band: "Drop the flashy background on the
  top. Maybe it will work better on the bottom." So it fades in from the
  white the field ends in. 840 wide for a 420px tile on a sharp screen.
*/
const sheet = await backgroundUrl(settings?.proofBandBackground, 840);
const tagline = clean(settings?.tagline) || 'Brand identity & merch design for heritage apparel brands.';
/*
  CURRENTLY - one line on what Chris is working on and when he is next
  free (Site Settings > Homepage > "Currently" line). Chris liked "what's
  Chris up to" - an open question since the first site brief. Preview only
  until he says; there, an empty field says where to write it.
*/
const CURRENTLY = import.meta.env.PUBLIC_IS_PREVIEW === 'true';
const nowLine = clean(settings?.nowLine);
/*
  COMMISSION SLOTS as a ticket drop (Site Settings > Booking): a numbered
  ticket per slot, the taken ones stamped. Preview only, beside Currently;
  left out until a season and a count are set, except on the preview where
  a DRAFT row shows what it would look like.
*/
const slotsTotal = Number(settings?.slotsTotal) || 0;
const slots = {
  season: clean(settings?.slotsSeason),
  total: slotsTotal || 5,
  taken: Math.min(Number(settings?.slotsTaken) || 0, slotsTotal || 5),
  note: clean(settings?.slotsNote),
  draft: !slotsTotal || !clean(settings?.slotsSeason),
};
if (slots.draft) slots.taken = 2;
const left = slots.total - slots.taken;
// His own closing words from Site Settings, or none - no sentence written for him.
const finalLine = clean(settings?.finalCtaLine) || clean(settings?.finalCtaHeading).replace(/:\s*$/, '');
---

<section class="wf-band">
  <h1 class="wf-band__line">{tagline}</h1>
  <p class="wf-band__who">{bioText}</p>
  {CURRENTLY && (
    <div class="tk" aria-label={`Commission slots${slots.season ? `, ${slots.season}` : ''}: ${left} of ${slots.total} open`}>
      <p class="tk__head">
        {slots.season || 'Next season'}: {left ? `${left} of ${slots.total} open` : 'all taken'}
        {slots.draft && <em> DRAFT - set Site Settings &gt; Booking</em>}
      </p>
      <ol class="tk__row">
        {Array.from({length: slots.total}, (_, i) => (
          <li class:list={['tk__ticket', i < slots.taken && 'is-taken']}>
            <span class="tk__no">No. {String(i + 1).padStart(2, '0')}</span>
            {i < slots.taken ? <span class="tk__stamp">Taken</span> : <a class="tk__claim" href={contactUrl}>Claim</a>}
          </li>
        ))}
      </ol>
      {(slots.note || !left) && <p class="tk__note">{slots.note || 'The next season opens soon.'}</p>}
    </div>
  )}
  {CURRENTLY && (
    <p class="wf-band__now">
      Currently: {nowLine || <em>write this line in Studio, Site Settings &gt; Homepage &gt; "Currently" line</em>}
    </p>
  )}
  <div class="wf-band__go">
    <a class="button" href={contactUrl}>Let's Work</a>
    <a class="button button--outline" href="/portfolio?view=all">Portfolio</a>
  </div>
</section>

<section class="pf-section wf-field" aria-label="The work">
  {/* The field asks which pane is shown; here it is the only one. */}
  <script is:inline>document.documentElement.dataset.pfPane = 'all';</script>
  <LandsView only={[...only]} home />
  {/* The field fades out under this, so it reads as going on - and the way on is a button. */}
  <p class="wf-field__more"><a class="button" href="/portfolio?view=all">See all the work</a></p>
</section>

<section class="wf-foot" style={sheet ? `--wf-sheet: url(${sheet})` : undefined}>
  {settings?.portrait && (
    <Img class="wf-foot__portrait" image={settings.portrait} field="portrait (Portrait of you)" alt="Chris Rumeau, founder of Rumeau Design Co" width={700} sizes="(max-width: 40rem) 272px, 340px" loading="lazy" />
  )}
  <div class="wf-foot__words">
    {finalLine && <p class="wf-foot__line">{finalLine}</p>}
    <a class="button" href={contactUrl}>Let's Work</a>
  </div>
</section>
