---
import '@fontsource-variable/inter-tight';
import '@fontsource/gothic-a1/400.css';
import '@fontsource/gothic-a1/500.css';
import '@fontsource/gothic-a1/700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Rumeau Design Co' } = Astro.props;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/portfolio' },
  { label: 'Merch', href: '/merchfolio' },
  { label: 'Collage', href: '/collage' },
  { label: 'Process', href: '/video' },
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="wrap">
      <nav class="site-nav">
        <a class="site-nav__brand" href="/">Rumeau Design Co</a>
        <button
          type="button"
          class="site-nav__toggle"
          id="site-nav-toggle"
          aria-expanded="false"
          aria-controls="site-nav-links"
          aria-label="Toggle menu"
        >
          <span></span><span></span><span></span>
        </button>
        <div class="site-nav__links" id="site-nav-links">
          {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>&copy; {new Date().getFullYear()} Rumeau Design Co.</p>
      </div>
    </footer>
    <style is:global>
      img {
        -webkit-user-drag: none;
        -khtml-user-drag: none;
        -moz-user-drag: none;
        -o-user-drag: none;
        user-drag: none;
        -webkit-touch-callout: none;
      }
    </style>
    <script>
      const navToggle = document.querySelector<HTMLButtonElement>('#site-nav-toggle');
      const navLinks = document.querySelector<HTMLElement>('#site-nav-links');
      navToggle?.addEventListener('click', () => {
        const isOpen = navLinks?.classList.toggle('is-open');
        navToggle.setAttribute('aria-expanded', String(!!isOpen));
      });
    </script>
    <script>
      // Ported from the Webflow site: blocks right-click save and
      // drag-to-desktop on images, site-wide.
      document.addEventListener(
        'contextmenu',
        (e) => {
          if (e.target instanceof HTMLImageElement) e.preventDefault();
        },
        false,
      );
      document.addEventListener(
        'dragstart',
        (e) => {
          if (e.target instanceof HTMLImageElement) e.preventDefault();
        },
        false,
      );
    </script>
  </body>
</html>
