---
import Layout from '../layouts/Layout.astro';
import { getPage } from '../lib/queries';
import { renderPortableText } from '../lib/portableText';
import Sections from '../components/Sections.astro';

const page = await getPage('collage');
---

<Layout title={page?.title ?? 'Collage'} description={page?.seoDescription}>
  <h1>{page?.heading ?? page?.title ?? 'Collage'}</h1>
  {page?.body?.length > 0 && <div class="prose" set:html={renderPortableText(page.body)} />}
  {page?.sections?.length > 0 ? (
    <div class="page-sections">
      <Sections sections={page.sections} />
    </div>
  ) : (
    <p>Content coming soon — add this page's copy and images in Studio.</p>
  )}
</Layout>
