---
/*
  One <img> for the whole site, so responsive sizing and layout stability
  can't be forgotten per call site - which is how all 21 images ended up
  without dimensions or a srcset in the first place.

  Emits:
  - width/height, so the browser reserves the right box before the file
    arrives and the page doesn't reflow as you scroll
  - srcset/sizes, so a phone fetches a phone-sized file instead of the one
    size that happened to suit a desktop hero
  - a format-negotiated src via urlFor()

  Pass `width`/`height` together to crop to a fixed ratio; pass `width`
  alone to keep the source's own aspect.
*/
import { urlFor, imageDimensions, buildSrcSet, originalUrl, isPassThrough } from '../lib/image';
import { isAnimatedSource } from '../lib/animated';
import { getAnimatedVideo } from '../lib/animatedVideo';

interface Props {
  image: any;
  alt: string;
  /** Largest width this image is ever rendered at, in CSS pixels. */
  width: number;
  /** Only when cropping to a fixed ratio. */
  height?: number;
  /** Defaults to full-viewport-width, which is right for most blocks here. */
  sizes?: string;
  /** Above-the-fold images should pass "eager". */
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  image,
  alt,
  width,
  height,
  sizes = '100vw',
  loading = 'lazy',
  fetchpriority,
  class: className,
} = Astro.props;

const cropped = typeof height === 'number';
const aspect = cropped ? {width, height: height!} : undefined;

// Fall back to the requested box if the reference carries no dimensions, so
// a malformed asset degrades to "no srcset" rather than breaking the build.
const intrinsic = imageDimensions(image);
const ratio = cropped
  ? {width, height: height!}
  : intrinsic ?? {width, height: Math.round(width * 0.75)};

/*
  "Serve exactly as uploaded" wins over everything below: no transform
  parameters, and no srcset, because every srcset candidate is by definition
  a re-encode. Dimensions are still emitted, so pass-through images reserve
  their space and don't reintroduce the layout shift.
*/
// Decided by reading the file header, cached per asset per build. The asset
// reference's extension is not trusted: this dataset has `-gif` references
// holding static PNG and `-webp` references holding JPEG, and believing them
// disabled responsive sizing on dozens of ordinary images.
const animated = await isAnimatedSource(image);
const passThrough = isPassThrough(image, animated);
const original = passThrough ? originalUrl(image) : null;

/*
  An animation with a converted video version renders as <video> instead: a
  looping h264 is typically an order of magnitude smaller than the same GIF.
  Silent, looping and inline, so it behaves exactly like the animated image it
  replaces. Falls back to the image when no conversion exists yet.
*/
const video = passThrough ? await getAnimatedVideo(image, width) : null;

let builtSrc = urlFor(image).width(width);
if (cropped) builtSrc = builtSrc.height(height!).fit('crop');

const src = original ?? builtSrc.url();
const srcset = passThrough ? undefined : buildSrcSet(image, width, aspect);

// A pass-through file is delivered at its full size to every device, so an
// oversized one is a cost the CDN can no longer absorb. Flag it at build
// time rather than letting it quietly land on phones.
const manualPassThrough = image?.noRecompress === true;
if (manualPassThrough && intrinsic && intrinsic.width > width * 2) {
  console.warn(
    `[Img] "serve exactly as uploaded" image is ${intrinsic.width}px wide but ` +
      `renders at most ${width}px. Every visitor downloads the full file. ` +
      `Consider uploading it closer to ${width * 2}px.`,
  );
}
if (manualPassThrough && (image?.crop || image?.hotspot)) {
  console.warn(
    '[Img] "serve exactly as uploaded" ignores the crop/hotspot set in Studio, ' +
      'because cropping requires re-encoding.',
  );
}
---

{video ? (
  <video
    class={className}
    width={ratio.width}
    height={ratio.height}
    poster={video.poster ?? undefined}
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    aria-label={alt}
  >
    {video.webm && <source src={video.webm} type="video/webm" />}
    {video.mp4 && <source src={video.mp4} type="video/mp4" />}
  </video>
) : (
<img
  src={src}
  data-ink-mode={image?.inkMode && image.inkMode !== 'auto' ? image.inkMode : undefined}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  width={ratio.width}
  height={ratio.height}
  alt={alt}
  loading={loading}
  decoding={loading === 'eager' ? 'sync' : 'async'}
  fetchpriority={fetchpriority}
  class={className}
/>
)}
