---
import '@fontsource-variable/inter-tight';
import '@fontsource/gothic-a1/400.css';
import '@fontsource/gothic-a1/500.css';
import '@fontsource/gothic-a1/700.css';
import '../styles/global.css';
import { getSiteSettings } from '../lib/queries';
import { urlFor } from '../lib/image';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Rumeau Design Co' } = Astro.props;

const settings = await getSiteSettings();

// The real site's nav: only 4 links are shown, not every page in the
// project (Merch/Collage/Blog still exist, just aren't nav-linked).
const navLinks = [
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'About', href: '/about' },
  { label: 'Video', href: '/video' },
];
const TALLY_URL = settings?.contactUrl || 'https://tally.so/r/mZ8LXz';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-nav">
      <nav class="site-nav__inner">
        <a class="site-nav__brand" href="/">
          {settings?.logo ? (
            <img src={urlFor(settings.logo).height(96).url()} alt="Rumeau Design Co" />
          ) : (
            'Rumeau Design Co'
          )}
        </a>
        <button
          type="button"
          class="site-nav__toggle"
          id="site-nav-toggle"
          aria-expanded="false"
          aria-controls="site-nav-links"
          aria-label="Toggle menu"
        >
          <span></span><span></span><span></span>
        </button>
        <div class="site-nav__links" id="site-nav-links">
          {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          <a class="site-nav__contact" href={TALLY_URL}>Contact</a>
        </div>
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__top">
        <a class="site-footer__brand" href="/">
          {settings?.logo ? (
            <img src={urlFor(settings.logo).height(60).url()} alt="Rumeau Design Co" />
          ) : (
            'Rumeau Design Co'
          )}
        </a>

        <div class="site-footer__col">
          <p class="site-footer__heading">Follow</p>
          {settings?.socialLinks?.length > 0 ? (
            settings.socialLinks.map((s: any) =>
              s.url ? (
                <a class="site-footer__social-link" href={s.url} target="_blank" rel="noopener noreferrer">
                  {s.platform}
                </a>
              ) : null,
            )
          ) : (
            <p class="site-footer__muted">No social links yet</p>
          )}
        </div>

        <div class="site-footer__col">
          <p class="site-footer__heading">Contact</p>
          <a class="button button--dark" href={TALLY_URL}>Get in Touch</a>
        </div>
      </div>

      <div class="wrap site-footer__bottom">
        <p>&copy; {new Date().getFullYear()} Rumeau Design LLC. All rights reserved.</p>
        <a href="/privacy-policy">Privacy Policy</a>
      </div>
    </footer>
    <style is:global>
      img {
        -webkit-user-drag: none;
        -khtml-user-drag: none;
        -moz-user-drag: none;
        -o-user-drag: none;
        user-drag: none;
        -webkit-touch-callout: none;
      }
    </style>
    <script>
      const navToggle = document.querySelector<HTMLButtonElement>('#site-nav-toggle');
      const navLinks = document.querySelector<HTMLElement>('#site-nav-links');
      navToggle?.addEventListener('click', () => {
        const isOpen = navLinks?.classList.toggle('is-open');
        navToggle.setAttribute('aria-expanded', String(!!isOpen));
      });
    </script>
    <script>
      // Ported from the Webflow site: blocks right-click save and
      // drag-to-desktop on images, site-wide.
      document.addEventListener(
        'contextmenu',
        (e) => {
          if (e.target instanceof HTMLImageElement) e.preventDefault();
        },
        false,
      );
      document.addEventListener(
        'dragstart',
        (e) => {
          if (e.target instanceof HTMLImageElement) e.preventDefault();
        },
        false,
      );
    </script>
  </body>
</html>
